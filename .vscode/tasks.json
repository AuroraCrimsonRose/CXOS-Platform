{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build CXOS",
            "type": "shell",
            "command": "${workspaceFolder}/tools/cxk.exe os build",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": []
        },
        {
            "label": "Build CXOS (development: runs unsigned programs)",
            "type": "shell",
            "command": "${workspaceFolder}/tools/cxk.exe os build --dev",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Build DevKit",
            "type": "shell",
            "command": "dotnet build ${workspaceFolder}/devkit/CXEX.Studio.slnx",
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Run QEMU",
            "type": "shell",
            "command": "${workspaceFolder}/tools/cxk.exe run ${workspaceFolder}/dist/CXK_x86_32/images/cxk_disk.img",
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": []
        },
        {
            "label": "Run QEMU (q35 / AHCI / e1000)",
            "type": "shell",
            "command": "${workspaceFolder}/tools/cxk.exe run ${workspaceFolder}/dist/CXK_x86_32/images/cxk_disk.img --machine q35",
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Run QEMU (serial log to boot.log)",
            "type": "shell",
            "command": "${workspaceFolder}/tools/cxk.exe run ${workspaceFolder}/dist/CXK_x86_32/images/cxk_disk.img --machine pc --snapshot --headless --serial boot.log",
            "group": "test",
            "problemMatcher": []
        }
    ]
}
