// hi.xfxn - a program that lives on the disk rather than inside the OS.
// Aurora Tejeda / CATX SYSTEMS LLC
//
// Built to a signed .xcex, staged into /System/Programs, and started with
// SYS_EXEC_PATH.
// Nothing about it is embedded in the executive: the kernel reads it off CXFS,
// checks the signature, and runs it. Change this file and only this file, and
// the running system changes - which is the whole point of the exercise.
//
// It writes to the console directly rather than asking a broker to, because
// its launcher hands it GRANT_CONSOLE by attenuation (CX_ABI.md section 5). The
// brokered model still works unchanged; this is the other end of that
// spectrum, and it is the end that needs no endpoint to exist first.

import "io.xfxn";
import "fmt.xfxn";

fn _start() -> void {
    puts("hi - loaded from disk, verified, run in ring 3\n");
    puts("    nothing about this program is compiled into the OS\n");

    // The kernel hands a program its arguments on a page of its own; arg_at(0)
    // is the name its launcher used. Printing them is the only way to see from
    // the outside that they crossed the address-space boundary intact.
    let n: u32 = arg_count();
    puts("    argc ");
    print_u32(n);
    newline();
    let i: u32 = 0;
    while (i < n) {
        puts("    argv[");
        print_u32(i);
        puts("] = ");
        puts(arg_at(i));
        newline();
        i = i + 1;
    }
    exit(0);
}
