// std/geos.xfxn - Classic UI widget toolkit for CXK X.
// Aurora Tejeda / CATX SYSTEMS LLC
//
//   import "geos.xfxn";
//
// Provides high-level drawing primitives for a GEOS/System 6 style environment.
// Relies on gfx.xfxn for framebuffer operations and string.xfxn for centering.

import "gfx.xfxn";
import "string.xfxn";

// Classic high-contrast theme
const GEOS_DESKTOP: color = CYAN;
const GEOS_BORDER:  color = BLACK;
const GEOS_FILL:    color = WHITE;

// Keyboard navigation constants (Assumes WASD layout)
const KEY_UP:    i32 = 119;  // 'w'
const KEY_DOWN:  i32 = 115;  // 's'
const KEY_LEFT:  i32 = 97;   // 'a'
const KEY_RIGHT: i32 = 100;  // 'd'

// Draw the desktop background and top menu bar
fn geos_desktop(menu_text: *u8) -> void {
    let sw: u32 = gfx_width();
    gfx_clear(GEOS_DESKTOP);
    gfx_fill_rect(0, 0, sw, 20, GEOS_FILL);
    gfx_line(0, 20, sw, 20, GEOS_BORDER);
    
    // Draw the menu text (e.g., "cxk   File   Edit   View")
    gfx_text(16, 4, menu_text, GEOS_BORDER, GEOS_FILL);
}

// Draw a classic window with a drop shadow, striped title bar, and close box
fn geos_window(x: u32, y: u32, w: u32, h: u32, title: *u8) -> void {
    // 1. Drop shadow (6px offset)
    gfx_fill_rect(x + 6, y + 6, w, h, GEOS_BORDER);

    // 2. Window body and border
    gfx_fill_rect(x, y, w, h, GEOS_FILL);
    gfx_rect(x, y, w, h, GEOS_BORDER);

    // 3. Title bar stripes
    let i: u32 = 2;
    while (i < 18) {
        if (i % 2 == 0) {
            gfx_line(x + 2, y + i, (x + w) - 3, y + i, GEOS_BORDER);
        }
        i = i + 1;
    }

    // 4. Centered Title Text (Assuming an 8px wide font)
    let tw: u32 = strlen(title) * 8;
    let tx: u32 = x + (w / 2) - (tw / 2);
    
    // Blank out the stripes behind the text for readability
    gfx_fill_rect(tx - 8, y + 1, tw + 16, 18, GEOS_FILL);
    gfx_text(tx, y + 4, title, GEOS_BORDER, GEOS_FILL);

    // 5. Close Box (Top left)
    gfx_fill_rect(x + 6, y + 4, 12, 12, GEOS_FILL);
    gfx_rect(x + 6, y + 4, 12, 12, GEOS_BORDER);
}

// Draw a button that automatically centers its text and handles its focus state
fn geos_button(x: u32, y: u32, w: u32, h: u32, label: *u8, is_active: i32) -> void {
    // Drop shadow
    gfx_fill_rect(x + 2, y + 2, w, h, GEOS_BORDER);
    
    // Calculate centered text coordinates (assuming 8x16 font)
    let tw: u32 = strlen(label) * 8;
    let tx: u32 = x + (w / 2) - (tw / 2);
    let ty: u32 = y + (h / 2) - 8;
    
    if (is_active == 1) {
        // Focused state (Inverted)
        gfx_fill_rect(x, y, w, h, GEOS_BORDER);
        gfx_rect(x, y, w, h, GEOS_FILL);
        gfx_text(tx, ty, label, GEOS_FILL, GEOS_BORDER);
    } else {
        // Normal state
        gfx_fill_rect(x, y, w, h, GEOS_FILL);
        gfx_rect(x, y, w, h, GEOS_BORDER);
        gfx_text(tx, ty, label, GEOS_BORDER, GEOS_FILL);
    }
}

// Draw the inverted (active) state for the close box
fn geos_close_box_active(x: u32, y: u32) -> void {
    gfx_fill_rect(x + 6, y + 4, 12, 12, GEOS_BORDER);
    gfx_rect(x + 6, y + 4, 12, 12, GEOS_FILL);
}

// Returns 1 if the point (px, py) is inside the rectangle, else 0
fn geos_hit_test(px: u32, py: u32, x: u32, y: u32, w: u32, h: u32) -> i32 {
    if (px >= x && px <= x + w) {
        if (py >= y && py <= y + h) {
            return 1;
        }
    }
    return 0;
}

// Draws a classic high-contrast crosshair pointer
fn geos_cursor(mx: u32, my: u32) -> void {
    // Black outline cross
    gfx_line(mx - 5, my, mx + 5, my, GEOS_BORDER);
    gfx_line(mx, my - 5, mx, my + 5, GEOS_BORDER);
    
    // White center to ensure it's visible on dark backgrounds
    gfx_pixel(mx, my, GEOS_FILL);
    gfx_pixel(mx - 1, my, GEOS_FILL);
    gfx_pixel(mx + 1, my, GEOS_FILL);
    gfx_pixel(mx, my - 1, GEOS_FILL);
    gfx_pixel(mx, my + 1, GEOS_FILL);
}

// ---- Calculator GUI State & Callbacks ----
global gui_focus:  i32;
global gui_mx:     u32;
global gui_my:     u32;

global calc_v:        i32;
global calc_acc:      i32;
global calc_op:       u32; 
global calc_disp:     [16]u8;
global calc_new_num:  i32;

// Helper: Convert signed integer to string for the display
fn i32_to_str(buf: *u8, cap: u32, val: i32) -> void {
    let v: u32 = val as u32;
    let n: u32 = 0;
    if (val < 0) {
        buf[0] = 45; // '-'
        n = 1;
        v = (0 - val) as u32;
    }
    u32_to_dec(&buf[n], cap - n, v);
}

fn calc_update_display() -> void {
    i32_to_str(&calc_disp[0], 16, calc_v);
}

fn calc_push_digit(d: i32) -> void {
    if (calc_new_num == 1) {
        calc_v = d;
        calc_new_num = 0;
    } else {
        if (calc_v > 0 - 9999999 && calc_v < 9999999) {
            if (calc_v >= 0) { calc_v = (calc_v * 10) + d; }
            if (calc_v < 0)  { calc_v = (calc_v * 10) - d; }
        }
    }
    calc_update_display();
}

fn calc_do_op(op: u32) -> void {
    if (calc_op == 1) { calc_acc = calc_acc + calc_v; } // Add
    if (calc_op == 2) { calc_acc = calc_acc - calc_v; } // Subtract
    if (calc_op == 0) { calc_acc = calc_v; }

    calc_v = calc_acc;
    calc_op = op;
    calc_new_num = 1;
    calc_update_display();
}

fn calc_clear() -> void {
    calc_v = 0; calc_acc = 0; calc_op = 0; calc_new_num = 1;
    calc_update_display();
}

// Helper to draw grid buttons
fn draw_calc_btn(wx: u32, wy: u32, col: u32, row: u32, id: i32, label: *u8) -> void {
    let bx: u32 = wx + 16 + (col * 32);
    let by: u32 = wy + 60 + (row * 32);
    let active: i32 = 0;
    if (gui_focus == id) { active = 1; }
    geos_button(bx, by, 28, 28, label, active);
}

fn hit_calc_btn(mx: u32, my: u32, wx: u32, wy: u32, col: u32, row: u32) -> i32 {
    let bx: u32 = wx + 16 + (col * 32);
    let by: u32 = wy + 60 + (row * 32);
    return geos_hit_test(mx, my, bx, by, 28, 28);
}

// ---- Desktop Layer (Z=0) ----
fn draw_desktop(id: u32, rx: u32, ry: u32, rw: u32, rh: u32) -> void {
    gfx_fill_rect(rx, ry, rw, rh, CYAN);
    if (ry < 20) {
        gfx_fill_rect(0, 0, gfx_width(), 20, WHITE);
        gfx_line(0, 20, gfx_width(), 20, BLACK);
        gfx_text(16, 4, "cxk   File   Edit   View   Options", BLACK, WHITE);
    }
}

// ---- Calculator Window Layer (Z=10) ----
fn draw_window(id: u32, rx: u32, ry: u32, rw: u32, rh: u32) -> void {
    let x: u32 = layer_get_x(id);
    let y: u32 = layer_get_y(id);
    
    geos_window(x, y, 156, 210, "Calculator");

    if (gui_focus == 0 - 2) { geos_close_box_active(x, y); }
    
    // LCD Display background
    gfx_fill_rect(x + 16, y + 24, 124, 24, WHITE);
    gfx_rect(x + 16, y + 24, 124, 24, BLACK);
    gfx_text(x + 20, y + 30, &calc_disp[0], BLACK, WHITE);

    // Buttons (Row 0)
    draw_calc_btn(x, y, 0, 0, 7, "7");
    draw_calc_btn(x, y, 1, 0, 8, "8");
    draw_calc_btn(x, y, 2, 0, 9, "9");
    draw_calc_btn(x, y, 3, 0, 10, "+");

    // Buttons (Row 1)
    draw_calc_btn(x, y, 0, 1, 4, "4");
    draw_calc_btn(x, y, 1, 1, 5, "5");
    draw_calc_btn(x, y, 2, 1, 6, "6");
    draw_calc_btn(x, y, 3, 1, 11, "-");

    // Buttons (Row 2)
    draw_calc_btn(x, y, 0, 2, 1, "1");
    draw_calc_btn(x, y, 1, 2, 2, "2");
    draw_calc_btn(x, y, 2, 2, 3, "3");
    draw_calc_btn(x, y, 3, 2, 12, "=");

    // Buttons (Row 3)
    draw_calc_btn(x, y, 0, 3, 13, "C");
    draw_calc_btn(x, y, 1, 3, 0, "0");
}

// ---- Cursor Layer (Z=100) ----
fn draw_cursor(id: u32, rx: u32, ry: u32, rw: u32, rh: u32) -> void {
    geos_cursor(gui_mx, gui_my);
}