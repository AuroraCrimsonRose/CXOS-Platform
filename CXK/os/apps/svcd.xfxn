// svcd.xfxn - the CXK service supervisor.
// Aurora Tejeda / CATX SYSTEMS LLC
//
// Reads service descriptors from /System/Services and starts the ones marked
// to run at boot. The executive spawns it with GRANT_OS_BASELINE and then gets
// out of the way; svcd is what actually decides that a program should be
// running, and with what authority.
//
// It lives in ring 3 like everything else. Nothing here needs to be in the
// kernel: starting a program is exec_path, reading a descriptor is the file
// API, and both are already gated by capabilities the executive had to hand
// over deliberately.
//
// A descriptor is key=value lines. Blank lines and # comments are ignored:
//
//     # /System/Services/hello.xosv
//     exec=/System/Programs/hi.xcex
//     args=hello world
//     start=boot
//     grants=console,disk
//
// exec   the program to run. Required; a descriptor without one is skipped.
// args   passed through as argv, with the program's own path as argv[0].
// start  `boot` to start it now. Anything else, or absent, means "not yet" -
//        so a descriptor can sit there disabled without being deleted.
// every  seconds between runs. With it, svcd stays alive and re-runs the
//        program on that interval. `start` and `every` are independent:
//        `start=boot` alone runs it once, `every=60` alone first runs it a
//        minute from now, and both together run it at boot and every minute
//        after.
// grants what authority to hand it, comma separated. Default is console only.
//        Least privilege is the default on purpose: a service that turns out
//        to need the disk should have to say so in its descriptor, where
//        someone reading the system can see it.

import "io.xfxn";
import "file.xfxn";
import "string.xfxn";
import "fmt.xfxn";

const SVC_TEXT_CAP: u32 = 1024;      // one descriptor file
const SVC_PATH_CAP: u32 =  192;
const SVC_ARGS_CAP: u32 =  256;

global svc_text: [1024]u8;           // the descriptor as read
global svc_path: [192]u8;            // /System/Services/<name>
global svc_exec: [192]u8;            // the exec= value
global svc_val:  [256]u8;            // scratch for one field value
global svc_blob: [256]u8;            // packed argv for the child
global svc_started: u32;

// ---- the schedule ----------------------------------------------------------
// Flat arrays with a manual stride rather than an array of structs: X has no
// array-of-struct indexing, and one allocation per column is easier to read
// than a hand-packed record.
const SCH_MAX:     u32 = 8;
const SCH_ESTRIDE: u32 = 192;        // bytes reserved per exec path
const SCH_BSTRIDE: u32 = 256;        // bytes reserved per packed argv blob

global sch_n:      u32;
global sch_exec:   [1536]u8;         // SCH_MAX * SCH_ESTRIDE
global sch_blob:   [2048]u8;         // SCH_MAX * SCH_BSTRIDE
global sch_blen:   [8]u32;           // packed argv length, per entry
global sch_grants: [8]u32;
global sch_every:  [8]u32;           // seconds between runs
global sch_next:   [8]u32;           // tick (ms since boot) this is next due

// ---- descriptor parsing ----------------------------------------------------

// Copy the value of `key` out of `text` into `out`, NUL-terminated.
// Returns 1 if the key was present, 0 if not.
//
// Walks whole lines rather than searching for the key anywhere in the text: a
// value that happens to contain "exec=" must not be mistaken for the field.
fn svc_field(text: *u8, key: *u8, out: *u8, cap: u32) -> i32 {
    out[0] = 0;
    let i: u32 = 0;
    while (text[i] != 0) {
        // start of a line: skip indentation
        while (text[i] == 32 || text[i] == 9) { i = i + 1; }

        // a comment or a blank line - step to the next newline
        if (text[i] == 35 || text[i] == 10 || text[i] == 13) {
            while (text[i] != 0 && text[i] != 10) { i = i + 1; }
            if (text[i] == 10) { i = i + 1; }
            continue;
        }

        // does this line start with key, followed by '='?
        let k: u32 = 0;
        while (key[k] != 0 && text[i + k] == key[k]) { k = k + 1; }
        if (key[k] == 0 && text[i + k] == 61) {
            let src: u32 = i + k + 1;
            while (text[src] == 32) { src = src + 1; }     // value may be indented
            let n: u32 = 0;
            while (text[src] != 0 && text[src] != 10 && text[src] != 13) {
                if (n + 1 >= cap) { break; }
                out[n] = text[src];
                n = n + 1;
                src = src + 1;
            }
            // trailing spaces are almost always a typo, never intent
            while (n > 0 && out[n - 1] == 32) { n = n - 1; }
            out[n] = 0;
            return 1;
        }

        while (text[i] != 0 && text[i] != 10) { i = i + 1; }
        if (text[i] == 10) { i = i + 1; }
    }
    return 0;
}

// Turn a `grants=` value into a capability mask. Unknown names are ignored
// rather than failing the service: a descriptor written for a later kernel
// that names a capability this one has never heard of should still start with
// the authority this kernel can give it.
fn svc_grants(spec: *u8) -> u32 {
    if (spec[0] == 0) { return GRANT_CONSOLE; }          // the default

    let g: u32 = 0;
    let i: u32 = 0;
    let word: [16]u8;
    while (spec[i] != 0) {
        let n: u32 = 0;
        while (spec[i] != 0 && spec[i] != 44) {          // ',' separates
            if (n + 1 < 16) { word[n] = spec[i]; n = n + 1; }
            i = i + 1;
        }
        word[n] = 0;
        if (spec[i] == 44) { i = i + 1; }

        if (streq(&word[0], "console")     == 1) { g = g | GRANT_CONSOLE; }
        if (streq(&word[0], "disk")        == 1) { g = g | GRANT_DISK; }
        if (streq(&word[0], "net")         == 1) { g = g | GRANT_NET; }
        if (streq(&word[0], "mem")         == 1) { g = g | GRANT_MEM; }
        if (streq(&word[0], "framebuffer") == 1) { g = g | GRANT_FRAMEBUFFER; }
        if (streq(&word[0], "spawn")       == 1) { g = g | GRANT_SPAWN; }
    }
    return g;
}

// Pack argv the way the kernel wants it: the strings back to back, each
// NUL-terminated, with the program's own path first.
fn svc_pack(path: *u8, args: *u8) -> u32 {
    let n: u32 = strcopy(&svc_blob[0], path, SVC_ARGS_CAP) + 1;   // keep the NUL
    let i: u32 = 0;
    while (args[i] != 0) {
        while (args[i] == 32) { i = i + 1; }
        if (args[i] == 0) { break; }
        while (args[i] != 0 && args[i] != 32) {
            if (n + 2 >= SVC_ARGS_CAP) { return n; }
            svc_blob[n] = args[i];
            n = n + 1;
            i = i + 1;
        }
        svc_blob[n] = 0;
        n = n + 1;
    }
    return n;
}

// ---- running one program ---------------------------------------------------

// Start `path` with an already-packed argv blob and the given authority.
// Returns the pid, or a negative error.
fn svc_run(path: *u8, blob: *u8, blen: u32, grants: u32) -> i32 {
    let a: spawn_args;
    memzero((&a) as *u8, 28);
    a.name            = path;
    a.broker_endpoint = 0 - 1;
    a.caps            = grants;
    a.args            = blob;
    a.args_len        = blen;
    return exec_path(path, &a);
}

fn svc_fail(name: *u8, rc: i32) -> void {
    puts("svcd: ");
    puts(name);
    puts(": ");
    if (rc == E_PERM) { puts("not signed by a key this kernel trusts\n"); }
    else { puts(file_strerror(rc)); newline(); }
}

// ---- starting one service --------------------------------------------------

fn svc_start(name: *u8) -> void {
    let n: u32 = strcopy(&svc_path[0], "/System/Services/", SVC_PATH_CAP);
    strcopy(&svc_path[n], name, SVC_PATH_CAP - n);

    let len: i32 = file_slurp(&svc_path[0], &svc_text[0], SVC_TEXT_CAP - 1);
    if (len < 0) {
        puts("svcd: ");
        puts(name);
        puts(": ");
        puts(file_strerror(len));
        newline();
        return;
    }
    svc_text[len as u32] = 0;

    if (svc_field(&svc_text[0], "exec", &svc_exec[0], SVC_PATH_CAP) == 0) {
        // A descriptor with no program is a typo, not a disabled service -
        // say so rather than skipping it silently.
        puts("svcd: ");
        puts(name);
        puts(": no exec= line\n");
        return;
    }

    // `start=boot` runs it now. `every=` repeats it. They are independent, and
    // a descriptor with neither is simply off - which is what lets one sit on
    // disk disabled instead of having to be deleted.
    let at_boot: i32 = 0;
    if (svc_field(&svc_text[0], "start", &svc_val[0], SVC_ARGS_CAP) == 1) {
        if (streq(&svc_val[0], "boot") == 1) { at_boot = 1; }
    }

    let every: u32 = 0;
    if (svc_field(&svc_text[0], "every", &svc_val[0], SVC_ARGS_CAP) == 1) {
        every = dec_u32(&svc_val[0]);
    }

    if (at_boot == 0 && every == 0) { return; }        // present but off

    let grants: u32 = GRANT_CONSOLE;
    if (svc_field(&svc_text[0], "grants", &svc_val[0], SVC_ARGS_CAP) == 1) {
        grants = svc_grants(&svc_val[0]);
    }

    svc_val[0] = 0;
    svc_field(&svc_text[0], "args", &svc_val[0], SVC_ARGS_CAP);
    let blob: u32 = svc_pack(&svc_exec[0], &svc_val[0]);

    if (at_boot == 1) {
        let pid: i32 = svc_run(&svc_exec[0], &svc_blob[0], blob, grants);
        if (pid < 0) {
            svc_fail(name, pid);
        } else {
            puts("svcd: started ");
            puts(name);
            puts(" pid ");
            print_u32(pid as u32);
            newline();
            svc_started = svc_started + 1;
        }
    }

    if (every == 0) { return; }

    if (sch_n >= SCH_MAX) {
        puts("svcd: ");
        puts(name);
        puts(": no room in the schedule\n");
        return;
    }

    // Copy the exec path and the packed argv into the schedule: svc_exec and
    // svc_blob are scratch and the next descriptor read overwrites both.
    let e: u32 = sch_n * SCH_ESTRIDE;
    let b: u32 = sch_n * SCH_BSTRIDE;
    strcopy(&sch_exec[e], &svc_exec[0], SCH_ESTRIDE);
    let k: u32 = 0;
    while (k < blob && k < SCH_BSTRIDE) { sch_blob[b + k] = svc_blob[k]; k = k + 1; }
    sch_blen[sch_n]   = k;
    sch_grants[sch_n] = grants;
    sch_every[sch_n]  = every;
    sch_next[sch_n]   = ticks_ms() + every * 1000;
    sch_n = sch_n + 1;

    puts("svcd: scheduled ");
    puts(name);
    puts(" every ");
    print_u32(every);
    puts("s\n");
}

// ---- the schedule loop -----------------------------------------------------
//
// Wake when the soonest task is due, run everything that has come due, work
// out the next wake, sleep again. Between wakes svcd is blocked in the kernel
// and off the run queue entirely - a scheduled task costs nothing until it
// runs.
//
// All the time arithmetic is signed differences rather than direct
// comparisons, because ticks_ms is milliseconds since boot in a u32 and wraps
// after about 49 days. `now >= due` starts answering no for the next 49 days
// the first time that happens; `(due - now) as i32 <= 0` does not care.
//
// What this does NOT do is notice that the previous run of a task is still
// going. There is no way to ask - a pid is returned but nothing reports
// whether it is still alive - so a task that runs longer than its interval
// will be started again on top of itself. For the intervals worth setting by
// hand that is not a real risk, and the honest fix is a "is this pid alive"
// call rather than a guess here.
fn svc_loop() -> void {
    while (1 == 1) {
        let now: u32 = ticks_ms();

        // run everything due
        let i: u32 = 0;
        while (i < sch_n) {
            if (((sch_next[i] - now) as i32) <= 0) {
                let rc: i32 = svc_run(&sch_exec[i * SCH_ESTRIDE],
                                      &sch_blob[i * SCH_BSTRIDE],
                                      sch_blen[i], sch_grants[i]);
                if (rc < 0) { svc_fail(&sch_exec[i * SCH_ESTRIDE], rc); }
                else {
                    // The tick it actually ran at, not the tick it was due.
                    // For a scheduled task "when did this last happen" is the
                    // question, and the answer has to come from the clock
                    // rather than from what was intended.
                    puts("svcd: ran ");
                    puts(&sch_exec[i * SCH_ESTRIDE]);
                    puts(" at ");
                    print_u32(ticks_ms());
                    puts("ms\n");
                }

                // Next due from NOW, not from when it was due. A task whose
                // run was late should not immediately be late again, and a
                // task that could not start at all should not spin.
                sch_next[i] = ticks_ms() + sch_every[i] * 1000;
            }
            i = i + 1;
        }

        // the soonest wake
        now = ticks_ms();
        let wait: u32 = SLEEP_MAX_MS;
        i = 0;
        while (i < sch_n) {
            let d: i32 = (sch_next[i] - now) as i32;
            if (d < 0) { d = 0; }
            if ((d as u32) < wait) { wait = d as u32; }
            i = i + 1;
        }

        // Never sleep zero in this loop: a task with a zero interval would
        // spin the supervisor and starve everything else.
        if (wait < 100) { wait = 100; }
        sleep_ms(wait);
    }
}

// ---- main ------------------------------------------------------------------

fn _start() -> void {
    svc_started = 0;

    // Walk the directory by index. dir_entry returns 1 for a hit and 0 once
    // the index runs past the end - it never returns a negative for "no more",
    // so the loop stops on anything that is not 1. Testing for a negative
    // instead runs to the bound with `st` still holding the LAST entry that
    // was found, and starts that service over and over.
    let i: u32 = 0;
    while (i < 64) {
        let st: file_stat;
        if (dir_entry("/System/Services", i, &st) != 1) { break; }
        i = i + 1;
        if (st.kind != FTYPE_FILE) { continue; }
        svc_start(&st.name[0]);
    }

    puts("svcd: ");
    print_u32(svc_started);
    puts(" started, ");
    print_u32(sch_n);
    puts(" scheduled\n");

    // Nothing to come back for: exit and free the thread slot rather than
    // sleeping forever on the off chance.
    if (sch_n == 0) { exit(0); }

    svc_loop();
    exit(0);
}
