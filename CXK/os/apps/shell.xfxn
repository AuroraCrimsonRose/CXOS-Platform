// shell.xfxn - the CXK console shell.
// Aurora Tejeda / CATX SYSTEMS LLC
//
// Privileged OS-level executable (CAP_OS_BASELINE): reads input, writes the
// console, reboots. Commands: help, echo <text>, reboot, gui
//
// String handling now comes from the standard library rather than being
// re-implemented here - the first X program built from more than one file.

import "io.xfxn";
import "string.xfxn";
import "fmt.xfxn";
import "fixed.xfxn";
import "gfx.xfxn";

fn _start() -> void {
    let line: [128]u8;

    puts("CXK shell - type 'help'\n");

    while (1 == 1) {
        puts("cxk> ");
        read_line(&line[0], sizeof line);

        if (streq(&line[0], "help") == 1) {
            puts("commands: help  echo <text>  pid  math  reboot  gui\n");
            continue;
        }
        if (streq(&line[0], "reboot") == 1) {
            puts("rebooting...\n");
            reboot();
        }
        if (streq(&line[0], "pid") == 1) {
            puts("shell pid: ");
            print_u32(getpid() as u32);
            puts("\n");
            continue;
        }
        if (streq(&line[0], "math") == 1) {
            // fixed-point demo: 2/3, then 15% of 200
            puts("2/3      = ");
            print_fx(fx_ratio(2, 3), 4);
            puts("\n15% of 200 = ");
            print_fx(fx_pct(fx(200), fx(15)), 2);
            puts("\n");
            continue;
        }
        if (streq(&line[0], "gui") == 1) {
            // draw a panel, some swatches and a diagonal, then wait for a key
            gfx_panel("CXK", rgb(16, 20, 32), rgb(32, 48, 96), WHITE);
            gfx_fill_rect(40, 60, 120, 80, RED);
            gfx_fill_rect(180, 60, 120, 80, GREEN);
            gfx_fill_rect(320, 60, 120, 80, BLUE);
            gfx_rect(38, 58, 404, 84, WHITE);
            gfx_line(40, 170, 440, 230, YELLOW);
            gfx_text(40, 250, "press any key to return", GREY, rgb(16, 20, 32));
            input_read();
            gfx_clear(BLACK);
            puts("\n");
            continue;
        }
        if (starts_with(&line[0], "echo ") == 1) {
            puts(&line[5]);
            puts("\n");
            continue;
        }
        if (line[0] != 0) {
            puts("unknown command: ");
            puts(&line[0]);
            puts("\n");
        }
    }
}
