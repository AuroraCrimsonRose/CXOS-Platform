// std/gui.xfxn - windowing toolkit and layer compositor for CXK X.
// Aurora Tejeda / CATX SYSTEMS LLC
//
//   import "gui.xfxn";
//
// Two halves that work together:
//
//   TOOLKIT   - immediate-mode drawing for a classic desktop: menu bar,
//               windows with drop shadows and striped title bars, buttons,
//               hit testing, and a mouse cursor.
//
//   COMPOSITOR - a z-ordered layer manager. Each layer registers a draw
//               callback (a function pointer) and the compositor redraws only
//               the layers overlapping a dirty rectangle, back to front.
//
// Pointer input comes from the kernel's PS/2 mouse driver via SYS_MOUSE_READ:
// the position is already absolute and clamped to the screen, so nothing here
// deals in relative deltas. Swapping to a USB HID mouse later changes the
// driver, not this file.

import "gfx.xfxn";
import "string.xfxn";
import "mem.xfxn";

// Classic high-contrast theme
const GEOS_DESKTOP: color = CYAN;
const GEOS_BORDER:  color = BLACK;
const GEOS_FILL:    color = WHITE;

// Keyboard navigation constants (Assumes WASD layout)
const KEY_UP:    i32 = 119;  // 'w'
const KEY_DOWN:  i32 = 115;  // 's'
const KEY_LEFT:  i32 = 97;   // 'a'
const KEY_RIGHT: i32 = 100;  // 'd'

// Draw the desktop background and top menu bar
fn geos_desktop(menu_text: *u8) -> void {
    let sw: u32 = gfx_width();
    gfx_clear(GEOS_DESKTOP);
    gfx_fill_rect(0, 0, sw, 20, GEOS_FILL);
    gfx_line(0, 20, sw, 20, GEOS_BORDER);
    
    // Draw the menu text (e.g., "cxk   File   Edit   View")
    gfx_text(16, 4, menu_text, GEOS_BORDER, GEOS_FILL);
}

// Draw a classic window with a drop shadow, striped title bar, and close box
fn geos_window(x: u32, y: u32, w: u32, h: u32, title: *u8) -> void {
    // 1. Drop shadow (6px offset)
    gfx_fill_rect(x + 6, y + 6, w, h, GEOS_BORDER);

    // 2. Window body and border
    gfx_fill_rect(x, y, w, h, GEOS_FILL);
    gfx_rect(x, y, w, h, GEOS_BORDER);

    // 3. Title bar stripes
    let i: u32 = 2;
    while (i < 18) {
        if (i % 2 == 0) {
            gfx_line(x + 2, y + i, (x + w) - 3, y + i, GEOS_BORDER);
        }
        i = i + 1;
    }

    // 4. Centered Title Text (Assuming an 8px wide font)
    let tw: u32 = strlen(title) * 8;
    let tx: u32 = x + (w / 2) - (tw / 2);
    
    // Blank out the stripes behind the text for readability
    gfx_fill_rect(tx - 8, y + 1, tw + 16, 18, GEOS_FILL);
    gfx_text(tx, y + 4, title, GEOS_BORDER, GEOS_FILL);

    // 5. Close Box (Top left)
    gfx_fill_rect(x + 6, y + 4, 12, 12, GEOS_FILL);
    gfx_rect(x + 6, y + 4, 12, 12, GEOS_BORDER);
}

// Draw a button that automatically centers its text and handles its focus state
fn geos_button(x: u32, y: u32, w: u32, h: u32, label: *u8, is_active: i32) -> void {
    // Drop shadow
    gfx_fill_rect(x + 2, y + 2, w, h, GEOS_BORDER);
    
    // Calculate centered text coordinates (assuming 8x16 font)
    let tw: u32 = strlen(label) * 8;
    let tx: u32 = x + (w / 2) - (tw / 2);
    let ty: u32 = y + (h / 2) - 8;
    
    if (is_active == 1) {
        // Focused state (Inverted)
        gfx_fill_rect(x, y, w, h, GEOS_BORDER);
        gfx_rect(x, y, w, h, GEOS_FILL);
        gfx_text(tx, ty, label, GEOS_FILL, GEOS_BORDER);
    } else {
        // Normal state
        gfx_fill_rect(x, y, w, h, GEOS_FILL);
        gfx_rect(x, y, w, h, GEOS_BORDER);
        gfx_text(tx, ty, label, GEOS_BORDER, GEOS_FILL);
    }
}

// Draw the inverted (active) state for the close box
fn geos_close_box_active(x: u32, y: u32) -> void {
    gfx_fill_rect(x + 6, y + 4, 12, 12, GEOS_BORDER);
    gfx_rect(x + 6, y + 4, 12, 12, GEOS_FILL);
}

// Returns 1 if the point (px, py) is inside the rectangle, else 0
fn geos_hit_test(px: u32, py: u32, x: u32, y: u32, w: u32, h: u32) -> i32 {
    if (px >= x && px <= x + w) {
        if (py >= y && py <= y + h) {
            return 1;
        }
    }
    return 0;
}

// Draws a classic high-contrast crosshair pointer
fn geos_cursor(mx: u32, my: u32) -> void {
    // Black outline cross
    gfx_line(mx - 5, my, mx + 5, my, GEOS_BORDER);
    gfx_line(mx, my - 5, mx, my + 5, GEOS_BORDER);
    
    // White center to ensure it's visible on dark backgrounds
    gfx_pixel(mx, my, GEOS_FILL);
    gfx_pixel(mx - 1, my, GEOS_FILL);
    gfx_pixel(mx + 1, my, GEOS_FILL);
    gfx_pixel(mx, my - 1, GEOS_FILL);
    gfx_pixel(mx, my + 1, GEOS_FILL);
}

// ---- pointer ----
// mouse_state is supplied by the ABI prelude; these wrap the syscall so callers
// never touch it directly.

global gui_mouse: mouse_state;

// refresh the cached pointer state; returns 1 if a mouse is present
fn gui_poll_mouse() -> i32 { return mouse_read(&gui_mouse); }

fn gui_mouse_x() -> u32 { return gui_mouse.x as u32; }
fn gui_mouse_y() -> u32 { return gui_mouse.y as u32; }

fn gui_mouse_left()   -> i32 { if ((gui_mouse.buttons & 1) != 0) { return 1; } return 0; }
fn gui_mouse_right()  -> i32 { if ((gui_mouse.buttons & 2) != 0) { return 1; } return 0; }
fn gui_mouse_middle() -> i32 { if ((gui_mouse.buttons & 4) != 0) { return 1; } return 0; }

// has anything changed since `last`? pass gui_mouse.seq back in next time
fn gui_mouse_changed(last: u32) -> i32 {
    if (gui_mouse.seq != last) { return 1; }
    return 0;
}

fn gui_mouse_seq() -> u32 { return gui_mouse.seq; }

// ---- compositor (z-ordered layers with dirty-rect redraw) ----

// draw_fn receives: (layer_id, dirty_x, dirty_y, dirty_w, dirty_h)
type layer_draw_fn = fn(u32, u32, u32, u32, u32) -> void;

struct layer_t {
    z: u32,
    x: u32,
    y: u32,
    w: u32,
    h: u32,
    visible: i32,
    draw: layer_draw_fn
}

const MAX_LAYERS: u32 = 16;
global layers: [16]layer_t;
global layer_count: u32;
global draw_order: [16]u32;

fn layer_init() -> void { layer_count = 0; }

fn layer_add(z: u32, x: u32, y: u32, w: u32, h: u32, draw: layer_draw_fn) -> u32 {
    if (layer_count >= MAX_LAYERS) { return 0 - 1; }
    let id: u32 = layer_count;
    layers[id].z = z;  layers[id].x = x; layers[id].y = y;
    layers[id].w = w;  layers[id].h = h;
    layers[id].visible = 1;
    layers[id].draw = draw;
    layer_count = layer_count + 1;
    return id;
}

// Move a layer's bounding box
fn layer_set_pos(id: u32, x: u32, y: u32) -> void {
    layers[id].x = x;  layers[id].y = y;
}

fn layer_get_x(id: u32) -> u32 { return layers[id].x; }
fn layer_get_y(id: u32) -> u32 { return layers[id].y; }

// AABB Collision Detection
fn rect_intersect(x1: u32, y1: u32, w1: u32, h1: u32, x2: u32, y2: u32, w2: u32, h2: u32) -> i32 {
    if (x1 + w1 <= x2) { return 0; }
    if (x2 + w2 <= x1) { return 0; }
    if (y1 + h1 <= y2) { return 0; }
    if (y2 + h2 <= y1) { return 0; }
    return 1;
}

// Painter's Algorithm: Sort layers back-to-front
fn layer_sort() -> void {
    let i: u32 = 0;
    while (i < layer_count) { draw_order[i] = i; i = i + 1; }

    let swapped: i32 = 1;
    while (swapped == 1) {
        swapped = 0;
        let j: u32 = 0;
        while (j + 1 < layer_count) {
            let id1: u32 = draw_order[j];
            let id2: u32 = draw_order[j+1];
            if (layers[id1].z > layers[id2].z) {
                draw_order[j] = id2;
                draw_order[j+1] = id1;
                swapped = 1;
            }
            j = j + 1;
        }
    }
}

// Redraws a specific "damaged" area of the screen
fn layer_render_rect(rx: u32, ry: u32, rw: u32, rh: u32) -> void {
    layer_sort();
    let k: u32 = 0;
    while (k < layer_count) {
        let id: u32 = draw_order[k];
        if (layers[id].visible == 1) {
            if (rect_intersect(rx, ry, rw, rh, layers[id].x, layers[id].y, layers[id].w, layers[id].h) == 1) {
                layers[id].draw(id, rx, ry, rw, rh);
            }
        }
        k = k + 1;
    }
}

fn layer_render_all() -> void { layer_render_rect(0, 0, gfx_width(), gfx_height()); }