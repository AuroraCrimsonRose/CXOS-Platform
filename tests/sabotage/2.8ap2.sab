# ---- reading a checked face ----

[lookup-short]
# the binary search never looks at the last entry
expect = x: fonts: an XFNT v2 face reads as written @ failed at step 8
group = g1
narrow = yes
edit = os/std/outline.xfxn
<<<
    let hi: u32 = f.map;
    while (lo < hi) {
===
    let hi: u32 = f.map - 1;
    while (lo < hi) {
>>>

[glyph-first-wrong]
# a glyph's first contour read from its contour count
expect = x: fonts: an XFNT v2 face reads as written @ failed at step 12
group = g3
narrow = yes
edit = os/std/outline.xfxn
<<<
    out.first = of_u32(f.p, r + 12);
===
    out.first = of_u32(f.p, r + 10);
>>>

# ---- loading ----

[name-takes-a-path]
