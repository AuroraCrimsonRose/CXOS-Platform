expect = x: fonts: the faces in /System/Fonts @ failed at step 1902
group = g1
narrow = yes
edit = os/std/outline.xfxn
<<<
        if (!((c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 45 || c == 95)) { return 0; }
===
