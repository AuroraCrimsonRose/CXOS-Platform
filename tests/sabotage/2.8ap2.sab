# Step 2.8a′2, the OS's XFNT v2 reader (std/outline.xfxn), run by
# `cxk test sabotage`. Each must turn red exactly the self-tests named.
# Format: docs/devkit/CX_CXK_PLAN.md, "cxk test sabotage". A group holds
# at most one sabotage per test.
#
# The mutation test stops at its first red, so one blinded rule a boot:
# every check line of of_check is blinded, each in a run of its own (or a
# group whose other members land in other tests), and every run is
# narrowed to the fonts tests (`narrow = yes`); `--all` re-proves them
# full. A rule's step is 100 + the first mutation it must refuse
# (ot_m_why); a blinded rule's mutation is either read on or refused by a
# later rule, and both are red there. The host's XfntOutlineTests holds the
# X file's face and mutations to the C# checker, which is sabotaged on the
# host.

# ---- the header ----

[short-blind]
# a file shorter than the header is read on (and refused by its length)
expect = x: fonts: each rule refuses its own break @ failed at step 300
narrow = yes
edit = os/std/outline.xfxn
<<<
    if (n < OF_HEADER) { return of_refuse(f, OF_W_SHORT); }
===
>>>

[magic-blind]
# any first four bytes pass
expect = x: fonts: each rule refuses its own break @ failed at step 100
group = g1
narrow = yes
edit = os/std/outline.xfxn
<<<
    if (p[0] != 88 || p[1] != 70 || p[2] != 78 || p[3] != 84) { return of_refuse(f, OF_W_MAGIC); }   // "XFNT"
===
>>>

[version-blind]
# a v1 file reads on as a v2 one
expect = x: fonts: each rule refuses its own break @ failed at step 101
expect = x: fonts: the faces in /System/Fonts @ failed at step 1907
group = g2
narrow = yes
edit = os/std/outline.xfxn
<<<
    if (of_u16(p, 4) != 2) { return of_refuse(f, OF_W_VERSION); }
===
>>>

[kind-blind]
# a kind other than outlines
expect = x: fonts: each rule refuses its own break @ failed at step 102
narrow = yes
edit = os/std/outline.xfxn
<<<
    if (p[6] != 2) { return of_refuse(f, OF_W_KIND); }
===
>>>

