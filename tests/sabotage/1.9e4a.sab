<<<
        if (user_copy_in(piece, text + n, m) != 0) {
            if (n == 0) return E_BAD_ADDRESS;
            break;
        }
===
        __builtin_memcpy(piece, (const void *)(uintptr_t)(text + n), m);
>>>

[fb-font-raw]
# the font's name is read where it lies
expect = syscalls use user memory only through the copy @ user copy test failed at step 32
edit = kernel/drivers/video/fb.c
<<<
    int len = user_copy_str(name, uname, sizeof name);      /* checked on the copy (1.9e4) */
===
    int len = 0;
    while (len < (int)sizeof name - 1 && (name[len] = ((const char *)(uintptr_t)uname)[len])) len++;
    name[len] = '\0';
>>>

# ---- the hook itself (usercopy.c) ----

[hook-out-gone]
# a copy out no longer fails on the armed page: the calls succeed
expect = syscalls use user memory only through the copy @ user copy test failed at step 4
edit = kernel/cpu/usercopy.c
<<<
    if (ucopy_gone(udst, len)) return E_BAD_ADDRESS;   /* a test's page gone since the check */
===
>>>

[hook-in-gone]
# a copy in no longer fails on the armed page
expect = syscalls use user memory only through the copy @ user copy test failed at step 2
edit = kernel/cpu/usercopy.c
<<<
    if (ucopy_gone(usrc, len)) return E_BAD_ADDRESS;
===
>>>
