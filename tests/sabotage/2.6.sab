group = g2
edit = os/std/wm.xfxn
<<<
ds_text(&win.frame, w.font, 6 + used, 2, room - used, &win.title[0], WM_COL_TEXT);
===
ds_text(&win.frame, w.font, 6, 2, room - used, &win.title[0], WM_COL_TEXT);
>>>

[signer-unsigned-unsaid]
