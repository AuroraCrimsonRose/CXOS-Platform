[next-due-unlocked]
expect = hooks: the scheduler takes its lock @ sched lock: step 7
edit = kernel/cpu/sched.c
<<<
    if (running && preempt_on) d = slice_end;
    uint32_t f = spin_lock(&sched_lock);
    for (uint32_t i = 0; i < tids.cap; i++) {
        struct thread *t = th((int)i);
        if (t && t->sleeping && t->wake_ns < d) d = t->wake_ns;
    }
    spin_unlock(&sched_lock, f);
===
    if (running && preempt_on) d = slice_end;
    uint32_t f = irq_save();
    for (uint32_t i = 0; i < tids.cap; i++) {
        struct thread *t = th((int)i);
        if (t && t->sleeping && t->wake_ns < d) d = t->wake_ns;
    }
    irq_restore(f);
>>>

[active-count-unlocked]
expect = hooks: the scheduler takes its lock @ sched lock: step 8
edit = kernel/cpu/sched.c
<<<
