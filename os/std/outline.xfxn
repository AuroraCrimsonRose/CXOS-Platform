// SPDX-License-Identifier: MIT
// SPDX-FileCopyrightText: 2026 Aurora Tejeda (trading as CATX Systems)
// std/outline.xfxn - outline fonts: the OS's reader of XFNT v2.
// Aurora Tejeda / CATX Systems
// Threads: any thread; a face is read-only once checked.
//
// The format is docs/system/CX_FONTS.md §4. The host converts TrueType into
// it (`cxk font build`), so nothing here parses TrueType: a file is fixed
// records whose places all follow from the header's four counts, and
// of_check compares every field, count, running sum and coordinate against
// the file and the em box before anything reads a glyph, the CXFS
// superblock check's standard. A face that passed is drawn with no further
// check, so the accessors below index without one.
//
// of_check makes the same comparisons, in the same order, as the host's
// checker (devkit/CXEX.Build/Fonts/XfntOutline.cs, Read), and each refusal
// names its rule in f.why (OF_W_*), so a test can tell which rule refused.
// The x tests (apps/outline_tests.xfxn) break each rule of the same small
// face the host's tests break, byte for byte.
//
// Fonts are loaded only from /System/Fonts (of_load takes a name, never a
// path), so a program cannot be pointed at a file another one wrote.

import "display.xfxn";
import "file.xfxn";

const OF_HEADER: u32 = 64;
const OF_EM: u32 = 4096;
const OF_LIMIT: i32 = 16384;                 // every coordinate and advance within ±4 em
const OF_MAX_GLYPHS: u32 = 65535;
const OF_MAX_MAP: u32 = 1114112;             // 0x110000
const OF_MAX_CONTOURS: u32 = 4194304;        // 2^22
const OF_MAX_POINTS: u32 = 16777216;         // 2^24
const OF_FILE_MAX: u32 = 8388608;            // 8 MiB: a larger file is refused unread
const OF_NAME_MAX: u32 = 14;                 // XSTG caps a staged name at 32 bytes, path included

const OF_ITALIC: u32 = 1;
const OF_MONOSPACE: u32 = 2;

// The rules, in the order of_check applies them. 0 is "passed".
const OF_W_SHORT: u32 = 1;           // shorter than the header
const OF_W_MAGIC: u32 = 2;
const OF_W_VERSION: u32 = 3;         // not v2 (a v1 bitmap font is refused here)
const OF_W_KIND: u32 = 4;            // not kind 2, outlines
const OF_W_FLAGS: u32 = 5;           // an unknown flag
const OF_W_EM: u32 = 6;              // the em is not 4096
const OF_W_WEIGHT: u32 = 7;          // not 1-1000
const OF_W_ASCENDER: u32 = 8;        // not above the baseline, or past the limit
const OF_W_DESCENDER: u32 = 9;       // above the baseline, or past the limit
const OF_W_GAP: u32 = 10;
const OF_W_HEIGHTS: u32 = 11;        // cap or x height
const OF_W_UNDERLINE: u32 = 12;
const OF_W_RESERVED: u32 = 13;       // a reserved field is not zero
const OF_W_GLYPHS: u32 = 14;         // glyph count not 1-65535
const OF_W_MAP_COUNT: u32 = 15;
const OF_W_CONTOUR_COUNT: u32 = 16;
const OF_W_POINT_COUNT: u32 = 17;
const OF_W_LENGTH: u32 = 18;         // the counts describe another length
const OF_W_NAME_EMPTY: u32 = 19;
const OF_W_NAME: u32 = 20;           // not printable ASCII, NUL padded
const OF_W_MAP_ORDER: u32 = 21;      // codepoints not strictly ascending
const OF_W_MAP_CHAR: u32 = 22;       // a surrogate, or past U+10FFFF
const OF_W_MAP_GLYPH: u32 = 23;      // a glyph past the font
const OF_W_ADVANCE: u32 = 24;
const OF_W_FIRST_CONTOUR: u32 = 25;  // not the running sum
const OF_W_CONTOURS_PAST: u32 = 26;  // a glyph's contours run past the table
const OF_W_BOX: u32 = 27;            // inverted, past the limit, or set with no contours
const OF_W_CONTOUR_TOTAL: u32 = 28;  // the glyphs hold another number of contours
const OF_W_FIRST_POINT: u32 = 29;    // not the running sum
const OF_W_FEW_POINTS: u32 = 30;     // a contour of fewer than two
const OF_W_POINTS_PAST: u32 = 31;
const OF_W_POINT_TOTAL: u32 = 32;    // the contours hold another number of points
const OF_W_OUTSIDE: u32 = 33;        // a point outside its glyph's box
const OF_W_FLAG: u32 = 34;           // an on-curve flag not 0 or 1
const OF_W_STARTS_OFF: u32 = 35;     // a contour starts off the curve
const OF_W_TWO_OFF: u32 = 36;        // two off-curve points together
const OF_W_PADDING: u32 = 37;        // the padding after the flags is not zero

// A checked face. p and n are the file; the *_at fields are where each
// section starts in it. mem and addr are the memory object of_load read it
// into (0 for a face checked in place).
struct of_face {
    p: *u8,
    n: u32,
    why: u32,
    mem: i32,
    addr: u64,
    flags: u32,
    weight: u32,
    ascender: i32,
    descender: i32,
    line_gap: i32,
    cap_height: i32,
    x_height: i32,
    ul_pos: i32,
    ul_thick: i32,
    glyphs: u32,
    map: u32,
    contours: u32,
    points: u32,
    map_at: u32,
    glyph_at: u32,
    contour_at: u32,
    point_at: u32,
    on_at: u32
}

// A glyph's record. The box is in em units, y up.
struct of_glyph {
    advance: u32,
    xmin: i32,
    ymin: i32,
    xmax: i32,
    ymax: i32,
    contours: u32,
    first: u32         // its first contour
}

fn of_u16(p: *u8, o: u32) -> u32 { return (p[o] as u32) | ((p[o + 1] as u32) << 8); }
fn of_s16(p: *u8, o: u32) -> i32 {
    let v: i32 = of_u16(p, o) as i32;
    if (v >= 32768) { v = v - 65536; }
    return v;
}
fn of_u32(p: *u8, o: u32) -> u32 { return of_u16(p, o) | (of_u16(p, o + 2) << 16); }
fn of_in_limit(v: i32) -> u32 { if (v >= 0 - OF_LIMIT && v <= OF_LIMIT) { return 1; } return 0; }

fn of_refuse(f: *of_face, why: u32) -> i32 {
    f.why = why;
    return E_CORRUPT;
}

// The file's length the counts describe; the counts are within their caps.
fn of_length(glyphs: u32, map: u32, contours: u32, points: u32) -> u64 {
    return (OF_HEADER as u64) + (map as u64) * 8 + (glyphs as u64) * 16 + (contours as u64) * 8
         + (points as u64) * 4 + (((points as u64) + 3) & 0xFFFFFFFC);
}

// The header: every field, the counts against their caps and the length.
fn of_check_header(f: *of_face, p: *u8, n: u32) -> i32 {
    if (n < OF_HEADER) { return of_refuse(f, OF_W_SHORT); }
    if (p[0] != 88 || p[1] != 70 || p[2] != 78 || p[3] != 84) { return of_refuse(f, OF_W_MAGIC); }   // "XFNT"
    if (of_u16(p, 4) != 2) { return of_refuse(f, OF_W_VERSION); }
    if (p[6] != 2) { return of_refuse(f, OF_W_KIND); }
    let flags: u32 = p[7] as u32;
    if ((flags & ~(OF_ITALIC | OF_MONOSPACE)) != 0) { return of_refuse(f, OF_W_FLAGS); }
    if (of_u16(p, 8) != OF_EM) { return of_refuse(f, OF_W_EM); }
    let weight: u32 = of_u16(p, 10);
    if (weight < 1 || weight > 1000) { return of_refuse(f, OF_W_WEIGHT); }
    let asc: i32 = of_s16(p, 12);
    let desc: i32 = of_s16(p, 14);
    let gap: i32 = of_s16(p, 16);
    let cap: i32 = of_s16(p, 18);
    let xh: i32 = of_s16(p, 20);
    let ulpos: i32 = of_s16(p, 22);
    let ulthick: i32 = of_s16(p, 24);
    if (asc <= 0 || asc > OF_LIMIT) { return of_refuse(f, OF_W_ASCENDER); }
    if (desc > 0 || desc < 0 - OF_LIMIT) { return of_refuse(f, OF_W_DESCENDER); }
    if (gap < 0 || gap > OF_LIMIT) { return of_refuse(f, OF_W_GAP); }
    if (cap < 0 || cap > OF_LIMIT || xh < 0 || xh > OF_LIMIT) { return of_refuse(f, OF_W_HEIGHTS); }
    if (of_in_limit(ulpos) == 0 || ulthick < 0 || ulthick > OF_LIMIT) { return of_refuse(f, OF_W_UNDERLINE); }
    if (of_u16(p, 26) != 0 || of_u32(p, 44) != 0) { return of_refuse(f, OF_W_RESERVED); }
    let glyphs: u32 = of_u32(p, 28);
    let map: u32 = of_u32(p, 32);
    let contours: u32 = of_u32(p, 36);
    let points: u32 = of_u32(p, 40);
    if (glyphs < 1 || glyphs > OF_MAX_GLYPHS) { return of_refuse(f, OF_W_GLYPHS); }
    if (map > OF_MAX_MAP) { return of_refuse(f, OF_W_MAP_COUNT); }
    if (contours > OF_MAX_CONTOURS) { return of_refuse(f, OF_W_CONTOUR_COUNT); }
    if (points > OF_MAX_POINTS) { return of_refuse(f, OF_W_POINT_COUNT); }
    if (of_length(glyphs, map, contours, points) != (n as u64)) { return of_refuse(f, OF_W_LENGTH); }
    let len: u32 = 0;
    while (len < 16 && p[48 + len] != 0) { len = len + 1; }
    if (len == 0) { return of_refuse(f, OF_W_NAME_EMPTY); }
    let i: u32 = 0;
    while (i < 16) {
        let b: u32 = p[48 + i] as u32;
        if (i < len) { if (b < 32 || b > 126) { return of_refuse(f, OF_W_NAME); } }
        else if (b != 0) { return of_refuse(f, OF_W_NAME); }
        i = i + 1;
    }
    f.flags = flags; f.weight = weight;
    f.ascender = asc; f.descender = desc; f.line_gap = gap;
    f.cap_height = cap; f.x_height = xh; f.ul_pos = ulpos; f.ul_thick = ulthick;
    f.glyphs = glyphs; f.map = map; f.contours = contours; f.points = points;
    f.map_at = OF_HEADER;
    f.glyph_at = f.map_at + map * 8;
    f.contour_at = f.glyph_at + glyphs * 16;
    f.point_at = f.contour_at + contours * 8;
    f.on_at = f.point_at + points * 4;
    return 0;
}

// The map: strictly ascending codepoints, each a character, each glyph in the font.
fn of_check_map(f: *of_face, p: *u8) -> i32 {
    let i: u32 = 0;
    let prev: u32 = 0;
    while (i < f.map) {
        let cp: u32 = of_u32(p, f.map_at + i * 8);
        let g: u32 = of_u32(p, f.map_at + i * 8 + 4);
        if (i > 0 && cp <= prev) { return of_refuse(f, OF_W_MAP_ORDER); }
        if (cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF)) { return of_refuse(f, OF_W_MAP_CHAR); }
        if (g >= f.glyphs) { return of_refuse(f, OF_W_MAP_GLYPH); }
        prev = cp;
        i = i + 1;
    }
    return 0;
}

// Glyphs: each one's contours follow the last one's; its box within the limit.
fn of_check_glyphs(f: *of_face, p: *u8) -> i32 {
    let sum: u32 = 0;
    let i: u32 = 0;
    while (i < f.glyphs) {
        let r: u32 = f.glyph_at + i * 16;
        let adv: u32 = of_u16(p, r);
        let x0: i32 = of_s16(p, r + 2);
        let y0: i32 = of_s16(p, r + 4);
        let x1: i32 = of_s16(p, r + 6);
        let y1: i32 = of_s16(p, r + 8);
        let nc: u32 = of_u16(p, r + 10);
        let first: u32 = of_u32(p, r + 12);
        if (adv > (OF_LIMIT as u32)) { return of_refuse(f, OF_W_ADVANCE); }
        if (first != sum) { return of_refuse(f, OF_W_FIRST_CONTOUR); }
        if ((sum as u64) + (nc as u64) > (f.contours as u64)) { return of_refuse(f, OF_W_CONTOURS_PAST); }
        if (nc == 0) {
            if (x0 != 0 || y0 != 0 || x1 != 0 || y1 != 0) { return of_refuse(f, OF_W_BOX); }
        } else {
            if (x0 > x1 || y0 > y1) { return of_refuse(f, OF_W_BOX); }
            if (of_in_limit(x0) == 0 || of_in_limit(x1) == 0 || of_in_limit(y0) == 0 || of_in_limit(y1) == 0) { return of_refuse(f, OF_W_BOX); }
        }
        sum = sum + nc;
        i = i + 1;
    }
    if (sum != f.contours) { return of_refuse(f, OF_W_CONTOUR_TOTAL); }
    return 0;
}

// Contours: each one's points follow the last one's; at least two.
fn of_check_contours(f: *of_face, p: *u8) -> i32 {
    let sum: u32 = 0;
    let i: u32 = 0;
    while (i < f.contours) {
        let first: u32 = of_u32(p, f.contour_at + i * 8);
        let k: u32 = of_u32(p, f.contour_at + i * 8 + 4);
        if (first != sum) { return of_refuse(f, OF_W_FIRST_POINT); }
        if (k < 2) { return of_refuse(f, OF_W_FEW_POINTS); }
        if ((sum as u64) + (k as u64) > (f.points as u64)) { return of_refuse(f, OF_W_POINTS_PAST); }
        sum = sum + k;
        i = i + 1;
    }
    if (sum != f.points) { return of_refuse(f, OF_W_POINT_TOTAL); }
    return 0;
}

// Points: inside their glyph's box; on-curve flags 0 or 1, each contour
// starting on the curve, never two off-curve points together (so every
// segment is a line or one quadratic). Then the padding.
fn of_check_points(f: *of_face, p: *u8) -> i32 {
    let pi: u32 = 0;
    let ci: u32 = 0;
    let gi: u32 = 0;
    while (gi < f.glyphs) {
        let r: u32 = f.glyph_at + gi * 16;
        let x0: i32 = of_s16(p, r + 2);
        let y0: i32 = of_s16(p, r + 4);
        let x1: i32 = of_s16(p, r + 6);
        let y1: i32 = of_s16(p, r + 8);
        let nc: u32 = of_u16(p, r + 10);
        let k: u32 = 0;
        while (k < nc) {
            let cn: u32 = of_u32(p, f.contour_at + ci * 8 + 4);
            let prev_off: u32 = 0;
            let j: u32 = 0;
            while (j < cn) {
                let x: i32 = of_s16(p, f.point_at + pi * 4);
                let y: i32 = of_s16(p, f.point_at + pi * 4 + 2);
                let on: u32 = p[f.on_at + pi] as u32;
                if (x < x0 || x > x1 || y < y0 || y > y1) { return of_refuse(f, OF_W_OUTSIDE); }
                if (on > 1) { return of_refuse(f, OF_W_FLAG); }
                if (j == 0 && on == 0) { return of_refuse(f, OF_W_STARTS_OFF); }
                if (on == 0 && prev_off == 1) { return of_refuse(f, OF_W_TWO_OFF); }
                prev_off = 1 - on;
                j = j + 1;
                pi = pi + 1;
            }
            k = k + 1;
            ci = ci + 1;
        }
        gi = gi + 1;
    }
    let i: u32 = f.on_at + f.points;
    while (i < f.n) {
        if (p[i] != 0) { return of_refuse(f, OF_W_PADDING); }
        i = i + 1;
    }
    return 0;
}

// Check the font at p, n bytes of it, and describe it in f: 0, or
// E_CORRUPT with the rule it broke in f.why. Nothing past the header is
// read until the counts are known to describe exactly n bytes.
fn of_check(f: *of_face, p: *u8, n: u32) -> i32 {
    memzero(f as *u8, sizeof *f);
    let rc: i32 = of_check_header(f, p, n);
    if (rc != 0) { return rc; }
    f.p = p;
    f.n = n;
    rc = of_check_map(f, p);
    if (rc == 0) { rc = of_check_glyphs(f, p); }
    if (rc == 0) { rc = of_check_contours(f, p); }
    if (rc == 0) { rc = of_check_points(f, p); }
    if (rc != 0) { f.p = 0 as *u8; }
    return rc;
}

// ---- loading, from /System/Fonts only ----

// A font's name: 1-14 of a-z, 0-9, '-' and '_'. Nothing else reaches the path.
fn of_name_ok(name: *u8) -> u32 {
    let i: u32 = 0;
    while (name[i] != 0) {
        if (i >= OF_NAME_MAX) { return 0; }
        let c: u32 = name[i] as u32;
        if (!((c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 45 || c == 95)) { return 0; }
        i = i + 1;
    }
    if (i == 0) { return 0; }
    return 1;
}

// Load and check /System/Fonts/<name>.xfnt into f: 0, or E_INVALID_ARGS
// for a name that is not one, an error from the file (E_NOT_FOUND and the
// like), E_CORRUPT with f.why set, or E_NO_MEMORY. The file is read into
// a memory object of its own (f.mem), so a server can share it; of_free
// lets go of it.
fn of_load(f: *of_face, name: *u8) -> i32 {
    memzero(f as *u8, sizeof *f);
    if (of_name_ok(name) == 0) { return E_INVALID_ARGS; }
    let path: [40]u8;
    let k: u32 = strcopy(&path[0], "/System/Fonts/", 40);
    k = k + strcopy(&path[k], name, 40 - k);
    strcopy(&path[k], ".xfnt", 40 - k);
    let size: i64 = file_size(&path[0]);
    if (size < 0) { return size as i32; }
    if (size < OF_HEADER as i64 || size > OF_FILE_MAX as i64) { f.why = OF_W_LENGTH; return E_CORRUPT; }
    let n: u32 = size as u32;
    let addr: u64 = 0;
    // one byte more than the file: a file that grew since its size was read
    // is not cut to fit
    let m: i32 = ds_mem((n + 1) as u64, &addr);
    if (m <= 0) { return m; }
    let p: *u8 = addr as *u8;
    let got: i32 = file_slurp(&path[0], p, n + 1);
    let rc: i32 = 0;
    if (got < 0) { rc = got; }
    else if ((got as u32) != n) { f.why = OF_W_LENGTH; rc = E_CORRUPT; }
    else { rc = of_check(f, p, n); }
    if (rc != 0) {
        let why: u32 = f.why;
        vm_unmap(addr, 0);
        handle_close(m);
        memzero(f as *u8, sizeof *f);
        f.why = why;
        return rc;
    }
    f.mem = m;
    f.addr = addr;
    return 0;
}

// Let go of a face of_load made.
fn of_free(f: *of_face) -> void {
    if (f.mem > 0) {
        vm_unmap(f.addr, 0);
        handle_close(f.mem);
    }
    memzero(f as *u8, sizeof *f);
}

// ---- reading a checked face ----

// The face's name, NUL terminated into out (at least 17 bytes).
fn of_name(f: *of_face, out: *u8) -> void {
    let i: u32 = 0;
    while (i < 16 && f.p[48 + i] != 0) { out[i] = f.p[48 + i]; i = i + 1; }
    out[i] = 0;
}

// The glyph a codepoint draws: glyph 0 for one the map lacks.
fn of_lookup(f: *of_face, cp: u32) -> u32 {
    let lo: u32 = 0;
    let hi: u32 = f.map;
    while (lo < hi) {
        let mid: u32 = lo + (hi - lo) / 2;
        let c: u32 = of_u32(f.p, f.map_at + mid * 8);
        if (c == cp) { return of_u32(f.p, f.map_at + mid * 8 + 4); }
        if (c < cp) { lo = mid + 1; } else { hi = mid; }
    }
    return 0;
}

// Glyph g's record into out: 0, or E_INVALID_ARGS past the font.
fn of_glyph_get(f: *of_face, g: u32, out: *of_glyph) -> i32 {
    if (g >= f.glyphs) { return E_INVALID_ARGS; }
    let r: u32 = f.glyph_at + g * 16;
    out.advance = of_u16(f.p, r);
    out.xmin = of_s16(f.p, r + 2);
    out.ymin = of_s16(f.p, r + 4);
    out.xmax = of_s16(f.p, r + 6);
    out.ymax = of_s16(f.p, r + 8);
    out.contours = of_u16(f.p, r + 10);
    out.first = of_u32(f.p, r + 12);
    return 0;
}

// Contour c: its first point and its count. c below f.contours.
fn of_contour_first(f: *of_face, c: u32) -> u32 { return of_u32(f.p, f.contour_at + c * 8); }
fn of_contour_count(f: *of_face, c: u32) -> u32 { return of_u32(f.p, f.contour_at + c * 8 + 4); }

// Point i, in em units, y up, and whether it is on the curve. i below f.points.
fn of_point_x(f: *of_face, i: u32) -> i32 { return of_s16(f.p, f.point_at + i * 4); }
fn of_point_y(f: *of_face, i: u32) -> i32 { return of_s16(f.p, f.point_at + i * 4 + 2); }
fn of_point_on(f: *of_face, i: u32) -> u32 { return f.p[f.on_at + i] as u32; }
