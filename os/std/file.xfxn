// std/file.xfxn - files and directories for CXK X.
// Aurora Tejeda / CATX Systems
//
//   import "file.xfxn";
//
// Conveniences over the SYS_FILE_* calls on CXFS. The calls themselves are
// the prelude's generated wrappers - file_open, file_close, file_read,
// file_write, file_seek, file_tell, file_truncate, file_sync,
// file_lock_raw, file_unlock_range, stat, fstat, dir_entry, mkdir, unlink,
// rename, chdir and getcwd - documented in abi/kernel.xfil. They need
// GRANT_DISK, which is part of GRANT_OS_BASELINE - the shell can use it, a
// capability-less app cannot.
//
// A handle is a small non-negative integer; anything negative is an E_* code.
// Offsets and sizes are u64 (an offset to seek by is i64), so a file is not
// capped at 2 GB. file_seek and file_tell hand the position back through a
// *u64, since a result is an i32. One read or write moves at most 2 GB - 1:
// its count is an i32, and a larger n is cut to that.
//
// Paths are relative to the process's working directory unless they start
// with '/'. Every process starts in the root.

import "io.xfxn";
import "mem.xfxn";
import "string.xfxn";

// ---- open ----

// open for reading; negative if it does not exist
fn file_open_read(path: *u8) -> i32 { return file_open(path, FOPEN_READ); }

// create (or empty an existing file) and open it for writing
fn file_create(path: *u8) -> i32 {
    return file_open(path, FOPEN_WRITE | FOPEN_CREATE | FOPEN_TRUNC);
}

// open for writing at the end, creating the file if it is not there
fn file_append(path: *u8) -> i32 {
    return file_open(path, FOPEN_WRITE | FOPEN_CREATE | FOPEN_APPEND);
}

// ---- write ----

// write a NUL-terminated string (without the terminator)
fn file_puts(h: i32, s: *u8) -> i32 { return file_write(h, s, strlen(s)); }

// ---- advisory locks ----

// A byte range: len 0 runs to the end of the file, however long it grows.
// mode is FLOCK_SHARED or FLOCK_EXCLUSIVE; a conflict is E_BUSY, or with
// | FLOCK_WAIT the call sleeps until the lock can be had. The call takes its range in a file_lock_args.
fn file_lock_range(h: i32, start: u64, len: u64, mode: u32) -> i32 {
    let a: file_lock_args;
    a.start = start;
    a.len = len;
    a.mode = mode;
    a.reserved = 0;
    return file_lock_raw(h, &a);
}

// The whole file (file_lock_range with start 0, len 0). Locks belong to this
// handle, and file_close releases them; so does exit.
fn file_lock(h: i32, mode: u32) -> i32 { return file_lock_range(h, 0, 0, mode); }

// Every lock this handle holds.
fn file_unlock(h: i32) -> i32 { return file_unlock_range(h, 0, 0); }

// ---- metadata ----

// 1 if the path resolves to anything at all
fn file_exists(path: *u8) -> i32 {
    let st: file_stat;
    if (stat(path, &st) == 0) { return 1; }
    return 0;
}

// size in bytes, or a negative E_* code
fn file_size(path: *u8) -> i64 {
    let st: file_stat;
    let rc: i32 = stat(path, &st);
    if (rc != 0) { return rc as i64; }
    return st.size as i64;
}

// ---- whole-file convenience ----
//
// file_slurp and file_dump are the pair: one reads an entire file by path in a
// single call, the other writes an entire buffer to one. Everything above them
// works through a handle and a byte count; these do not need a handle at all.
//
// "Slurp" is the term Perl, Ruby and Clojure all use for reading a whole file
// at once, which is why it is here - someone arriving from any of those reads
// it without being told. It is jargon, and worth knowing that the name is
// borrowed rather than descriptive: nothing about the word says "file", and
// nothing about "dump" says it is the opposite of it. If you have not met the
// term before, read them as file_read_all and file_write_all.

// Read a whole file into `buf`. Returns the byte count, or a negative E_*.
// Loops because a read is allowed to come back short.
fn file_slurp(path: *u8, buf: *u8, cap: u32) -> i32 {
    let h: i32 = file_open_read(path);
    if (h < 0) { return h; }

    let total: u32 = 0;
    while (total < cap) {
        let n: i32 = file_read(h, &buf[total], cap - total);
        if (n < 0) { file_close(h); return n; }
        if (n == 0) { break; }
        total = total + (n as u32);
    }
    file_close(h);
    return total as i32;
}

// Create `path` and write `n` bytes to it, replacing anything already there.
// The counterpart to file_slurp above - "dump" as in write it all out, not as
// in discard it.
fn file_dump(path: *u8, buf: *u8, n: u32) -> i32 {
    let h: i32 = file_create(path);
    if (h < 0) { return h; }

    let total: u32 = 0;
    while (total < n) {
        let w: i32 = file_write(h, &buf[total], n - total);
        if (w <= 0) { file_close(h); return w; }
        total = total + (w as u32);
    }
    file_close(h);
    return total as i32;
}

// ---- errors ----

// a short name for a negative return, for error messages
fn file_strerror(rc: i32) -> *u8 {
    if (rc == E_INTERNAL)         { return "kernel error"; }
    if (rc == E_NOT_SUPPORTED)    { return "not supported"; }
    if (rc == E_INVALID_ARGS)     { return "invalid argument"; }
    if (rc == E_BAD_ADDRESS)      { return "bad pointer"; }
    if (rc == E_BAD_HANDLE)       { return "bad handle"; }
    if (rc == E_WRONG_TYPE)       { return "wrong kind of handle"; }
    if (rc == E_ACCESS_DENIED)    { return "permission denied"; }
    if (rc == E_NO_MEMORY)        { return "out of memory"; }
    if (rc == E_NO_RESOURCES)     { return "too many open"; }
    if (rc == E_OUT_OF_RANGE)     { return "out of range"; }
    if (rc == E_BUFFER_TOO_SMALL) { return "buffer too small"; }
    if (rc == E_PEER_CLOSED)      { return "the other end closed"; }
    if (rc == E_CANCELED)         { return "canceled"; }
    if (rc == E_BUSY)             { return "file is in use"; }
    if (rc == E_ALREADY_EXISTS)   { return "already exists"; }
    if (rc == E_NOT_FOUND)        { return "no such file or directory"; }
    if (rc == E_NOT_DIR)          { return "not a directory"; }
    if (rc == E_IS_DIR)           { return "is a directory"; }
    if (rc == E_NO_SPACE)         { return "out of space"; }
    if (rc == E_IO)               { return "disk error"; }
    if (rc == E_DEADLOCK)         { return "would wait forever"; }
    return "error";
}
