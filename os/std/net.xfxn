// Threads: any thread. Each call is one system call; threads sharing a socket
//   share its stream.
//
//   import "net.xfxn";
//
// Wraps the SYS_NET_* calls over the ported v4 stack (e1000 -> netif -> arp/ip/icmp).
// Needs GRANT_NET, which is part of GRANT_OS_BASELINE - the shell can use it, a
// capability-less app cannot.
//
// IPv4 addresses are a packed u32 in network order: 192.168.1.10 is
// (192<<24)|(168<<16)|(1<<8)|10. Use ip4() to build one.

import "io.xfxn";
import "fmt.xfxn";

type ipv4 = u32;

// The calls themselves are the prelude's, generated from abi/kernel.xfil:
// net_status, net_mac(buf, len), net_get_config, net_set_ip, net_set_mask,
// net_set_gateway, net_set_dns, net_ping(dst, seq, rtt_us), net_send and
// net_recv. This file adds the conveniences over them.

// build a packed address from four octets
fn ip4(a: u32, b: u32, c: u32, d: u32) -> ipv4 {
    return ((a & 255) << 24) | ((b & 255) << 16) | ((c & 255) << 8) | (d & 255);
}

fn ip4_octet(ip: ipv4, i: u32) -> u32 {
    if (i == 0) { return (ip >> 24) & 255; }
    if (i == 1) { return (ip >> 16) & 255; }
    if (i == 2) { return (ip >> 8) & 255; }
    return ip & 255;
}

// ---- queries ----

fn net_up() -> i32 {
    return net_status();
}

// this host's address, 0 if it cannot be read
fn net_ip() -> ipv4 {
    let c: net_ip_config;
    if (net_get_config(&c) != 0) { return 0; }
    return c.ip;
}

// ---- printing ----

fn print_ip(ip: ipv4) -> void {
    print_u32(ip4_octet(ip, 0)); putc(46);
    print_u32(ip4_octet(ip, 1)); putc(46);
    print_u32(ip4_octet(ip, 2)); putc(46);
    print_u32(ip4_octet(ip, 3));
}

fn print_mac(m: *u8) -> void {
    let i: u32 = 0;
    while (i < 6) {
        if (i > 0) { putc(58); }        // ':'
        let b: [4]u8;
        u32_to_hex(&b[0], sizeof b, m[i] as u32);
        if (m[i] < 16) { putc(48); }    // leading zero
        puts(&b[0]);
        i = i + 1;
    }
}
