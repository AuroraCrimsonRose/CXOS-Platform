//
//   import "net.xfxn";
//
// Wraps SYS_NET_OP over the ported v4 stack (e1000 -> netif -> arp/ip/icmp).
// Needs GRANT_NET, which is part of GRANT_OS_BASELINE - the shell can use it, a
// capability-less app cannot.
//
// IPv4 addresses are a packed u32 in network order: 192.168.1.10 is
// (192<<24)|(168<<16)|(1<<8)|10. Use ip4() to build one.

import "io.xfxn";
import "fmt.xfxn";

type ipv4 = u32;

const NET_OP_STATUS:  u32 = 0;
const NET_OP_MAC:     u32 = 1;
const NET_OP_GET_IP:  u32 = 2;
const NET_OP_SET_IP:  u32 = 3;
const NET_OP_PING:    u32 = 4;
const NET_OP_SEND:    u32 = 5;
const NET_OP_RECV:    u32 = 6;

// which field NET_OP_SET_IP writes
const NET_FIELD_IP:      u32 = 0;
const NET_FIELD_MASK:    u32 = 1;
const NET_FIELD_GATEWAY: u32 = 2;
const NET_FIELD_DNS:     u32 = 3;

// build a packed address from four octets
fn ip4(a: u32, b: u32, c: u32, d: u32) -> ipv4 {
    return ((a & 255) << 24) | ((b & 255) << 16) | ((c & 255) << 8) | (d & 255);
}

fn ip4_octet(ip: ipv4, i: u32) -> u32 {
    if (i == 0) { return (ip >> 24) & 255; }
    if (i == 1) { return (ip >> 16) & 255; }
    if (i == 2) { return (ip >> 8) & 255; }
    return ip & 255;
}

// ---- queries ----

fn net_up() -> i32 {
    let a: net_op_args;
    a.op = NET_OP_STATUS; a.ip = 0; a.len = 0;
    return net_op(&a);
}

// fills a 6-byte buffer; returns 6 on success
fn net_mac(buf: *u8) -> i32 {
    let a: net_op_args;
    a.op = NET_OP_MAC; a.ip = 0; a.data = buf; a.len = 6;
    return net_op(&a);
}

// fills out[0..3] with ip, mask, gateway, dns
fn net_config(out: *u32) -> i32 {
    let a: net_op_args;
    a.op = NET_OP_GET_IP; a.ip = 0; a.len = 0; a.out = out;
    return net_op(&a);
}

fn net_ip() -> ipv4 {
    let cfg: [4]u32;
    if (net_config(&cfg[0]) != 0) { return 0; }
    return cfg[0];
}

// ---- configuration ----

fn net_set(field: u32, addr: ipv4) -> i32 {
    let a: net_op_args;
    a.op = NET_OP_SET_IP; a.ip = addr; a.len = field;
    return net_op(&a);
}

fn net_set_ip(addr: ipv4)      -> i32 { return net_set(NET_FIELD_IP, addr); }
fn net_set_mask(addr: ipv4)    -> i32 { return net_set(NET_FIELD_MASK, addr); }
fn net_set_gateway(addr: ipv4) -> i32 { return net_set(NET_FIELD_GATEWAY, addr); }
fn net_set_dns(addr: ipv4)     -> i32 { return net_set(NET_FIELD_DNS, addr); }

// ---- icmp ----

// returns 0 on reply (rtt written to *rtt_ms), negative on timeout/error
fn net_ping(dst: ipv4, seq: u32, rtt_ms: *u32) -> i32 {
    let a: net_op_args;
    a.op = NET_OP_PING; a.ip = dst; a.len = seq; a.out = rtt_ms;
    return net_op(&a);
}

// ---- raw frames ----

fn net_send(frame: *u8, len: u32) -> i32 {
    let a: net_op_args;
    a.op = NET_OP_SEND; a.ip = 0; a.data = frame; a.len = len;
    return net_op(&a);
}

// returns bytes received, 0 if nothing is waiting
fn net_recv(buf: *u8, cap: u32) -> i32 {
    let a: net_op_args;
    a.op = NET_OP_RECV; a.ip = 0; a.data = buf; a.len = cap;
    return net_op(&a);
}

// ---- printing ----

fn print_ip(ip: ipv4) -> void {
    print_u32(ip4_octet(ip, 0)); putc(46);
    print_u32(ip4_octet(ip, 1)); putc(46);
    print_u32(ip4_octet(ip, 2)); putc(46);
    print_u32(ip4_octet(ip, 3));
}

fn print_mac(m: *u8) -> void {
    let i: u32 = 0;
    while (i < 6) {
        if (i > 0) { putc(58); }        // ':'
        let b: [4]u8;
        u32_to_hex(&b[0], sizeof b, m[i] as u32);
        if (m[i] < 16) { putc(48); }    // leading zero
        puts(&b[0]);
        i = i + 1;
    }
}
