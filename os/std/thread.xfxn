// std/thread.xfxn - threads for CXK X.
// Aurora Tejeda / CATX Systems
// Threads: any thread may spawn, join and end threads.
//
//   import "thread.xfxn";
//
// Wraps SYS_THREAD_CREATE and SYS_THREAD_EXIT. A thread runs a function of
// one u64 in the same process, on a stack the kernel maps for it with a
// guard page below, and what the function returns is its exit code. Its
// handle is how it is joined: a wait for SIGNAL_THREAD_ENDED.
//
// From the first thread_spawn on, the heap and the output take a lock
// (sync.xfxn's sync_lib_lock), so any thread may allocate and print. Input
// and the rest of the library keep no lock: read input from one thread.
// sync.xfxn has the mutexes, once and condition variables to share
// anything else with.
//
// Each thread has a block of its own (tls.xfxn), a page its creator maps and
// the kernel puts in FS before the thread's first instruction. The thread
// gives it back as it ends: by returning from its function, or by calling
// thread_end. The prelude's thread_exit called directly leaves the page
// mapped until the process ends.

import "sync.xfxn";
import "mem.xfxn";

type thread_fn = fn(u64) -> i32;

const THREAD_BLOCK_BYTES: u32 = 4096;   // a page: the least a mapping is

// End the calling thread with `code`, giving its block back first. After the
// unmap nothing reads through FS: thread_exit is the kernel call alone.
fn thread_end(code: i32) -> void {
    let b: *tls_block = __tls_base() as *tls_block;
    vm_unmap(b.self as u64, 0);
    thread_exit(code);
}

// What every thread runs first: the function and its argument arrive as
// SYS_THREAD_CREATE's arg0 and arg1, its block is already in FS. A function
// that returned to the kernel's 0 would fault, so its return ends the thread.
fn thread_main(f: thread_fn, arg: u64) -> void {
    let b: *tls_block = __tls_base() as *tls_block;
    b.tid = thread_id() as u32;
    thread_end(f(arg));
}

// A new thread running f(arg), with a stack of `stack` bytes (0 for the
// default, THREAD_USTACK_DEFAULT) -> its handle, or -E_*.
fn thread_spawn(f: thread_fn, arg: u64, stack: u64) -> i32 {
    // the first thread's block, while it is the only thread
    tls_self();
    let m: vm_map_args;
    memzero((&m) as *u8, sizeof m);
    m.object = MOBJ_ANON;
    m.length = THREAD_BLOCK_BYTES;
    m.prot   = MPROT_READ | MPROT_WRITE;
    let rc: i32 = vm_map(&m);
    if (rc != E_OK) { return rc; }
    let b: *tls_block = (m.addr as usize) as *tls_block;
    b.self = m.addr as usize;

    let a: thread_create_args;
    a.entry      = thread_main as u64;
    a.arg0       = f as u64;
    a.arg1       = arg;
    a.stack_size = stack;
    a.tls        = m.addr;
    a.flags      = 0;
    a.reserved   = 0;
    // before the thread exists, and from outside every lock (sync_threaded)
    __atomic_store(&sync_threaded, 1);
    let h: i32 = thread_create(&a);
    if (h < 0) { vm_unmap(m.addr, 0); }
    return h;
}

// Wait for thread `h` to end, until `deadline` on the monotonic clock
// (DEADLINE_NEVER for no limit; time.xfxn's time_deadline_ms). -> 0 with
// *code its exit code, and the handle closed; E_TIMED_OUT, with the handle
// still open, if it is still running. A thread that ended with its process
// is never joined: the joiner went with it.
fn thread_join(h: i32, deadline: u64, code: *i32) -> i32 {
    let seen: u32 = 0;
    let rc: i32 = object_wait(h, SIGNAL_THREAD_ENDED, deadline, &seen);
    if (rc != 0) { return rc; }
    let ti: thread_info;
    let q: object_info_args;
    q.cap    = sizeof ti;
    q.buf    = (&ti) as u64;
    q.handle = h;
    q.topic  = OBJINFO_THREAD;
    rc = object_info(&q);
    if (rc < 0) { return rc; }
    *code = ti.code;
    handle_close(h);
    return 0;
}
