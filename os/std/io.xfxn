// std/io.xfxn - console input and output for CXK X.
// Aurora Tejeda / CATX Systems
//
//   import "io.xfxn";
//
// Wraps SYS_CONSOLE_WRITE and SYS_INPUT_READ. Console output needs GRANT_CONSOLE;
// input is unprivileged (a process reading its own keystrokes).
//
// Key codes worth naming: Enter is 10, Backspace 8, Ctrl+C 3.

const KEY_ENTER:     i32 = 10;
const KEY_BACKSPACE: i32 = 8;
const KEY_CTRL_C:    i32 = 3;
const KEY_TAB:       i32 = 9;
const KEY_ESC:       i32 = 27;

// ---- output ----
//
// Output goes to the handle the launcher put in slot ARGS_STDOUT
// (SYS_ARGS_HANDLE) when it put one there: a pipe's write end or a file,
// written with SYS_FILE_WRITE, which needs no grant. A program given none
// writes to the console.

global io_out:   i32;   // the output handle, once io_known is 1
global io_known: i32;   // 0: not asked yet; 1: one was given; 2: none

fn io_stdout() -> i32 {
    if (io_known == 0) {
        let h: i32 = args_handle(ARGS_STDOUT);
        if (h >= 0) { io_out = h; io_known = 1; } else { io_known = 2; }
    }
    if (io_known == 1) { return io_out; }
    return 0 - 1;
}

// n bytes to the output. A pipe takes what it has room for, so the rest
// follows until it is all gone; a write that fails ends it (a reader that
// has gone is E_PEER_CLOSED, and the bytes have nowhere to go).
fn io_emit(s: *u8, n: u32) -> void {
    let h: i32 = io_stdout();
    if (h < 0) { console_write(s, n); return; }
    let done: u32 = 0;
    while (done < n) {
        let w: i32 = file_write(h, &s[done], n - done);
        if (w <= 0) { return; }
        done = done + (w as u32);
    }
}

// write a NUL-terminated string
fn puts(s: *u8) -> void {
    let n: u32 = 0;
    while (s[n] != 0) { n = n + 1; }
    if (n > 0) { io_emit(s, n); }
}

// write exactly n bytes, NULs included
fn write(s: *u8, n: u32) -> void { if (n > 0) { io_emit(s, n); } }

// write a single character
fn putc(c: u8) -> void {
    let b: [2]u8;
    b[0] = c;
    b[1] = 0;
    io_emit(&b[0], 1);
}

fn newline() -> void { puts("\n"); }

// ---- input ----
//
// Input comes from the handle in slot ARGS_STDIN when the launcher put one
// there (a pipe's read end, a file), a byte at a time with SYS_FILE_READ; a
// program given none reads keystrokes. A handle's input ends: the first read
// that returns 0 or fails, after which getkey answers -1 and input_ended 1.
// Keystrokes never end.

global io_in:       i32;   // the input handle, once io_in_known is 1
global io_in_known: i32;   // 0: not asked yet; 1: one was given; 2: none
global io_in_ended: u32;

fn io_stdin() -> i32 {
    if (io_in_known == 0) {
        let h: i32 = args_handle(ARGS_STDIN);
        if (h >= 0) { io_in = h; io_in_known = 1; } else { io_in_known = 2; }
    }
    if (io_in_known == 1) { return io_in; }
    return 0 - 1;
}

// block until a key is pressed, or the next byte of the input handle;
// returns its code, or -1 once that input has ended
fn getkey() -> i32 {
    let h: i32 = io_stdin();
    if (h < 0) { return input_read(); }
    if (io_in_ended != 0) { return 0 - 1; }
    let b: [1]u8;
    if (file_read(h, &b[0], 1) != 1) { io_in_ended = 1; return 0 - 1; }
    return b[0] as i32;
}

// 1 once the input handle has nothing more to give
fn input_ended() -> u32 { return io_in_ended; }

// return a key if one is waiting, else 0 - never blocks
fn poll_key() -> i32 { return input_poll(); }

// ---- line editing ----

// Read a line into caller storage, echoing as it goes. Handles Backspace.
// Stops at Enter, the end of the input, or when the buffer is full. Returns
// the length (excluding the NUL terminator, which is always written).
// Only keystrokes are echoed: a line from an input handle is not the
// user's typing, and the output may be that same pipe's other end.
fn read_line(buf: *u8, cap: u32) -> u32 {
    let n: u32 = 0;
    let keys: u32 = 0;
    if (io_stdin() < 0) { keys = 1; }

    while (1 == 1) {
        if (n + 1 >= cap) { break; }

        let c: i32 = getkey();
        if (c < 0 || c == KEY_ENTER) { break; }

        if (c == KEY_BACKSPACE) {
            if (n > 0) {
                n = n - 1;
                if (keys != 0) { puts("\b \b"); }   // erase the character on screen
            }
            continue;
        }

        buf[n] = c as u8;
        n = n + 1;
        if (keys != 0) { putc(c as u8); }         // echo
    }

    buf[n] = 0;
    if (keys != 0) { newline(); }
    return n;
}

// Read a line with no echo (for passwords and the like).
fn read_line_quiet(buf: *u8, cap: u32) -> u32 {
    let n: u32 = 0;
    while (1 == 1) {
        if (n + 1 >= cap) { break; }
        let c: i32 = getkey();
        if (c == KEY_ENTER) { break; }
        if (c == KEY_BACKSPACE) {
            if (n > 0) { n = n - 1; }
            continue;
        }
        buf[n] = c as u8;
        n = n + 1;
    }
    buf[n] = 0;
    return n;
}

// print a prompt, then read a line
fn prompt(text: *u8, buf: *u8, cap: u32) -> u32 {
    puts(text);
    return read_line(buf, cap);
}
