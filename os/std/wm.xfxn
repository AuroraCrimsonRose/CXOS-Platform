// std/wm.xfxn - windows: stacking, frames, focus and where input goes (roadmap 2.4).
// Aurora Tejeda / CATX Systems
// Threads: one (the display server's).
//
// The window system's decisions, with nothing of the transport in them: the
// server (std/dserver.xfxn) feeds this the keys, the pointer and the clients'
// requests, and delivers what it queues; the tests feed it directly and look
// at the screen.
//
// The rules (docs/system/CX_DISPLAY.md sections 4 and 7):
//   - A key goes to the focused window and to nobody else.
//   - The pointer goes to the window under it, in that window's coordinates,
//     or to the window a press landed in until the button comes up.
//   - A press focuses and raises. The title bar drags, the close box asks.
//   - The server draws the frames, so a client that has stopped answering can
//     still be moved and closed: its frame goes grey, and its close box ends it.
//
// As Serenity's WindowServer: a stack bottom first, server-drawn frames, and
// the client's buffer composed as it was committed.
//
// Since 2.5 (section 6) what the eye sees can lag what is true. A window's
// x and y, and which workspace it is on, change at once and are what input is
// tested against; its springs only carry the picture there. A window closing
// stays as a ghost for as long as it fades, with no client and no input.

import "scene.xfxn";

const WM_WIN_MAX: u32 = 16;
const WM_CLIENT_MAX: u32 = 16;
const WM_PER_CLIENT: u32 = 8;       // windows one client may have
const WM_NONE: u32 = 0xFFFFFFFF;
const WM_RING: u32 = 32;            // events waiting for one client
const WM_TITLE_LEN: u32 = 32;
const WM_DIM_MAX: u32 = 4096;       // a window's largest side

const WM_TITLE_H: u32 = 20;
const WM_EDGE: u32 = 2;
const WM_CLOSE_W: u32 = 16;
const WM_HANG_MS: u64 = 2000;       // events unread this long: not answering

// Keys the server keeps for itself, which no client sees: Ctrl+Q ends the
// session, Ctrl+N is the next window, for a machine with no pointer.
const WM_KEY_QUIT: u32 = 17;
const WM_KEY_NEXT: u32 = 14;
const WM_KEY_MINIMISE: u32 = 2;     // Ctrl+B; Ctrl+N brings it back
const WM_KEY_WORKSPACE: u32 = 23;   // Ctrl+W: the next workspace
const WM_KEY_SEND: u32 = 5;         // Ctrl+E: this window to the next workspace
const WM_KEY_MOTION: u32 = 18;      // Ctrl+R: reduce motion, on and off

const WM_WORKSPACES: u32 = 4;
const WM_OPEN_SCALE: i32 = 920;     // thousandths: where a window grows from
const WM_MIN_SCALE: i32 = 100;      // and what minimising shrinks it to

const WM_LAYERS_PER_CLIENT: u32 = 16;
const WM_POS_MAX: i32 = 16383;      // a layer's position, either way
const WM_SCALE_MAX: u32 = 16000;    // thousandths
const WM_MATRIX_MAX: i32 = 1048576; // 16.0

// What a ds_lprops sets.
const WM_LP_POS: u32 = 1;
const WM_LP_SCALE: u32 = 2;
const WM_LP_ALPHA: u32 = 4;
const WM_LP_ANCHOR: u32 = 8;
const WM_LP_MATRIX: u32 = 16;
const WM_LP_VISIBLE: u32 = 32;
const WM_LP_ALL: u32 = 63;

// A change to a layer. Position, scale and opacity go by a spring of stiffness
// k and damping c, or at once if k is 0; the rest at once.
struct ds_lprops {
    mask: u32,
    k: u32,
    c: u32,
    visible: u32,
    x: i32,
    y: i32,
    scale: u32,         // thousandths
    alpha: u32,         // 0-255
    ax: i32,            // the point that stays put under the scale and matrix
    ay: i32,
    m: [4]i32           // [a b; c d], Q16.16
}

const WM_F_ALPHA: u32 = 1;          // the client's pixels carry alpha
const WM_F_OVERLAY: u32 = 2;        // above every ordinary window; takes no input

// ---- the system's own screen, consent (section 7) ----
// What a client must be given before it may do these.
const WM_CAP_CAPTURE: u32 = 1;      // read what is on the screen
const WM_CAP_OVERLAY: u32 = 2;      // windows above all the others
const WM_CAPS_ALL: u32 = 3;

const WM_TS_NONE: u32 = 0;
const WM_TS_SYSTEM: u32 = 1;        // Ctrl+Alt+Del
const WM_TS_CONSENT: u32 = 2;       // a client's request, asked of the user

const WM_TS_COL_SYSTEM: u32 = 0xFF14283C;
const WM_TS_COL_CONSENT: u32 = 0xFF3C2414;
const WM_TS_COL_TEXT: u32 = 0xFFFFFFFF;
const WM_TS_BAND: u32 = 4;          // a white band along the top of either

// A consent screen takes no answer for this long after it comes up, so a key
// already on its way, typed at the window behind, cannot be what answers it.
const WM_CONSENT_ARM_MS: u64 = 500;
const WM_CAPTURE_SHOW_MS: u64 = 2000;   // the mark stays this long after a capture
const WM_MARK_SIZE: u32 = 12;
const WM_COL_MARK: u32 = 0xFFE02020;

const WM_KEY_ESC: u32 = 27;

const WM_SIGNER_LEN: u32 = 24;
const WM_COL_SIGNER_SYSTEM: u32 = 0xFFA0E8A0;
const WM_COL_SIGNER_OTHER: u32 = 0xFFF0D060;

const WM_COL_FOCUS: u32 = 0xFF2F5F9F;
const WM_COL_IDLE: u32 = 0xFF4A5058;
const WM_COL_HUNG: u32 = 0xFF8C8C8C;
const WM_COL_CLOSE: u32 = 0xFFB83A3A;
const WM_COL_TEXT: u32 = 0xFFFFFFFF;

// What a client is told (std/window.xfxn carries it).
const WM_EV_KEY: u32 = 1;           // a: the key
const WM_EV_POINTER: u32 = 2;       // a, b: in the window; c: buttons
const WM_EV_FOCUS: u32 = 3;         // a: 1 gained, 0 lost
const WM_EV_CLOSE: u32 = 4;         // its close box was pressed
const WM_EV_FRAME: u32 = 5;         // what it committed is on the screen: draw the next

struct wm_event {
    kind: u32,
    win: u32,
    a: i32,
    b: i32,
    c: i32,
    reserved: u32
}

struct wm_client {
    used: u32,
    waiter: i32,        // the reply token of its waiting call, or 0
    head: u32,
    n: u32,
    since: u64,         // when the oldest event still unread became that
    hung: u32,
    kill: u32,          // the server is to end it
    caps: u32,          // WM_CAP_*, as the user has allowed
    denied: u32,        // WM_CAP_*, as the user has refused; not asked again
    ask: u32,           // the WM_CAP_ being asked for, or 0
    ask_seq: u32,       // the order the asks came in
    ask_token: i32,     // the reply token of that call
    ask_done: u32,      // answered: the server is to reply
    ask_status: i32,
    signer: [24]u8,     // WM_SIGNER_LEN; as the kernel verified it, never the client's word
    signer_col: u32,
    ring: [32]wm_event  // WM_RING
}

struct wm_win {
    used: u32,
    client: u32,
    x: u32,             // the frame's top left
    y: u32,
    w: u32,             // the content's size
    h: u32,
    flags: u32,
    cur: u32,           // the buffer on the screen: 0, 1 or WM_NONE
    want_frame: u32,    // committed since the last frame was told
    lease: [2]i32,      // what keeps a shown buffer unwritable; 0 if none
    buf: [2]ds_surface, // the client's, mapped read-only; .mem is our handle
    frame: ds_surface,  // server-drawn; the content's area is transparent
    title: [32]u8,      // WM_TITLE_LEN
    ghost: u32,         // closed, and fading: nobody's, and takes no input
    min: u32,           // minimised
    ws: u32,            // its workspace
    head: u32,          // its layers (scene nodes), or SC_NONE
    tail: u32,
    sa: ds_spring,      // the picture's scale, thousandths
    al: ds_spring,      // its opacity
    dx: ds_spring,      // how far it is from where the window is
    dy: ds_spring
}

struct wm {
    comp: *ds_comp,
    desktop: *ds_surface,
    cursor: *ds_surface,
    font: *ds_font,     // 0: titles are not drawn
    trusted: *ds_surface,   // the screen only the system draws
    mark: *ds_surface,      // that the screen is being read
    ts: u32,            // WM_TS_*: what is on the screen instead of the windows
    ts_client: u32,     // WM_TS_CONSENT: who is asking
    ts_armed: u32,      // it may be answered
    ts_clock: u32,      // ts_t0 has been set
    ts_t0: u64,
    ask_next: u32,
    marked: u32,        // the mark is up
    capture_at: u64,    // when the screen was last read
    sw: u32,
    sh: u32,
    now: u64,
    z: [16]u32,         // indexes into win, bottom first; WM_WIN_MAX
    zn: u32,
    focus: u32,
    capture: u32,       // the window a press landed in
    drag: u32,          // the window being dragged
    grab_x: u32,
    grab_y: u32,
    px: u32,
    py: u32,
    buttons: u32,
    cursor_layer: u32,
    quit: u32,
    reduce: u32,        // reduce motion, for everybody
    ws: u32,            // the workspace on the screen
    ws_pos: ds_spring,  // where the view is, in pixels across the workspaces
    sc: scene,
    win: [16]wm_win,            // WM_WIN_MAX
    client: [16]wm_client       // WM_CLIENT_MAX
}

// ---- the stack ----

fn wm_frame_w(win: *wm_win) -> u32 { return win.w + 2 * WM_EDGE; }
fn wm_frame_h(win: *wm_win) -> u32 { return win.h + WM_TITLE_H + WM_EDGE; }

fn wm_damage_win(w: *wm, win: *wm_win) -> void {
    ds_damage_add(&w.comp.damage, win.x, win.y, wm_frame_w(win), wm_frame_h(win));
}

// The compositor's layers, from the stack: the desktop, each window's frame
// and content, the pointer. Whoever changed the stack damages what it changed.
// On the system's own screen that is the whole of it: nothing of a client's is
// a layer, so there is nothing that could be drawn over it or show through.
fn wm_restack(w: *wm) -> void {
    ds_layers_clear(w.comp);
    if (w.ts != WM_TS_NONE) {
        ds_layer_put(w.comp, w.trusted, 0, 0, 1);
        return;
    }
    ds_layer_put(w.comp, w.desktop, 0, 0, 1);
    let k: u32 = 0;
    while (k < w.zn) { wm_emit(w, &w.win[w.z[k]]); k = k + 1; }
    if (w.marked == 1) { ds_layer_put(w.comp, w.mark, (w.sw - WM_MARK_SIZE - 8) as i32, 4, 1); }
    w.cursor_layer = ds_layer_put(w.comp, w.cursor, w.px as i32, w.py as i32, 0);
}

fn wm_win_moving(w: *wm, win: *wm_win) -> u32 {
    return sp_moving(&win.sa) | sp_moving(&win.al) | sp_moving(&win.dx) | sp_moving(&win.dy) | sp_moving(&w.ws_pos);
}

// A window, its frame, its buffer and its layers, as compositor layers. One
// minimised or on another workspace is left out once its springs have stopped
// (not merely once they stop moving it: the last step's damage was taken from
// where it was, and nothing runs afterwards to take it out).
fn wm_emit(w: *wm, win: *wm_win) -> void {
    let anim: u32 = wm_win_moving(w, win);
    let going: u32 = win.sa.active | win.al.active | win.dx.active | win.dy.active | w.ws_pos.active;
    if (going == 0 && (win.min == 1 || win.ws != w.ws)) { return; }
    let m: [4]i32;
    m[0] = DS_FX_ONE; m[1] = 0; m[2] = 0; m[3] = DS_FX_ONE;
    let root: sc_world;
    sc_world_root(&root);
    let wo: sc_world;
    let view: i64 = (((win.ws as i64) * (w.sw as i64)) << 16) - w.ws_pos.x;
    sc_world_child(&wo, &root, ((win.x as i64) << 16) + win.dx.x + view, ((win.y as i64) << 16) + win.dy.x,
                   (wm_frame_w(win) as i64) << 15, (wm_frame_h(win) as i64) << 15,
                   sp_scale(&win.sa), &m[0], sp_alpha(&win.al), anim);
    sc_put(w.comp, &win.frame, &wo, 0, 0, 0, 0 as *ds_rect);
    let cx: i64 = (WM_EDGE as i64) << 16;
    let cy: i64 = (WM_TITLE_H as i64) << 16;
    if (win.cur != WM_NONE) {
        let opaque: u32 = 1;
        if ((win.flags & WM_F_ALPHA) != 0) { opaque = 0; }
        sc_put(w.comp, &win.buf[win.cur], &wo, cx, cy, opaque, 0 as *ds_rect);
    }
    if (win.head == SC_NONE) { return; }
    // a client's layers are clipped to its own content: nothing it asks for
    // can reach the frame or another window
    let content: sc_world;
    sc_world_child(&content, &wo, cx, cy, 0, 0, DS_FX_ONE as i64, &m[0], 255, 0);
    let clip: ds_rect;
    sc_box(&content, win.w, win.h, w.sw, w.sh, &clip);
    let k: u32 = win.head;
    while (k != SC_NONE) {
        sc_emit(w.comp, &w.sc, k, &content, &clip);
        k = w.sc.n[k].next;
    }
}

fn wm_paint_frame(w: *wm, i: u32) -> void {
    let win: *wm_win = &w.win[i];
    let bar: u32 = WM_COL_IDLE;
    if (w.focus == i) { bar = WM_COL_FOCUS; }
    if (w.client[win.client].hung == 1) { bar = WM_COL_HUNG; }
    let fw: u32 = wm_frame_w(win);
    ds_fill(&win.frame, 0, 0, fw, wm_frame_h(win), bar);
    ds_fill(&win.frame, WM_EDGE, WM_TITLE_H, win.w, win.h, 0);
    if (fw > WM_CLOSE_W + 2 * WM_EDGE) {
        ds_fill(&win.frame, fw - WM_EDGE - WM_CLOSE_W, WM_EDGE, WM_CLOSE_W, WM_TITLE_H - 2 * WM_EDGE, WM_COL_CLOSE);
    }
    if (w.font != (0 as *ds_font) && fw > WM_CLOSE_W + 16) {
        // who signed it first and in its own colour: the title is the client's
        // own words, and however long they are they cannot push this away
        let cl: *wm_client = &w.client[win.client];
        let room: u32 = fw - WM_CLOSE_W - 12;
        let used: u32 = (strlen(&cl.signer[0]) + 1) * w.font.width;
        ds_text(&win.frame, w.font, 6, 2, room, &cl.signer[0], cl.signer_col);
        if (room > used) { ds_text(&win.frame, w.font, 6 + used, 2, room - used, &win.title[0], WM_COL_TEXT); }
    }
    wm_damage_win(w, win);
}

fn wm_z_remove(w: *wm, i: u32) -> void {
    let k: u32 = 0;
    let at: u32 = 0;
    while (k < w.zn) {
        if (w.z[k] != i) { w.z[at] = w.z[k]; at = at + 1; }
        k = k + 1;
    }
    w.zn = at;
}

fn wm_overlay(win: *wm_win) -> u32 {
    if ((win.flags & WM_F_OVERLAY) != 0) { return 1; }
    return 0;
}

// Window i on top of its own kind: overlays are all above everything else.
fn wm_z_put(w: *wm, i: u32) -> void {
    let at: u32 = w.zn;
    if (wm_overlay(&w.win[i]) == 0) {
        while (at > 0 && wm_overlay(&w.win[w.z[at - 1]]) == 1) { at = at - 1; }
    }
    let k: u32 = w.zn;
    while (k > at) { w.z[k] = w.z[k - 1]; k = k - 1; }
    w.z[at] = i;
    w.zn = w.zn + 1;
}

// Is window i the top of its own kind already?
fn wm_on_top(w: *wm, i: u32) -> u32 {
    let k: u32 = w.zn;
    while (k > 0) {
        k = k - 1;
        if (wm_overlay(&w.win[w.z[k]]) == wm_overlay(&w.win[i])) {
            if (w.z[k] == i) { return 1; }
            return 0;
        }
    }
    return 0;
}

fn wm_raise(w: *wm, i: u32) -> void {
    if (wm_on_top(w, i) == 1) { return; }
    wm_z_remove(w, i);
    wm_z_put(w, i);
    wm_restack(w);
    wm_damage_win(w, &w.win[i]);
}

// ---- events ----

// Queue one for a client. A movement replaces one still unread with the same
// buttons; a full ring drops the newest, and only that client pays for it.
fn wm_push(w: *wm, c: u32, kind: u32, win: u32, a: i32, b: i32, e: i32) -> void {
    let cl: *wm_client = &w.client[c];
    if (kind == WM_EV_POINTER && cl.n > 0) {
        let last: *wm_event = &cl.ring[(cl.head + cl.n - 1) % WM_RING];
        if (last.kind == WM_EV_POINTER && last.win == win && last.c == e) {
            last.a = a; last.b = b;
            return;
        }
    }
    if (cl.n == WM_RING) { return; }
    let ev: *wm_event = &cl.ring[(cl.head + cl.n) % WM_RING];
    ev.kind = kind; ev.win = win; ev.a = a; ev.b = b; ev.c = e; ev.reserved = 0;
    if (cl.n == 0) { cl.since = w.now; }
    cl.n = cl.n + 1;
}

// The oldest event for a client: 1 and *ev, or 0.
fn wm_take(w: *wm, c: u32, ev: *wm_event) -> u32 {
    let cl: *wm_client = &w.client[c];
    if (cl.n == 0) { return 0; }
    let from: *wm_event = &cl.ring[cl.head];
    ev.kind = from.kind; ev.win = from.win; ev.a = from.a;
    ev.b = from.b; ev.c = from.c; ev.reserved = 0;
    cl.head = (cl.head + 1) % WM_RING;
    cl.n = cl.n - 1;
    cl.since = w.now;
    return 1;
}

// ---- focus ----

fn wm_focus_set(w: *wm, i: u32) -> void {
    if (w.focus == i) { return; }
    let old: u32 = w.focus;
    w.focus = i;
    if (old != WM_NONE) {
        wm_push(w, w.win[old].client, WM_EV_FOCUS, old, 0, 0, 0);
        wm_paint_frame(w, old);
    }
    if (i != WM_NONE) {
        wm_push(w, w.win[i].client, WM_EV_FOCUS, i, 1, 0, 0);
        wm_paint_frame(w, i);
    }
}

// The close box: asked of a client that answers, done to one that does not.
fn wm_request_close(w: *wm, i: u32) -> void {
    let c: u32 = w.win[i].client;
    if (w.client[c].hung == 1) { w.client[c].kill = 1; return; }
    wm_push(w, c, WM_EV_CLOSE, i, 0, 0, 0);
}

// ---- input ----

fn wm_key(w: *wm, code: u32) -> void {
    if (w.ts != WM_TS_NONE) { wm_ts_key(w, code); return; }
    if (code == WM_KEY_QUIT) { w.quit = 1; return; }
    if (code == WM_KEY_NEXT) { wm_next(w); return; }
    if (code == WM_KEY_MOTION) { w.reduce = 1 - w.reduce; return; }
    if (code == WM_KEY_WORKSPACE) { wm_workspace(w, (w.ws + 1) % WM_WORKSPACES); return; }
    if (w.focus == WM_NONE) { return; }
    if (code == WM_KEY_MINIMISE) { wm_minimise(w, w.focus); return; }
    if (code == WM_KEY_SEND) { wm_send(w, w.focus); return; }
    wm_push(w, w.win[w.focus].client, WM_EV_KEY, w.focus, code as i32, 0, 0);
}

const WM_ZONE_NONE: u32 = 0;
const WM_ZONE_CONTENT: u32 = 1;
const WM_ZONE_TITLE: u32 = 2;
const WM_ZONE_CLOSE: u32 = 3;
const WM_ZONE_EDGE: u32 = 4;

fn wm_zone(win: *wm_win, x: u32, y: u32) -> u32 {
    let fw: u32 = wm_frame_w(win);
    if (x < win.x || y < win.y || x - win.x >= fw || y - win.y >= wm_frame_h(win)) { return WM_ZONE_NONE; }
    let fx: u32 = x - win.x;
    let fy: u32 = y - win.y;
    if (fy >= WM_TITLE_H) {
        if (fx >= WM_EDGE && fx < WM_EDGE + win.w && fy < WM_TITLE_H + win.h) { return WM_ZONE_CONTENT; }
        return WM_ZONE_EDGE;
    }
    if (fw > WM_CLOSE_W + 2 * WM_EDGE && fx >= fw - WM_EDGE - WM_CLOSE_W && fx < fw - WM_EDGE) { return WM_ZONE_CLOSE; }
    return WM_ZONE_TITLE;
}

// Can input reach it?
fn wm_shown(w: *wm, win: *wm_win) -> u32 {
    if (win.ghost == 1 || win.min == 1 || win.ws != w.ws) { return 0; }
    if (wm_overlay(win) == 1) { return 0; }     // something on top, not something to press
    return 1;
}

// The topmost window at a point, or WM_NONE.
fn wm_top_at(w: *wm, x: u32, y: u32) -> u32 {
    let k: u32 = w.zn;
    while (k > 0) {
        k = k - 1;
        if (wm_shown(w, &w.win[w.z[k]]) == 1 && wm_zone(&w.win[w.z[k]], x, y) != WM_ZONE_NONE) { return w.z[k]; }
    }
    return WM_NONE;
}

// The topmost window input can reach, or WM_NONE.
fn wm_top_shown(w: *wm) -> u32 {
    let k: u32 = w.zn;
    while (k > 0) {
        k = k - 1;
        if (wm_shown(w, &w.win[w.z[k]]) == 1) { return w.z[k]; }
    }
    return WM_NONE;
}

// Nothing may go on pointing at a window input can no longer reach.
fn wm_let_go(w: *wm, i: u32) -> void {
    if (w.drag == i) { w.drag = WM_NONE; }
    if (w.capture == i) { w.capture = WM_NONE; }
    if (w.focus == i) {
        // only a window that still has a client is told it lost focus
        if (w.win[i].used == 0 || w.win[i].ghost == 1) { w.focus = WM_NONE; }
        wm_focus_set(w, wm_top_shown(w));
    }
}

fn wm_minimise(w: *wm, i: u32) -> void {
    let win: *wm_win = &w.win[i];
    win.min = 1;
    sp_to(&win.sa, WM_MIN_SCALE, SP_K, SP_C);
    sp_to(&win.al, 0, SP_K, SP_C);
    sp_to(&win.dy, (w.sh - win.y) as i32, SP_K, SP_C);
    wm_let_go(w, i);
}

fn wm_restore(w: *wm, i: u32) -> void {
    let win: *wm_win = &w.win[i];
    win.min = 0;
    sp_to(&win.sa, 1000, SP_K, SP_C);
    sp_to(&win.al, 255, SP_K, SP_C);
    sp_to(&win.dy, 0, SP_K, SP_C);
}

// The bottom window of this workspace comes to the top, from minimised if it was.
fn wm_next(w: *wm) -> void {
    let k: u32 = 0;
    while (k < w.zn) {
        let i: u32 = w.z[k];
        if (w.win[i].ghost == 0 && w.win[i].ws == w.ws && wm_overlay(&w.win[i]) == 0) {
            if (w.win[i].min == 1) { wm_restore(w, i); }
            wm_raise(w, i);
            wm_focus_set(w, i);
            return;
        }
        k = k + 1;
    }
}

fn wm_workspace(w: *wm, n: u32) -> void {
    w.ws = n;
    sp_to(&w.ws_pos, (n * w.sw) as i32, SP_K, SP_C);
    w.drag = WM_NONE;
    w.capture = WM_NONE;
    wm_focus_set(w, wm_top_shown(w));
}

// Window i to the next workspace, sliding away from where it was.
fn wm_send(w: *wm, i: u32) -> void {
    let win: *wm_win = &w.win[i];
    let n: u32 = (win.ws + 1) % WM_WORKSPACES;
    let from: i32 = ((win.ws as i32) - (n as i32)) * (w.sw as i32);
    win.ws = n;
    sp_rest(&win.dx, from);
    sp_to(&win.dx, 0, SP_K, SP_C);
    wm_let_go(w, i);
}

fn wm_move(w: *wm, i: u32, x: u32, y: u32) -> void {
    let win: *wm_win = &w.win[i];
    if (win.x == x && win.y == y) { return; }
    wm_damage_win(w, win);
    win.x = x; win.y = y;
    wm_restack(w);
    wm_damage_win(w, win);
}

fn wm_pointer_to(w: *wm, i: u32, buttons: u32) -> void {
    let win: *wm_win = &w.win[i];
    let cx: i32 = (win.x + WM_EDGE) as i32;
    let cy: i32 = (win.y + WM_TITLE_H) as i32;
    wm_push(w, win.client, WM_EV_POINTER, i, (w.px as i32) - cx, (w.py as i32) - cy, buttons as i32);
}

fn wm_clamp(v: i32, max: u32) -> u32 {
    if (v < 0) { return 0; }
    if ((v as u32) >= max) { return max - 1; }
    return v as u32;
}

fn wm_pointer(w: *wm, x: i32, y: i32, buttons: u32) -> void {
    let was: u32 = w.buttons;
    w.buttons = buttons;
    w.px = wm_clamp(x, w.sw);
    w.py = wm_clamp(y, w.sh);
    if (w.ts != WM_TS_NONE) { return; }     // no client is told, and it is keys only
    ds_layer_move(w.comp, w.cursor_layer, w.px as i32, w.py as i32);
    let pressed: u32 = 0;
    let released: u32 = 0;
    if ((buttons & 1) == 1 && (was & 1) == 0) { pressed = 1; }
    if ((buttons & 1) == 0 && (was & 1) == 1) { released = 1; }

    if (w.drag != WM_NONE) {
        if (released == 1) { w.drag = WM_NONE; return; }
        let nx: u32 = 0;
        let ny: u32 = 0;
        if (w.px > w.grab_x) { nx = w.px - w.grab_x; }
        if (w.py > w.grab_y) { ny = w.py - w.grab_y; }
        wm_move(w, w.drag, nx, ny);
        return;
    }

    let top: u32 = wm_top_at(w, w.px, w.py);
    if (pressed == 1 && top != WM_NONE) {
        let zone: u32 = wm_zone(&w.win[top], w.px, w.py);
        wm_raise(w, top);
        wm_focus_set(w, top);
        if (zone == WM_ZONE_CLOSE) { wm_request_close(w, top); return; }
        if (zone == WM_ZONE_TITLE) {
            w.drag = top;
            w.grab_x = w.px - w.win[top].x;
            w.grab_y = w.py - w.win[top].y;
            return;
        }
        if (zone == WM_ZONE_CONTENT) { w.capture = top; }
    }

    if (w.capture != WM_NONE) {
        wm_pointer_to(w, w.capture, buttons);
        if (released == 1) { w.capture = WM_NONE; }
        return;
    }
    if (top != WM_NONE && wm_zone(&w.win[top], w.px, w.py) == WM_ZONE_CONTENT) {
        wm_pointer_to(w, top, buttons);
    }
}

// ---- clients and windows ----

fn wm_init(w: *wm, comp: *ds_comp, desktop: *ds_surface, cursor: *ds_surface, font: *ds_font,
           trusted: *ds_surface, mark: *ds_surface) -> void {
    memzero(w as *u8, sizeof *w);
    w.comp = comp; w.desktop = desktop; w.cursor = cursor; w.font = font;
    w.trusted = trusted; w.mark = mark;
    ds_fill(mark, 0, 0, mark.width, mark.height, WM_COL_MARK);
    w.sw = comp.back.width; w.sh = comp.back.height;
    w.focus = WM_NONE; w.capture = WM_NONE; w.drag = WM_NONE;
    w.px = w.sw / 2; w.py = w.sh / 2;
    sp_rest(&w.ws_pos, 0);
    wm_restack(w);
    ds_damage_all(&comp.damage);
}

fn wm_client_new(w: *wm) -> u32 {
    let c: u32 = 0;
    while (c < WM_CLIENT_MAX) {
        if (w.client[c].used == 0) {
            memzero((&w.client[c]) as *u8, sizeof w.client[c]);
            w.client[c].used = 1;
            // until the kernel has said who signed it
            strcopy(&w.client[c].signer[0], "[Unknown]", WM_SIGNER_LEN);
            w.client[c].signer_col = WM_COL_SIGNER_OTHER;
            return c;
        }
        c = c + 1;
    }
    return WM_NONE;
}

// A new window for client c, on top and focused, showing nothing until its
// first commit. s0 and s1 are its two buffers, already mapped; the window
// takes them. The index, or an error; on an error the caller keeps them.
fn wm_window_new(w: *wm, c: u32, width: u32, height: u32, flags: u32, title: *u8, s0: *ds_surface, s1: *ds_surface) -> i32 {
    let i: u32 = 0;
    let free: u32 = WM_NONE;
    let mine: u32 = 0;
    while (i < WM_WIN_MAX) {
        if (w.win[i].used == 0) { if (free == WM_NONE) { free = i; } }
        else if (w.win[i].client == c) { mine = mine + 1; }
        i = i + 1;
    }
    if (mine >= WM_PER_CLIENT) { return E_NO_RESOURCES; }
    // a window still fading must not be why a new one is refused
    if (free == WM_NONE) { free = wm_reap_ghost(w); }
    if (free == WM_NONE) { return E_NO_RESOURCES; }
    let win: *wm_win = &w.win[free];
    memzero(win as *u8, sizeof *win);
    win.w = width; win.h = height; win.flags = flags; win.client = c; win.cur = WM_NONE;
    win.ws = w.ws; win.head = SC_NONE; win.tail = SC_NONE;
    sp_rest(&win.sa, 1000); sp_rest(&win.al, 255); sp_rest(&win.dx, 0); sp_rest(&win.dy, 0);
    if (w.reduce == 0) {
        sp_rest(&win.sa, WM_OPEN_SCALE);
        sp_rest(&win.al, 0);
        sp_to(&win.sa, 1000, SP_K, SP_C);
        sp_to(&win.al, 255, SP_K, SP_C);
    }
    let rc: i32 = ds_surface_new(&win.frame, wm_frame_w(win), wm_frame_h(win));
    if (rc != 0) { return rc; }
    win.used = 1;
    win.buf[0] = *s0;
    win.buf[1] = *s1;
    strcopy(&win.title[0], title, WM_TITLE_LEN);
    win.title[WM_TITLE_LEN - 1] = 0;
    // each new one a step down and right of the last, kept on the screen
    let step: u32 = 24 + 28 * w.zn;
    win.x = step % ds_max(w.sw / 2, 1);
    win.y = step % ds_max(w.sh / 2, 1);
    wm_z_put(w, free);
    wm_restack(w);
    wm_paint_frame(w, free);
    if (wm_overlay(win) == 0) { wm_focus_set(w, free); }
    return free as i32;
}

// Everything of a window goes, now.
fn wm_window_reap(w: *wm, i: u32) -> void {
    let win: *wm_win = &w.win[i];
    if (win.used == 0) { return; }
    wm_damage_win(w, win);
    if (win.lease[0] > 0) { handle_close(win.lease[0]); }
    if (win.lease[1] > 0) { handle_close(win.lease[1]); }
    wm_z_remove(w, i);
    win.used = 0;
    wm_restack(w);
    // the stack no longer names these, so nothing composes from them now
    sc_free_all(&w.sc, &win.head, &win.tail);
    ds_surface_free(&win.buf[0]);
    ds_surface_free(&win.buf[1]);
    ds_surface_free(&win.frame);
    wm_let_go(w, i);
}

// A ghost's slot back, the first one's: its index, or WM_NONE if there are none.
fn wm_reap_ghost(w: *wm) -> u32 {
    let i: u32 = 0;
    while (i < WM_WIN_MAX) {
        if (w.win[i].used == 1 && w.win[i].ghost == 1) { wm_window_reap(w, i); return i; }
        i = i + 1;
    }
    return WM_NONE;
}

// A window closes: it stops being anybody's now, and fades before it goes.
fn wm_window_destroy(w: *wm, i: u32) -> void {
    let win: *wm_win = &w.win[i];
    if (win.used == 0 || win.ghost == 1) { return; }
    if (w.reduce == 1) { wm_window_reap(w, i); return; }
    win.ghost = 1;
    win.client = WM_NONE;
    win.want_frame = 0;
    sp_to(&win.sa, WM_OPEN_SCALE, SP_K, SP_C);
    sp_to(&win.al, 0, SP_K, SP_C);
    wm_let_go(w, i);
}

// Does client c have window i?
fn wm_owns(w: *wm, c: u32, i: u32) -> u32 {
    if (i >= WM_WIN_MAX || w.win[i].used == 0 || w.win[i].client != c) { return 0; }
    return 1;
}

// A client has gone: every window of its, and a call it had waiting.
fn wm_client_gone(w: *wm, c: u32) -> void {
    let i: u32 = 0;
    while (i < WM_WIN_MAX) {
        if (w.win[i].used == 1 && w.win[i].client == c) { wm_window_destroy(w, i); }
        i = i + 1;
    }
    if (w.client[c].waiter > 0) { handle_close(w.client[c].waiter); }
    w.client[c].waiter = 0;
    if (w.client[c].ask_token > 0) { handle_close(w.client[c].ask_token); }
    w.client[c].ask_token = 0;
    w.client[c].ask = 0;
    w.client[c].ask_done = 0;
    w.client[c].used = 0;
    if (w.ts == WM_TS_CONSENT && w.ts_client == c) { wm_ts_next(w); }
    else if (w.ts == WM_TS_SYSTEM) { wm_ts_paint(w); }
}

// Who signed client c, as the kernel found it when it loaded the image.
fn wm_client_signer(w: *wm, c: u32, trust: u32, signer: u64) -> void {
    let cl: *wm_client = &w.client[c];
    let s: *u8 = &cl.signer[0];
    cl.signer_col = WM_COL_SIGNER_OTHER;
    if (trust == PROC_TRUST_PLATFORM) {
        strcopy(s, "[System]", WM_SIGNER_LEN);
        cl.signer_col = WM_COL_SIGNER_SYSTEM;
        return;
    }
    if (trust == PROC_TRUST_UNSIGNED) { strcopy(s, "[Unsigned]", WM_SIGNER_LEN); return; }
    let n: u32 = 0;
    if (trust == PROC_TRUST_PUBLISHER) { n = strcopy(s, "[Publisher ", WM_SIGNER_LEN); }
    else { n = strcopy(s, "[Unknown ", WM_SIGNER_LEN); }
    let top: u32 = (signer >> 32) as u32;
    let k: u32 = 0;
    while (k < 8) {
        let d: u32 = (top >> (28 - 4 * k)) & 15;
        if (d < 10) { s[n + k] = (48 + d) as u8; } else { s[n + k] = (87 + d) as u8; }
        k = k + 1;
    }
    s[n + 8] = 93;      // ]
    s[n + 9] = 0;
}

// ---- the system's own screen ----
// No client draws here and no key or press reaches one while it is up.

fn wm_ts_row(w: *wm, y: u32, text: *u8) -> void {
    if (w.font != (0 as *ds_font)) { ds_text(w.trusted, w.font, 24, y, w.sw - 48, text, WM_TS_COL_TEXT); }
}

// The nth (from 0) connected client, or WM_NONE.
fn wm_ts_nth(w: *wm, n: u32) -> u32 {
    let c: u32 = 0;
    let seen: u32 = 0;
    while (c < WM_CLIENT_MAX) {
        if (w.client[c].used == 1) {
            if (seen == n) { return c; }
            seen = seen + 1;
        }
        c = c + 1;
    }
    return WM_NONE;
}

// The first title client c has, or a word for none.
fn wm_ts_title(w: *wm, c: u32) -> *u8 {
    let i: u32 = 0;
    while (i < WM_WIN_MAX) {
        if (w.win[i].used == 1 && w.win[i].client == c) { return &w.win[i].title[0]; }
        i = i + 1;
    }
    return "(no window)";
}

fn wm_ts_paint(w: *wm) -> void {
    let bg: u32 = WM_TS_COL_SYSTEM;
    if (w.ts == WM_TS_CONSENT) { bg = WM_TS_COL_CONSENT; }
    ds_fill(w.trusted, 0, 0, w.sw, w.sh, bg);
    ds_fill(w.trusted, 0, 0, w.sw, WM_TS_BAND, WM_TS_COL_TEXT);
    wm_ts_row(w, 16, "CXOS system screen");
    if (w.ts == WM_TS_CONSENT) {
        let cl: *wm_client = &w.client[w.ts_client];
        wm_ts_row(w, 56, &cl.signer[0]);
        if (cl.ask == WM_CAP_CAPTURE) { wm_ts_row(w, 76, "asks to read everything on the screen."); }
        if (cl.ask == WM_CAP_OVERLAY) { wm_ts_row(w, 76, "asks to draw on top of every other window."); }
        wm_ts_row(w, 116, "Y to allow, N to refuse.");
    } else {
        wm_ts_row(w, 36, "Only the system can draw this screen. Esc goes back.");
        wm_ts_row(w, 56, "A number ends that program.");
        let n: u32 = 0;
        while (n < 9) {
            let c: u32 = wm_ts_nth(w, n);
            if (c != WM_NONE) {
                let line: [64]u8;
                line[0] = (49 + n) as u8;
                line[1] = 32;
                let at: u32 = 2 + strcopy(&line[2], &w.client[c].signer[0], WM_SIGNER_LEN);
                line[at] = 32;
                strcopy(&line[at + 1], wm_ts_title(w, c), WM_TITLE_LEN);
                wm_ts_row(w, 88 + 20 * n, &line[0]);
            }
            n = n + 1;
        }
    }
    ds_damage_all(&w.comp.damage);
}

// Nothing goes on being pressed or dragged behind the system's screen.
fn wm_ts_cover(w: *wm) -> void {
    if (w.ts != WM_TS_NONE) { return; }
    w.drag = WM_NONE;
    if (w.capture != WM_NONE) {
        wm_pointer_to(w, w.capture, 0);
        w.capture = WM_NONE;
    }
}

// The oldest ask still unanswered goes up; with none, the windows come back.
fn wm_ts_next(w: *wm) -> void {
    let best: u32 = WM_NONE;
    let c: u32 = 0;
    while (c < WM_CLIENT_MAX) {
        let cl: *wm_client = &w.client[c];
        if (cl.used == 1 && cl.ask != 0 && (best == WM_NONE || cl.ask_seq < w.client[best].ask_seq)) { best = c; }
        c = c + 1;
    }
    if (best != WM_NONE) {
        wm_ts_cover(w);
        w.ts = WM_TS_CONSENT;
        w.ts_client = best;
        w.ts_armed = 0;
        w.ts_clock = 0;
        wm_restack(w);
        wm_ts_paint(w);
        return;
    }
    if (w.ts == WM_TS_NONE) { return; }
    w.ts = WM_TS_NONE;
    wm_restack(w);
    ds_damage_all(&w.comp.damage);
}

// Ctrl+Alt+Del. Already on a screen only the system draws, it has its answer.
fn wm_attention(w: *wm) -> void {
    if (w.ts != WM_TS_NONE) { return; }
    wm_ts_cover(w);
    w.ts = WM_TS_SYSTEM;
    wm_restack(w);
    wm_ts_paint(w);
}

fn wm_ts_answer(w: *wm, allow: u32) -> void {
    let cl: *wm_client = &w.client[w.ts_client];
    if (allow == 1) { cl.caps = cl.caps | cl.ask; cl.ask_status = 0; }
    else { cl.denied = cl.denied | cl.ask; cl.ask_status = E_ACCESS_DENIED; }
    cl.ask = 0;
    cl.ask_done = 1;
    cl.since = w.now;
    wm_ts_next(w);
}

fn wm_ts_key(w: *wm, code: u32) -> void {
    if (w.ts == WM_TS_CONSENT) {
        if (w.ts_armed == 0) { return; }
        if (code == 121 || code == 89) { wm_ts_answer(w, 1); }
        else if (code == 110 || code == 78 || code == WM_KEY_ESC) { wm_ts_answer(w, 0); }
        return;
    }
    if (code == WM_KEY_ESC) { wm_ts_next(w); return; }
    if (code >= 49 && code <= 57) {
        let c: u32 = wm_ts_nth(w, code - 49);
        if (c != WM_NONE) { w.client[c].kill = 1; }
    }
}

// Client c asks for WM_CAP_ cap, in a call whose reply token is this. 1: it is
// on its way to the user and the token is kept; 0: it already has it; or an
// error, and in both of those the caller answers. Asked once and refused, it
// is refused from then on without troubling the user.
fn wm_ask(w: *wm, c: u32, cap: u32, token: i32) -> i32 {
    let cl: *wm_client = &w.client[c];
    if (cap != WM_CAP_CAPTURE && cap != WM_CAP_OVERLAY) { return E_INVALID_ARGS; }
    if ((cl.caps & cap) != 0) { return 0; }
    if ((cl.denied & cap) != 0) { return E_ACCESS_DENIED; }
    if (cl.ask != 0 || cl.ask_done == 1) { return E_BUSY; }
    cl.ask = cap;
    cl.ask_token = token;
    cl.ask_seq = w.ask_next;
    w.ask_next = w.ask_next + 1;
    if (w.ts == WM_TS_NONE) { wm_ts_next(w); }
    return 1;
}

// The screen was read just now: the mark goes up and stays a while.
fn wm_captured(w: *wm) -> void {
    w.capture_at = w.now;
    if (w.marked == 1) { return; }
    w.marked = 1;
    wm_restack(w);
    ds_damage_add(&w.comp.damage, w.sw - WM_MARK_SIZE - 8, 4, WM_MARK_SIZE, WM_MARK_SIZE);
}

// Buffer b of window i is now what it shows, held by `lease` (the caller has
// checked that the lease is on that buffer). Only the rectangles changed, in
// the window's coordinates; none means all of it. -> the buffer given back
// (WM_NONE if none was showing), or WM_NONE - 1 for a buffer that is showing.
const WM_COMMIT_REFUSED: u32 = 0xFFFFFFFE;

fn wm_commit(w: *wm, i: u32, b: u32, lease: i32, rects: *ds_rect, n: u32) -> u32 {
    let win: *wm_win = &w.win[i];
    if (b > 1 || win.cur == b) { return WM_COMMIT_REFUSED; }
    let first: u32 = 0;
    if (win.cur == WM_NONE) { first = 1; }
    let freed: u32 = win.cur;
    if (freed != WM_NONE) {
        handle_close(win.lease[freed]);
        win.lease[freed] = 0;
    }
    win.lease[b] = lease;
    win.cur = b;
    win.want_frame = 1;
    wm_restack(w);
    let ox: u32 = win.x + WM_EDGE;
    let oy: u32 = win.y + WM_TITLE_H;
    if (n == 0 || first == 1) {
        ds_damage_add(&w.comp.damage, ox, oy, win.w, win.h);
        return freed;
    }
    let k: u32 = 0;
    while (k < n) {
        let r: *ds_rect = &rects[k];
        if (r.x < win.w && r.y < win.h) {
            ds_damage_add(&w.comp.damage, ox + r.x, oy + r.y, ds_min(r.w, win.w - r.x), ds_min(r.h, win.h - r.y));
        }
        k = k + 1;
    }
    return freed;
}

// A frame reached the screen: tell whoever committed for it.
fn wm_frames_done(w: *wm) -> void {
    let i: u32 = 0;
    while (i < WM_WIN_MAX) {
        if (w.win[i].used == 1 && w.win[i].want_frame == 1) {
            w.win[i].want_frame = 0;
            wm_push(w, w.win[i].client, WM_EV_FRAME, i, 0, 0, 0);
        }
        i = i + 1;
    }
}

fn wm_repaint_client(w: *wm, c: u32) -> void {
    let i: u32 = 0;
    while (i < WM_WIN_MAX) {
        if (w.win[i].used == 1 && w.win[i].client == c) { wm_paint_frame(w, i); }
        i = i + 1;
    }
}

// A client has called for its next event, with this reply token.
fn wm_wait(w: *wm, c: u32, token: i32) -> void {
    let cl: *wm_client = &w.client[c];
    if (cl.waiter > 0) { handle_close(cl.waiter); }
    cl.waiter = token;
    cl.since = w.now;
    if (cl.hung == 1) { cl.hung = 0; wm_repaint_client(w, c); }
}

// ---- animation ----

fn wm_any_active(w: *wm) -> u32 {
    if (w.ws_pos.active == 1) { return 1; }
    let i: u32 = 0;
    while (i < WM_WIN_MAX) {
        let win: *wm_win = &w.win[i];
        if (win.used == 1 && (win.sa.active | win.al.active | win.dx.active | win.dy.active) == 1) { return 1; }
        i = i + 1;
    }
    i = 0;
    while (i < SC_NODE_MAX) {
        let n: *sc_node = &w.sc.n[i];
        if (n.used == 1 && (n.x.active | n.y.active | n.sc.active | n.al.active) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

// Where everything that is moving is, as damage.
fn wm_damage_moving(w: *wm) -> void {
    let i: u32 = 0;
    while (i < w.comp.n) {
        if (w.comp.l[i].anim == 1) { ds_layer_damage(w.comp, i); }
        i = i + 1;
    }
}

// ms milliseconds on. With nothing moving this does nothing at all, which is
// what lets an idle screen cost no composition. Otherwise what moves is
// damaged where it was and where it now is.
fn wm_animate(w: *wm, ms: u32) -> void {
    if (wm_any_active(w) == 0) { return; }
    wm_restack(w);
    wm_damage_moving(w);
    sp_step(&w.ws_pos, ms, w.reduce);
    let i: u32 = 0;
    while (i < WM_WIN_MAX) {
        let win: *wm_win = &w.win[i];
        if (win.used == 1) {
            sp_step(&win.sa, ms, w.reduce);
            sp_step(&win.al, ms, w.reduce);
            sp_step(&win.dx, ms, w.reduce);
            sp_step(&win.dy, ms, w.reduce);
            if (win.ghost == 1 && win.al.active == 0 && win.sa.active == 0) { wm_window_reap(w, i); }
        }
        i = i + 1;
    }
    i = 0;
    while (i < SC_NODE_MAX) {
        if (w.sc.n[i].used == 1) { sc_step(&w.sc.n[i], ms, w.reduce); }
        i = i + 1;
    }
    wm_restack(w);
    wm_damage_moving(w);
}

// ---- layers ----

fn wm_damage_content(w: *wm, win: *wm_win) -> void {
    ds_damage_add(&w.comp.damage, win.x + WM_EDGE, win.y + WM_TITLE_H, win.w, win.h);
}

fn wm_layers_of(w: *wm, c: u32) -> u32 {
    let n: u32 = 0;
    let i: u32 = 0;
    while (i < SC_NODE_MAX) {
        if (w.sc.n[i].used == 1 && w.win[w.sc.n[i].owner].client == c) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

// A layer of window i, showing the surface s, under another of its layers or
// (SC_NONE) directly in its content. It takes s and lease only on success:
// the layer's id, or an error.
fn wm_layer_new(w: *wm, i: u32, parent: u32, s: *ds_surface, lease: i32, flags: u32) -> i32 {
    let win: *wm_win = &w.win[i];
    if (wm_layers_of(w, win.client) >= WM_LAYERS_PER_CLIENT) { return E_NO_RESOURCES; }
    let opaque: u32 = 1;
    if ((flags & WM_F_ALPHA) != 0) { opaque = 0; }
    let id: i32 = sc_new(&w.sc, &win.head, &win.tail, i, parent, s, lease, opaque);
    if (id == E_NO_RESOURCES && wm_reap_ghost(w) != WM_NONE) {
        id = sc_new(&w.sc, &win.head, &win.tail, i, parent, s, lease, opaque);
    }
    if (id < 0) { return id; }
    wm_restack(w);
    wm_damage_content(w, win);
    return id;
}

fn wm_in(v: i32, max: i32) -> u32 {
    if (v < (0 - max) || v > max) { return 0; }
    return 1;
}

// Apply a change to a layer of window i: 0 or an error, and an error changes
// nothing. A client's numbers are all checked here.
fn wm_layer_set(w: *wm, i: u32, id: u32, p: *ds_lprops) -> i32 {
    if (sc_owns(&w.sc, i, id) == 0) { return E_INVALID_ARGS; }
    if ((p.mask & (0 - 1 - WM_LP_ALL)) != 0) { return E_INVALID_ARGS; }
    if (p.k > SP_K_MAX || p.c > SP_C_MAX || (p.k != 0 && p.c == 0)) { return E_INVALID_ARGS; }
    if ((p.mask & WM_LP_POS) != 0 && (wm_in(p.x, WM_POS_MAX) == 0 || wm_in(p.y, WM_POS_MAX) == 0)) { return E_INVALID_ARGS; }
    if ((p.mask & WM_LP_SCALE) != 0 && p.scale > WM_SCALE_MAX) { return E_INVALID_ARGS; }
    if ((p.mask & WM_LP_ALPHA) != 0 && p.alpha > 255) { return E_INVALID_ARGS; }
    if ((p.mask & WM_LP_ANCHOR) != 0 && (wm_in(p.ax, WM_POS_MAX) == 0 || wm_in(p.ay, WM_POS_MAX) == 0)) { return E_INVALID_ARGS; }
    if ((p.mask & WM_LP_VISIBLE) != 0 && p.visible > 1) { return E_INVALID_ARGS; }
    if ((p.mask & WM_LP_MATRIX) != 0) {
        let k: u32 = 0;
        while (k < 4) {
            if (wm_in(p.m[k], WM_MATRIX_MAX) == 0) { return E_INVALID_ARGS; }
            k = k + 1;
        }
    }
    let n: *sc_node = &w.sc.n[id];
    if ((p.mask & WM_LP_POS) != 0) { sp_to(&n.x, p.x, p.k, p.c); sp_to(&n.y, p.y, p.k, p.c); }
    if ((p.mask & WM_LP_SCALE) != 0) { sp_to(&n.sc, p.scale as i32, p.k, p.c); }
    if ((p.mask & WM_LP_ALPHA) != 0) { sp_to(&n.al, p.alpha as i32, p.k, p.c); }
    if ((p.mask & (WM_LP_ANCHOR | WM_LP_MATRIX | WM_LP_VISIBLE)) != 0) {
        if ((p.mask & WM_LP_ANCHOR) != 0) { n.ax = p.ax; n.ay = p.ay; }
        if ((p.mask & WM_LP_VISIBLE) != 0) { n.visible = p.visible; }
        if ((p.mask & WM_LP_MATRIX) != 0) {
            n.m[0] = p.m[0]; n.m[1] = p.m[1]; n.m[2] = p.m[2]; n.m[3] = p.m[3];
        }
        wm_restack(w);
        wm_damage_content(w, &w.win[i]);
    }
    return 0;
}

// A layer of window i goes, with everything under it: 0 or an error.
fn wm_layer_free(w: *wm, i: u32, id: u32) -> i32 {
    if (sc_owns(&w.sc, i, id) == 0) { return E_INVALID_ARGS; }
    let win: *wm_win = &w.win[i];
    sc_free(&w.sc, &win.head, &win.tail, id);
    wm_restack(w);
    wm_damage_content(w, win);
    return 0;
}

// The time. Springs go on by what has passed, and a client with events unread
// and no call waiting for WM_HANG_MS is not answering.
fn wm_tick(w: *wm, now: u64) -> void {
    let ms: u64 = 0;
    if (now > w.now) { ms = now - w.now; }
    w.now = now;
    if (ms > (SP_MS_MAX as u64)) { ms = SP_MS_MAX as u64; }
    wm_animate(w, ms as u32);
    // counted from the first tick it was up for, so that a screen raised
    // before the clock first ran is not already old
    if (w.ts == WM_TS_CONSENT && w.ts_armed == 0) {
        if (w.ts_clock == 0) { w.ts_clock = 1; w.ts_t0 = now; }
        else if (now - w.ts_t0 >= WM_CONSENT_ARM_MS) { w.ts_armed = 1; }
    }
    if (w.marked == 1 && now - w.capture_at >= WM_CAPTURE_SHOW_MS) {
        w.marked = 0;
        wm_restack(w);
        ds_damage_add(&w.comp.damage, w.sw - WM_MARK_SIZE - 8, 4, WM_MARK_SIZE, WM_MARK_SIZE);
    }
    let c: u32 = 0;
    while (c < WM_CLIENT_MAX) {
        let cl: *wm_client = &w.client[c];
        // waiting on the user is not the same as not answering
        if (cl.used == 1 && cl.hung == 0 && cl.n > 0 && cl.waiter == 0 && cl.ask == 0 && now - cl.since >= WM_HANG_MS) {
            cl.hung = 1;
            wm_repaint_client(w, c);
        }
        c = c + 1;
    }
}
