// std/fmt.xfxn - number formatting for CXK X.
// Aurora Tejeda / CATX Systems
//
//   import "fmt.xfxn";
//
// Converts numbers to text in caller-provided buffers - no allocation, so this
// works anywhere (kernel-adjacent code, apps, the shell).

import "io.xfxn";

// write `v` as decimal into buf (needs 11 bytes for a full u32); returns length
fn u32_to_dec(buf: *u8, cap: u32, v: u32) -> u32 {
    let tmp: [12]u8;
    let n: u32 = 0;
    let x: u32 = v;

    if (x == 0) {
        tmp[0] = 48;            // '0'
        n = 1;
    }
    while (x > 0) {
        let d: u32 = x % 10;
        tmp[n] = (d + 48) as u8;
        n = n + 1;
        x = x / 10;
    }

    // tmp holds the digits reversed - copy them back out in order
    let i: u32 = 0;
    while (i < n) {
        if (i + 1 >= cap) { break; }
        buf[i] = tmp[n - 1 - i];
        i = i + 1;
    }
    buf[i] = 0;
    return i;
}

// write `v` as lowercase hex WITHOUT a 0x prefix; returns length
fn u32_to_hex(buf: *u8, cap: u32, v: u32) -> u32 {
    let tmp: [9]u8;
    let n: u32 = 0;
    let x: u32 = v;

    if (x == 0) {
        tmp[0] = 48;            // '0'
        n = 1;
    }
    while (x > 0) {
        let d: u32 = x % 16;
        if (d < 10) { tmp[n] = (d + 48) as u8; }        // '0'..'9'
        else { tmp[n] = (d - 10 + 97) as u8; }          // 'a'..'f'
        n = n + 1;
        x = x / 16;
    }

    let i: u32 = 0;
    while (i < n) {
        if (i + 1 >= cap) { break; }
        buf[i] = tmp[n - 1 - i];
        i = i + 1;
    }
    buf[i] = 0;
    return i;
}

// print a decimal number to the console
// Parse leading decimal digits into a u32, stopping at the first character
// that is not one - so "30s" gives 30 and "30 " gives 30.
//
// A string with no digits at all gives 0, which is the same answer a literal
// "0" gives. A caller that has to tell those apart should look at the first
// character itself; every caller so far treats 0 as "not set", which is the
// same thing either way.
//
// Saturates rather than wrapping. A value that overflowed silently would be a
// number the caller never wrote down anywhere, and for an interval that means
// a task firing at a time nobody chose.
fn dec_u32(s: *u8) -> u32 {
    let v: u32 = 0;
    let i: u32 = 0;
    while (s[i] >= 48 && s[i] <= 57) {
        let d: u32 = (s[i] - 48) as u32;
        // 4294967295 is 429496729 * 10 + 5: at exactly 429496729 a digit above
        // 5 still overflows, so both halves of the check are needed. This used
        // to test only the first half, and even that never fired once v passed
        // 2^31, because u32 comparisons compiled as signed.
        if (v > 429496729) { return 4294967295; }
        if (v == 429496729 && d > 5) { return 4294967295; }
        v = v * 10 + d;
        i = i + 1;
    }
    return v;
}

fn print_u32(v: u32) -> void {
    let b: [12]u8;
    u32_to_dec(&b[0], sizeof b, v);
    puts(&b[0]);
}

// print a hex number with a 0x prefix
fn print_hex(v: u32) -> void {
    let b: [12]u8;
    u32_to_hex(&b[0], sizeof b, v);
    puts("0x");
    puts(&b[0]);
}
