// Aurora Tejeda / CATX Systems
// Threads: a ui belongs to one thread.
//
// A ui is a retained tree of widgets in logical units, drawn into a canvas
// of device pixels at a scale in quarters (4 = 100 %). Changing a widget
// marks its box as damage; tk_paint draws only what the damage covers and
// hands the rectangles back. Nothing here knows about windows: toolkit_window.xfxn
// puts a ui in one, and the self-tests drive a ui with no server at all.
//
// Widgets are named by a tk id, an index and a generation, so an id kept
// past tk_reset is refused rather than naming whatever took its place.
// Text is copied into the ui's own arena: a widget never points at its
// caller's memory.
//
// Names: X has one namespace, so everything here starts tk_ (toolkit), as
// display.xfxn's start ds_ and wm.xfxn's wm_.

import "display.xfxn";
import "string.xfxn";
import "mem.xfxn";

const TK_NODES_MAX: u32 = 256;
const TK_ARENA_BYTES: u32 = 8192;
const TK_EVENTS_MAX: u32 = 32;
const TK_NONE: u32 = 0xFFFFFFFF;
const TK_GRID_COLS_MAX: u32 = 8;
const TK_SCALE_MIN: u32 = 4;        // 100 %
const TK_SCALE_MAX: u32 = 16;       // 400 %

// ---- kinds: one switch each, not a class hierarchy (CX_TOOLKIT.md §1) ----

const TK_COLUMN: u32 = 1;           // containers
const TK_ROW: u32 = 2;
const TK_GRID: u32 = 3;             // cols: its column count
const TK_STACK: u32 = 4;            // children on top of each other
const TK_LABEL: u32 = 10;
const TK_HEADING: u32 = 11;
const TK_BUTTON: u32 = 12;          // first of the ones that take input
const TK_CHECK: u32 = 13;
const TK_RADIO: u32 = 14;           // group: which radios are exclusive
const TK_SWITCH: u32 = 15;
const TK_SLIDER: u32 = 16;          // last of the run of ones that take input
const TK_PROGRESS: u32 = 17;
const TK_TEXTFIELD: u32 = 18;       // one line of text (2.8a2); takes input too
const TK_KIND_LAST: u32 = 18;

// ---- flags ----

const TK_F_HIDDEN: u32 = 1;
const TK_F_DISABLED: u32 = 2;
const TK_F_CHECKED: u32 = 4;
const TK_F_MIXED: u32 = 8;          // a check box that is neither
const TK_F_PRESSED: u32 = 16;
const TK_F_HOVER: u32 = 32;
const TK_F_FOCUS: u32 = 64;         // the ui's own: has the keyboard focus
const TK_F_GROW: u32 = 128;         // takes a share of what is left on its parent's axis
const TK_F_FILL: u32 = 256;         // stretched across its parent's axis
const TK_F_DEFAULT: u32 = 512;      // the button Enter presses
const TK_F_MUTED: u32 = 1024;       // secondary text
const TK_F_SHOW_RING: u32 = 2048;   // drawn as if focused (a gallery's state)
const TK_F_CANCEL: u32 = 4096;      // the button Esc presses
const TK_F_APP: u32 = 8127;         // what tk_set_flags may change: all but FOCUS
const TK_F_LAYOUT: u32 = 385;       // HIDDEN | GROW | FILL: a change lays out again
const TK_F_USED: u32 = 0x80000000;

// ---- accessibility roles (the tree is the accessibility tree) ----

const TK_ROLE_GROUP: u32 = 1;
const TK_ROLE_TEXT: u32 = 2;
const TK_ROLE_HEADING: u32 = 3;
const TK_ROLE_BUTTON: u32 = 4;
const TK_ROLE_CHECK: u32 = 5;
const TK_ROLE_RADIO: u32 = 6;
const TK_ROLE_SWITCH: u32 = 7;
const TK_ROLE_SLIDER: u32 = 8;
const TK_ROLE_PROGRESS: u32 = 9;
const TK_ROLE_TEXTFIELD: u32 = 10;

// ---- what the app is told ----

const TK_EV_NONE: u32 = 0;
const TK_EV_ACTIVATE: u32 = 1;      // id: a button was pressed
const TK_EV_CHANGE: u32 = 2;        // id, value: a check, radio, switch or slider changed
const TK_EV_KEY: u32 = 3;           // code, ch, mods: a press no widget or command took
const TK_EV_CLOSE: u32 = 4;         // the window's close box (toolkit_window.xfxn)
const TK_EV_GONE: u32 = 5;          // value: the server has gone, or a commit failed
const TK_EV_COMMAND: u32 = 6;       // value: a command ran (id: the widget, or 0 for a key)

// ---- keys: codes are KC_* (USB usages), mods KEYMOD_* | KEYEV_*, from
// the ABI (2.8a2); a key is a press or a release with its character ----

const TK_MODS_CAS: u32 = 14;        // KEYMOD_CTRL | KEYMOD_ALT | KEYMOD_SUPER

// ---- commands: a name, and a key that runs it (CX_TOOLKIT.md §7) ----

const TK_CMDS_MAX: u32 = 64;
const TK_CMD_COPY: u32 = 1;         // the toolkit's own, made by tk_reset
const TK_CMD_CUT: u32 = 2;
const TK_CMD_PASTE: u32 = 3;
const TK_CMD_SELECT_ALL: u32 = 4;
const TK_CMD_UNDO: u32 = 5;
const TK_CMD_REDO: u32 = 6;

// ---- text fields, the clipboard, input methods ----

const TK_FIELDS_MAX: u32 = 8;
const TK_FIELD_BYTES: u32 = 255;    // UTF-8, without its terminator
const TK_FIELD_W: i32 = 200;
const TK_FIELD_PADX: i32 = 6;
const TK_CLIP_NONE: u32 = 0;
const TK_CLIP_SET: u32 = 1;         // copy ui.clip[0, clip_n) to the clipboard
const TK_CLIP_GET: u32 = 2;         // a paste: give what is there to tk_paste_text
const TK_IM_NONE: u32 = 0;          // keys are their characters
const TK_IM_DEAD: u32 = 1;          // ' ` ^ ~ " wait for the letter they go on

// ---- the design system, in logical units ----

const TK_RING: i32 = 3;             // round every focusable widget: room for its ring
const TK_RING_T: i32 = 2;           // the ring's thickness
const TK_RADIUS: i32 = 4;           // the one radius
const TK_CTRL_H: i32 = 28;
const TK_BTN_PADX: i32 = 16;
const TK_BOX: i32 = 16;             // a check box, a radio
const TK_TEXT_GAP: i32 = 8;         // from a control to its text
const TK_SW_W: i32 = 32;
const TK_SW_H: i32 = 18;
const TK_SLIDER_W: i32 = 160;
const TK_SLIDER_H: i32 = 20;
const TK_KNOB: i32 = 16;
const TK_TRACK: i32 = 4;
const TK_PROG_H: i32 = 8;

// The spacing scale: an app names a step, never a number of units.
fn tk_sp(step: u32) -> i32 {
    if (step == 1) { return 4; }
    if (step == 2) { return 8; }
    if (step == 3) { return 12; }
    if (step == 4) { return 16; }
    if (step == 5) { return 24; }
    if (step >= 6) { return 32; }
    return 0;
}

struct tk_theme {
    surface: u32,
    raised: u32,
    text: u32,
    muted: u32,
    accent: u32,
    on_accent: u32,
    border: u32,
    ring: u32,
    hover: u32,
    pressed: u32,
    off_bg: u32,
    off_text: u32,
    track: u32
}

fn tk_theme_set(t: *tk_theme, dark: u32) -> void {
    if (dark == 0) {
        t.surface = 0xFFF5F6F8; t.raised = 0xFFFFFFFF; t.text = 0xFF1B1F24;
        t.muted = 0xFF5B6470; t.accent = 0xFF2F6FDB; t.on_accent = 0xFFFFFFFF;
        t.border = 0xFFC3CAD4; t.ring = 0xFF2F6FDB; t.hover = 0xFFEDF0F4;
        t.pressed = 0xFFDCE2EA; t.off_bg = 0xFFE7EAEE; t.off_text = 0xFF9AA2AD;
        t.track = 0xFFD3D9E0;
    } else {
        t.surface = 0xFF1E2126; t.raised = 0xFF2A2E35; t.text = 0xFFE8EAED;
        t.muted = 0xFFA2AAB5; t.accent = 0xFF5B93F0; t.on_accent = 0xFF0E1726;
        t.border = 0xFF474E58; t.ring = 0xFF7FAAF5; t.hover = 0xFF333841;
        t.pressed = 0xFF3D434D; t.off_bg = 0xFF2A2D32; t.off_text = 0xFF686F79;
        t.track = 0xFF3F4650;
    }
}

struct tk_node {
    flags: u32,
    gen: u32,
    kind: u32,
    parent: u32,
    first: u32,
    last: u32,
    next: u32,
    text: u32,          // its offset in the arena, or TK_NONE
    value: i32,
    vmin: i32,
    vmax: i32,
    step: i32,
    group: u32,         // radios: the group
    cols: u32,          // grids: the column count
    gap: u32,           // containers: spacing steps between and around
    pad: u32,
    minw: i32,          // logical units
    minh: i32,
    pw: i32,            // measured: the size it asks for
    ph: i32,
    x: i32,             // arranged: its box, logical, in the ui
    y: i32,
    w: i32,
    h: i32,
    dx: u32,            // its box in device pixels, each edge rounded on its own
    dy: u32,
    dw: u32,
    dh: u32,
    cmd: u32,           // the command it runs when pressed, or 0
    field: u32          // text fields: its slot in ui.field
}

struct tk_event {
    kind: u32,
    id: u32,
    value: i32,
    code: u32,
    ch: u32,            // TK_EV_KEY: the character, or 0
    mods: u32           // TK_EV_KEY: KEYMOD_*
}

struct tk_cmd {
    name: u32,          // its offset in the arena
    key: u32,           // KC_*, or 0 for none
    mods: u32           // what must be held with it: exactly these
}

// A line of text. Offsets are bytes, always on a character's first byte.
struct tk_field {
    node: u32,
    len: u32,
    caret: u32,
    anchor: u32,        // the selection is anchor to caret, either way round
    scroll: u32,        // the first character shown
    buf: [256]u8,       // TK_FIELD_BYTES + 1
    undo: [256]u8,      // what it was before the last change
    undo_len: u32,
    undo_caret: u32,
    has_undo: u32,
    redo: u32,          // undo was the last thing done: undo again swaps back
    typing: u32,        // the last change was a typed character (they are one)
    dead: u32           // TK_IM_DEAD: the accent waiting, or 0
}

struct tk_ui {
    node: [256]tk_node,     // TK_NODES_MAX
    used: u32,
    root: u32,
    gen: u32,
    focus: u32,
    hover: u32,
    capture: u32,
    buttons: u32,
    scale: u32,             // quarters
    glyph: u32,             // the bitmap font's magnification
    dark: u32,
    theme: tk_theme,
    font: *ds_font,         // 0: text is measured as 8x16 and not drawn
    canvas: ds_surface,
    damage: ds_damage,
    relayout: u32,
    lw: i32,                // the canvas in logical units
    lh: i32,
    arena: [8192]u8,        // TK_ARENA_BYTES
    arena_used: u32,
    ev: [32]tk_event,       // TK_EVENTS_MAX
    ev_head: u32,
    ev_n: u32,
    cmd: [64]tk_cmd,        // TK_CMDS_MAX; command n is cmd[n - 1]
    cmd_n: u32,
    field: [8]tk_field,     // TK_FIELDS_MAX
    field_n: u32,
    im: u32,                // TK_IM_*
    clip_want: u32,         // TK_CLIP_*: for whoever has the window
    clip: [256]u8,
    clip_n: u32
}

// ---- units ----

// A logical edge to a device pixel: each edge is rounded on its own, so
// boxes that meet in logical units meet in pixels at every scale.
fn tk_dev(ui: *tk_ui, v: i32) -> u32 {
    if (v <= 0) { return 0; }
    return (((v as u32) * ui.scale + 2) / 4);
}

// A logical length as device pixels, never less than one if it is any.
fn tk_len(ui: *tk_ui, v: i32) -> i32 {
    if (v <= 0) { return 0; }
    let d: i32 = (tk_dev(ui, v)) as i32;
    if (d == 0) { return 1; }
    return d;
}

// Device pixels to logical units, rounded up.
fn tk_logical(ui: *tk_ui, d: u32) -> i32 {
    return ((d * 4 + ui.scale - 1) / ui.scale) as i32;
}

fn tk_imax(a: i32, b: i32) -> i32 { if (a > b) { return a; } return b; }
fn tk_imin(a: i32, b: i32) -> i32 { if (a < b) { return a; } return b; }

// ---- the tree ----

fn tk_glyph_for(scale: u32) -> u32 {
    let g: u32 = (scale + 1) / 4;
    if (g == 0) { return 1; }
    return g;
}

fn tk_node_new(ui: *tk_ui, kind: u32) -> u32 {
    if (ui.used >= TK_NODES_MAX) { return TK_NONE; }
    let i: u32 = ui.used;
    ui.used = ui.used + 1;
    let n: *tk_node = &ui.node[i];
    memzero(n as *u8, sizeof *n);
    n.flags = TK_F_USED;
    n.gen = ui.gen;
    n.kind = kind;
    n.parent = TK_NONE; n.first = TK_NONE; n.last = TK_NONE; n.next = TK_NONE;
    n.text = TK_NONE;
    n.field = TK_NONE;
    n.vmax = 100;
    n.step = 1;
    return i;
}

// Forget every widget; ids from before are refused from now on.
fn tk_reset(ui: *tk_ui) -> void {
    ui.gen = ui.gen + 1;
    if (ui.gen > 65535) { ui.gen = 1; }
    ui.used = 0;
    ui.arena_used = 0;
    ui.focus = TK_NONE; ui.hover = TK_NONE; ui.capture = TK_NONE;
    ui.ev_head = 0; ui.ev_n = 0;
    ui.field_n = 0;
    ui.clip_want = TK_CLIP_NONE; ui.clip_n = 0;
    ui.root = tk_node_new(ui, TK_COLUMN);
    ui.relayout = 1;
    // the standard commands, numbered TK_CMD_*, on the keys every app has
    ui.cmd_n = 0;
    tk_command(ui, "copy", KC_C, KEYMOD_CTRL);
    tk_command(ui, "cut", KC_X, KEYMOD_CTRL);
    tk_command(ui, "paste", KC_V, KEYMOD_CTRL);
    tk_command(ui, "select-all", KC_A, KEYMOD_CTRL);
    tk_command(ui, "undo", KC_Z, KEYMOD_CTRL);
    tk_command(ui, "redo", KC_Z, KEYMOD_CTRL | KEYMOD_SHIFT);
}

// A ui at `scale` quarters with this font (0 for none). No canvas yet: give
// it one with tk_size, or let toolkit_window.xfxn.
fn tk_init(ui: *tk_ui, scale: u32, font: *ds_font) -> void {
    memzero(ui as *u8, sizeof *ui);
    if (scale < TK_SCALE_MIN) { scale = TK_SCALE_MIN; }
    if (scale > TK_SCALE_MAX) { scale = TK_SCALE_MAX; }
    ui.scale = scale;
    ui.glyph = tk_glyph_for(scale);
    ui.font = font;
    ui.canvas.px = 0;
    ui.canvas.mem = 0 - 1;
    tk_theme_set(&ui.theme, 0);
    tk_reset(ui);
}

fn tk_free(ui: *tk_ui) -> void {
    if (ui.canvas.px != 0) { ds_surface_free(&ui.canvas); ui.canvas.px = 0; }
}

fn tk_id(ui: *tk_ui, i: u32) -> u32 {
    if (i == TK_NONE) { return 0; }
    return (ui.node[i].gen << 16) | (i + 1);
}

// The index an id names, or TK_NONE if it is stale or was never one.
fn tk_index(ui: *tk_ui, id: u32) -> u32 {
    let low: u32 = id & 0xFFFF;
    if (low == 0 || low > ui.used) { return TK_NONE; }
    let i: u32 = low - 1;
    if ((ui.node[i].flags & TK_F_USED) == 0) { return TK_NONE; }
    if (ui.node[i].gen != (id >> 16)) { return TK_NONE; }
    return i;
}

fn tk_root(ui: *tk_ui) -> u32 { return tk_id(ui, ui.root); }

fn tk_is_container(kind: u32) -> u32 {
    if (kind >= TK_COLUMN && kind <= TK_STACK) { return 1; }
    return 0;
}

fn tk_takes_input(kind: u32) -> u32 {
    if ((kind >= TK_BUTTON && kind <= TK_SLIDER) || kind == TK_TEXTFIELD) { return 1; }
    return 0;
}

// Copy text into the arena: its offset, or TK_NONE when the arena is full.
fn tk_store(ui: *tk_ui, text: *u8) -> u32 {
    if (text == (0 as *u8)) { return TK_NONE; }
    let n: u32 = strlen(text);
    if (ui.arena_used + n + 1 > TK_ARENA_BYTES) { return TK_NONE; }
    let at: u32 = ui.arena_used;
    memcpy(&ui.arena[at], text, n);
    ui.arena[at + n] = 0;
    ui.arena_used = at + n + 1;
    return at;
}

// A new widget at the end of parent's children: its id, or 0 (the parent is
// stale or not a container, the pool or the arena is full).
fn tk_add(ui: *tk_ui, parent: u32, kind: u32, text: *u8) -> u32 {
    let p: u32 = tk_index(ui, parent);
    if (p == TK_NONE || tk_is_container(ui.node[p].kind) == 0) { return 0; }
    if (kind < TK_COLUMN || kind > TK_KIND_LAST || (kind > TK_STACK && kind < TK_LABEL)) { return 0; }
    if (kind == TK_TEXTFIELD && ui.field_n >= TK_FIELDS_MAX) { return 0; }
    let at: u32 = TK_NONE;
    if (text != (0 as *u8)) {
        at = tk_store(ui, text);
        if (at == TK_NONE) { return 0; }
    }
    let i: u32 = tk_node_new(ui, kind);
    if (i == TK_NONE) { return 0; }
    ui.node[i].text = at;
    if (kind == TK_TEXTFIELD) {
        // its text starts empty; the node's text is its name, not shown
        let f: *tk_field = &ui.field[ui.field_n];
        memzero(f as *u8, sizeof *f);
        f.node = i;
        ui.node[i].field = ui.field_n;
        ui.field_n = ui.field_n + 1;
    }
    ui.node[i].parent = p;
    if (ui.node[p].last == TK_NONE) { ui.node[p].first = i; }
    else { ui.node[ui.node[p].last].next = i; }
    ui.node[p].last = i;
    if (kind == TK_GRID) { ui.node[i].cols = 2; }
    ui.relayout = 1;
    return tk_id(ui, i);
}

fn tk_text_of(ui: *tk_ui, i: u32) -> *u8 {
    if (ui.node[i].text == TK_NONE) { return 0 as *u8; }
    return &ui.arena[ui.node[i].text];
}

// ---- damage ----

fn tk_damage_node(ui: *tk_ui, i: u32) -> void {
    let n: *tk_node = &ui.node[i];
    if (n.dw == 0 || n.dh == 0) { return; }
    ds_damage_add(&ui.damage, n.dx, n.dy, n.dw, n.dh);
}

fn tk_damage_all(ui: *tk_ui) -> void { ds_damage_all(&ui.damage); }

// ---- setting what a widget is ----

// Set and clear flags (only TK_F_APP ones): 0, or E_INVALID_ARGS for a
// stale id.
fn tk_set_flags(ui: *tk_ui, id: u32, set: u32, clear: u32) -> i32 {
    let i: u32 = tk_index(ui, id);
    if (i == TK_NONE) { return E_INVALID_ARGS; }
    let old: u32 = ui.node[i].flags;
    let f: u32 = (old & ~(clear & TK_F_APP)) | (set & TK_F_APP);
    if (f == old) { return 0; }
    ui.node[i].flags = f;
    if (((old ^ f) & TK_F_LAYOUT) != 0) { ui.relayout = 1; }
    else { tk_damage_node(ui, i); }
    // a widget that goes away or off cannot keep the focus
    if (ui.focus == i && (f & (TK_F_HIDDEN | TK_F_DISABLED)) != 0) {
        ui.node[i].flags = ui.node[i].flags & ~TK_F_FOCUS;
        ui.focus = TK_NONE;
    }
    return 0;
}

fn tk_flags(ui: *tk_ui, id: u32) -> u32 {
    let i: u32 = tk_index(ui, id);
    if (i == TK_NONE) { return 0; }
    return ui.node[i].flags;
}

fn tk_clamp_value(n: *tk_node, v: i32) -> i32 {
    if (v < n.vmin) { v = n.vmin; }
    if (v > n.vmax) { v = n.vmax; }
    return v;
}

fn tk_set_range(ui: *tk_ui, id: u32, vmin: i32, vmax: i32, step: i32) -> i32 {
    let i: u32 = tk_index(ui, id);
    if (i == TK_NONE || vmax <= vmin || step <= 0) { return E_INVALID_ARGS; }
    let n: *tk_node = &ui.node[i];
    n.vmin = vmin; n.vmax = vmax; n.step = step;
    n.value = tk_clamp_value(n, n.value);
    tk_damage_node(ui, i);
    return 0;
}

fn tk_set_value(ui: *tk_ui, id: u32, v: i32) -> i32 {
    let i: u32 = tk_index(ui, id);
    if (i == TK_NONE) { return E_INVALID_ARGS; }
    let n: *tk_node = &ui.node[i];
    let c: i32 = tk_clamp_value(n, v);
    if (c != n.value) { n.value = c; tk_damage_node(ui, i); }
    return 0;
}

fn tk_value(ui: *tk_ui, id: u32) -> i32 {
    let i: u32 = tk_index(ui, id);
    if (i == TK_NONE) { return 0; }
    return ui.node[i].value;
}

fn tk_set_text(ui: *tk_ui, id: u32, text: *u8) -> i32 {
    let i: u32 = tk_index(ui, id);
    if (i == TK_NONE) { return E_INVALID_ARGS; }
    let at: u32 = tk_store(ui, text);
    if (at == TK_NONE && text != (0 as *u8)) { return E_NO_RESOURCES; }
    ui.node[i].text = at;
    ui.relayout = 1;
    return 0;
}

// A container's spacing, as steps of the design scale.
fn tk_set_spacing(ui: *tk_ui, id: u32, gap: u32, pad: u32) -> i32 {
    let i: u32 = tk_index(ui, id);
    if (i == TK_NONE) { return E_INVALID_ARGS; }
    ui.node[i].gap = gap; ui.node[i].pad = pad;
    ui.relayout = 1;
    return 0;
}

fn tk_set_min(ui: *tk_ui, id: u32, w: i32, h: i32) -> i32 {
    let i: u32 = tk_index(ui, id);
    if (i == TK_NONE || w < 0 || h < 0) { return E_INVALID_ARGS; }
    ui.node[i].minw = w; ui.node[i].minh = h;
    ui.relayout = 1;
    return 0;
}

fn tk_set_cols(ui: *tk_ui, id: u32, cols: u32) -> i32 {
    let i: u32 = tk_index(ui, id);
    if (i == TK_NONE || cols == 0 || cols > TK_GRID_COLS_MAX) { return E_INVALID_ARGS; }
    ui.node[i].cols = cols;
    ui.relayout = 1;
    return 0;
}

fn tk_set_group(ui: *tk_ui, id: u32, group: u32) -> i32 {
    let i: u32 = tk_index(ui, id);
    if (i == TK_NONE) { return E_INVALID_ARGS; }
    ui.node[i].group = group;
    return 0;
}

fn tk_set_scale(ui: *tk_ui, scale: u32) -> void {
    if (scale < TK_SCALE_MIN) { scale = TK_SCALE_MIN; }
    if (scale > TK_SCALE_MAX) { scale = TK_SCALE_MAX; }
    ui.scale = scale;
    ui.glyph = tk_glyph_for(scale);
    ui.relayout = 1;
}

fn tk_set_dark(ui: *tk_ui, dark: u32) -> void {
    ui.dark = dark;
    tk_theme_set(&ui.theme, dark);
    tk_damage_all(ui);
}

// ---- accessibility ----

fn tk_role(ui: *tk_ui, id: u32) -> u32 {
    let i: u32 = tk_index(ui, id);
    if (i == TK_NONE) { return 0; }
    let k: u32 = ui.node[i].kind;
    if (tk_is_container(k) == 1) { return TK_ROLE_GROUP; }
    if (k == TK_LABEL) { return TK_ROLE_TEXT; }
    if (k == TK_HEADING) { return TK_ROLE_HEADING; }
    if (k == TK_BUTTON) { return TK_ROLE_BUTTON; }
    if (k == TK_CHECK) { return TK_ROLE_CHECK; }
    if (k == TK_RADIO) { return TK_ROLE_RADIO; }
    if (k == TK_SWITCH) { return TK_ROLE_SWITCH; }
    if (k == TK_SLIDER) { return TK_ROLE_SLIDER; }
    if (k == TK_TEXTFIELD) { return TK_ROLE_TEXTFIELD; }
    return TK_ROLE_PROGRESS;
}

fn tk_name(ui: *tk_ui, id: u32) -> *u8 {
    let i: u32 = tk_index(ui, id);
    if (i == TK_NONE) { return 0 as *u8; }
    return tk_text_of(ui, i);
}

// ---- events for the app ----

fn tk_push(ui: *tk_ui, kind: u32, i: u32, value: i32, code: u32) -> void {
    if (ui.ev_n == TK_EVENTS_MAX) { return; }   // the app is behind: the oldest stand
    let at: u32 = (ui.ev_head + ui.ev_n) % TK_EVENTS_MAX;
    ui.ev[at].kind = kind;
    ui.ev[at].id = tk_id(ui, i);
    ui.ev[at].value = value;
    ui.ev[at].code = code;
    ui.ev[at].ch = 0;
    ui.ev[at].mods = 0;
    ui.ev_n = ui.ev_n + 1;
}

// The next thing for the app: 1 and *ev, or 0 if there is none.
fn tk_next(ui: *tk_ui, ev: *tk_event) -> u32 {
    if (ui.ev_n == 0) { return 0; }
    *ev = ui.ev[ui.ev_head];
    ui.ev_head = (ui.ev_head + 1) % TK_EVENTS_MAX;
    ui.ev_n = ui.ev_n - 1;
    return 1;
}

// ---- UTF-8 (text is UTF-8; the bitmap font is code page 437) ----

// The character at s[at] of n bytes: its length (1 to 4) and *cp, or 0 if
// the bytes there are not UTF-8 (overlong, a surrogate, past U+10FFFF, cut).
fn tk_utf8_at(s: *u8, n: u32, at: u32, cp: *u32) -> u32 {
    if (at >= n) { return 0; }
    let b: u32 = s[at] as u32;
    if (b < 0x80) { *cp = b; return 1; }
    let len: u32 = 0;
    let v: u32 = 0;
    let lo: u32 = 0x80;     // the second byte's range, for the special leads
    let hi: u32 = 0xBF;
    if (b >= 0xC2 && b <= 0xDF) { len = 2; v = b & 0x1F; }
    else if (b >= 0xE0 && b <= 0xEF) {
        len = 3; v = b & 0x0F;
        if (b == 0xE0) { lo = 0xA0; }
        if (b == 0xED) { hi = 0x9F; }
    }
    else if (b >= 0xF0 && b <= 0xF4) {
        len = 4; v = b & 0x07;
        if (b == 0xF0) { lo = 0x90; }
        if (b == 0xF4) { hi = 0x8F; }
    }
    else { return 0; }
    if (at + len > n) { return 0; }
    let k: u32 = 1;
    while (k < len) {
        let c: u32 = s[at + k] as u32;
        if (k == 1 && (c < lo || c > hi)) { return 0; }
        if (c < 0x80 || c > 0xBF) { return 0; }
        v = (v << 6) | (c & 0x3F);
        k = k + 1;
    }
    *cp = v;
    return len;
}

// cp as UTF-8 into out (room for 4): its length.
fn tk_utf8_put(cp: u32, out: *u8) -> u32 {
    if (cp < 0x80) { out[0] = cp as u8; return 1; }
    if (cp < 0x800) {
        out[0] = (0xC0 | (cp >> 6)) as u8;
        out[1] = (0x80 | (cp & 0x3F)) as u8;
        return 2;
    }
    if (cp < 0x10000) {
        out[0] = (0xE0 | (cp >> 12)) as u8;
        out[1] = (0x80 | ((cp >> 6) & 0x3F)) as u8;
        out[2] = (0x80 | (cp & 0x3F)) as u8;
        return 3;
    }
    out[0] = (0xF0 | (cp >> 18)) as u8;
    out[1] = (0x80 | ((cp >> 12) & 0x3F)) as u8;
    out[2] = (0x80 | ((cp >> 6) & 0x3F)) as u8;
    out[3] = (0x80 | (cp & 0x3F)) as u8;
    return 4;
}

// How many characters n bytes are: a byte that is not UTF-8 is one.
fn tk_utf8_count(s: *u8, n: u32) -> u32 {
    let at: u32 = 0;
    let count: u32 = 0;
    while (at < n) {
        let cp: u32 = 0;
        let l: u32 = tk_utf8_at(s, n, at, &cp);
        if (l == 0) { l = 1; }
        at = at + l;
        count = count + 1;
    }
    return count;
}

// The glyph for a character: ASCII is itself, the Latin-1 letters code page
// 437 has are theirs, anything else is '?'.
fn tk_cp437(cp: u32) -> u32 {
    if (cp < 0x80) { return cp; }
    if (cp == 0xC7) { return 0x80; }   if (cp == 0xFC) { return 0x81; }
    if (cp == 0xE9) { return 0x82; }   if (cp == 0xE2) { return 0x83; }
    if (cp == 0xE4) { return 0x84; }   if (cp == 0xE0) { return 0x85; }
    if (cp == 0xE5) { return 0x86; }   if (cp == 0xE7) { return 0x87; }
    if (cp == 0xEA) { return 0x88; }   if (cp == 0xEB) { return 0x89; }
    if (cp == 0xE8) { return 0x8A; }   if (cp == 0xEF) { return 0x8B; }
    if (cp == 0xEE) { return 0x8C; }   if (cp == 0xEC) { return 0x8D; }
    if (cp == 0xC4) { return 0x8E; }   if (cp == 0xC5) { return 0x8F; }
    if (cp == 0xC9) { return 0x90; }   if (cp == 0xE6) { return 0x91; }
    if (cp == 0xC6) { return 0x92; }   if (cp == 0xF4) { return 0x93; }
    if (cp == 0xF6) { return 0x94; }   if (cp == 0xF2) { return 0x95; }
    if (cp == 0xFB) { return 0x96; }   if (cp == 0xF9) { return 0x97; }
    if (cp == 0xFF) { return 0x98; }   if (cp == 0xD6) { return 0x99; }
    if (cp == 0xDC) { return 0x9A; }   if (cp == 0xE1) { return 0xA0; }
    if (cp == 0xED) { return 0xA1; }   if (cp == 0xF3) { return 0xA2; }
    if (cp == 0xFA) { return 0xA3; }   if (cp == 0xF1) { return 0xA4; }
    if (cp == 0xD1) { return 0xA5; }
    return 63;
}

// ---- text metrics ----

fn tk_char_w(ui: *tk_ui) -> u32 {
    if (ui.font == (0 as *ds_font)) { return 8 * ui.glyph; }
    return ui.font.width * ui.glyph;
}

fn tk_char_h(ui: *tk_ui) -> u32 {
    if (ui.font == (0 as *ds_font)) { return 16 * ui.glyph; }
    return ui.font.height * ui.glyph;
}

// Text's size in logical units; a heading is drawn one pixel wider.
fn tk_text_lw(ui: *tk_ui, i: u32) -> i32 {
    let s: *u8 = tk_text_of(ui, i);
    if (s == (0 as *u8)) { return 0; }
    let d: u32 = tk_utf8_count(s, strlen(s)) * tk_char_w(ui);
    if (ui.node[i].kind == TK_HEADING && d > 0) { d = d + 1; }
    return tk_logical(ui, d);
}

fn tk_text_lh(ui: *tk_ui, i: u32) -> i32 {
    if (ui.node[i].text == TK_NONE) { return 0; }
    return tk_logical(ui, tk_char_h(ui));
}

// ---- layout: measure, children first ----

fn tk_shown(ui: *tk_ui, i: u32) -> u32 {
    if ((ui.node[i].flags & TK_F_HIDDEN) != 0) { return 0; }
    return 1;
}

fn tk_measure_leaf(ui: *tk_ui, i: u32) -> void {
    let n: *tk_node = &ui.node[i];
    let tw: i32 = tk_text_lw(ui, i);
    let th: i32 = tk_text_lh(ui, i);
    let w: i32 = 0;
    let h: i32 = 0;
    let k: u32 = n.kind;
    if (k == TK_LABEL || k == TK_HEADING) { w = tw; h = th; }
    else if (k == TK_BUTTON) { w = tw + 2 * TK_BTN_PADX + 2 * TK_RING; h = TK_CTRL_H + 2 * TK_RING; }
    else if (k == TK_CHECK || k == TK_RADIO || k == TK_SWITCH) {
        let cw: i32 = TK_BOX;
        let ch: i32 = TK_BOX;
        if (k == TK_SWITCH) { cw = TK_SW_W; ch = TK_SW_H; }
        w = 2 * TK_RING + cw;
        if (tw > 0) { w = w + TK_TEXT_GAP + tw; }
        h = tk_imax(ch, th) + 2 * TK_RING;
    }
    else if (k == TK_SLIDER) { w = TK_SLIDER_W + 2 * TK_RING; h = TK_SLIDER_H + 2 * TK_RING; }
    else if (k == TK_PROGRESS) { w = TK_SLIDER_W; h = TK_PROG_H; }
    else if (k == TK_TEXTFIELD) { w = TK_FIELD_W + 2 * TK_RING; h = TK_CTRL_H + 2 * TK_RING; }
    n.pw = w;
    n.ph = h;
}

fn tk_measure(ui: *tk_ui, i: u32) -> void {
    let n: *tk_node = &ui.node[i];
    if (tk_is_container(n.kind) == 0) {
        tk_measure_leaf(ui, i);
    } else {
        let gap: i32 = tk_sp(n.gap);
        let pad: i32 = tk_sp(n.pad);
        let w: i32 = 0;
        let h: i32 = 0;
        let count: u32 = 0;
        let colw: [8]i32;
        let k: u32 = 0;
        while (k < TK_GRID_COLS_MAX) { colw[k] = 0; k = k + 1; }
        let rowh: i32 = 0;
        let rows: i32 = 0;
        let c: u32 = n.first;
        while (c != TK_NONE) {
            if (tk_shown(ui, c) == 1) {
                tk_measure(ui, c);
                let cn: *tk_node = &ui.node[c];
                if (n.kind == TK_COLUMN) {
                    w = tk_imax(w, cn.pw);
                    h = h + cn.ph;
                    if (count > 0) { h = h + gap; }
                } else if (n.kind == TK_ROW) {
                    h = tk_imax(h, cn.ph);
                    w = w + cn.pw;
                    if (count > 0) { w = w + gap; }
                } else if (n.kind == TK_STACK) {
                    w = tk_imax(w, cn.pw);
                    h = tk_imax(h, cn.ph);
                } else {
                    let col: u32 = count % n.cols;
                    colw[col] = tk_imax(colw[col], cn.pw);
                    rowh = tk_imax(rowh, cn.ph);
                    if (col == n.cols - 1) { h = h + rowh; rows = rows + 1; rowh = 0; }
                }
                count = count + 1;
            }
            c = ui.node[c].next;
        }
        if (n.kind == TK_GRID) {
            if (rowh > 0) { h = h + rowh; rows = rows + 1; }
            if (rows > 1) { h = h + gap * (rows - 1); }
            let used: u32 = n.cols;
            if (count < used) { used = count; }
            k = 0;
            while (k < used) { w = w + colw[k]; if (k > 0) { w = w + gap; } k = k + 1; }
        }
        n.pw = w + 2 * pad;
        n.ph = h + 2 * pad;
    }
    n.pw = tk_imax(n.pw, n.minw);
    n.ph = tk_imax(n.ph, n.minh);
}

// ---- layout: arrange, parents first ----

fn tk_place(ui: *tk_ui, i: u32, x: i32, y: i32, w: i32, h: i32) -> void {
    let n: *tk_node = &ui.node[i];
    n.x = x; n.y = y; n.w = w; n.h = h;
    let x0: u32 = tk_dev(ui, x);
    let y0: u32 = tk_dev(ui, y);
    n.dx = x0;
    n.dy = y0;
    n.dw = tk_dev(ui, x + w) - x0;
    n.dh = tk_dev(ui, y + h) - y0;
}

// Grow children's count on a container's axis.
fn tk_growers(ui: *tk_ui, i: u32) -> i32 {
    let g: i32 = 0;
    let c: u32 = ui.node[i].first;
    while (c != TK_NONE) {
        if (tk_shown(ui, c) == 1 && (ui.node[c].flags & TK_F_GROW) != 0) { g = g + 1; }
        c = ui.node[c].next;
    }
    return g;
}

fn tk_arrange(ui: *tk_ui, i: u32, x: i32, y: i32, w: i32, h: i32) -> void {
    tk_place(ui, i, x, y, w, h);
    let n: *tk_node = &ui.node[i];
    if (tk_is_container(n.kind) == 0) { return; }
    let gap: i32 = tk_sp(n.gap);
    let pad: i32 = tk_sp(n.pad);
    let ix: i32 = x + pad;
    let iy: i32 = y + pad;
    let iw: i32 = tk_imax(w - 2 * pad, 0);
    let ih: i32 = tk_imax(h - 2 * pad, 0);
    let growers: i32 = tk_growers(ui, i);
    let extra: i32 = 0;
    // what the children asked for along the axis (not the container's own
    // minimum): the rest goes to the growers
    let asked: i32 = 0;
    let shown: i32 = 0;
    let c: u32 = n.first;
    while (c != TK_NONE) {
        if (tk_shown(ui, c) == 1) {
            if (n.kind == TK_COLUMN) { asked = asked + ui.node[c].ph; }
            if (n.kind == TK_ROW) { asked = asked + ui.node[c].pw; }
            shown = shown + 1;
        }
        c = ui.node[c].next;
    }
    if (shown > 1) { asked = asked + gap * (shown - 1); }
    if (n.kind == TK_COLUMN) { extra = tk_imax(ih - asked, 0); }
    if (n.kind == TK_ROW) { extra = tk_imax(iw - asked, 0); }

    let colw: [8]i32;
    let colx: [8]i32;
    if (n.kind == TK_GRID) {
        let k: u32 = 0;
        while (k < TK_GRID_COLS_MAX) { colw[k] = 0; k = k + 1; }
        let count: u32 = 0;
        c = n.first;
        while (c != TK_NONE) {
            if (tk_shown(ui, c) == 1) {
                let col: u32 = count % n.cols;
                colw[col] = tk_imax(colw[col], ui.node[c].pw);
                count = count + 1;
            }
            c = ui.node[c].next;
        }
        let at: i32 = ix;
        k = 0;
        while (k < n.cols) { colx[k] = at; at = at + colw[k] + gap; k = k + 1; }
    }

    let at: i32 = 0;
    let given: i32 = 0;
    let g: i32 = 0;
    let count: u32 = 0;
    let rowy: i32 = iy;
    let rowh: i32 = 0;
    c = n.first;
    while (c != TK_NONE) {
        if (tk_shown(ui, c) == 1) {
            let cn: *tk_node = &ui.node[c];
            let grows: u32 = 0;
            if ((cn.flags & TK_F_GROW) != 0) { grows = 1; }
            let fills: u32 = 0;
            if ((cn.flags & TK_F_FILL) != 0) { fills = 1; }
            if (n.kind == TK_COLUMN) {
                let ch: i32 = cn.ph;
                if (grows == 1 && growers > 0) {
                    g = g + 1;
                    // the last grower takes the remainder, so nothing is lost
                    let share: i32 = (extra * g) / growers - given;
                    given = given + share;
                    ch = ch + share;
                }
                let cw: i32 = tk_imin(cn.pw, iw);
                if (fills == 1) { cw = iw; }
                tk_arrange(ui, c, ix, iy + at, cw, ch);
                at = at + ch + gap;
            } else if (n.kind == TK_ROW) {
                let cw: i32 = cn.pw;
                if (grows == 1 && growers > 0) {
                    g = g + 1;
                    let share: i32 = (extra * g) / growers - given;
                    given = given + share;
                    cw = cw + share;
                }
                let ch: i32 = tk_imin(cn.ph, ih);
                let cy: i32 = iy + (ih - ch) / 2;
                if (fills == 1) { ch = ih; cy = iy; }
                tk_arrange(ui, c, ix + at, cy, cw, ch);
                at = at + cw + gap;
            } else if (n.kind == TK_STACK) {
                tk_arrange(ui, c, ix, iy, iw, ih);
            } else {
                let col: u32 = count % n.cols;
                if (col == 0 && count > 0) { rowy = rowy + rowh + gap; rowh = 0; }
                // the row's height: the tallest in it
                let rh: i32 = 0;
                let r: u32 = c;
                let k2: u32 = col;
                while (r != TK_NONE && k2 < n.cols) {
                    if (tk_shown(ui, r) == 1) { rh = tk_imax(rh, ui.node[r].ph); k2 = k2 + 1; }
                    r = ui.node[r].next;
                }
                if (col == 0) { rowh = rh; }
                let cw: i32 = cn.pw;
                if (fills == 1) { cw = colw[col]; }
                tk_arrange(ui, c, colx[col], rowy + (rowh - cn.ph) / 2, cw, cn.ph);
            }
            count = count + 1;
        }
        c = ui.node[c].next;
    }
}

// Lay the tree out over the canvas.
fn tk_layout(ui: *tk_ui) -> void {
    tk_measure(ui, ui.root);
    tk_arrange(ui, ui.root, 0, 0, ui.lw, ui.lh);
    ui.relayout = 0;
}

// The size the tree asks for, in device pixels.
fn tk_fit(ui: *tk_ui, w: *u32, h: *u32) -> void {
    tk_measure(ui, ui.root);
    *w = tk_dev(ui, ui.node[ui.root].pw);
    *h = tk_dev(ui, ui.node[ui.root].ph);
}

// A canvas of w x h device pixels (a new one, the old freed): 0 or an error.
fn tk_size(ui: *tk_ui, w: u32, h: u32) -> i32 {
    tk_free(ui);
    let rc: i32 = ds_surface_new(&ui.canvas, w, h);
    if (rc != 0) { ui.canvas.px = 0; return rc; }
    ds_damage_init(&ui.damage, w, h);
    ui.lw = tk_logical(ui, w);
    ui.lh = tk_logical(ui, h);
    // a logical size rounded up can reach past the canvas: what is past it is clipped
    ui.relayout = 1;
    return 0;
}

// ---- drawing: device pixels, every pixel clipped to `c` ----

fn tk_blend(ui: *tk_ui, x: i32, y: i32, argb: u32, cov: u32, c: *ds_rect) -> void {
    if (x < (c.x as i32) || y < (c.y as i32)) { return; }
    if (x >= ((c.x + c.w) as i32) || y >= ((c.y + c.h) as i32)) { return; }
    if (cov == 0) { return; }
    let row: *u32 = ds_row(&ui.canvas, y as u32);
    if (cov >= 16) { row[x] = argb; return; }
    row[x] = ds_over(ds_fade(argb, (cov * 255) / 16), row[x]);
}

fn tk_box(ui: *tk_ui, c: *ds_rect, x: i32, y: i32, w: i32, h: i32, argb: u32) -> void {
    if (w <= 0 || h <= 0) { return; }
    let x0: i32 = tk_imax(x, c.x as i32);
    let y0: i32 = tk_imax(y, c.y as i32);
    let x1: i32 = tk_imin(x + w, (c.x + c.w) as i32);
    let y1: i32 = tk_imin(y + h, (c.y + c.h) as i32);
    if (x1 <= x0 || y1 <= y0) { return; }
    ds_fill(&ui.canvas, x0 as u32, y0 as u32, (x1 - x0) as u32, (y1 - y0) as u32, argb);
}

// Is (sx, sy), in eighths of a pixel, inside the rounded rectangle at
// (x, y, w, h) pixels with radius r?
fn tk_in_rr(sx: i32, sy: i32, x: i32, y: i32, w: i32, h: i32, r: i32) -> u32 {
    let x8: i32 = x * 8;
    let y8: i32 = y * 8;
    let r8: i32 = r * 8;
    if (sx < x8 || sy < y8 || sx >= x8 + w * 8 || sy >= y8 + h * 8) { return 0; }
    if (r <= 0) { return 1; }
    let lx: i32 = x8 + r8;
    let rx: i32 = x8 + w * 8 - r8;
    let ty: i32 = y8 + r8;
    let by: i32 = y8 + h * 8 - r8;
    let dx: i32 = 0;
    let dy: i32 = 0;
    if (sx < lx) { dx = lx - sx; } else if (sx > rx) { dx = sx - rx; }
    if (sy < ty) { dy = ty - sy; } else if (sy > by) { dy = sy - by; }
    if (dx * dx + dy * dy <= r8 * r8) { return 1; }
    return 0;
}

// The samples of a pixel are the 4 x 4 at (s0x + 2i, s0y + 2j): are all of
// them inside the rounded rectangle? Its four corners decide, it being convex.
fn tk_rr_all(s0x: i32, s0y: i32, x: i32, y: i32, w: i32, h: i32, r: i32) -> u32 {
    if (tk_in_rr(s0x, s0y, x, y, w, h, r) == 0) { return 0; }
    if (tk_in_rr(s0x + 6, s0y, x, y, w, h, r) == 0) { return 0; }
    if (tk_in_rr(s0x, s0y + 6, x, y, w, h, r) == 0) { return 0; }
    if (tk_in_rr(s0x + 6, s0y + 6, x, y, w, h, r) == 0) { return 0; }
    return 1;
}

// 1 when no sample of the pixel can be inside: their box is past the
// rectangle's bounds, or farther than the radius from its core (as tk_in_rr
// measures). 0 is "perhaps", never a claim.
fn tk_rr_none(s0x: i32, s0y: i32, x: i32, y: i32, w: i32, h: i32, r: i32) -> u32 {
    if (w <= 0 || h <= 0) { return 1; }
    let s1x: i32 = s0x + 6;
    let s1y: i32 = s0y + 6;
    let x8: i32 = x * 8;
    let y8: i32 = y * 8;
    if (s1x < x8 || s1y < y8 || s0x >= x8 + w * 8 || s0y >= y8 + h * 8) { return 1; }
    if (r <= 0) { return 0; }
    let r8: i32 = r * 8;
    let lx: i32 = x8 + r8;
    let rx: i32 = x8 + w * 8 - r8;
    let ty: i32 = y8 + r8;
    let by: i32 = y8 + h * 8 - r8;
    let dx: i32 = 0;
    let dy: i32 = 0;
    if (s1x < lx) { dx = lx - s1x; } else if (s0x > rx) { dx = s0x - rx; }
    if (s1y < ty) { dy = ty - s1y; } else if (s0y > by) { dy = s0y - by; }
    if (dx * dx + dy * dy > r8 * r8) { return 1; }
    return 0;
}

// Sixteenths of pixel (px, py) inside the shape: a rounded rectangle, less
// the one inset t pixels when t > 0 (a ring).
fn tk_cov(px: i32, py: i32, x: i32, y: i32, w: i32, h: i32, r: i32, t: i32) -> u32 {
    // The shape is convex: when its four outermost samples are in, all
    // sixteen are; when the samples' box is out of reach, none is. Only a
    // pixel an edge crosses is sampled one by one.
    let s0x: i32 = px * 8 + 1;
    let s0y: i32 = py * 8 + 1;
    if (tk_rr_none(s0x, s0y, x, y, w, h, r) == 1) { return 0; }
    let ix: i32 = x + t;
    let iy: i32 = y + t;
    let iw: i32 = w - 2 * t;
    let ih: i32 = h - 2 * t;
    let ir: i32 = tk_imax(r - t, 0);
    if (tk_rr_all(s0x, s0y, x, y, w, h, r) == 1) {
        if (t <= 0 || tk_rr_none(s0x, s0y, ix, iy, iw, ih, ir) == 1) { return 16; }
        if (tk_rr_all(s0x, s0y, ix, iy, iw, ih, ir) == 1) { return 0; }
    }
    let n: u32 = 0;
    let j: i32 = 0;
    while (j < 4) {
        let i: i32 = 0;
        while (i < 4) {
            let sx: i32 = px * 8 + 2 * i + 1;
            let sy: i32 = py * 8 + 2 * j + 1;
            if (tk_in_rr(sx, sy, x, y, w, h, r) == 1) {
                if (t <= 0 || tk_in_rr(sx, sy, x + t, y + t, w - 2 * t, h - 2 * t, tk_imax(r - t, 0)) == 0) {
                    n = n + 1;
                }
            }
            i = i + 1;
        }
        j = j + 1;
    }
    return n;
}

// A rounded rectangle, filled (t 0) or as a ring t pixels thick, with
// antialiased edges. A circle is one whose radius is half its side.
fn tk_shape(ui: *tk_ui, c: *ds_rect, x: i32, y: i32, w: i32, h: i32, r: i32, t: i32, argb: u32) -> void {
    if (w <= 0 || h <= 0) { return; }
    r = tk_imin(r, tk_imin(w, h) / 2);
    // Edges are on whole pixels, so only the corner squares (edge on a side)
    // can cover a pixel in part: they are sampled. Elsewhere a pixel is all
    // in or all out, and is filled as part of a run.
    let edge: i32 = tk_imax(r, t) + 1;
    let lx: i32 = tk_imin(x + edge, x + w);         // [x, lx): left corners
    let rx: i32 = tk_imax(x + w - edge, lx);        // [rx, x + w): right corners
    let y0: i32 = tk_imax(y, c.y as i32);
    let y1: i32 = tk_imin(y + h, (c.y + c.h) as i32);
    let x0: i32 = tk_imax(x, c.x as i32);
    let x1: i32 = tk_imin(x + w, (c.x + c.w) as i32);
    let py: i32 = y0;
    while (py < y1) {
        if (py < y + edge || py >= y + h - edge) {
            // a corner row: its two ends sampled
            let px: i32 = x0;
            while (px < tk_imin(lx, x1)) { tk_blend(ui, px, py, argb, tk_cov(px, py, x, y, w, h, r, t), c); px = px + 1; }
            px = tk_imax(rx, x0);
            while (px < x1) { tk_blend(ui, px, py, argb, tk_cov(px, py, x, y, w, h, r, t), c); px = px + 1; }
            // between them: the outline's top or bottom, or the inside
            if (t <= 0 || py < y + t || py >= y + h - t) { tk_box(ui, c, lx, py, rx - lx, 1, argb); }
        } else if (t <= 0) {
            tk_box(ui, c, x, py, w, 1, argb);
        } else {
            // a ring's sides
            tk_box(ui, c, x, py, tk_imin(t, w), 1, argb);
            tk_box(ui, c, tk_imax(x + w - t, x + t), py, tk_imin(t, w - t), 1, argb);
        }
        py = py + 1;
    }
}

// A stroke from (ax, ay) to (bx, by), in eighths of a pixel, t eighths
// thick, with round ends.
fn tk_seg(ui: *tk_ui, c: *ds_rect, ax: i32, ay: i32, bx: i32, by: i32, t: i32, argb: u32) -> void {
    let half: i32 = t / 2;
    let x0: i32 = (tk_imin(ax, bx) - half) / 8 - 1;
    let x1: i32 = (tk_imax(ax, bx) + half) / 8 + 1;
    let y0: i32 = (tk_imin(ay, by) - half) / 8 - 1;
    let y1: i32 = (tk_imax(ay, by) + half) / 8 + 1;
    // nothing is sampled where nothing may be drawn
    x0 = tk_imax(x0, c.x as i32);
    y0 = tk_imax(y0, c.y as i32);
    x1 = tk_imin(x1, (c.x + c.w) as i32 - 1);
    y1 = tk_imin(y1, (c.y + c.h) as i32 - 1);
    let vx: i64 = (bx - ax) as i64;
    let vy: i64 = (by - ay) as i64;
    let ll: i64 = vx * vx + vy * vy;
    let hh: i64 = (half as i64) * (half as i64);
    let py: i32 = y0;
    while (py <= y1) {
        let px: i32 = x0;
        while (px <= x1) {
            let n: u32 = 0;
            let j: i32 = 0;
            while (j < 4) {
                let i: i32 = 0;
                while (i < 4) {
                    let wx: i64 = (px * 8 + 2 * i + 1 - ax) as i64;
                    let wy: i64 = (py * 8 + 2 * j + 1 - ay) as i64;
                    let dot: i64 = wx * vx + wy * vy;
                    let inside: u32 = 0;
                    if (ll == 0 || dot <= 0) {
                        if (wx * wx + wy * wy <= hh) { inside = 1; }
                    } else if (dot >= ll) {
                        let ex: i64 = wx - vx;
                        let ey: i64 = wy - vy;
                        if (ex * ex + ey * ey <= hh) { inside = 1; }
                    } else {
                        let cr: i64 = wx * vy - wy * vx;
                        if (cr * cr <= hh * ll) { inside = 1; }
                    }
                    n = n + inside;
                    i = i + 1;
                }
                j = j + 1;
            }
            tk_blend(ui, px, py, argb, n, c);
            px = px + 1;
        }
        py = py + 1;
    }
}

// Text from (x, y), the bitmap font magnified by the ui's glyph factor.
fn tk_text(ui: *tk_ui, c: *ds_rect, x: i32, y: i32, s: *u8, argb: u32, bold: u32) -> void {
    if (s == (0 as *u8)) { return; }
    tk_text_n(ui, c, x, y, s, strlen(s), argb, bold);
}

// n bytes of UTF-8 as text: one glyph a character (a byte that is not
// UTF-8 is one, as '?').
fn tk_text_n(ui: *tk_ui, c: *ds_rect, x: i32, y: i32, s: *u8, n: u32, argb: u32, bold: u32) -> void {
    if (s == (0 as *u8) || ui.font == (0 as *ds_font)) { return; }
    let f: *ds_font = ui.font;
    let g: i32 = ui.glyph as i32;
    let cw: i32 = (f.width as i32) * g;
    let at: u32 = 0;
    let k: u32 = 0;
    while (at < n) {
        let cp: u32 = 63;
        let l: u32 = tk_utf8_at(s, n, at, &cp);
        if (l == 0) { l = 1; cp = 63; }
        at = at + l;
        let code: u32 = tk_cp437(cp);
        let gx: i32 = x + (k as i32) * cw;
        k = k + 1;
        if (gx >= ((c.x + c.w) as i32)) { return; }
        if (code < f.count && gx + cw > (c.x as i32)) {
            let row: u32 = 0;
            while (row < f.height) {
                let bits: u32 = f.bits[code * f.height + row] as u32;
                // each run of set bits is one box
                let col: u32 = 0;
                while (col < f.width) {
                    if ((bits & (0x80 >> col)) != 0) {
                        let end: u32 = col + 1;
                        while (end < f.width && (bits & (0x80 >> end)) != 0) { end = end + 1; }
                        let px: i32 = gx + (col as i32) * g;
                        let py: i32 = y + (row as i32) * g;
                        tk_box(ui, c, px, py, ((end - col) as i32) * g + (bold as i32), g, argb);
                        col = end;
                    } else {
                        col = col + 1;
                    }
                }
                row = row + 1;
            }
        }
    }
}

// ---- drawing each kind ----

fn tk_on(n: *tk_node, f: u32) -> u32 {
    if ((n.flags & f) != 0) { return 1; }
    return 0;
}

fn tk_text_colour(ui: *tk_ui, n: *tk_node) -> u32 {
    if (tk_on(n, TK_F_DISABLED) == 1) { return ui.theme.off_text; }
    if (tk_on(n, TK_F_MUTED) == 1) { return ui.theme.muted; }
    return ui.theme.text;
}

// The focus ring, in the room every focusable widget keeps round itself.
fn tk_draw_ring(ui: *tk_ui, n: *tk_node, c: *ds_rect) -> void {
    if (tk_on(n, TK_F_FOCUS) == 0 && tk_on(n, TK_F_SHOW_RING) == 0) { return; }
    let r: i32 = tk_len(ui, TK_RADIUS + TK_RING);
    tk_shape(ui, c, n.dx as i32, n.dy as i32, n.dw as i32, n.dh as i32, r, tk_len(ui, TK_RING_T), ui.theme.ring);
}

fn tk_draw_button(ui: *tk_ui, n: *tk_node, i: u32, c: *ds_rect) -> void {
    let m: i32 = tk_len(ui, TK_RING);
    let x: i32 = (n.dx as i32) + m;
    let y: i32 = (n.dy as i32) + m;
    let w: i32 = (n.dw as i32) - 2 * m;
    let h: i32 = (n.dh as i32) - 2 * m;
    let r: i32 = tk_len(ui, TK_RADIUS);
    let bg: u32 = ui.theme.raised;
    let fg: u32 = ui.theme.text;
    let edge: u32 = ui.theme.border;
    if (tk_on(n, TK_F_DEFAULT) == 1) { bg = ui.theme.accent; fg = ui.theme.on_accent; edge = ui.theme.accent; }
    if (tk_on(n, TK_F_HOVER) == 1) { bg = ui.theme.hover; if (tk_on(n, TK_F_DEFAULT) == 1) { bg = ds_over(ds_fade(0xFFFFFFFF, 40), ui.theme.accent); } }
    if (tk_on(n, TK_F_PRESSED) == 1) { bg = ui.theme.pressed; fg = ui.theme.text; }
    if (tk_on(n, TK_F_DISABLED) == 1) { bg = ui.theme.off_bg; fg = ui.theme.off_text; edge = ui.theme.off_bg; }
    tk_shape(ui, c, x, y, w, h, r, 0, edge);
    tk_shape(ui, c, x + 1, y + 1, w - 2, h - 2, tk_imax(r - 1, 0), 0, bg);
    // the text, centred, clipped to the inside of the button
    let s: *u8 = tk_text_of(ui, i);
    if (s != (0 as *u8)) {
        let tw: i32 = ((tk_utf8_count(s, strlen(s)) * tk_char_w(ui)) as i32);
        let th: i32 = tk_char_h(ui) as i32;
        let inside: ds_rect;
        let mine: ds_rect;
        ds_rect_set(&mine, (x + 1) as u32, (y + 1) as u32, (tk_imax(w - 2, 0)) as u32, (tk_imax(h - 2, 0)) as u32);
        if (ds_rect_and(&inside, &mine, c) == 1) {
            tk_text(ui, &inside, x + (w - tw) / 2, y + (h - th) / 2, s, fg, 0);
        }
    }
    tk_draw_ring(ui, n, c);
}

// A control's label, to the right of its box, clipped to the widget.
fn tk_draw_side_text(ui: *tk_ui, n: *tk_node, i: u32, c: *ds_rect, from: i32) -> void {
    let s: *u8 = tk_text_of(ui, i);
    if (s == (0 as *u8)) { return; }
    let th: i32 = tk_char_h(ui) as i32;
    let y: i32 = (n.dy as i32) + ((n.dh as i32) - th) / 2;
    tk_text(ui, c, from + tk_len(ui, TK_TEXT_GAP), y, s, tk_text_colour(ui, n), 0);
}

fn tk_draw_check(ui: *tk_ui, n: *tk_node, i: u32, c: *ds_rect) -> void {
    let m: i32 = tk_len(ui, TK_RING);
    let s: i32 = tk_len(ui, TK_BOX);
    let x: i32 = (n.dx as i32) + m;
    let y: i32 = (n.dy as i32) + ((n.dh as i32) - s) / 2;
    let r: i32 = tk_len(ui, TK_RADIUS);
    let off: u32 = tk_on(n, TK_F_DISABLED);
    let on: u32 = tk_on(n, TK_F_CHECKED) | tk_on(n, TK_F_MIXED);
    if (n.kind == TK_RADIO) { r = s / 2; }
    let fill: u32 = ui.theme.raised;
    if (tk_on(n, TK_F_HOVER) == 1 || tk_on(n, TK_F_PRESSED) == 1) { fill = ui.theme.hover; }
    if (on == 1 && off == 0) {
        tk_shape(ui, c, x, y, s, s, r, 0, ui.theme.accent);
    } else {
        let edge: u32 = ui.theme.border;
        if (off == 1) { edge = ui.theme.off_bg; fill = ui.theme.off_bg; }
        tk_shape(ui, c, x, y, s, s, r, 0, edge);
        tk_shape(ui, c, x + 1, y + 1, s - 2, s - 2, tk_imax(r - 1, 0), 0, fill);
    }
    let mark: u32 = ui.theme.on_accent;
    if (off == 1) { mark = ui.theme.off_text; }
    if (n.kind == TK_RADIO && tk_on(n, TK_F_CHECKED) == 1) {
        let d: i32 = tk_imax((s * 3) / 8, 2);
        tk_shape(ui, c, x + (s - d) / 2, y + (s - d) / 2, d, d, d / 2, 0, mark);
    }
    if (n.kind == TK_CHECK && tk_on(n, TK_F_MIXED) == 1) {
        let bh: i32 = tk_imax(s / 8, 1);
        tk_box(ui, c, x + s / 4, y + (s - bh) / 2, s - s / 2, bh, mark);
    } else if (n.kind == TK_CHECK && tk_on(n, TK_F_CHECKED) == 1) {
        // a tick: two strokes, in eighths of a pixel
        let x8: i32 = x * 8;
        let y8: i32 = y * 8;
        let t: i32 = tk_imax(s, 8);
        tk_seg(ui, c, x8 + s * 2, y8 + s * 4, x8 + (s * 7) / 2, y8 + (s * 11) / 2, t, mark);
        tk_seg(ui, c, x8 + (s * 7) / 2, y8 + (s * 11) / 2, x8 + s * 6, y8 + (s * 5) / 2, t, mark);
    }
    tk_draw_side_text(ui, n, i, c, x + s);
    tk_draw_ring(ui, n, c);
}

fn tk_draw_switch(ui: *tk_ui, n: *tk_node, i: u32, c: *ds_rect) -> void {
    let m: i32 = tk_len(ui, TK_RING);
    let w: i32 = tk_len(ui, TK_SW_W);
    let h: i32 = tk_len(ui, TK_SW_H);
    let x: i32 = (n.dx as i32) + m;
    let y: i32 = (n.dy as i32) + ((n.dh as i32) - h) / 2;
    let track: u32 = ui.theme.track;
    if (tk_on(n, TK_F_CHECKED) == 1) { track = ui.theme.accent; }
    if (tk_on(n, TK_F_DISABLED) == 1) { track = ui.theme.off_bg; }
    tk_shape(ui, c, x, y, w, h, h / 2, 0, track);
    let k: i32 = h - 2 * tk_len(ui, 2);
    let kx: i32 = x + tk_len(ui, 2);
    if (tk_on(n, TK_F_CHECKED) == 1) { kx = x + w - tk_len(ui, 2) - k; }
    let knob: u32 = ui.theme.raised;
    if (tk_on(n, TK_F_DISABLED) == 1) { knob = ui.theme.off_text; }
    tk_shape(ui, c, kx, y + (h - k) / 2, k, k, k / 2, 0, knob);
    tk_draw_side_text(ui, n, i, c, x + w);
    tk_draw_ring(ui, n, c);
}

// Where a slider's knob is: its left edge in device pixels.
fn tk_knob_x(ui: *tk_ui, n: *tk_node) -> i32 {
    let m: i32 = tk_len(ui, TK_RING);
    let k: i32 = tk_len(ui, TK_KNOB);
    let run: i32 = tk_imax((n.dw as i32) - 2 * m - k, 0);
    let span: i64 = (n.vmax - n.vmin) as i64;
    let off: i64 = 0;
    if (span > 0) { off = (((n.value - n.vmin) as i64) * (run as i64) + span / 2) / span; }
    return (n.dx as i32) + m + (off as i32);
}

fn tk_draw_slider(ui: *tk_ui, n: *tk_node, c: *ds_rect) -> void {
    let m: i32 = tk_len(ui, TK_RING);
    let k: i32 = tk_len(ui, TK_KNOB);
    let th: i32 = tk_len(ui, TK_TRACK);
    let x: i32 = (n.dx as i32) + m;
    let w: i32 = (n.dw as i32) - 2 * m;
    let cy: i32 = (n.dy as i32) + (n.dh as i32) / 2;
    let kx: i32 = tk_knob_x(ui, n);
    let on: u32 = ui.theme.accent;
    let knob_edge: u32 = ui.theme.border;
    if (tk_on(n, TK_F_HOVER) == 1 || tk_on(n, TK_F_PRESSED) == 1) { knob_edge = ui.theme.accent; }
    if (tk_on(n, TK_F_DISABLED) == 1) { on = ui.theme.off_text; knob_edge = ui.theme.off_bg; }
    tk_shape(ui, c, x, cy - th / 2, w, th, th / 2, 0, ui.theme.track);
    tk_shape(ui, c, x, cy - th / 2, kx + k / 2 - x, th, th / 2, 0, on);
    tk_shape(ui, c, kx, cy - k / 2, k, k, k / 2, 0, knob_edge);
    let fill: u32 = ui.theme.raised;
    if (tk_on(n, TK_F_DISABLED) == 1) { fill = ui.theme.off_bg; }
    tk_shape(ui, c, kx + 1, cy - k / 2 + 1, k - 2, k - 2, (k - 2) / 2, 0, fill);
    tk_draw_ring(ui, n, c);
}

fn tk_draw_progress(ui: *tk_ui, n: *tk_node, c: *ds_rect) -> void {
    let x: i32 = n.dx as i32;
    let y: i32 = n.dy as i32;
    let w: i32 = n.dw as i32;
    let h: i32 = n.dh as i32;
    tk_shape(ui, c, x, y, w, h, h / 2, 0, ui.theme.track);
    let span: i64 = (n.vmax - n.vmin) as i64;
    let fw: i32 = 0;
    if (span > 0) { fw = ((((n.value - n.vmin) as i64) * (w as i64)) / span) as i32; }
    let on: u32 = ui.theme.accent;
    if (tk_on(n, TK_F_DISABLED) == 1) { on = ui.theme.off_text; }
    if (fw > 0) { tk_shape(ui, c, x, y, fw, h, h / 2, 0, on); }
}

// Where a field's text goes: its first column's x, its row's y, and how
// many characters fit.
fn tk_field_geom(ui: *tk_ui, n: *tk_node, tx: *i32, ty: *i32, cap: *u32) -> void {
    let m: i32 = tk_len(ui, TK_RING);
    let pad: i32 = tk_len(ui, TK_FIELD_PADX);
    let cw: i32 = tk_char_w(ui) as i32;
    *tx = (n.dx as i32) + m + pad;
    *ty = (n.dy as i32) + ((n.dh as i32) - (tk_char_h(ui) as i32)) / 2;
    let room: i32 = (n.dw as i32) - 2 * m - 2 * pad;
    let fit: i32 = 1;
    if (cw > 0 && room / cw > 1) { fit = room / cw; }
    *cap = fit as u32;
}

// The caret's column: characters before it, the accent waiting included.
fn tk_field_caret_col(f: *tk_field) -> u32 {
    let col: u32 = tk_utf8_count(&f.buf[0], f.caret);
    if (f.dead != 0) { col = col + 1; }
    return col;
}

// Keep the caret in sight: the first character shown moves if it must.
fn tk_field_scroll(ui: *tk_ui, n: *tk_node, f: *tk_field) -> void {
    let tx: i32 = 0; let ty: i32 = 0; let cap: u32 = 1;
    tk_field_geom(ui, n, &tx, &ty, &cap);
    let col: u32 = tk_field_caret_col(f);
    if (col < f.scroll) { f.scroll = col; }
    if (col > f.scroll + cap - 1) { f.scroll = col - (cap - 1); }
}

// One character of a field at column col (from the first shown).
fn tk_field_glyph(ui: *tk_ui, c: *ds_rect, tx: i32, ty: i32, col: u32, s: *u8, l: u32, fg: u32, bg: u32, under: u32) -> void {
    let cw: i32 = tk_char_w(ui) as i32;
    let ch: i32 = tk_char_h(ui) as i32;
    let gx: i32 = tx + (col as i32) * cw;
    if (bg != 0) { tk_box(ui, c, gx, ty, cw, ch, bg); }
    tk_text_n(ui, c, gx, ty, s, l, fg, 0);
    if (under == 1) { tk_box(ui, c, gx, ty + ch - tk_len(ui, 1), cw, tk_len(ui, 1), fg); }
}

// A text field: a box, its text from the first character shown, the
// selection in the accent, the accent waiting underlined, and the caret.
fn tk_draw_field(ui: *tk_ui, n: *tk_node, c: *ds_rect) -> void {
    let f: *tk_field = &ui.field[n.field];
    let m: i32 = tk_len(ui, TK_RING);
    let x: i32 = (n.dx as i32) + m;
    let y: i32 = (n.dy as i32) + m;
    let w: i32 = (n.dw as i32) - 2 * m;
    let h: i32 = (n.dh as i32) - 2 * m;
    let r: i32 = tk_len(ui, TK_RADIUS);
    let bg: u32 = ui.theme.raised;
    let edge: u32 = ui.theme.border;
    let fg: u32 = ui.theme.text;
    if (tk_on(n, TK_F_FOCUS) == 1) { edge = ui.theme.accent; }
    if (tk_on(n, TK_F_DISABLED) == 1) { bg = ui.theme.off_bg; edge = ui.theme.off_bg; fg = ui.theme.off_text; }
    tk_shape(ui, c, x, y, w, h, r, 0, edge);
    tk_shape(ui, c, x + 1, y + 1, w - 2, h - 2, tk_imax(r - 1, 0), 0, bg);
    let inside: ds_rect;
    let mine: ds_rect;
    ds_rect_set(&mine, (x + 1) as u32, (y + 1) as u32, (tk_imax(w - 2, 0)) as u32, (tk_imax(h - 2, 0)) as u32);
    if (ds_rect_and(&inside, &mine, c) == 0) { tk_draw_ring(ui, n, c); return; }
    tk_field_scroll(ui, n, f);
    let tx: i32 = 0; let ty: i32 = 0; let cap: u32 = 1;
    tk_field_geom(ui, n, &tx, &ty, &cap);
    let a: u32 = f.anchor; let b: u32 = f.caret;
    if (a > b) { a = f.caret; b = f.anchor; }
    let pre: [4]u8;
    let pre_n: u32 = 0;
    if (f.dead != 0) { pre_n = tk_utf8_put(f.dead, &pre[0]); }
    // every character in order, the accent at the caret; columns before
    // the first shown are skipped
    let col: u32 = 0;
    let at: u32 = 0;
    while (at <= f.len) {
        if (at == f.caret && pre_n > 0) {
            if (col >= f.scroll) { tk_field_glyph(ui, &inside, tx, ty, col - f.scroll, &pre[0], pre_n, fg, 0, 1); }
            col = col + 1;
        }
        if (at == f.len) { break; }
        let cp: u32 = 0;
        let l: u32 = tk_utf8_at(&f.buf[0], f.len, at, &cp);
        if (l == 0) { l = 1; }
        if (col >= f.scroll) {
            if (at >= a && at < b) { tk_field_glyph(ui, &inside, tx, ty, col - f.scroll, &f.buf[at], l, ui.theme.on_accent, ui.theme.accent, 0); }
            else { tk_field_glyph(ui, &inside, tx, ty, col - f.scroll, &f.buf[at], l, fg, 0, 0); }
        }
        col = col + 1;
        at = at + l;
    }
    if (tk_on(n, TK_F_FOCUS) == 1) {
        let cx: i32 = tx + ((tk_field_caret_col(f) - f.scroll) as i32) * (tk_char_w(ui) as i32);
        tk_box(ui, &inside, cx, ty, tk_len(ui, 1), tk_char_h(ui) as i32, fg);
    }
    tk_draw_ring(ui, n, c);
}

fn tk_draw_node(ui: *tk_ui, i: u32, c: *ds_rect) -> void {
    let n: *tk_node = &ui.node[i];
    let k: u32 = n.kind;
    if (k == TK_LABEL || k == TK_HEADING) {
        let bold: u32 = 0;
        if (k == TK_HEADING) { bold = 1; }
        tk_text(ui, c, n.dx as i32, n.dy as i32, tk_text_of(ui, i), tk_text_colour(ui, n), bold);
    }
    else if (k == TK_BUTTON) { tk_draw_button(ui, n, i, c); }
    else if (k == TK_CHECK || k == TK_RADIO) { tk_draw_check(ui, n, i, c); }
    else if (k == TK_SWITCH) { tk_draw_switch(ui, n, i, c); }
    else if (k == TK_SLIDER) { tk_draw_slider(ui, n, c); }
    else if (k == TK_PROGRESS) { tk_draw_progress(ui, n, c); }
    else if (k == TK_TEXTFIELD) { tk_draw_field(ui, n, c); }
}

// Draw i and its children inside clip, each kept to its own box.
fn tk_paint_node(ui: *tk_ui, i: u32, clip: *ds_rect) -> void {
    if (tk_shown(ui, i) == 0) { return; }
    let n: *tk_node = &ui.node[i];
    let box: ds_rect;
    let c: ds_rect;
    ds_rect_set(&box, n.dx, n.dy, n.dw, n.dh);
    if (ds_rect_and(&c, &box, clip) == 0) { return; }
    tk_draw_node(ui, i, &c);
    let k: u32 = n.first;
    while (k != TK_NONE) { tk_paint_node(ui, k, &c); k = ui.node[k].next; }
}

// Draw what the damage covers, lay out first if anything asked for it. The
// rectangles drawn go to *out (the ui's damage is then empty): their count.
fn tk_paint(ui: *tk_ui, out: *ds_damage) -> u32 {
    if (ui.canvas.px == 0) { out.n = 0; return 0; }
    if (ui.relayout == 1) {
        tk_layout(ui);
        tk_damage_all(ui);
    }
    let k: u32 = 0;
    while (k < ui.damage.n) {
        let r: *ds_rect = &ui.damage.r[k];
        ds_fill(&ui.canvas, r.x, r.y, r.w, r.h, ui.theme.surface);
        tk_paint_node(ui, ui.root, r);
        k = k + 1;
    }
    *out = ui.damage;
    ds_damage_clear(&ui.damage);
    return out.n;
}

// ---- input ----

fn tk_focusable(ui: *tk_ui, i: u32) -> u32 {
    let n: *tk_node = &ui.node[i];
    if (tk_takes_input(n.kind) == 0 || (n.flags & TK_F_DISABLED) != 0) { return 0; }
    let a: u32 = i;
    while (a != TK_NONE) {
        if ((ui.node[a].flags & TK_F_HIDDEN) != 0) { return 0; }
        a = ui.node[a].parent;
    }
    return 1;
}

// The node after i in tree order (preorder), or TK_NONE past the last.
fn tk_after(ui: *tk_ui, i: u32) -> u32 {
    if (ui.node[i].first != TK_NONE) { return ui.node[i].first; }
    let a: u32 = i;
    while (a != TK_NONE) {
        if (ui.node[a].next != TK_NONE) { return ui.node[a].next; }
        a = ui.node[a].parent;
    }
    return TK_NONE;
}

fn tk_focus_set(ui: *tk_ui, i: u32) -> void {
    if (ui.focus == i) { return; }
    if (ui.focus != TK_NONE) {
        ui.node[ui.focus].flags = ui.node[ui.focus].flags & ~TK_F_FOCUS;
        // an accent still waiting is dropped with the focus
        if (ui.node[ui.focus].kind == TK_TEXTFIELD) { ui.field[ui.node[ui.focus].field].dead = 0; }
        tk_damage_node(ui, ui.focus);
    }
    ui.focus = i;
    if (i != TK_NONE) {
        ui.node[i].flags = ui.node[i].flags | TK_F_FOCUS;
        tk_damage_node(ui, i);
    }
}

// Tab: the next widget that can take the focus, in tree order, wrapping.
fn tk_focus_next(ui: *tk_ui) -> void {
    let start: u32 = ui.focus;
    if (start == TK_NONE) { start = ui.root; }
    let i: u32 = tk_after(ui, start);
    let steps: u32 = 0;
    while (steps <= ui.used) {
        if (i == TK_NONE) { i = ui.root; }
        if (tk_focusable(ui, i) == 1) { tk_focus_set(ui, i); return; }
        i = tk_after(ui, i);
        steps = steps + 1;
    }
}

// Shift+Tab: the one before, wrapping.
fn tk_focus_prev(ui: *tk_ui) -> void {
    let before: u32 = TK_NONE;     // the last focusable one ahead of the focus
    let last: u32 = TK_NONE;
    let found: u32 = 0;
    let i: u32 = ui.root;
    while (i != TK_NONE) {
        if (i == ui.focus) { found = 1; before = last; }
        if (tk_focusable(ui, i) == 1) { last = i; }
        i = tk_after(ui, i);
    }
    // nothing before the focus, or no focus: the last one
    let to: u32 = before;
    if (found == 0 || to == TK_NONE) { to = last; }
    if (to != TK_NONE) { tk_focus_set(ui, to); }
}

fn tk_focused(ui: *tk_ui) -> u32 { return tk_id(ui, ui.focus); }

fn tk_focus(ui: *tk_ui, id: u32) -> i32 {
    let i: u32 = tk_index(ui, id);
    if (i == TK_NONE || tk_focusable(ui, i) == 0) { return E_INVALID_ARGS; }
    tk_focus_set(ui, i);
    return 0;
}

fn tk_radio_pick(ui: *tk_ui, i: u32) -> void {
    let k: u32 = 0;
    while (k < ui.used) {
        let o: *tk_node = &ui.node[k];
        if (k != i && o.kind == TK_RADIO && o.group == ui.node[i].group && o.parent == ui.node[i].parent
            && (o.flags & TK_F_CHECKED) != 0) {
            o.flags = o.flags & ~TK_F_CHECKED;
            tk_damage_node(ui, k);
        }
        k = k + 1;
    }
    let n: *tk_node = &ui.node[i];
    if ((n.flags & TK_F_CHECKED) == 0) {
        n.flags = n.flags | TK_F_CHECKED;
        tk_damage_node(ui, i);
        tk_push(ui, TK_EV_CHANGE, i, 1, 0);
    }
}

// What pressing a widget does.
fn tk_activate(ui: *tk_ui, i: u32) -> void {
    let n: *tk_node = &ui.node[i];
    if ((n.flags & TK_F_DISABLED) != 0) { return; }
    if (n.kind == TK_BUTTON && n.cmd != 0) { tk_run(ui, n.cmd, i); return; }
    if (n.kind == TK_BUTTON) { tk_push(ui, TK_EV_ACTIVATE, i, 0, 0); return; }
    if (n.kind == TK_CHECK || n.kind == TK_SWITCH) {
        // a mixed box becomes checked; otherwise it turns over
        let was: u32 = n.flags & TK_F_CHECKED;
        n.flags = n.flags & ~(TK_F_CHECKED | TK_F_MIXED);
        if (was == 0) { n.flags = n.flags | TK_F_CHECKED; }
        tk_damage_node(ui, i);
        let v: i32 = 0;
        if (was == 0) { v = 1; }
        tk_push(ui, TK_EV_CHANGE, i, v, 0);
        return;
    }
    if (n.kind == TK_RADIO) { tk_radio_pick(ui, i); }
}

fn tk_slider_to(ui: *tk_ui, i: u32, v: i32) -> void {
    let n: *tk_node = &ui.node[i];
    // snapped to the step, from the minimum
    let off: i32 = v - n.vmin;
    if (off < 0) { off = 0; }
    off = ((off + n.step / 2) / n.step) * n.step;
    let c: i32 = tk_clamp_value(n, n.vmin + off);
    if (c == n.value) { return; }
    n.value = c;
    tk_damage_node(ui, i);
    tk_push(ui, TK_EV_CHANGE, i, c, 0);
}

// The value under device x on slider i.
fn tk_slider_at(ui: *tk_ui, i: u32, x: i32) -> i32 {
    let n: *tk_node = &ui.node[i];
    let m: i32 = tk_len(ui, TK_RING);
    let k: i32 = tk_len(ui, TK_KNOB);
    let run: i32 = tk_imax((n.dw as i32) - 2 * m - k, 1);
    let at: i32 = x - ((n.dx as i32) + m + k / 2);
    let span: i64 = (n.vmax - n.vmin) as i64;
    let v: i64 = ((at as i64) * span + (run as i64) / 2) / (run as i64);
    return n.vmin + (v as i32);
}

// The next radio of i's group in its parent, forward or back, wrapping.
fn tk_radio_step(ui: *tk_ui, i: u32, back: u32) -> u32 {
    let p: u32 = ui.node[i].parent;
    let best: u32 = TK_NONE;
    let first: u32 = TK_NONE;
    let last: u32 = TK_NONE;
    let seen: u32 = 0;
    let c: u32 = ui.node[p].first;
    while (c != TK_NONE) {
        if (ui.node[c].kind == TK_RADIO && ui.node[c].group == ui.node[i].group && tk_focusable(ui, c) == 1) {
            if (first == TK_NONE) { first = c; }
            if (c == i) { seen = 1; }
            else if (back == 1 && seen == 0) { best = c; }
            else if (back == 0 && seen == 1 && best == TK_NONE) { best = c; }
            last = c;
        }
        c = ui.node[c].next;
    }
    if (best != TK_NONE) { return best; }
    if (back == 1) { return last; }
    return first;
}

// A key the focused widget may take (no Ctrl, Alt or Super held): 1 if it did.
fn tk_widget_key(ui: *tk_ui, code: u32, ch: u32, mods: u32) -> u32 {
    let f: u32 = ui.focus;
    if (f == TK_NONE || (mods & TK_MODS_CAS) != 0) { return 0; }
    let n: *tk_node = &ui.node[f];
    if (n.kind == TK_TEXTFIELD) { return tk_field_key(ui, f, code, ch, mods); }
    if (code == KC_SPACE && n.kind != TK_SLIDER) { tk_activate(ui, f); return 1; }
    if ((code == KC_ENTER || code == KC_KP_ENTER) && n.kind == TK_BUTTON) { tk_activate(ui, f); return 1; }
    if (n.kind == TK_SLIDER) {
        if (code == KC_LEFT || code == KC_DOWN) { tk_slider_to(ui, f, n.value - n.step); return 1; }
        if (code == KC_RIGHT || code == KC_UP) { tk_slider_to(ui, f, n.value + n.step); return 1; }
        if (code == KC_HOME) { tk_slider_to(ui, f, n.vmin); return 1; }
        if (code == KC_END) { tk_slider_to(ui, f, n.vmax); return 1; }
    }
    if (n.kind == TK_RADIO) {
        let back: u32 = 2;
        if (code == KC_LEFT || code == KC_UP) { back = 1; }
        if (code == KC_RIGHT || code == KC_DOWN) { back = 0; }
        if (back != 2) {
            let to: u32 = tk_radio_step(ui, f, back);
            if (to != TK_NONE) { tk_focus_set(ui, to); tk_radio_pick(ui, to); }
            return 1;
        }
    }
    return 0;
}

// The button with flag (DEFAULT or CANCEL) that can be pressed: pressed, 1.
fn tk_press_flagged(ui: *tk_ui, flag: u32) -> u32 {
    let k: u32 = 0;
    while (k < ui.used) {
        if (ui.node[k].kind == TK_BUTTON && (ui.node[k].flags & flag) != 0 && tk_focusable(ui, k) == 1) {
            tk_activate(ui, k);
            return 1;
        }
        k = k + 1;
    }
    return 0;
}

// A key from the window: code KC_*, ch its character or 0, mods KEYMOD_* |
// KEYEV_* (as WM_EV_KEY gives them). 1 if the ui took it; else 0, and a
// press goes to the app as TK_EV_KEY. Releases are taken by nobody.
//
// In order: the input method (a text field has the focus), the focused
// widget, the dialog manager (Tab, Shift+Tab, Enter, Esc), the commands.
fn tk_key(ui: *tk_ui, code: u32, ch: u32, mods: u32) -> u32 {
    if ((mods & KEYEV_RELEASE) != 0) { return 0; }
    let held: u32 = mods & KEYMOD_HELD;
    if (ui.focus != TK_NONE && ui.node[ui.focus].kind == TK_TEXTFIELD && ui.im != TK_IM_NONE) {
        if (tk_im_key(ui, ui.focus, code, ch, held) == 1) { return 1; }
    }
    if (tk_widget_key(ui, code, ch, held) == 1) { return 1; }
    if ((held & TK_MODS_CAS) == 0) {
        if (code == KC_TAB) {
            if ((held & KEYMOD_SHIFT) != 0) { tk_focus_prev(ui); } else { tk_focus_next(ui); }
            return 1;
        }
        if ((code == KC_ENTER || code == KC_KP_ENTER) && tk_press_flagged(ui, TK_F_DEFAULT) == 1) { return 1; }
        if (code == KC_ESC && tk_press_flagged(ui, TK_F_CANCEL) == 1) { return 1; }
    }
    let cmd: u32 = tk_command_for(ui, code, held);
    if (cmd != 0) { tk_run(ui, cmd, TK_NONE); return 1; }
    let at: u32 = (ui.ev_head + ui.ev_n) % TK_EVENTS_MAX;
    let room: u32 = 0;
    if (ui.ev_n < TK_EVENTS_MAX) { room = 1; }
    tk_push(ui, TK_EV_KEY, TK_NONE, 0, code);
    if (room == 1) { ui.ev[at].ch = ch; ui.ev[at].mods = mods; }
    return 0;
}

// ---- commands ----

// Is key with held a system key, the window server's or the kernel's,
// which no app may have (CX_TOOLKIT.md §7)? 1 if so.
fn tk_key_reserved(key: u32, held: u32) -> u32 {
    if ((held & KEYMOD_SUPER) != 0 || key == KC_LSUPER || key == KC_RSUPER) { return 1; }
    if ((held & ~KEYMOD_SHIFT) == KEYMOD_ALT && key == KC_TAB) { return 1; }
    if (held == KEYMOD_ALT && key == KC_F4) { return 1; }
    if (held == (KEYMOD_CTRL | KEYMOD_ALT) && key == KC_F2) { return 1; }
    if ((held & (KEYMOD_CTRL | KEYMOD_ALT)) == (KEYMOD_CTRL | KEYMOD_ALT) && (key == KC_DELETE || key == KC_KP_PERIOD)) { return 1; }
    return 0;
}

// May command cmd (0 for a new one) be bound to key with mods? 0, or
// E_INVALID_ARGS (not a key a command can have: one that types, or no Ctrl
// or Alt and not F1 to F12), E_ACCESS_DENIED (the system's), or
// E_ALREADY_EXISTS (another command has it; a binding is never taken over).
fn tk_bind_check(ui: *tk_ui, cmd: u32, key: u32, mods: u32) -> i32 {
    if (key == 0) { return 0; }
    if ((mods & ~KEYMOD_HELD) != 0 || key > KC_RSUPER) { return E_INVALID_ARGS; }
    if (tk_key_reserved(key, mods) == 1) { return E_ACCESS_DENIED; }
    if (key >= KC_LCTRL) { return E_INVALID_ARGS; }
    let fkey: u32 = 0;
    if (key >= KC_F1 && key <= KC_F12) { fkey = 1; }
    if (fkey == 0 && (mods & (KEYMOD_CTRL | KEYMOD_ALT)) == 0) { return E_INVALID_ARGS; }
    let k: u32 = 0;
    while (k < ui.cmd_n) {
        if (k + 1 != cmd && ui.cmd[k].key == key && ui.cmd[k].mods == mods) { return E_ALREADY_EXISTS; }
        k = k + 1;
    }
    return 0;
}

// A new command, named, run by key with exactly mods held (key 0: by no
// key). Its number (from 1), or E_INVALID_ARGS, E_ACCESS_DENIED,
// E_ALREADY_EXISTS (as tk_bind_check, or the name is taken), E_NO_RESOURCES.
fn tk_command(ui: *tk_ui, name: *u8, key: u32, mods: u32) -> i32 {
    if (name == (0 as *u8) || name[0] == 0) { return E_INVALID_ARGS; }
    if (tk_command_find(ui, name) != 0) { return E_ALREADY_EXISTS; }
    let rc: i32 = tk_bind_check(ui, 0, key, mods);
    if (rc != 0) { return rc; }
    if (ui.cmd_n >= TK_CMDS_MAX) { return E_NO_RESOURCES; }
    let at: u32 = tk_store(ui, name);
    if (at == TK_NONE) { return E_NO_RESOURCES; }
    let c: *tk_cmd = &ui.cmd[ui.cmd_n];
    c.name = at; c.key = key; c.mods = mods;
    ui.cmd_n = ui.cmd_n + 1;
    return ui.cmd_n as i32;
}

// Bind command cmd to another key (0 unbinds it): 0, or as tk_bind_check,
// or E_INVALID_ARGS for no such command. Refused, it keeps the key it had.
fn tk_bind(ui: *tk_ui, cmd: u32, key: u32, mods: u32) -> i32 {
    if (cmd == 0 || cmd > ui.cmd_n) { return E_INVALID_ARGS; }
    let rc: i32 = tk_bind_check(ui, cmd, key, mods);
    if (rc != 0) { return rc; }
    ui.cmd[cmd - 1].key = key;
    ui.cmd[cmd - 1].mods = mods & KEYMOD_HELD;
    if (key == 0) { ui.cmd[cmd - 1].mods = 0; }
    return 0;
}

// The command named so, or 0.
fn tk_command_find(ui: *tk_ui, name: *u8) -> u32 {
    let k: u32 = 0;
    while (k < ui.cmd_n) {
        if (streq(&ui.arena[ui.cmd[k].name], name) != 0) { return k + 1; }
        k = k + 1;
    }
    return 0;
}

fn tk_command_name(ui: *tk_ui, cmd: u32) -> *u8 {
    if (cmd == 0 || cmd > ui.cmd_n) { return 0 as *u8; }
    return &ui.arena[ui.cmd[cmd - 1].name];
}

// The command a press runs, or 0.
fn tk_command_for(ui: *tk_ui, code: u32, held: u32) -> u32 {
    if (code == 0) { return 0; }
    let k: u32 = 0;
    while (k < ui.cmd_n) {
        if (ui.cmd[k].key == code && ui.cmd[k].mods == held) { return k + 1; }
        k = k + 1;
    }
    return 0;
}

// A widget that runs a command when pressed (0: none): 0 or E_INVALID_ARGS.
fn tk_set_command(ui: *tk_ui, id: u32, cmd: u32) -> i32 {
    let i: u32 = tk_index(ui, id);
    if (i == TK_NONE || cmd > ui.cmd_n) { return E_INVALID_ARGS; }
    ui.node[i].cmd = cmd;
    return 0;
}

// Run a command, from a key (from = TK_NONE) or a widget: a focused text
// field does the standard ones itself; anything else is the app's.
fn tk_run(ui: *tk_ui, cmd: u32, from: u32) -> void {
    let f: u32 = ui.focus;
    if (cmd <= TK_CMD_REDO && f != TK_NONE && ui.node[f].kind == TK_TEXTFIELD) {
        tk_field_command(ui, f, cmd);
        return;
    }
    tk_push(ui, TK_EV_COMMAND, from, cmd as i32, 0);
}

// ---- text fields ----

fn tk_field_prev(f: *tk_field, at: u32) -> u32 {
    if (at == 0) { return 0; }
    at = at - 1;
    while (at > 0 && ((f.buf[at] as u32) & 0xC0) == 0x80) { at = at - 1; }
    return at;
}

fn tk_field_next(f: *tk_field, at: u32) -> u32 {
    if (at >= f.len) { return f.len; }
    at = at + 1;
    while (at < f.len && ((f.buf[at] as u32) & 0xC0) == 0x80) { at = at + 1; }
    return at;
}

// The selection's two ends, the first first.
fn tk_field_sel(f: *tk_field, a: *u32, b: *u32) -> void {
    if (f.anchor <= f.caret) { *a = f.anchor; *b = f.caret; }
    else { *a = f.caret; *b = f.anchor; }
}

// Its text changed: drawn again, and the app told (value: its length).
fn tk_field_changed(ui: *tk_ui, i: u32) -> void {
    tk_damage_node(ui, i);
    tk_push(ui, TK_EV_CHANGE, i, ui.field[ui.node[i].field].len as i32, 0);
}

// Keep what it is now for undo. Characters typed one after another are one
// change: only the first of them saves.
fn tk_field_save(f: *tk_field, typing: u32) -> void {
    if (typing == 0 || f.typing == 0 || f.has_undo == 0 || f.redo == 1) {
        memcpy(&f.undo[0], &f.buf[0], f.len);
        f.undo_len = f.len;
        f.undo_caret = f.caret;
        f.has_undo = 1;
    }
    f.typing = typing;
    f.redo = 0;
}

// Take out bytes [a, b): the caret and anchor go to a.
fn tk_field_remove(f: *tk_field, a: u32, b: u32) -> void {
    if (b > a) {
        memmove(&f.buf[a], &f.buf[b], f.len - b);
        f.len = f.len - (b - a);
    }
    f.buf[f.len] = 0;
    f.caret = a; f.anchor = a;
}

// Put n bytes of UTF-8 in place of the selection: as many whole characters
// as there is room for (the caret after them). The bytes inserted.
fn tk_field_insert(ui: *tk_ui, i: u32, s: *u8, n: u32, typing: u32) -> u32 {
    let f: *tk_field = &ui.field[ui.node[i].field];
    let a: u32 = 0; let b: u32 = 0;
    tk_field_sel(f, &a, &b);
    let room: u32 = TK_FIELD_BYTES - (f.len - (b - a));
    let take: u32 = 0;
    while (take < n) {
        let cp: u32 = 0;
        let l: u32 = tk_utf8_at(s, n, take, &cp);
        if (l == 0 || take + l > room) { break; }
        take = take + l;
    }
    if (take == 0 && a == b) { return 0; }
    tk_field_save(f, typing);
    tk_field_remove(f, a, b);
    memmove(&f.buf[a + take], &f.buf[a], f.len - a);
    memcpy(&f.buf[a], s, take);
    f.len = f.len + take;
    f.buf[f.len] = 0;
    f.caret = a + take; f.anchor = f.caret;
    tk_field_changed(ui, i);
    return take;
}

fn tk_field_insert_cp(ui: *tk_ui, i: u32, cp: u32) -> void {
    let b: [4]u8;
    let n: u32 = tk_utf8_put(cp, &b[0]);
    tk_field_insert(ui, i, &b[0], n, 1);
}

// The caret to `to`; with extend the anchor stays, so the selection grows.
fn tk_field_move(ui: *tk_ui, i: u32, to: u32, extend: u32) -> void {
    let f: *tk_field = &ui.field[ui.node[i].field];
    f.caret = to;
    if (extend == 0) { f.anchor = to; }
    f.typing = 0;
    tk_damage_node(ui, i);
}

// Delete the selection, or else the bytes [a, b): 1 if anything went.
fn tk_field_delete(ui: *tk_ui, i: u32, a: u32, b: u32) -> u32 {
    let f: *tk_field = &ui.field[ui.node[i].field];
    let sa: u32 = 0; let sb: u32 = 0;
    tk_field_sel(f, &sa, &sb);
    if (sa != sb) { a = sa; b = sb; }
    if (a == b) { return 0; }
    tk_field_save(f, 0);
    tk_field_remove(f, a, b);
    tk_field_changed(ui, i);
    return 1;
}

// A key for focused field i, with no Ctrl, Alt or Super: 1 if it took it.
fn tk_field_key(ui: *tk_ui, i: u32, code: u32, ch: u32, held: u32) -> u32 {
    let f: *tk_field = &ui.field[ui.node[i].field];
    let extend: u32 = 0;
    if ((held & KEYMOD_SHIFT) != 0) { extend = 1; }
    let a: u32 = 0; let b: u32 = 0;
    tk_field_sel(f, &a, &b);
    if (code == KC_LEFT) {
        if (extend == 0 && a != b) { tk_field_move(ui, i, a, 0); }
        else { tk_field_move(ui, i, tk_field_prev(f, f.caret), extend); }
        return 1;
    }
    if (code == KC_RIGHT) {
        if (extend == 0 && a != b) { tk_field_move(ui, i, b, 0); }
        else { tk_field_move(ui, i, tk_field_next(f, f.caret), extend); }
        return 1;
    }
    if (code == KC_HOME) { tk_field_move(ui, i, 0, extend); return 1; }
    if (code == KC_END) { tk_field_move(ui, i, f.len, extend); return 1; }
    if (code == KC_BACKSPACE) { tk_field_delete(ui, i, tk_field_prev(f, f.caret), f.caret); return 1; }
    if (code == KC_DELETE) { tk_field_delete(ui, i, f.caret, tk_field_next(f, f.caret)); return 1; }
    if (ch >= 0x20 && ch != 0x7F && (ch < 0x80 || ch > 0x9F) && ch < 0x110000) {
        tk_field_insert_cp(ui, i, ch);
        return 1;
    }
    return 0;
}

// Copy the selection to ui.clip and ask for it to go to the clipboard: 1 if
// there was one.
fn tk_field_copy(ui: *tk_ui, f: *tk_field) -> u32 {
    let a: u32 = 0; let b: u32 = 0;
    tk_field_sel(f, &a, &b);
    if (a == b) { return 0; }
    memcpy(&ui.clip[0], &f.buf[a], b - a);
    ui.clip_n = b - a;
    ui.clip_want = TK_CLIP_SET;
    return 1;
}

// Swap the text with what undo kept.
fn tk_field_swap(f: *tk_field) -> void {
    let t: [256]u8;
    let tn: u32 = f.len;
    let tc: u32 = f.caret;
    memcpy(&t[0], &f.buf[0], f.len);
    memcpy(&f.buf[0], &f.undo[0], f.undo_len);
    f.len = f.undo_len;
    f.buf[f.len] = 0;
    f.caret = f.undo_caret; f.anchor = f.caret;
    memcpy(&f.undo[0], &t[0], tn);
    f.undo_len = tn;
    f.undo_caret = tc;
    f.typing = 0;
}

// A standard command, done to field i.
fn tk_field_command(ui: *tk_ui, i: u32, cmd: u32) -> void {
    let f: *tk_field = &ui.field[ui.node[i].field];
    if (cmd == TK_CMD_COPY) { tk_field_copy(ui, f); return; }
    if (cmd == TK_CMD_CUT) {
        if (tk_field_copy(ui, f) == 1) { tk_field_delete(ui, i, 0, 0); }
        return;
    }
    // the clipboard is read only here, for a paste (CX_TOOLKIT.md §9)
    if (cmd == TK_CMD_PASTE) { ui.clip_want = TK_CLIP_GET; return; }
    if (cmd == TK_CMD_SELECT_ALL) { f.anchor = 0; f.caret = f.len; f.typing = 0; tk_damage_node(ui, i); return; }
    if (cmd == TK_CMD_UNDO && f.has_undo == 1 && f.redo == 0) { tk_field_swap(f); f.redo = 1; tk_field_changed(ui, i); return; }
    if (cmd == TK_CMD_REDO && f.redo == 1) { tk_field_swap(f); f.redo = 0; tk_field_changed(ui, i); return; }
}

// What the clipboard had, for the paste asked for (TK_CLIP_GET): put in the
// focused field. Line breaks and tabs become spaces; other control
// characters and bytes that are not UTF-8 are left out. The bytes inserted.
fn tk_paste_text(ui: *tk_ui, s: *u8, n: u32) -> u32 {
    let i: u32 = ui.focus;
    if (i == TK_NONE || ui.node[i].kind != TK_TEXTFIELD) { return 0; }
    let t: [256]u8;
    let tn: u32 = 0;
    let at: u32 = 0;
    while (at < n && tn < TK_FIELD_BYTES) {
        let cp: u32 = 0;
        let l: u32 = tk_utf8_at(s, n, at, &cp);
        if (l == 0) { at = at + 1; continue; }
        at = at + l;
        if (cp == 9 || cp == 10 || cp == 13) { cp = 32; }
        if (cp < 0x20 || cp == 0x7F || (cp >= 0x80 && cp <= 0x9F)) { continue; }
        if (tn + l > TK_FIELD_BYTES) { break; }
        tn = tn + tk_utf8_put(cp, &t[tn]);
    }
    return tk_field_insert(ui, i, &t[0], tn, 0);
}

// What the window holder is asked to do with the clipboard (TK_CLIP_*),
// once: the ask is cleared.
fn tk_clip_take(ui: *tk_ui) -> u32 {
    let w: u32 = ui.clip_want;
    ui.clip_want = TK_CLIP_NONE;
    return w;
}

// A field's text (UTF-8, terminated), or 0 for an id that is not one.
fn tk_field_text(ui: *tk_ui, id: u32) -> *u8 {
    let i: u32 = tk_index(ui, id);
    if (i == TK_NONE || ui.node[i].kind != TK_TEXTFIELD) { return 0 as *u8; }
    return &ui.field[ui.node[i].field].buf[0];
}

// A field's selection, as byte offsets: 0, or E_INVALID_ARGS.
fn tk_field_selection(ui: *tk_ui, id: u32, a: *u32, b: *u32) -> i32 {
    let i: u32 = tk_index(ui, id);
    if (i == TK_NONE || ui.node[i].kind != TK_TEXTFIELD) { return E_INVALID_ARGS; }
    tk_field_sel(&ui.field[ui.node[i].field], a, b);
    return 0;
}

// Set a field's text (it must be UTF-8 and fit): 0, or E_INVALID_ARGS.
// The caret goes to the end; undo forgets.
fn tk_set_field_text(ui: *tk_ui, id: u32, text: *u8) -> i32 {
    let i: u32 = tk_index(ui, id);
    if (i == TK_NONE || ui.node[i].kind != TK_TEXTFIELD || text == (0 as *u8)) { return E_INVALID_ARGS; }
    let n: u32 = strlen(text);
    if (n > TK_FIELD_BYTES) { return E_INVALID_ARGS; }
    let at: u32 = 0;
    while (at < n) {
        let cp: u32 = 0;
        let l: u32 = tk_utf8_at(text, n, at, &cp);
        if (l == 0) { return E_INVALID_ARGS; }
        at = at + l;
    }
    let f: *tk_field = &ui.field[ui.node[i].field];
    memcpy(&f.buf[0], text, n);
    f.len = n; f.buf[n] = 0;
    f.caret = n; f.anchor = n; f.scroll = 0;
    f.has_undo = 0; f.redo = 0; f.typing = 0; f.dead = 0;
    tk_damage_node(ui, i);
    return 0;
}

// ---- input methods: they see a field's keys first (CX_TOOLKIT.md §9) ----

// The method for every field: TK_IM_*. 0, or E_INVALID_ARGS.
fn tk_set_im(ui: *tk_ui, im: u32) -> i32 {
    if (im > TK_IM_DEAD) { return E_INVALID_ARGS; }
    ui.im = im;
    let k: u32 = 0;
    while (k < ui.field_n) {
        if (ui.field[k].dead != 0) { ui.field[k].dead = 0; tk_damage_node(ui, ui.field[k].node); }
        k = k + 1;
    }
    return 0;
}

// The five dead keys (Haiku's keymaps have the same five).
fn tk_is_accent(ch: u32) -> u32 {
    if (ch == 39 || ch == 96 || ch == 94 || ch == 126 || ch == 34) { return 1; }
    return 0;
}

// An accent on a letter, as one Latin-1 character, or 0 if there is none.
fn tk_compose(accent: u32, base: u32) -> u32 {
    let upper: u32 = 0;
    let l: u32 = base;
    if (base >= 65 && base <= 90) { upper = 1; l = base + 32; }
    let c: u32 = 0;
    if (accent == 39) {
        if (l == 97) { c = 0xE1; } if (l == 101) { c = 0xE9; } if (l == 105) { c = 0xED; }
        if (l == 111) { c = 0xF3; } if (l == 117) { c = 0xFA; } if (l == 121) { c = 0xFD; }
        if (l == 99) { c = 0xE7; }
    }
    if (accent == 96) {
        if (l == 97) { c = 0xE0; } if (l == 101) { c = 0xE8; } if (l == 105) { c = 0xEC; }
        if (l == 111) { c = 0xF2; } if (l == 117) { c = 0xF9; }
    }
    if (accent == 94) {
        if (l == 97) { c = 0xE2; } if (l == 101) { c = 0xEA; } if (l == 105) { c = 0xEE; }
        if (l == 111) { c = 0xF4; } if (l == 117) { c = 0xFB; }
    }
    if (accent == 126) {
        if (l == 97) { c = 0xE3; } if (l == 111) { c = 0xF5; } if (l == 110) { c = 0xF1; }
    }
    if (accent == 34) {
        if (l == 97) { c = 0xE4; } if (l == 101) { c = 0xEB; } if (l == 105) { c = 0xEF; }
        if (l == 111) { c = 0xF6; } if (l == 117) { c = 0xFC; } if (l == 121) { c = 0xFF; }
    }
    if (c == 0 || upper == 0) { return c; }
    if (c == 0xFF) { return 0; }       // no capital y with diaeresis in Latin-1
    return c - 32;
}

// The method's look at a key for field i: 1 if it took it. The dead-key
// method holds an accent (shown underlined at the caret) until the next
// key: a letter it goes on becomes the one character; Space or the same
// accent again gives the accent; Esc or Backspace drops it; anything else
// gives the accent and then is itself.
fn tk_im_key(ui: *tk_ui, i: u32, code: u32, ch: u32, held: u32) -> u32 {
    if (ui.im != TK_IM_DEAD) { return 0; }
    if ((code >= KC_LCTRL && code <= KC_RSUPER) || code == KC_CAPS || code == KC_NUMLOCK) { return 0; }
    let f: *tk_field = &ui.field[ui.node[i].field];
    if (f.dead == 0) {
        if ((held & TK_MODS_CAS) == 0 && tk_is_accent(ch) == 1) {
            f.dead = ch;
            tk_damage_node(ui, i);
            return 1;
        }
        return 0;
    }
    let acc: u32 = f.dead;
    f.dead = 0;
    tk_damage_node(ui, i);
    if (code == KC_ESC || code == KC_BACKSPACE) { return 1; }
    if ((held & TK_MODS_CAS) != 0 || ch == 0) { tk_field_insert_cp(ui, i, acc); return 0; }
    if (ch == 32 || ch == acc) { tk_field_insert_cp(ui, i, acc); return 1; }
    let c: u32 = tk_compose(acc, ch);
    if (c != 0) { tk_field_insert_cp(ui, i, c); return 1; }
    tk_field_insert_cp(ui, i, acc);
    if (tk_is_accent(ch) == 1) { f.dead = ch; return 1; }
    tk_field_insert_cp(ui, i, ch);
    return 1;
}

// The character offset under device x in field i.
fn tk_field_at(ui: *tk_ui, i: u32, x: i32) -> u32 {
    let n: *tk_node = &ui.node[i];
    let f: *tk_field = &ui.field[n.field];
    let tx: i32 = 0; let ty: i32 = 0; let cap: u32 = 1;
    tk_field_geom(ui, n, &tx, &ty, &cap);
    let cw: i32 = tk_imax(tk_char_w(ui) as i32, 1);
    let col: u32 = f.scroll;
    if (x > tx) { col = col + (((x - tx) + cw / 2) / cw) as u32; }
    let at: u32 = 0;
    let k: u32 = 0;
    while (k < col && at < f.len) { at = tk_field_next(f, at); k = k + 1; }
    return at;
}

// The widget that takes input under device (x, y): the last drawn wins.
fn tk_hit(ui: *tk_ui, i: u32, x: i32, y: i32) -> u32 {
    if (tk_shown(ui, i) == 0) { return TK_NONE; }
    let n: *tk_node = &ui.node[i];
    if (x < (n.dx as i32) || y < (n.dy as i32) || x >= ((n.dx + n.dw) as i32) || y >= ((n.dy + n.dh) as i32)) { return TK_NONE; }
    let found: u32 = TK_NONE;
    if (tk_takes_input(n.kind) == 1 && (n.flags & TK_F_DISABLED) == 0) { found = i; }
    let c: u32 = n.first;
    while (c != TK_NONE) {
        let h: u32 = tk_hit(ui, c, x, y);
        if (h != TK_NONE) { found = h; }
        c = ui.node[c].next;
    }
    return found;
}

fn tk_set_bit(ui: *tk_ui, i: u32, f: u32, on: u32) -> void {
    if (i == TK_NONE) { return; }
    let old: u32 = ui.node[i].flags;
    let nf: u32 = old & ~f;
    if (on == 1) { nf = nf | f; }
    if (nf == old) { return; }
    ui.node[i].flags = nf;
    tk_damage_node(ui, i);
}

// The pointer, in device pixels of the canvas, with its buttons (bit 0 the
// left). A press captures the widget under it; it is pressed only if the
// button comes up over that widget still.
fn tk_pointer(ui: *tk_ui, x: i32, y: i32, buttons: u32) -> void {
    let hit: u32 = tk_hit(ui, ui.root, x, y);
    if (ui.capture == TK_NONE && hit != ui.hover) {
        tk_set_bit(ui, ui.hover, TK_F_HOVER, 0);
        ui.hover = hit;
        tk_set_bit(ui, hit, TK_F_HOVER, 1);
    }
    let was: u32 = ui.buttons & 1;
    let now: u32 = buttons & 1;
    ui.buttons = buttons;
    if (was == 0 && now == 1 && hit != TK_NONE) {
        ui.capture = hit;
        tk_set_bit(ui, hit, TK_F_PRESSED, 1);
        tk_focus_set(ui, hit);
        if (ui.node[hit].kind == TK_SLIDER) { tk_slider_to(ui, hit, tk_slider_at(ui, hit, x)); }
        if (ui.node[hit].kind == TK_TEXTFIELD) {
            // the caret where it was pressed; a drag selects from there
            ui.field[ui.node[hit].field].dead = 0;
            tk_field_move(ui, hit, tk_field_at(ui, hit, x), 0);
        }
        return;
    }
    let cap: u32 = ui.capture;
    if (cap == TK_NONE) { return; }
    if (now == 1) {
        if (ui.node[cap].kind == TK_SLIDER) { tk_slider_to(ui, cap, tk_slider_at(ui, cap, x)); }
        if (ui.node[cap].kind == TK_TEXTFIELD) { tk_field_move(ui, cap, tk_field_at(ui, cap, x), 1); }
        // pressed only while over itself
        let over: u32 = 0;
        if (hit == cap) { over = 1; }
        tk_set_bit(ui, cap, TK_F_PRESSED, over);
        return;
    }
    // released
    ui.capture = TK_NONE;
    tk_set_bit(ui, cap, TK_F_PRESSED, 0);
    if (hit == cap && ui.node[cap].kind != TK_SLIDER) { tk_activate(ui, cap); }
    if (hit != ui.hover) {
        tk_set_bit(ui, ui.hover, TK_F_HOVER, 0);
        ui.hover = hit;
        tk_set_bit(ui, hit, TK_F_HOVER, 1);
    }
}

// ---- for tests and the gallery's witness ----

// FNV-1a over a surface's pixels, row by row.
fn tk_surface_hash(s: *ds_surface) -> u32 {
    let h: u32 = 2166136261;
    let y: u32 = 0;
    while (y < s.height) {
        let row: *u32 = ds_row(s, y);
        let x: u32 = 0;
        while (x < s.width) {
            // a pixel per step, not a byte: four times the speed, and only
            // ever compared with itself
            h = (h ^ row[x]) * 16777619;
            x = x + 1;
        }
        y = y + 1;
    }
    return h;
}

// Is every node's device box inside its parent's? 1 if so.
fn tk_boxes_nest(ui: *tk_ui) -> u32 {
    let k: u32 = 0;
    while (k < ui.used) {
        let n: *tk_node = &ui.node[k];
        if (n.parent != TK_NONE && tk_shown(ui, k) == 1) {
            let p: *tk_node = &ui.node[n.parent];
            if (n.dw > 0 && n.dh > 0) {
                if (n.dx < p.dx || n.dy < p.dy || n.dx + n.dw > p.dx + p.dw || n.dy + n.dh > p.dy + p.dh) { return 0; }
            }
        }
        k = k + 1;
    }
    return 1;
}

// A node's device box, by id: 0, or E_INVALID_ARGS.
fn tk_box_of(ui: *tk_ui, id: u32, r: *ds_rect) -> i32 {
    let i: u32 = tk_index(ui, id);
    if (i == TK_NONE) { return E_INVALID_ARGS; }
    ds_rect_set(r, ui.node[i].dx, ui.node[i].dy, ui.node[i].dw, ui.node[i].dh);
    return 0;
}
