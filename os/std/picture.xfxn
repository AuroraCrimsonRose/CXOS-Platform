// SPDX-FileCopyrightText: 2026 Aurora Tejeda (trading as CATX Systems)
// std/picture.xfxn - pictures: the QOI reader, and the desktop's background.
// Aurora Tejeda / CATX Systems
//
// The OS reads one picture format, QOI (qoiformat.org, specification 1.0):
// lossless, and its reader is the six cases in pic_qoi_decode. Photographs
// are converted on the host, at build time (`cxk picture build`: a baseline
// JPEG scaled down to just cover a 1920x1080 screen), so nothing here parses
// a real codec's input. Every count in a file is checked before it is used.
//
// The background is painted once into the display server's desktop surface
// (pic_background), scaled to cover the screen and cropped to its middle.
// The compositor copies from that surface afterwards, so a window moving
// over it costs the copy of what it uncovered, never a rescale.

import "display.xfxn";
import "file.xfxn";

const PIC_QOI_HEADER: u32 = 14;
const PIC_QOI_END: u32 = 8;
const PIC_SIDE_MAX: u32 = 8192;              // a side longer than this is refused
const PIC_FILE_MAX: u32 = 33554432;          // 32 MiB: a file larger is refused unread
const PIC_SCREEN_MAX: u32 = 4096;            // pic_cover's column table

global pic_cx0: [4096]u32;
global pic_cf: [4096]u32;

fn pic_be32(p: *u8) -> u32 {
    return ((p[0] as u32) << 24) | ((p[1] as u32) << 16) | ((p[2] as u32) << 8) | (p[3] as u32);
}

// A QOI header at p (n bytes): its size into w and h, 0 or E_CORRUPT.
fn pic_qoi_size(p: *u8, n: u32, w: *u32, h: *u32) -> i32 {
    if (n < PIC_QOI_HEADER + PIC_QOI_END) { return E_CORRUPT; }
    if (p[0] != 113 || p[1] != 111 || p[2] != 105 || p[3] != 102) { return E_CORRUPT; }   // "qoif"
    let ww: u32 = pic_be32(&p[4]);
    let hh: u32 = pic_be32(&p[8]);
    if (ww == 0 || hh == 0 || ww > PIC_SIDE_MAX || hh > PIC_SIDE_MAX) { return E_CORRUPT; }
    if ((p[12] != 3 && p[12] != 4) || p[13] > 1) { return E_CORRUPT; }
    w[0] = ww; h[0] = hh;
    return 0;
}

// Decode the QOI at p (n bytes) into out, w * h opaque pixels, which the
// caller sized from pic_qoi_size. 0, or E_CORRUPT for a stream that ends
// early or lacks its end marker; alpha is read and dropped.
fn pic_qoi_decode(p: *u8, n: u32, out: *u32) -> i32 {
    let w: u32 = 0;
    let h: u32 = 0;
    let rc: i32 = pic_qoi_size(p, n, &w, &h);
    if (rc != 0) { return rc; }
    let index: [64]u32;
    memzero((&index[0]) as *u8, 256);
    let r: u32 = 0;
    let g: u32 = 0;
    let b: u32 = 0;
    let a: u32 = 255;
    let at: u32 = PIC_QOI_HEADER;
    let limit: u32 = n - PIC_QOI_END;
    let run: u32 = 0;
    let total: u32 = w * h;
    let i: u32 = 0;
    while (i < total) {
        if (run > 0) {
            run = run - 1;
        } else {
            if (at >= limit) { return E_CORRUPT; }
            let op: u32 = p[at] as u32;
            at = at + 1;
            if (op == 0xFE) {
                if (at + 3 > limit) { return E_CORRUPT; }
                r = p[at] as u32; g = p[at + 1] as u32; b = p[at + 2] as u32;
                at = at + 3;
            } else if (op == 0xFF) {
                if (at + 4 > limit) { return E_CORRUPT; }
                r = p[at] as u32; g = p[at + 1] as u32; b = p[at + 2] as u32; a = p[at + 3] as u32;
                at = at + 4;
            } else if ((op & 0xC0) == 0x00) {
                let v: u32 = index[op];
                r = (v >> 24) & 255; g = (v >> 16) & 255; b = (v >> 8) & 255; a = v & 255;
            } else if ((op & 0xC0) == 0x40) {
                r = (r + ((op >> 4) & 3) + 254) & 255;
                g = (g + ((op >> 2) & 3) + 254) & 255;
                b = (b + (op & 3) + 254) & 255;
            } else if ((op & 0xC0) == 0x80) {
                if (at + 1 > limit) { return E_CORRUPT; }
                let x: u32 = p[at] as u32;
                at = at + 1;
                let dg: u32 = (op & 63) + 224;               // dg - 32, mod 256
                r = (r + dg + ((x >> 4) & 15) + 248) & 255;  // + dg + (dr-dg) - 8
                g = (g + dg) & 255;
                b = (b + dg + (x & 15) + 248) & 255;
            } else {
                run = op & 63;
            }
            index[(r * 3 + g * 5 + b * 7 + a * 11) % 64] = (r << 24) | (g << 16) | (b << 8) | a;
        }
        out[i] = 0xFF000000 | (r << 16) | (g << 8) | b;
        i = i + 1;
    }
    let k: u32 = 0;
    while (k < 7) { if (p[limit + k] != 0) { return E_CORRUPT; } k = k + 1; }
    if (p[limit + 7] != 1) { return E_CORRUPT; }
    return 0;
}

// a and b mixed, f/256 of b: both opaque, so the channels are mixed as two
// pairs without unpacking them.
fn pic_mix(a: u32, b: u32, f: u32) -> u32 {
    let rb: u32 = (((a & 0xFF00FF) * (256 - f) + (b & 0xFF00FF) * f) >> 8) & 0xFF00FF;
    let g: u32 = (((a & 0x00FF00) * (256 - f) + (b & 0x00FF00) * f) >> 8) & 0x00FF00;
    return 0xFF000000 | rb | g;
}

// Fill s from a sw x sh picture so that it covers s, aspect kept, cropped to
// the middle, filtered bilinearly. E_INVALID_ARGS for a surface wider than
// PIC_SCREEN_MAX.
fn pic_cover(s: *ds_surface, src: *u32, sw: u32, sh: u32) -> i32 {
    if (s.width == 0 || s.height == 0 || s.width > PIC_SCREEN_MAX || sw == 0 || sh == 0) { return E_INVALID_ARGS; }
    // The part of the picture that is shown: all of one side, the other
    // cropped to the screen's shape.
    let cw: u64 = sw as u64;
    let ch: u64 = sh as u64;
    if ((s.width as u64) * (sh as u64) >= (s.height as u64) * (sw as u64)) {
        ch = (sw as u64) * (s.height as u64) / (s.width as u64);
    } else {
        cw = (sh as u64) * (s.width as u64) / (s.height as u64);
    }
    if (cw == 0) { cw = 1; }
    if (ch == 0) { ch = 1; }
    let ox: u64 = ((sw as u64) - cw) * 65536 / 2;
    let oy: u64 = ((sh as u64) - ch) * 65536 / 2;
    let stepx: u64 = cw * 65536 / (s.width as u64);
    let stepy: u64 = ch * 65536 / (s.height as u64);
    let maxx: u64 = ((sw as u64) - 1) * 65536;
    let maxy: u64 = ((sh as u64) - 1) * 65536;
    // A pixel's centre maps to a centre: ox + (x + 1/2) * step - 1/2.
    let x: u32 = 0;
    while (x < s.width) {
        let fx: u64 = ox + (x as u64) * stepx + stepx / 2;
        if (fx >= 32768) { fx = fx - 32768; } else { fx = 0; }
        if (fx > maxx) { fx = maxx; }
        pic_cx0[x] = (fx >> 16) as u32;
        pic_cf[x] = ((fx >> 8) & 255) as u32;
        x = x + 1;
    }
    let y: u32 = 0;
    while (y < s.height) {
        let fy: u64 = oy + (y as u64) * stepy + stepy / 2;
        if (fy >= 32768) { fy = fy - 32768; } else { fy = 0; }
        if (fy > maxy) { fy = maxy; }
        let y0: u32 = (fy >> 16) as u32;
        let y1: u32 = y0 + 1;
        if (y1 >= sh) { y1 = sh - 1; }
        let wy: u32 = ((fy >> 8) & 255) as u32;
        let top: *u32 = &src[y0 * sw];
        let bot: *u32 = &src[y1 * sw];
        let row: *u32 = ds_row(s, y);
        x = 0;
        while (x < s.width) {
            let x0: u32 = pic_cx0[x];
            let x1: u32 = x0 + 1;
            if (x1 >= sw) { x1 = sw - 1; }
            let wx: u32 = pic_cf[x];
            row[x] = pic_mix(pic_mix(top[x0], top[x1], wx), pic_mix(bot[x0], bot[x1], wx), wy);
            x = x + 1;
        }
        y = y + 1;
    }
    return 0;
}

// The background when there is no picture: a vertical gradient with a faint
// grid every 32 pixels, opaque: blue over red everywhere, which the
// kernel's display server test tells from background 1 by (ktest_loader.c).
fn pic_gradient(s: *ds_surface) -> void {
    let y: u32 = 0;
    while (y < s.height) {
        let t: u32 = (y * 255) / s.height;
        let r: u32 = 0x20 + (t * 0x20) / 255;
        let g: u32 = 0x30 + (t * 0x30) / 255;
        let b: u32 = 0x48 + (t * 0x38) / 255;
        let c: u32 = 0xFF000000 | (r << 16) | (g << 8) | b;
        ds_fill(s, 0, y, s.width, 1, c);
        if (y % 32 == 0) { ds_fill(s, 0, y, s.width, 1, 0xFF2A3A54); }
        y = y + 1;
    }
    let x: u32 = 0;
    while (x < s.width) { ds_fill(s, x, 0, 1, s.height, 0xFF2A3A54); x = x + 32; }
}

// Paint the QOI picture at path over all of s. 0, or an error with s
// untouched: E_NOT_FOUND and the like from the file, E_CORRUPT for a file
// that is not a whole QOI, E_NO_MEMORY.
fn pic_load_cover(s: *ds_surface, path: *u8) -> i32 {
    let size: i64 = file_size(path);
    if (size < 0) { return size as i32; }
    if (size < (PIC_QOI_HEADER + PIC_QOI_END) as i64 || size > PIC_FILE_MAX as i64) { return E_CORRUPT; }
    let n: u32 = size as u32;
    let faddr: u64 = 0;
    let fm: i32 = ds_mem(n as u64, &faddr);
    if (fm <= 0) { return fm; }
    let p: *u8 = faddr as *u8;
    let got: i32 = file_slurp(path, p, n);
    let rc: i32 = 0;
    let w: u32 = 0;
    let h: u32 = 0;
    if (got < 0) { rc = got; }
    else if ((got as u32) != n) { rc = E_CORRUPT; }
    else { rc = pic_qoi_size(p, n, &w, &h); }
    if (rc == 0) {
        let pix: ds_surface;
        rc = ds_surface_new(&pix, w, h);
        if (rc == 0) {
            rc = pic_qoi_decode(p, n, pix.px as *u32);
            if (rc == 0) { rc = pic_cover(s, pix.px as *u32, w, h); }
            ds_surface_free(&pix);
        }
    }
    vm_unmap(faddr, 0);
    handle_close(fm);
    return rc;
}

// The desktop's background: the picture at path, or the gradient when it is
// missing or broken. Returns what pic_load_cover did, so 0 means the picture.
fn pic_background(s: *ds_surface, path: *u8) -> i32 {
    let rc: i32 = pic_load_cover(s, path);
    if (rc != 0) { pic_gradient(s); }
    return rc;
}
