// std/gfx.xfxn - framebuffer drawing for CXK X.
// Aurora Tejeda / CATX Systems
//
//   import "gfx.xfxn";
//
// A thin, typed wrapper over the SYS_FB_* calls. Every call needs GRANT_FRAMEBUFFER, which
// is part of GRANT_OS_BASELINE - so the executive and the shell can draw, but a
// capability-less app cannot (it gets E_ACCESS_DENIED and must go through a broker).
//
// Colours are canonical 0x00RRGGBB; the kernel converts to the active mode, so
// nothing here needs to know whether the display is 16bpp or 32bpp.

type color = u32;               // 0x00RRGGBB

// ---- common colours ----
const BLACK:   color = 0;
const WHITE:   color = 16777215;      // 0xFFFFFF
const RED:     color = 16711680;      // 0xFF0000
const GREEN:   color = 65280;         // 0x00FF00
const BLUE:    color = 255;           // 0x0000FF
const YELLOW:  color = 16776960;      // 0xFFFF00
const CYAN:    color = 65535;         // 0x00FFFF
const MAGENTA: color = 16711935;      // 0xFF00FF
const GREY:    color = 8421504;       // 0x808080

// build a colour from components
fn rgb(r: u32, g: u32, b: u32) -> color {
    return ((r & 255) << 16) | ((g & 255) << 8) | (b & 255);
}

// ---- drawing: one syscall each ----

fn gfx_clear(c: color) -> i32 {
    return fb_clear(c);
}

fn gfx_fill_rect(x: u32, y: u32, w: u32, h: u32, c: color) -> i32 {
    return fb_fill_rect(x, y, w, h, c);
}

fn gfx_pixel(x: u32, y: u32, c: color) -> i32 {
    return fb_put_pixel(x, y, c);
}

fn gfx_line(x0: u32, y0: u32, x1: u32, y1: u32, c: color) -> i32 {
    return fb_draw_line(x0, y0, x1, y1, c);
}

fn gfx_text(x: u32, y: u32, s: *u8, fg: color, bg: color) -> i32 {
    return fb_draw_text(x, y, s, fg, bg);
}

// ---- console font ----
// Install /System/Fonts/<name>.xfnt as the console font. `name` is a NAME, not
// a path: the kernel composes the path and reads the file itself, so a name
// carrying '/' or '.' is refused. Returns 0, or E_INVALID_ARGS / E_NOT_FOUND.
//
// The console's grid follows the font's cell, so a font of another size changes
// how many columns and rows fit the screen. The kernel clears on a successful
// change, because what is already drawn is the old size.
fn gfx_set_font(name: *u8) -> i32 {
    return fb_set_font(name);
}

// ---- geometry ----
// fills g with width, height, bpp, pitch; returns 0 on success
fn gfx_info(g: *fb_geometry) -> i32 {
    return fb_info(g);
}

fn gfx_width() -> u32 {
    let g: fb_geometry;
    if (gfx_info(&g) != 0) { return 0; }
    return g.width;
}

fn gfx_height() -> u32 {
    let g: fb_geometry;
    if (gfx_info(&g) != 0) { return 0; }
    return g.height;
}

// ---- a couple of conveniences ----

// outline rectangle (four filled 1px edges)
fn gfx_rect(x: u32, y: u32, w: u32, h: u32, c: color) -> void {
    gfx_fill_rect(x, y, w, 1, c);
    gfx_fill_rect(x, y + h - 1, w, 1, c);
    gfx_fill_rect(x, y, 1, h, c);
    gfx_fill_rect(x + w - 1, y, 1, h, c);
}

// fill the whole screen with a colour, then draw a centred title bar
fn gfx_panel(title: *u8, bg: color, bar: color, fg: color) -> void {
    gfx_clear(bg);
    gfx_fill_rect(0, 0, gfx_width(), 20, bar);
    gfx_text(8, 4, title, fg, bar);
}
