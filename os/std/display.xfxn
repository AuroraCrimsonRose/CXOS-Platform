// std/display.xfxn - the display server's software renderer (roadmap 2.3).
// Aurora Tejeda / CATX Systems
// Threads: one thread per compositor. Nothing here is locked.
//
//   import "display.xfxn";
//
// The parts of docs/system/CX_DISPLAY.md section 4 that need no windows yet:
//
//   SURFACES   - pixels in RAM, 32 bits of premultiplied alpha, 0xAARRGGBB,
//                each a memory object of its own so it can be shared later.
//                The one pixel format the protocol has (section 9);
//                converted only when written to the screen.
//   DAMAGE     - the rectangles that changed since the last frame, clipped to
//                the screen, overlapping ones merged, collapsed to their
//                bounding box when there are more than DS_DAMAGE_MAX.
//   COMPOSITOR - layers bottom to top, each a surface at a position, opaque or
//                blended (source-over, premultiplied). It redraws only the
//                damage, into a back buffer in RAM, starting at the topmost
//                opaque layer that covers a rectangle whole: what lies under
//                it is never drawn.
//   SCREENS    - where a frame goes: the real one (SYS_SCREEN_OPEN, which
//                needs GRANT_FRAMEBUFFER) or a VIRTUAL one, a memory object of
//                the same layout, for tests and CI. Presenting converts the
//                back buffer's damaged rectangles to the screen's format and
//                writes them; nothing ever reads the real screen, which on the
//                rig is uncached and slow to read (kernel/drivers/video/fb.c).
//
// Serenity's WindowServer is the model (Compositor::compose: damage into a
// back buffer, then flush only the damage; its opaque and transparent
// regions kept apart so hidden content is skipped). Rectangles are on the
// screen and unsigned; a layer's position is signed, since an animation can
// take it off any edge. A layer also has an opacity, a 2x2 transform and a
// clip (std/scene.xfxn makes those from a tree). Sampling is nearest-neighbour:
// the software renderer's quality.

import "mem.xfxn";
import "string.xfxn";
import "virtiogpu.xfxn";

// ---- rectangles ----

struct ds_rect {
    x: u32,
    y: u32,
    w: u32,
    h: u32
}

fn ds_rect_set(r: *ds_rect, x: u32, y: u32, w: u32, h: u32) -> void {
    r.x = x; r.y = y; r.w = w; r.h = h;
}

fn ds_min(a: u32, b: u32) -> u32 { if (a < b) { return a; } return b; }
fn ds_max(a: u32, b: u32) -> u32 { if (a > b) { return a; } return b; }

// Clip r to a w x h area: 1 if anything is left, else 0 (and r is empty).
fn ds_rect_clip(r: *ds_rect, w: u32, h: u32) -> u32 {
    if (r.w == 0 || r.h == 0 || r.x >= w || r.y >= h) { r.w = 0; r.h = 0; return 0; }
    if (r.w > w - r.x) { r.w = w - r.x; }
    if (r.h > h - r.y) { r.h = h - r.y; }
    return 1;
}

// out = a's overlap with b: 1 if they overlap, else 0 (and out is empty).
fn ds_rect_and(out: *ds_rect, a: *ds_rect, b: *ds_rect) -> u32 {
    let x0: u32 = ds_max(a.x, b.x);
    let y0: u32 = ds_max(a.y, b.y);
    let x1: u32 = ds_min(a.x + a.w, b.x + b.w);
    let y1: u32 = ds_min(a.y + a.h, b.y + b.h);
    if (x1 <= x0 || y1 <= y0) { ds_rect_set(out, 0, 0, 0, 0); return 0; }
    ds_rect_set(out, x0, y0, x1 - x0, y1 - y0);
    return 1;
}

// Do a and b overlap or share an edge? Touching ones merge too: their union
// wastes nothing.
fn ds_rect_meets(a: *ds_rect, b: *ds_rect) -> u32 {
    if (a.x + a.w < b.x || b.x + b.w < a.x) { return 0; }
    if (a.y + a.h < b.y || b.y + b.h < a.y) { return 0; }
    return 1;
}

// a becomes the smallest rectangle holding a and b.
fn ds_rect_grow(a: *ds_rect, b: *ds_rect) -> void {
    let x0: u32 = ds_min(a.x, b.x);
    let y0: u32 = ds_min(a.y, b.y);
    let x1: u32 = ds_max(a.x + a.w, b.x + b.w);
    let y1: u32 = ds_max(a.y + a.h, b.y + b.h);
    ds_rect_set(a, x0, y0, x1 - x0, y1 - y0);
}

// Does a hold b whole?
fn ds_rect_holds(a: *ds_rect, b: *ds_rect) -> u32 {
    if (b.x < a.x || b.y < a.y) { return 0; }
    if (b.x + b.w > a.x + a.w || b.y + b.h > a.y + a.h) { return 0; }
    return 1;
}

// ---- damage ----

const DS_DAMAGE_MAX: u32 = 8;

struct ds_damage {
    n: u32,
    width: u32,         // the screen's: every rectangle is clipped to it
    height: u32,
    r: [8]ds_rect       // DS_DAMAGE_MAX; no two overlap or touch
}

fn ds_damage_init(d: *ds_damage, width: u32, height: u32) -> void {
    d.n = 0; d.width = width; d.height = height;
}

fn ds_damage_clear(d: *ds_damage) -> void { d.n = 0; }

// The whole screen.
fn ds_damage_all(d: *ds_damage) -> void {
    ds_rect_set(&d.r[0], 0, 0, d.width, d.height);
    d.n = 1;
    if (d.width == 0 || d.height == 0) { d.n = 0; }
}

// Remove entry i, keeping the rest in order.
fn ds_damage_drop(d: *ds_damage, i: u32) -> void {
    while (i + 1 < d.n) {
        ds_rect_set(&d.r[i], d.r[i + 1].x, d.r[i + 1].y, d.r[i + 1].w, d.r[i + 1].h);
        i = i + 1;
    }
    d.n = d.n - 1;
}

// Add a changed rectangle. Clipped to the screen; one already covered adds
// nothing; one that meets others swallows them, again and again until it
// meets none; past DS_DAMAGE_MAX everything becomes one bounding box.
fn ds_damage_add(d: *ds_damage, x: u32, y: u32, w: u32, h: u32) -> void {
    let nr: ds_rect;
    ds_rect_set(&nr, x, y, w, h);
    if (ds_rect_clip(&nr, d.width, d.height) == 0) { return; }
    let merged: u32 = 1;
    while (merged == 1) {
        merged = 0;
        let i: u32 = 0;
        while (i < d.n) {
            if (ds_rect_holds(&d.r[i], &nr) == 1) { return; }
            if (ds_rect_meets(&d.r[i], &nr) == 1) {
                ds_rect_grow(&nr, &d.r[i]);
                ds_damage_drop(d, i);
                merged = 1;
            } else {
                i = i + 1;
            }
        }
    }
    if (d.n == DS_DAMAGE_MAX) {
        let i: u32 = 0;
        while (i < d.n) { ds_rect_grow(&nr, &d.r[i]); i = i + 1; }
        d.n = 0;
    }
    ds_rect_set(&d.r[d.n], nr.x, nr.y, nr.w, nr.h);
    d.n = d.n + 1;
}

// Pixels the damage covers (no two of its rectangles overlap).
fn ds_damage_area(d: *ds_damage) -> u64 {
    let a: u64 = 0;
    let i: u32 = 0;
    while (i < d.n) { a = a + (d.r[i].w as u64) * (d.r[i].h as u64); i = i + 1; }
    return a;
}

// ---- memory for pixels ----

// A memory object of `bytes`, mapped read-write: its handle, with the address
// in *addr, or an error (and nothing left behind).
fn ds_mem(bytes: u64, addr: *u64) -> i32 {
    let m: i32 = mem_create(bytes, 0);
    if (m <= 0) { return m; }
    let a: vm_map_args;
    memzero((&a) as *u8, sizeof a);
    a.object = m as u32;
    a.length = bytes;
    a.prot = MPROT_READ | MPROT_WRITE;
    let rc: i32 = vm_map(&a);
    if (rc != E_OK) { handle_close(m); return rc; }
    addr[0] = a.addr;
    return m;
}

// ---- surfaces ----

struct ds_surface {
    px: u64,        // the first pixel's address
    width: u32,
    height: u32,
    stride: u32,    // pixels from one row to the next
    mem: i32        // its memory object
}

// A width x height surface, every pixel 0 (transparent): 0 or an error.
fn ds_surface_new(s: *ds_surface, width: u32, height: u32) -> i32 {
    s.px = 0; s.mem = -1; s.width = 0; s.height = 0; s.stride = 0;
    if (width == 0 || height == 0) { return E_INVALID_ARGS; }
    let addr: u64 = 0;
    let m: i32 = ds_mem((width as u64) * (height as u64) * 4, &addr);
    if (m <= 0) { return m; }
    s.px = addr; s.mem = m; s.width = width; s.height = height; s.stride = width;
    return 0;
}

fn ds_surface_free(s: *ds_surface) -> void {
    if (s.px != 0) { vm_unmap(s.px, 0); }
    if (s.mem > 0) { handle_close(s.mem); }
    s.px = 0; s.mem = -1;
}

fn ds_row(s: *ds_surface, y: u32) -> *u32 {
    return (s.px + (y as u64) * (s.stride as u64) * 4) as *u32;
}

fn ds_pixel(s: *ds_surface, x: u32, y: u32) -> u32 {
    if (x >= s.width || y >= s.height) { return 0; }
    let row: *u32 = ds_row(s, y);
    return row[x];
}

fn ds_put(s: *ds_surface, x: u32, y: u32, argb: u32) -> void {
    if (x >= s.width || y >= s.height) { return; }
    let row: *u32 = ds_row(s, y);
    row[x] = argb;
}

// Replace a rectangle's pixels with one value (premultiplied), clipped.
fn ds_fill(s: *ds_surface, x: u32, y: u32, w: u32, h: u32, argb: u32) -> void {
    let r: ds_rect;
    ds_rect_set(&r, x, y, w, h);
    if (ds_rect_clip(&r, s.width, s.height) == 0) { return; }
    let j: u32 = 0;
    while (j < r.h) {
        let row: *u32 = ds_row(s, r.y + j);
        let i: u32 = 0;
        while (i < r.w) { row[r.x + i] = argb; i = i + 1; }
        j = j + 1;
    }
}

// One channel of source-over: s + d * (255 - sa) / 255, rounded.
fn ds_over_ch(s: u32, d: u32, inv: u32) -> u32 {
    return s + (d * inv + 127) / 255;
}

// src over dst, both premultiplied 0xAARRGGBB.
fn ds_over(src: u32, dst: u32) -> u32 {
    let sa: u32 = src >> 24;
    if (sa == 255) { return src; }
    if (src == 0) { return dst; }
    let inv: u32 = 255 - sa;
    let a: u32 = ds_over_ch(sa, dst >> 24, inv);
    let r: u32 = ds_over_ch((src >> 16) & 255, (dst >> 16) & 255, inv);
    let g: u32 = ds_over_ch((src >> 8) & 255, (dst >> 8) & 255, inv);
    let b: u32 = ds_over_ch(src & 255, dst & 255, inv);
    return (a << 24) | (r << 16) | (g << 8) | b;
}

// A premultiplied pixel at an opacity of alpha/255.
fn ds_fade(p: u32, alpha: u32) -> u32 {
    if (alpha == 255) { return p; }
    let a: u32 = (((p >> 24) & 255) * alpha + 127) / 255;
    let r: u32 = (((p >> 16) & 255) * alpha + 127) / 255;
    let g: u32 = (((p >> 8) & 255) * alpha + 127) / 255;
    let b: u32 = ((p & 255) * alpha + 127) / 255;
    return (a << 24) | (r << 16) | (g << 8) | b;
}

// ---- text ----

// A bitmap font, as /System/Fonts holds them (kernel/lib/gfx/xfnt.h): rows
// most significant bit first, a glyph's index being its code in the file's
// first 256. 8 pixels wide at most.
struct ds_font {
    bits: *u8,
    width: u32,
    height: u32,
    count: u32
}

const DS_FONT_BYTES_MAX: u32 = 16384;

// Load one, every field checked against the file's length, as the kernel's
// reader does: 0 or an error.
fn ds_font_load(f: *ds_font, path: *u8) -> i32 {
    f.bits = 0 as *u8;
    let h: i32 = file_open(path, FOPEN_READ);
    if (h <= 0) { return h; }
    let addr: u64 = 0;
    let m: i32 = ds_mem(DS_FONT_BYTES_MAX as u64, &addr);
    if (m <= 0) { file_close(h); return m; }
    let p: *u8 = addr as *u8;
    let n: i32 = file_read(h, p, DS_FONT_BYTES_MAX as u64);
    file_close(h);
    if (n < 24 || p[0] != 88 || p[1] != 70 || p[2] != 78 || p[3] != 84) { return E_INVALID_ARGS; }
    let bpr: u32 = p[7] as u32;
    let width: u32 = p[8] as u32;
    let height: u32 = p[9] as u32;
    let count: u32 = (p[10] as u32) | ((p[11] as u32) << 8);
    if (p[6] != 1 || bpr != 1 || width == 0 || width > 8 || height == 0 || height > 32) { return E_INVALID_ARGS; }
    if (count == 0 || count > 256 || 24 + count * height > (n as u32)) { return E_INVALID_ARGS; }
    f.bits = (addr + 24) as *u8;
    f.width = width; f.height = height; f.count = count;
    return 0;
}

// Text at (x, y) on a surface, set in one colour, stopping before `room`
// pixels are used and at the surface's edges.
fn ds_text(s: *ds_surface, f: *ds_font, x: u32, y: u32, room: u32, text: *u8, argb: u32) -> void {
    let at: u32 = 0;
    let i: u32 = 0;
    while (text[i] != 0 && at + f.width <= room) {
        let code: u32 = text[i] as u32;
        if (code < f.count) {
            let row: u32 = 0;
            while (row < f.height) {
                let bits: u32 = f.bits[code * f.height + row] as u32;
                let col: u32 = 0;
                while (col < f.width) {
                    if ((bits & (0x80 >> col)) != 0) { ds_put(s, x + at + col, y + row, argb); }
                    col = col + 1;
                }
                row = row + 1;
            }
        }
        at = at + f.width;
        i = i + 1;
    }
}

// ---- the compositor ----

const DS_LAYER_MAX: u32 = 128;
const DS_FX_ONE: i32 = 65536;       // 1.0 in a layer's matrix (Q16.16)
const DS_POS_MAX: i32 = 32767;      // the furthest a layer's position goes
const DS_M_MAX: i64 = 1048576;      // 16.0: the largest entry of a matrix
// A layer whose matrix has a determinant smaller than this (Q32.32: an area
// of 1/1024) has collapsed and is not drawn. With DS_M_MAX and DS_POS_MAX it
// is what keeps ds_draw_xf's products inside an i64.
const DS_DET_MIN: i64 = 4194304;

struct ds_layer {
    s: *ds_surface,
    x: i32,         // where the surface's top left lands
    y: i32,
    visible: u32,
    opaque: u32,    // 1: every pixel's alpha is 255, so what is under it is hidden
    alpha: u32,     // 0-255: the whole layer's opacity
    plain: u32,     // 1: the matrix is the identity
    anim: u32,      // 1: moving now, so each frame damages where it is
    a: i32,         // screen = (x, y) + [a b; c d] * surface, Q16.16
    b: i32,
    c: i32,
    d: i32,
    clip: ds_rect   // nothing is drawn outside this; on the screen
}

struct ds_comp {
    n: u32,
    back: ds_surface,   // the frame, in RAM; never read from the screen
    damage: ds_damage,
    l: [128]ds_layer    // DS_LAYER_MAX, bottom first
}

// A compositor for a width x height screen: 0 or an error.
fn ds_comp_init(c: *ds_comp, width: u32, height: u32) -> i32 {
    c.n = 0;
    ds_damage_init(&c.damage, width, height);
    return ds_surface_new(&c.back, width, height);
}

// A compositor whose back buffer is memory that is someone else's: a
// virtio-gpu's backing, which the device reads only when asked, so a frame
// half composed is never seen and there is no need of a second full screen.
fn ds_comp_on(c: *ds_comp, px: u64, width: u32, height: u32) -> void {
    c.n = 0;
    ds_damage_init(&c.damage, width, height);
    c.back.px = px; c.back.width = width; c.back.height = height;
    c.back.stride = width; c.back.mem = -1;
}

fn ds_comp_free(c: *ds_comp) -> void {
    if (c.back.mem > 0) { ds_surface_free(&c.back); }
    c.n = 0;
}

fn ds_lmin(a: i64, b: i64) -> i64 { if (a < b) { return a; } return b; }
fn ds_lmax(a: i64, b: i64) -> i64 { if (a > b) { return a; } return b; }

// The part of a layer's bounding box inside a width x height screen and its
// clip: 1, or 0 if nothing is (and r is empty). The box of a parallelogram is
// the sum of its edges' extents.
fn ds_extent(l: *ds_layer, width: u32, height: u32, r: *ds_rect) -> u32 {
    let sw: i64 = l.s.width as i64;
    let sh: i64 = l.s.height as i64;
    let x0: i64 = l.x as i64;
    let y0: i64 = l.y as i64;
    let x1: i64 = x0 + sw;
    let y1: i64 = y0 + sh;
    if (l.plain == 0) {
        let ax: i64 = (l.a as i64) * sw;
        let bx: i64 = (l.b as i64) * sh;
        let cy: i64 = (l.c as i64) * sw;
        let dy: i64 = (l.d as i64) * sh;
        x1 = x0 + ((ds_lmax(ax, 0) + ds_lmax(bx, 0) + 65535) >> 16);
        y1 = y0 + ((ds_lmax(cy, 0) + ds_lmax(dy, 0) + 65535) >> 16);
        x0 = x0 + ((ds_lmin(ax, 0) + ds_lmin(bx, 0)) >> 16);
        y0 = y0 + ((ds_lmin(cy, 0) + ds_lmin(dy, 0)) >> 16);
    }
    x0 = ds_lmax(x0, l.clip.x as i64);
    y0 = ds_lmax(y0, l.clip.y as i64);
    x1 = ds_lmin(x1, ds_lmin((l.clip.x as i64) + (l.clip.w as i64), width as i64));
    y1 = ds_lmin(y1, ds_lmin((l.clip.y as i64) + (l.clip.h as i64), height as i64));
    if (x1 <= x0 || y1 <= y0) { ds_rect_set(r, 0, 0, 0, 0); return 0; }
    ds_rect_set(r, x0 as u32, y0 as u32, (x1 - x0) as u32, (y1 - y0) as u32);
    return 1;
}

// A layer with a matrix, sampled at each pixel's centre through the inverse.
// r is inside dst, the layer's extent and whatever is being composed.
fn ds_draw_xf(dst: *ds_surface, l: *ds_layer, r: *ds_rect) -> void {
    let a: i64 = l.a as i64;
    let b: i64 = l.b as i64;
    let c: i64 = l.c as i64;
    let d: i64 = l.d as i64;
    let det: i64 = a * d - b * c;
    if (det > (0 - DS_DET_MIN) && det < DS_DET_MIN) { return; }
    let ia: i64 = (d << 32) / det;
    let ib: i64 = (0 - (b << 32)) / det;
    let ic: i64 = (0 - (c << 32)) / det;
    let id: i64 = (a << 32) / det;
    let sw: i64 = l.s.width as i64;
    let sh: i64 = l.s.height as i64;
    let copy: u32 = 0;
    if (l.opaque == 1 && l.alpha == 255) { copy = 1; }
    let j: u32 = 0;
    while (j < r.h) {
        let row: *u32 = ds_row(dst, r.y + j);
        let dx: i64 = (((r.x as i64) - (l.x as i64)) << 16) + 32768;
        let dy: i64 = ((((r.y + j) as i64) - (l.y as i64)) << 16) + 32768;
        let u: i64 = (ia * dx + ib * dy) >> 16;
        let v: i64 = (ic * dx + id * dy) >> 16;
        let i: u32 = 0;
        while (i < r.w) {
            let su: i64 = u >> 16;
            let sv: i64 = v >> 16;
            if (su >= 0 && su < sw && sv >= 0 && sv < sh) {
                let from: *u32 = ds_row(l.s, sv as u32);
                let p: u32 = from[su as u32];
                if (copy == 1) { row[r.x + i] = p; }
                else { row[r.x + i] = ds_over(ds_fade(p, l.alpha), row[r.x + i]); }
            }
            u = u + ia;
            v = v + ic;
            i = i + 1;
        }
        j = j + 1;
    }
}

// The part of a layer that falls in `clip` (which is inside dst): copied if
// it is solid, else blended over what is there.
fn ds_draw(dst: *ds_surface, l: *ds_layer, clip: *ds_rect) -> void {
    let e: ds_rect;
    let r: ds_rect;
    if (l.alpha == 0 || ds_extent(l, dst.width, dst.height, &e) == 0) { return; }
    if (ds_rect_and(&r, &e, clip) == 0) { return; }
    if (l.plain == 0) { ds_draw_xf(dst, l, &r); return; }
    let ox: u32 = ((r.x as i64) - (l.x as i64)) as u32;
    let oy: u32 = ((r.y as i64) - (l.y as i64)) as u32;
    let copy: u32 = 0;
    if (l.opaque == 1 && l.alpha == 255) { copy = 1; }
    let j: u32 = 0;
    while (j < r.h) {
        let d: *u32 = ds_row(dst, r.y + j);
        let s: *u32 = ds_row(l.s, oy + j);
        let i: u32 = 0;
        if (copy == 1) {
            while (i < r.w) { d[r.x + i] = s[ox + i]; i = i + 1; }
        } else if (l.alpha == 255) {
            while (i < r.w) { d[r.x + i] = ds_over(s[ox + i], d[r.x + i]); i = i + 1; }
        } else {
            while (i < r.w) { d[r.x + i] = ds_over(ds_fade(s[ox + i], l.alpha), d[r.x + i]); i = i + 1; }
        }
        j = j + 1;
    }
}

// Rebuilding the stack: no layers, then ds_layer_put bottom up. Neither
// damages anything; whoever changed the stack knows what that changed.
fn ds_layers_clear(c: *ds_comp) -> void { c.n = 0; }

// Solid or blended, full opacity, no transform, clipped only by the screen:
// its index, or DS_LAYER_MAX when full.
fn ds_layer_put(c: *ds_comp, s: *ds_surface, x: i32, y: i32, opaque: u32) -> u32 {
    if (c.n >= DS_LAYER_MAX) { return DS_LAYER_MAX; }
    let i: u32 = c.n;
    let l: *ds_layer = &c.l[i];
    l.s = s; l.x = x; l.y = y; l.visible = 1; l.opaque = opaque;
    l.alpha = 255; l.plain = 1; l.anim = 0;
    l.a = DS_FX_ONE; l.b = 0; l.c = 0; l.d = DS_FX_ONE;
    ds_rect_set(&l.clip, 0, 0, c.damage.width, c.damage.height);
    c.n = c.n + 1;
    return i;
}

fn ds_layer_damage(c: *ds_comp, i: u32) -> void {
    if (c.l[i].visible != 1) { return; }
    let e: ds_rect;
    if (ds_extent(&c.l[i], c.back.width, c.back.height, &e) == 1) {
        ds_damage_add(&c.damage, e.x, e.y, e.w, e.h);
    }
}

// A layer on top of the rest: its index, or DS_LAYER_MAX when full. Its
// area is damaged.
fn ds_layer_add(c: *ds_comp, s: *ds_surface, x: i32, y: i32, opaque: u32) -> u32 {
    let i: u32 = ds_layer_put(c, s, x, y, opaque);
    if (i < DS_LAYER_MAX) { ds_layer_damage(c, i); }
    return i;
}

// Move a layer: where it was and where it is are both damaged.
fn ds_layer_move(c: *ds_comp, i: u32, x: i32, y: i32) -> void {
    if (i >= c.n) { return; }
    if (c.l[i].x == x && c.l[i].y == y) { return; }
    ds_layer_damage(c, i);
    c.l[i].x = x; c.l[i].y = y;
    ds_layer_damage(c, i);
}

fn ds_layer_show(c: *ds_comp, i: u32, visible: u32) -> void {
    if (i >= c.n || c.l[i].visible == visible) { return; }
    ds_layer_damage(c, i);
    c.l[i].visible = visible;
    ds_layer_damage(c, i);
}

// Does layer i hide all of r? Only a solid layer at full opacity, square to
// the screen, whose clip lets all of r through.
fn ds_layer_hides(c: *ds_comp, i: u32, r: *ds_rect) -> u32 {
    let l: *ds_layer = &c.l[i];
    if (l.visible != 1 || l.opaque != 1 || l.alpha != 255 || l.plain != 1) { return 0; }
    if (ds_rect_holds(&l.clip, r) == 0) { return 0; }
    if ((l.x as i64) > (r.x as i64) || (l.y as i64) > (r.y as i64)) { return 0; }
    if ((l.x as i64) + (l.s.width as i64) < (r.x as i64) + (r.w as i64)) { return 0; }
    if ((l.y as i64) + (l.s.height as i64) < (r.y as i64) + (r.h as i64)) { return 0; }
    return 1;
}

// One damaged rectangle into the back buffer: from the topmost layer that
// hides it whole (none: from transparent black), up.
fn ds_compose_rect(c: *ds_comp, r: *ds_rect) -> void {
    let first: u32 = 0;
    let k: u32 = c.n;
    while (k > 0) {
        k = k - 1;
        if (ds_layer_hides(c, k, r) == 1) { first = k; k = 0; }
    }
    if (first == 0 && (c.n == 0 || ds_layer_hides(c, 0, r) == 0)) {
        ds_fill(&c.back, r.x, r.y, r.w, r.h, 0);
    }
    let i: u32 = first;
    while (i < c.n) {
        if (c.l[i].visible == 1) { ds_draw(&c.back, &c.l[i], r); }
        i = i + 1;
    }
}

// Every damaged rectangle into the back buffer. The damage stays, for
// ds_present; clear it after.
fn ds_compose(c: *ds_comp) -> void {
    let i: u32 = 0;
    while (i < c.damage.n) { ds_compose_rect(c, &c.damage.r[i]); i = i + 1; }
}

// ---- screens ----

struct ds_screen {
    px: u64,        // the first pixel's address, mapped
    width: u32,
    height: u32,
    pitch: u32,     // bytes from one row to the next
    bpp: u32,
    format: u32,    // SCREEN_*
    size: u32,      // bytes mapped
    mem: i32,       // the memory object: the screen's, or a virtual one's
    gpu: *vgpu      // a virtio-gpu display, which shows only what it is sent; or 0
}

fn ds_screen_clear(sc: *ds_screen) -> void {
    sc.px = 0; sc.width = 0; sc.height = 0; sc.pitch = 0; sc.bpp = 0;
    sc.format = 0; sc.size = 0; sc.mem = -1; sc.gpu = 0 as *vgpu;
}

// The real screen, mapped: 0 or an error (E_ACCESS_DENIED without
// GRANT_FRAMEBUFFER, E_BUSY while another display server holds it,
// E_NOT_FOUND in VGA text mode). While it is open the kernel's console no
// longer reaches the screen; ds_screen_close gives it back.
fn ds_screen_open(sc: *ds_screen) -> i32 {
    ds_screen_clear(sc);
    let info: screen_info;
    memzero((&info) as *u8, sizeof info);
    let m: i32 = screen_open(&info);
    if (m <= 0) { return m; }
    if (info.format != SCREEN_RGB565 && info.format != SCREEN_XRGB8888) {
        handle_close(m);
        return E_NOT_SUPPORTED;
    }
    let a: vm_map_args;
    memzero((&a) as *u8, sizeof a);
    a.object = m as u32;
    a.length = info.size as u64;
    a.prot = MPROT_READ | MPROT_WRITE;
    let rc: i32 = vm_map(&a);
    if (rc != E_OK) { handle_close(m); return rc; }
    sc.px = a.addr; sc.width = info.width; sc.height = info.height;
    sc.pitch = info.pitch; sc.bpp = info.bpp; sc.format = info.format;
    sc.size = info.size; sc.mem = m;
    return 0;
}

// The machine's virtio-gpu display, in place of the real screen: `g` is the
// driver's state, which the screen keeps until ds_screen_close. 0 or an error
// (E_ACCESS_DENIED without GRANT_DRIVER, E_NOT_FOUND on a machine with none).
// The kernel's console stays where it was, on the screen the firmware set up.
fn ds_screen_gpu(sc: *ds_screen, g: *vgpu) -> i32 {
    ds_screen_clear(sc);
    let rc: i32 = vgpu_open_first(g);
    if (rc != 0) { return rc; }
    rc = vgpu_show(g, g.mode_w, g.mode_h);
    if (rc != 0) { vgpu_close(g); return rc; }
    sc.px = g.px; sc.width = g.width; sc.height = g.height; sc.pitch = g.pitch;
    sc.bpp = 32; sc.format = SCREEN_XRGB8888; sc.size = g.size; sc.gpu = g;
    return 0;
}

// A virtual screen, laid out as a real one would be: 0 or an error.
fn ds_screen_virtual(sc: *ds_screen, width: u32, height: u32, format: u32) -> i32 {
    ds_screen_clear(sc);
    let bpp: u32 = 32;
    if (format == SCREEN_RGB565) { bpp = 16; }
    else if (format != SCREEN_XRGB8888) { return E_INVALID_ARGS; }
    if (width == 0 || height == 0) { return E_INVALID_ARGS; }
    let pitch: u32 = ((width * (bpp / 8)) + 3) & 0xFFFFFFFC;
    let size: u32 = ((pitch * height) + 4095) & 0xFFFFF000;
    let addr: u64 = 0;
    let m: i32 = ds_mem(size as u64, &addr);
    if (m <= 0) { return m; }
    sc.px = addr; sc.width = width; sc.height = height; sc.pitch = pitch;
    sc.bpp = bpp; sc.format = format; sc.size = size; sc.mem = m;
    return 0;
}

// Unmapped and closed: the real screen goes back to the kernel.
fn ds_screen_close(sc: *ds_screen) -> void {
    if (sc.gpu != 0 as *vgpu) { vgpu_close(sc.gpu); ds_screen_clear(sc); return; }
    if (sc.px != 0) { vm_unmap(sc.px, 0); }
    if (sc.mem > 0) { handle_close(sc.mem); }
    ds_screen_clear(sc);
}

// A premultiplied pixel as the screen stores it. The frame is composed over
// an opaque bottom layer, so its alpha is dropped, not divided out.
fn ds_pack(format: u32, argb: u32) -> u32 {
    if (format == SCREEN_XRGB8888) { return argb & 0x00FFFFFF; }
    let r: u32 = (argb >> 19) & 31;
    let g: u32 = (argb >> 10) & 63;
    let b: u32 = (argb >> 3) & 31;
    return (r << 11) | (g << 5) | b;
}

// The back buffer's rectangle r, onto the screen. r is inside both.
fn ds_present_rect(sc: *ds_screen, back: *ds_surface, r: *ds_rect) -> void {
    let j: u32 = 0;
    while (j < r.h) {
        let s: *u32 = ds_row(back, r.y + j);
        let at: u64 = sc.px + ((r.y + j) as u64) * (sc.pitch as u64);
        let i: u32 = 0;
        if (sc.format == SCREEN_XRGB8888) {
            let d: *u32 = (at + (r.x as u64) * 4) as *u32;
            while (i < r.w) { d[i] = s[r.x + i] & 0x00FFFFFF; i = i + 1; }
        } else {
            let d: *u16 = (at + (r.x as u64) * 2) as *u16;
            while (i < r.w) { d[i] = ds_pack(SCREEN_RGB565, s[r.x + i]) as u16; i = i + 1; }
        }
        j = j + 1;
    }
}

// The compositor's damage, onto the screen, and the damage cleared: the
// pixels written. Only what changed is written.
fn ds_present(c: *ds_comp, sc: *ds_screen) -> u64 {
    let n: u64 = 0;
    let i: u32 = 0;
    while (i < c.damage.n) {
        let r: ds_rect;
        ds_rect_set(&r, c.damage.r[i].x, c.damage.r[i].y, c.damage.r[i].w, c.damage.r[i].h);
        if (ds_rect_clip(&r, ds_min(sc.width, c.back.width), ds_min(sc.height, c.back.height)) == 1) {
            if (sc.px != c.back.px) { ds_present_rect(sc, &c.back, &r); }
            // A device that stops answering loses the picture, not the server.
            if (sc.gpu != 0 as *vgpu) { vgpu_update(sc.gpu, r.x, r.y, r.w, r.h); }
            n = n + (r.w as u64) * (r.h as u64);
        }
        i = i + 1;
    }
    ds_damage_clear(&c.damage);
    return n;
}

// The pixel at (x, y) as the screen holds it, 0 off the screen. For virtual
// screens: reading the real one is slow, and nothing needs to.
fn ds_screen_pixel(sc: *ds_screen, x: u32, y: u32) -> u32 {
    if (x >= sc.width || y >= sc.height) { return 0; }
    let at: u64 = sc.px + (y as u64) * (sc.pitch as u64);
    if (sc.format == SCREEN_XRGB8888) {
        let d: *u32 = (at + (x as u64) * 4) as *u32;
        return d[0];
    }
    let h: *u16 = (at + (x as u64) * 2) as *u16;
    return h[0] as u32;
}

// FNV-1a over the frame's visible bytes, row by row (not the padding past a
// row's last pixel): a reference image's fingerprint, for virtual screens.
fn ds_screen_hash(sc: *ds_screen) -> u32 {
    let h: u32 = 2166136261;
    let row_bytes: u32 = sc.width * (sc.bpp / 8);
    let y: u32 = 0;
    while (y < sc.height) {
        let b: *u8 = (sc.px + (y as u64) * (sc.pitch as u64)) as *u8;
        let i: u32 = 0;
        while (i < row_bytes) { h = (h ^ (b[i] as u32)) * 16777619; i = i + 1; }
        y = y + 1;
    }
    return h;
}
