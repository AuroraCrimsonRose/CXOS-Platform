// std/locale.xfxn - XSTR string tables: checking, lookup, formatting and
// CLDR's plural rules (system/CX_TOOLKIT.md §10).
// Aurora Tejeda / CATX Systems
// Threads: any thread; a table is read-only once lc_parse accepted it.
//
//   import "locale.xfxn";
//
//   let t: lc_table;
//   if (lc_parse(&t, bytes, n) as usize != 0) { ...refused... }
//   let a: [1]lc_arg;
//   lc_arg_num(&a[0], "count", 3);
//   lc_format(&t, &english, "files-left", &a[0], 1, out, cap);
//
// A table is what `cxk strings build` writes (devkit/CXEX.Build/Locale/Xstr.cs,
// whose Read makes these same checks, refusal for refusal): a 40-byte header,
// records sorted by key, the messages as small programs (text, variable,
// select on a plural category or an integer) and the locale's cardinal
// plural rules, compiled from CLDR so no parser runs here. lc_parse copies
// the bytes first and checks the copy, so a table shared with another
// process cannot change between the check and the use.
//
// Lookup falls back: the locale's table, then the English one, then the key
// itself, so a missing translation shows English and a missing key shows
// its name; neither shows nothing.

const LC_VERSION: u32 = 1;           // XSTR's version (versions.json "xstr")
const LC_MAGIC: u32 = 0x52545358;    // 'X','S','T','R'
const LC_TABLE_MAX: u32 = 16384;
const LC_HEADER: u32 = 40;
const LC_RECORD: u32 = 12;
const LC_TAG: u32 = 16;
const LC_KEY_MAX: u32 = 64;
const LC_NAME_MAX: u32 = 32;
const LC_DEPTH: u32 = 4;
const LC_FLAG_RTL: u32 = 1;
const LC_NONE: u32 = 0xFFFFFFFF;

const LC_OP_TEXT: u8 = 1;
const LC_OP_VAR: u8 = 2;
const LC_OP_SELECT: u8 = 3;
const LC_OP_REL: u8 = 0x52;          // 'R' operand8 mod32 neg8 count8 (lo32 hi32)*
const LC_OP_OR: u8 = 0x4F;           // 'O'

// CLDR's plural categories, as the tables number them
const LC_ZERO: u32 = 0;
const LC_ONE: u32 = 1;
const LC_TWO: u32 = 2;
const LC_FEW: u32 = 3;
const LC_MANY: u32 = 4;
const LC_OTHER: u32 = 5;

struct lc_table {
    size: u32,           // 0: no table
    count: u32,
    plurals: u32,        // the plural block's offset
    rtl: u32,
    tag: [16]u8,         // NUL-terminated
    buf: [16384]u8,      // LC_TABLE_MAX
}

// a message's argument: a number, or text
struct lc_arg {
    name: *u8,
    text: *u8,           // 0 for a number
    num: i32,
}

fn lc_arg_num(a: *lc_arg, name: *u8, v: i32) -> void { a.name = name; a.text = 0 as *u8; a.num = v; }
fn lc_arg_text(a: *lc_arg, name: *u8, s: *u8) -> void { a.name = name; a.text = s; a.num = 0; }

fn lc_u16(p: *u8, at: u32) -> u32 { return (p[at] as u32) | ((p[at + 1] as u32) << 8); }
fn lc_u32(p: *u8, at: u32) -> u32 {
    return (p[at] as u32) | ((p[at + 1] as u32) << 8) | ((p[at + 2] as u32) << 16) | ((p[at + 3] as u32) << 24);
}

// ---- checking ----

fn lc_utf8_ok(s: *u8, n: u32) -> bool {
    let at: u32 = 0;
    while (at < n) {
        let b: u32 = s[at] as u32;
        if (b < 0x80) { at += 1; continue; }
        let len: u32 = 0;
        let lo: u32 = 0x80;
        let hi: u32 = 0xBF;
        if (b >= 0xC2 && b <= 0xDF) { len = 2; }
        else if (b >= 0xE0 && b <= 0xEF) { len = 3; if (b == 0xE0) { lo = 0xA0; } if (b == 0xED) { hi = 0x9F; } }
        else if (b >= 0xF0 && b <= 0xF4) { len = 4; if (b == 0xF0) { lo = 0x90; } if (b == 0xF4) { hi = 0x8F; } }
        else { return false; }
        if (len > n - at) { return false; }
        let k: u32 = 1;
        while (k < len) {
            let c: u32 = s[at + k] as u32;
            if (k == 1 && (c < lo || c > hi)) { return false; }
            if (c < 0x80 || c > 0xBF) { return false; }
            k += 1;
        }
        at += len;
    }
    return true;
}

// a pattern in p[at, end); the refusal, or 0
fn lc_check_pattern(p: *u8, at0: u32, end: u32, depth: u32) -> *u8 {
    if (depth > LC_DEPTH) { return "nested too deep"; }
    let at: u32 = at0;
    while (at < end) {
        let op: u8 = p[at];
        at += 1;
        if (op == LC_OP_TEXT) {
            if (end - at < 2) { return "a text's length"; }
            let n: u32 = lc_u16(p, at);
            at += 2;
            if (n > end - at || !lc_utf8_ok(&p[at], n)) { return "a text"; }
            at += n;
        } else if (op == LC_OP_VAR || op == LC_OP_SELECT) {
            if (at >= end) { return "a name's length"; }
            let n: u32 = p[at] as u32;
            at += 1;
            if (n == 0 || n > LC_NAME_MAX || n > end - at) { return "a name"; }
            at += n;
            if (op == LC_OP_VAR) { continue; }
            if (at >= end) { return "a select's count"; }
            let count: u32 = p[at] as u32;
            at += 1;
            let defaults: u32 = 0;
            let v: u32 = 0;
            while (v < count) {
                if (at >= end) { return "a variant"; }
                let kind: u8 = p[at];
                at += 1;
                if (kind == 0) { if (at >= end || (p[at] as u32) > LC_OTHER) { return "a category"; } at += 1; }
                else if (kind == 1) { if (end - at < 4) { return "an integer key"; } at += 4; }
                else { return "a variant's kind"; }
                if (end - at < 3 || p[at] > 1) { return "a variant's default"; }
                defaults += p[at] as u32;
                let bl: u32 = lc_u16(p, at + 1);
                at += 3;
                if (bl > end - at) { return "a variant's length"; }
                let why: *u8 = lc_check_pattern(p, at, at + bl, depth + 1);
                if (why as usize != 0) { return why; }
                at += bl;
                v += 1;
            }
            if (defaults != 1) { return "a select without exactly one default"; }
        } else { return "unknown op"; }
    }
    return 0 as *u8;
}

fn lc_check_program(p: *u8, at0: u32, end: u32) -> *u8 {
    let at: u32 = at0;
    while (at < end) {
        if (p[at] == LC_OP_OR) { at += 1; continue; }
        if (p[at] != LC_OP_REL || end - at < 8 || p[at + 1] > 7 || p[at + 6] > 1) { return "a plural relation"; }
        let n: u32 = p[at + 7] as u32;
        at += 8;
        if (8 * n > end - at) { return "a plural relation's ranges"; }
        at += 8 * n;
    }
    return 0 as *u8;
}

// a plural block (count8, then per rule cat8 len16 program) of n bytes; the refusal, or 0
fn lc_check_plurals(pb: *u8, n: u32) -> *u8 {
    if (n < 1) { return "no plural block"; }
    let count: u32 = pb[0] as u32;
    let at: u32 = 1;
    let r: u32 = 0;
    while (r < count) {
        if (n - at < 3 || (pb[at] as u32) >= LC_OTHER) { return "a plural rule's category"; }
        let len: u32 = lc_u16(pb, at + 1);
        at += 3;
        if (len > n - at) { return "a plural rule's length"; }
        let why: *u8 = lc_check_program(pb, at, at + len);
        if (why as usize != 0) { return why; }
        at += len;
        r += 1;
    }
    if (at != n) { return "bytes after the plural rules"; }
    return 0 as *u8;
}

// <0, 0 or >0 as a's n bytes sort before, with or after b's m (bytes, then length)
fn lc_cmp(a: *u8, n: u32, b: *u8, m: u32) -> i32 {
    let k: u32 = 0;
    while (k < n && k < m) {
        if (a[k] != b[k]) { if (a[k] < b[k]) { return -1; } return 1; }
        k += 1;
    }
    if (n < m) { return -1; }
    if (n > m) { return 1; }
    return 0;
}

// copies src[0..n] into t and checks the copy; 0 when t holds it, else the
// refusal (and t is left empty, size 0)
fn lc_parse(t: *lc_table, src: *u8, n: u32) -> *u8 {
    t.size = 0;
    if (n < LC_HEADER) { return "shorter than its header"; }
    if (n > LC_TABLE_MAX) { return "longer than 16384 bytes"; }
    let i: u32 = 0;
    while (i < n) { t.buf[i] = src[i]; i += 1; }
    let b: *u8 = &t.buf[0];
    if (lc_u32(b, 0) != LC_MAGIC) { return "magic"; }
    if (lc_u16(b, 4) != LC_VERSION) { return "version"; }
    let flags: u32 = lc_u16(b, 6);
    if ((flags & ~LC_FLAG_RTL) != 0) { return "unknown flags"; }
    let tl: u32 = 0;
    while (tl < LC_TAG && b[8 + tl] != 0) { tl += 1; }
    if (tl == 0 || tl == LC_TAG) { return "the tag"; }
    let k: u32 = tl;
    while (k < LC_TAG) { if (b[8 + k] != 0) { return "the tag's padding"; } k += 1; }
    let count: u32 = lc_u32(b, 24);
    let index: u32 = lc_u32(b, 28);
    let plurals: u32 = lc_u32(b, 32);
    let size: u32 = lc_u32(b, 36);
    if (size != n) { return "its size is not its length"; }
    if (index != LC_HEADER) { return "the index is not after the header"; }
    if (count > (size - LC_HEADER) / LC_RECORD) { return "more records than fit"; }
    let data: u32 = LC_HEADER + LC_RECORD * count;
    if (plurals < data || plurals > size) { return "the plural rules are out of place"; }
    let r: u32 = 0;
    let pk: u32 = 0;
    let pl: u32 = 0;
    while (r < count) {
        let at: u32 = LC_HEADER + LC_RECORD * r;
        let ko: u32 = lc_u32(b, at);
        let kl: u32 = lc_u16(b, at + 4);
        let bl: u32 = lc_u16(b, at + 6);
        let bo: u32 = lc_u32(b, at + 8);
        if (kl == 0 || kl > LC_KEY_MAX || ko < data || ko > plurals || kl > plurals - ko) { return "a record's key"; }
        if (bo < data || bo > plurals || bl > plurals - bo) { return "a record's body"; }
        if (r > 0 && lc_cmp(&b[pk], pl, &b[ko], kl) >= 0) { return "keys not strictly rising"; }
        pk = ko;
        pl = kl;
        let why: *u8 = lc_check_pattern(b, bo, bo + bl, 1);
        if (why as usize != 0) { return why; }
        if (!lc_utf8_ok(&b[ko], kl)) { return "a record's key is not UTF-8"; }
        r += 1;
    }
    let why: *u8 = lc_check_plurals(&b[plurals], size - plurals);
    if (why as usize != 0) { return why; }
    k = 0;
    while (k < LC_TAG) { t.tag[k] = b[8 + k]; k += 1; }
    t.count = count;
    t.plurals = plurals;
    t.rtl = flags & LC_FLAG_RTL;
    t.size = size;
    return 0 as *u8;
}

// ---- lookup ----

fn lc_strlen(s: *u8) -> u32 { let n: u32 = 0; while (s[n] != 0) { n += 1; } return n; }

// the record of key[0..kl], or LC_NONE (also for no table)
fn lc_find(t: *lc_table, key: *u8, kl: u32) -> u32 {
    if (t as usize == 0 || t.size == 0) { return LC_NONE; }
    let lo: u32 = 0;
    let hi: u32 = t.count;
    while (lo < hi) {
        let mid: u32 = (lo + hi) / 2;
        let at: u32 = LC_HEADER + LC_RECORD * mid;
        let c: i32 = lc_cmp(&t.buf[lc_u32(&t.buf[0], at)], lc_u16(&t.buf[0], at + 4), key, kl);
        if (c == 0) { return mid; }
        if (c < 0) { lo = mid + 1; } else { hi = mid; }
    }
    return LC_NONE;
}

fn lc_has(t: *lc_table, key: *u8) -> bool { return lc_find(t, key, lc_strlen(key)) != LC_NONE; }

// ---- plural rules ----

// the category of a whole number under a plural block (n = i = |v|; v, w, f,
// t, c and e are 0: CXOS's numbers are integers for now)
fn lc_plural_in(pb: *u8, value: u32) -> u32 {
    let count: u32 = pb[0] as u32;
    let at: u32 = 1;
    let r: u32 = 0;
    while (r < count) {
        let cat: u32 = pb[at] as u32;
        let len: u32 = lc_u16(pb, at + 1);
        at += 3;
        let end: u32 = at + len;
        let any: bool = false;
        let group: bool = true;
        let q: u32 = at;
        while (q < end) {
            if (pb[q] == LC_OP_OR) { if (group) { any = true; } group = true; q += 1; continue; }
            let operand: u32 = pb[q + 1] as u32;
            let mod: u32 = lc_u32(pb, q + 2);
            let neg: bool = pb[q + 6] != 0;
            let n: u32 = pb[q + 7] as u32;
            q += 8;
            let x: u32 = 0;
            if (operand <= 1) { x = value; }
            if (mod != 0) { x = x % mod; }
            let inside: bool = false;
            let k: u32 = 0;
            while (k < n) {
                if (x >= lc_u32(pb, q) && x <= lc_u32(pb, q + 4)) { inside = true; }
                q += 8;
                k += 1;
            }
            if (neg) { inside = !inside; }
            if (!inside) { group = false; }
        }
        if (any || group) { return cat; }
        at = end;
        r += 1;
    }
    return LC_OTHER;
}

fn lc_plural(t: *lc_table, v: i32) -> u32 {
    let a: u32 = v as u32;
    if (v < 0) { a = (0 - v) as u32; }
    return lc_plural_in(&t.buf[t.plurals], a);
}

// ---- formatting ----

struct lc_out { p: *u8, cap: u32, n: u32, full: bool }

// appends s[0..n], never past cap - 1 and never half a character
fn lc_put(o: *lc_out, s: *u8, n: u32) -> void {
    if (o.full) { return; }
    let k: u32 = 0;
    while (k < n && o.n + 1 < o.cap) { o.p[o.n] = s[k]; o.n += 1; k += 1; }
    if (k < n && (s[k] & 0xC0) == 0x80) {        // cut inside a character: drop its start
        while (o.n > 0 && (o.p[o.n - 1] & 0xC0) == 0x80) { o.n -= 1; }
        if (o.n > 0 && o.p[o.n - 1] >= 0xC0) { o.n -= 1; }
    }
    if (k < n) { o.full = true; }
}

fn lc_put_int(o: *lc_out, v: i32) -> void {
    let d: [12]u8;
    let n: u32 = 0;
    let a: u32 = v as u32;
    if (v < 0) { a = (0 - v) as u32; }
    while (true) { d[11 - n] = '0' + (a % 10) as u8; n += 1; a /= 10; if (a == 0) { break; } }
    if (v < 0) { d[11 - n] = '-'; n += 1; }
    lc_put(o, &d[12 - n], n);
}

fn lc_arg_of(args: *lc_arg, nargs: u32, name: *u8, nl: u32) -> u32 {
    let k: u32 = 0;
    while (k < nargs) {
        let s: *u8 = args[k].name;
        if (lc_cmp(s, lc_strlen(s), name, nl) == 0) { return k; }
        k += 1;
    }
    return LC_NONE;
}

fn lc_run(t: *lc_table, p: *u8, at0: u32, end: u32, args: *lc_arg, nargs: u32, o: *lc_out) -> void {
    let at: u32 = at0;
    while (at < end) {
        let op: u8 = p[at];
        at += 1;
        if (op == LC_OP_TEXT) {
            let n: u32 = lc_u16(p, at);
            lc_put(o, &p[at + 2], n);
            at += 2 + n;
            continue;
        }
        let nl: u32 = p[at] as u32;
        let name: *u8 = &p[at + 1];
        at += 1 + nl;
        let a: u32 = lc_arg_of(args, nargs, name, nl);
        if (op == LC_OP_VAR) {
            if (a == LC_NONE) { lc_put(o, "{$", 2); lc_put(o, name, nl); lc_put(o, "}", 1); }
            else if (args[a].text as usize != 0) { lc_put(o, args[a].text, lc_strlen(args[a].text)); }
            else { lc_put_int(o, args[a].num); }
            continue;
        }
        // a select: an integer key equal to the number, else its plural category, else the default
        let count: u32 = p[at] as u32;
        at += 1;
        let isnum: bool = a != LC_NONE && args[a].text as usize == 0;
        let cat: u32 = LC_NONE;
        if (isnum) { cat = lc_plural(t, args[a].num); }
        let pick_at: u32 = 0;
        let pick_len: u32 = 0;
        let pick_rank: u32 = 0;      // 3 exact, 2 category, 1 default
        let v: u32 = 0;
        while (v < count) {
            let kind: u8 = p[at];
            let rank: u32 = 0;
            if (kind == 0) {
                if (isnum && (p[at + 1] as u32) == cat) { rank = 2; }
                at += 2;
            } else {
                if (isnum && lc_u32(p, at + 1) == args[a].num as u32) { rank = 3; }
                at += 5;
            }
            if (rank == 0 && p[at] != 0) { rank = 1; }
            let bl: u32 = lc_u16(p, at + 1);
            at += 3;
            if (rank > pick_rank) { pick_rank = rank; pick_at = at; pick_len = bl; }
            at += bl;
            v += 1;
        }
        lc_run(t, p, pick_at, pick_at + pick_len, args, nargs, o);
    }
}

// key's message from t, else from fallback (either may be 0 or empty), else
// the key itself, into out (NUL-terminated, cut at a character); its length
fn lc_format(t: *lc_table, fallback: *lc_table, key: *u8, args: *lc_arg, nargs: u32, out: *u8, cap: u32) -> u32 {
    let o: lc_out;
    o.p = out;
    o.cap = cap;
    o.full = false;
    o.n = 0;
    if (cap == 0) { return 0; }
    let kl: u32 = lc_strlen(key);
    let tab: *lc_table = t;
    let r: u32 = lc_find(t, key, kl);
    if (r == LC_NONE) { tab = fallback; r = lc_find(fallback, key, kl); }
    if (r == LC_NONE) { lc_put(&o, key, kl); }
    else {
        let at: u32 = LC_HEADER + LC_RECORD * r;
        let b: *u8 = &tab.buf[0];
        let bo: u32 = lc_u32(b, at + 8);
        lc_run(tab, b, bo, bo + lc_u16(b, at + 6), args, nargs, &o);
    }
    out[o.n] = 0;
    return o.n;
}
