// std/xdata.xfxn - reading X Data, CXOS's configuration format.
// Aurora Tejeda / CATX SYSTEMS LLC
//
//   import "xdata.xfxn";
//
// The format is specified in docs/language/CX_X_DATA.md; this file implements it and
// should be read against it.
//
// ALLOCATES NOTHING AND IMPORTS NOTHING - not the allocator, not the prelude,
// not a syscall. A value is described by where it sits in the caller's buffer
// and nothing is copied until xd_str is asked for one. That keeps the reader
// usable before a heap exists, and it is what lets its tests run on the host.
//
// SHAPE. Everything rests on one routine, xd_value, that walks a value from
// its first byte and says where it ends - validating as it goes. Checking a
// document is walking it once. Looking up a key is walking a record's entries
// and skipping the values that are not wanted. There is no tree.
//
// Error state lives in the globals xd_err and xd_err_at. Every process today
// is single-threaded; that will need revisiting when threads exist.

// ---- kinds ----
const XD_NONE: u32 = 0;
const XD_STR:  u32 = 1;
const XD_INT:  u32 = 2;
const XD_BOOL: u32 = 3;
const XD_SYM:  u32 = 4;
const XD_LIST: u32 = 5;
const XD_REC:  u32 = 6;

// ---- results ----
const XD_OK:       i32 = 0;
const XD_E_SYNTAX: i32 = 0 - 1;   // a character that cannot start or continue what is expected
const XD_E_STRING: i32 = 0 - 2;   // unterminated string, raw newline inside one, unknown escape
const XD_E_DEPTH:  i32 = 0 - 3;   // nested deeper than XD_MAX_DEPTH
const XD_E_DUPKEY: i32 = 0 - 4;   // a key repeated in one record
const XD_E_SEP:    i32 = 0 - 5;   // two entries or items on one line with no comma
const XD_E_RANGE:  i32 = 0 - 6;   // an integer that does not fit the type asked for
const XD_E_TYPE:   i32 = 0 - 7;   // not the kind of value asked for
const XD_E_SPACE:  i32 = 0 - 8;   // the caller's buffer is too small

// A hostile file must not be able to exhaust the stack by nesting.
const XD_MAX_DEPTH: u32 = 32;

// Returned in place of a position when something went wrong; xd_err says what.
const XD_BAD: u32 = 0xFFFFFFFF;

// A value: its kind and where it is. For a list or record, at/len are the BODY
// - the text between the brackets - so iterating a braced record and the
// document's implied top-level one are the same operation.
struct xd_val { kind: u32, at: u32, len: u32, tag_at: u32, tag_len: u32 }

global xd_err: i32;
global xd_err_at: u32;

// Whether the last xd_skip crossed a line break - a line break separates
// entries as a comma does. Read immediately after the call that set it.
global xd_nl: u32;

// Filled by xd_entry: the key and value of the entry it just walked.
global xd_k_at: u32;
global xd_k_len: u32;
global xd_v_at: u32;
global xd_v_end: u32;

// ---- characters ----
// X has no character literals, so the bytes this cares about are named here.
const XC_TAB: u8 = 9;
const XC_LF: u8 = 10;
const XC_CR: u8 = 13;
const XC_SP: u8 = 32;
const XC_QUOTE: u8 = 34;
const XC_STAR: u8 = 42;
const XC_COMMA: u8 = 44;
const XC_MINUS: u8 = 45;
const XC_SLASH: u8 = 47;
const XC_EQ: u8 = 61;
const XC_LBRACK: u8 = 91;
const XC_BSLASH: u8 = 92;
const XC_RBRACK: u8 = 93;
const XC_UNDER: u8 = 95;
const XC_LBRACE: u8 = 123;
const XC_RBRACE: u8 = 125;

fn xd_fail(code: i32, at: u32) -> u32 {
    xd_err = code;
    xd_err_at = at;
    return XD_BAD;
}

fn xd_is_digit(c: u8) -> bool { return c >= 48 && c <= 57; }
fn xd_is_hex(c: u8) -> bool {
    return xd_is_digit(c) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102);
}
fn xd_is_ident_start(c: u8) -> bool {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == XC_UNDER;
}
fn xd_is_ident(c: u8) -> bool {
    return xd_is_ident_start(c) || xd_is_digit(c) || c == XC_MINUS;
}

fn xd_ident_end(s: *u8, p: u32, end: u32) -> u32 {
    while (p < end && xd_is_ident(s[p])) { p = p + 1; }
    return p;
}

// Does the text at [at, at+len) spell exactly the NUL-terminated `word`?
fn xd_spells(s: *u8, at: u32, len: u32, word: *u8) -> bool {
    let i: u32 = 0;
    while (i < len) {
        if (word[i] == 0) { return false; }
        if (s[at + i] != word[i]) { return false; }
        i = i + 1;
    }
    return word[len] == 0;
}

// Two spans of the same source spelling the same text.
fn xd_same(s: *u8, a: u32, alen: u32, b: u32, blen: u32) -> bool {
    if (alen != blen) { return false; }
    let i: u32 = 0;
    while (i < alen) {
        if (s[a + i] != s[b + i]) { return false; }
        i = i + 1;
    }
    return true;
}

// Skip whitespace and comments. Sets xd_nl if a line break was crossed.
// Returns the next significant position, or XD_BAD for an unterminated block
// comment.
fn xd_skip(s: *u8, p: u32, end: u32) -> u32 {
    xd_nl = 0;
    while (p < end) {
        let c: u8 = s[p];
        if (c == XC_LF) { xd_nl = 1; p = p + 1; continue; }
        if (c == XC_SP || c == XC_TAB || c == XC_CR) { p = p + 1; continue; }
        if (c == XC_SLASH && p + 1 < end) {
            if (s[p + 1] == XC_SLASH) {
                // to the line break, which the next pass sees and counts
                while (p < end && s[p] != XC_LF) { p = p + 1; }
                continue;
            }
            if (s[p + 1] == XC_STAR) {
                let q: u32 = p + 2;
                while (q + 1 < end && !(s[q] == XC_STAR && s[q + 1] == XC_SLASH)) {
                    if (s[q] == XC_LF) { xd_nl = 1; }
                    q = q + 1;
                }
                if (q + 1 >= end) { return xd_fail(XD_E_SYNTAX, p); }
                p = q + 2;
                continue;
            }
        }
        return p;
    }
    return p;
}

// A string starting at the quote at p. Returns the position past the closing
// quote. A raw line break inside is refused: a missing close quote then fails
// on the line it is missing from, instead of swallowing the rest of the file.
fn xd_string_end(s: *u8, p: u32, end: u32) -> u32 {
    let q: u32 = p + 1;
    while (q < end) {
        let c: u8 = s[q];
        if (c == XC_QUOTE) { return q + 1; }
        if (c == XC_LF) { return xd_fail(XD_E_STRING, q); }
        if (c == XC_BSLASH) {
            if (q + 1 >= end) { return xd_fail(XD_E_STRING, q); }
            let e: u8 = s[q + 1];
            // n t r 0 \ "
            if (!(e == 110 || e == 116 || e == 114 || e == 48 || e == XC_BSLASH || e == XC_QUOTE)) {
                return xd_fail(XD_E_STRING, q);
            }
            q = q + 2;
            continue;
        }
        q = q + 1;
    }
    return xd_fail(XD_E_STRING, p);
}

// An integer starting at p: optional '-', then decimal digits or 0x and hex
// digits, with '_' allowed between digits. Only the SHAPE is checked here -
// the range depends on the type the reader asks for, so it is checked there.
fn xd_int_end(s: *u8, p: u32, end: u32) -> u32 {
    let q: u32 = p;
    if (s[q] == XC_MINUS) { q = q + 1; }
    if (q >= end || !xd_is_digit(s[q])) { return xd_fail(XD_E_SYNTAX, p); }
    if (s[q] == 48 && q + 1 < end && (s[q + 1] == 120 || s[q + 1] == 88)) {   // 0x / 0X
        q = q + 2;
        if (q >= end || !xd_is_hex(s[q])) { return xd_fail(XD_E_SYNTAX, p); }
        while (q < end && (xd_is_hex(s[q]) || s[q] == XC_UNDER)) { q = q + 1; }
    } else {
        while (q < end && (xd_is_digit(s[q]) || s[q] == XC_UNDER)) { q = q + 1; }
    }
    // `12ab` is not a number followed by a name; it is a mistake
    if (q < end && xd_is_ident(s[q])) { return xd_fail(XD_E_SYNTAX, q); }
    return q;
}

// ---- the walk ----

// Entries from p to `end` (the body of a record, or a whole document). Returns
// `end`, or XD_BAD. `depth` is how deep this record sits.
fn xd_entries(s: *u8, p: u32, end: u32, depth: u32) -> u32 {
    if (depth > XD_MAX_DEPTH) { return xd_fail(XD_E_DEPTH, p); }
    let start: u32 = p;
    let first: u32 = 1;
    let sep: u32 = 0;
    while (true) {
        p = xd_skip(s, p, end);
        if (p == XD_BAD) { return XD_BAD; }
        if (xd_nl != 0) { sep = 1; }
        if (p >= end) { return end; }
        if (first == 0 && sep == 0) { return xd_fail(XD_E_SEP, p); }

        if (!xd_is_ident_start(s[p])) { return xd_fail(XD_E_SYNTAX, p); }
        let k: u32 = p;
        let ke: u32 = xd_ident_end(s, p, end);
        if (xd_find_key(s, start, k, k, ke - k) != 0) { return xd_fail(XD_E_DUPKEY, k); }

        p = xd_skip(s, ke, end);
        if (p == XD_BAD) { return XD_BAD; }
        if (p >= end || s[p] != XC_EQ) { return xd_fail(XD_E_SYNTAX, p); }
        p = xd_skip(s, p + 1, end);
        if (p == XD_BAD) { return XD_BAD; }
        p = xd_value(s, p, end, depth);
        if (p == XD_BAD) { return XD_BAD; }

        p = xd_skip(s, p, end);
        if (p == XD_BAD) { return XD_BAD; }
        sep = xd_nl;
        if (p < end && s[p] == XC_COMMA) { sep = 1; p = p + 1; }
        first = 0;
    }
    return end;
}

// Items from p to the ']' that closes the list. Returns the position past it.
fn xd_items(s: *u8, p: u32, end: u32, depth: u32) -> u32 {
    if (depth > XD_MAX_DEPTH) { return xd_fail(XD_E_DEPTH, p); }
    let first: u32 = 1;
    let sep: u32 = 0;
    while (true) {
        p = xd_skip(s, p, end);
        if (p == XD_BAD) { return XD_BAD; }
        if (xd_nl != 0) { sep = 1; }
        if (p >= end) { return xd_fail(XD_E_SYNTAX, p); }        // unterminated list
        if (s[p] == XC_RBRACK) { return p + 1; }
        if (first == 0 && sep == 0) { return xd_fail(XD_E_SEP, p); }
        p = xd_value(s, p, end, depth);
        if (p == XD_BAD) { return XD_BAD; }
        p = xd_skip(s, p, end);
        if (p == XD_BAD) { return XD_BAD; }
        sep = xd_nl;
        if (p < end && s[p] == XC_COMMA) { sep = 1; p = p + 1; }
        first = 0;
    }
    return XD_BAD;
}

// Where the '}' closing the record whose body starts at p sits. The body is
// walked as entries up to that brace, so this finds the brace by matching,
// honouring strings and comments, then validates what is between.
fn xd_close_brace(s: *u8, p: u32, end: u32) -> u32 {
    let level: u32 = 1;
    while (p < end) {
        let c: u8 = s[p];
        if (c == XC_QUOTE) {
            p = xd_string_end(s, p, end);
            if (p == XD_BAD) { return XD_BAD; }
            continue;
        }
        if (c == XC_SLASH && p + 1 < end && (s[p + 1] == XC_SLASH || s[p + 1] == XC_STAR)) {
            p = xd_skip(s, p, end);
            if (p == XD_BAD) { return XD_BAD; }
            continue;
        }
        if (c == XC_LBRACE) { level = level + 1; }
        if (c == XC_RBRACE) {
            level = level - 1;
            if (level == 0) { return p; }
        }
        p = p + 1;
    }
    return xd_fail(XD_E_SYNTAX, p);                              // unterminated record
}

// A value starting at p. Returns the position just past it, or XD_BAD.
fn xd_value(s: *u8, p: u32, end: u32, depth: u32) -> u32 {
    if (p >= end) { return xd_fail(XD_E_SYNTAX, p); }
    let c: u8 = s[p];
    if (c == XC_QUOTE) { return xd_string_end(s, p, end); }
    if (c == XC_LBRACK) { return xd_items(s, p + 1, end, depth + 1); }
    if (c == XC_LBRACE) { return xd_record(s, p + 1, end, depth + 1); }
    if (c == XC_MINUS || xd_is_digit(c)) { return xd_int_end(s, p, end); }
    if (xd_is_ident_start(c)) {
        let q: u32 = xd_ident_end(s, p, end);
        // A name followed by '{' ON THE SAME LINE is a tagged record. The
        // same-line rule is what keeps `[a` + newline + `{ ... }]` a symbol
        // then a record, rather than silently one tagged record.
        let r: u32 = xd_skip(s, q, end);
        if (r == XD_BAD) { return XD_BAD; }
        if (r < end && s[r] == XC_LBRACE && xd_nl == 0) { return xd_record(s, r + 1, end, depth + 1); }
        return q;
    }
    return xd_fail(XD_E_SYNTAX, p);
}

// A braced record whose body starts at p. Returns the position past its '}'.
fn xd_record(s: *u8, p: u32, end: u32, depth: u32) -> u32 {
    let close: u32 = xd_close_brace(s, p, end);
    if (close == XD_BAD) { return XD_BAD; }
    if (xd_entries(s, p, close, depth) == XD_BAD) { return XD_BAD; }
    return close + 1;
}

// Walk one entry of an ALREADY-CHECKED body, from p. Fills xd_k_* and xd_v_*
// and returns the position past the entry, or XD_BAD at the end of the body.
// The globals are written only after xd_value returns, because xd_value can
// re-enter this function for a nested record and would overwrite them.
fn xd_entry(s: *u8, p: u32, end: u32) -> u32 {
    p = xd_skip(s, p, end);
    if (p == XD_BAD || p >= end) { return XD_BAD; }
    let k: u32 = p;
    let ke: u32 = xd_ident_end(s, p, end);
    p = xd_skip(s, ke, end);
    p = xd_skip(s, p + 1, end);                    // past '='
    let v: u32 = p;
    let ve: u32 = xd_value(s, p, end, 0);
    xd_k_at = k; xd_k_len = ke - k; xd_v_at = v; xd_v_end = ve;
    p = xd_skip(s, ve, end);
    if (p < end && s[p] == XC_COMMA) { p = p + 1; }
    return p;
}

// Is the key [kat, kat+klen) already used between `from` and `upto`?
// Returns the entry's value position + 1 if so (so 0 means no).
fn xd_find_key(s: *u8, from: u32, upto: u32, kat: u32, klen: u32) -> u32 {
    let p: u32 = from;
    while (p < upto) {
        let n: u32 = xd_entry(s, p, upto);
        if (n == XD_BAD) { return 0; }
        if (xd_same(s, xd_k_at, xd_k_len, kat, klen)) { return xd_v_at + 1; }
        p = n;
    }
    return 0;
}

// ---- public: checking ----

// Validate a whole document. XD_OK, or an XD_E_* code with xd_err_at set to
// the byte offset where it went wrong. Must succeed before any other call.
fn xd_check(s: *u8, len: u32) -> i32 {
    xd_err = XD_OK;
    xd_err_at = 0;
    if (xd_entries(s, 0, len, 0) == XD_BAD) { return xd_err; }
    return XD_OK;
}

// ---- public: reporting ----

// A short description of an XD_E_* code, for a person reading a log.
fn xd_strerror(code: i32) -> *u8 {
    if (code == XD_OK)       { return "ok"; }
    if (code == XD_E_SYNTAX) { return "unexpected character"; }
    if (code == XD_E_STRING) { return "unterminated string, line break inside a string, or unknown escape"; }
    if (code == XD_E_DEPTH)  { return "nested too deeply"; }
    if (code == XD_E_DUPKEY) { return "key given more than once"; }
    if (code == XD_E_SEP)    { return "two entries on one line with no comma"; }
    if (code == XD_E_RANGE)  { return "number out of range"; }
    if (code == XD_E_TYPE)   { return "wrong kind of value"; }
    if (code == XD_E_SPACE)  { return "value too long"; }
    return "unknown error";
}

// The 1-based line that byte offset `at` falls on - xd_err_at turned into
// something a person can find in an editor.
fn xd_line(s: *u8, at: u32) -> u32 {
    let line: u32 = 1;
    let i: u32 = 0;
    while (i < at) {
        if (s[i] == XC_LF) { line = line + 1; }
        i = i + 1;
    }
    return line;
}

// ---- public: navigating ----

// Describe the value spanning [at, end) into out.
fn xd_describe(s: *u8, at: u32, end: u32, out: *xd_val) -> void {
    let c: u8 = s[at];
    out.tag_at = 0;
    out.tag_len = 0;
    out.at = at;
    out.len = end - at;
    if (c == XC_QUOTE) { out.kind = XD_STR; return; }
    if (c == XC_MINUS || xd_is_digit(c)) { out.kind = XD_INT; return; }
    if (c == XC_LBRACK) { out.kind = XD_LIST; out.at = at + 1; out.len = end - at - 2; return; }
    if (c == XC_LBRACE) { out.kind = XD_REC; out.at = at + 1; out.len = end - at - 2; return; }
    let q: u32 = xd_ident_end(s, at, end);
    if (q < end) {
        // a tagged record: the name, then the braced body
        let r: u32 = xd_skip(s, q, end);
        out.kind = XD_REC;
        out.tag_at = at;
        out.tag_len = q - at;
        out.at = r + 1;
        out.len = end - r - 2;
        return;
    }
    if (xd_spells(s, at, end - at, "true") || xd_spells(s, at, end - at, "false")) {
        out.kind = XD_BOOL;
        return;
    }
    out.kind = XD_SYM;
}

// The document's implied top-level record.
fn xd_root(s: *u8, len: u32, out: *xd_val) -> void {
    out.kind = XD_REC; out.at = 0; out.len = len; out.tag_at = 0; out.tag_len = 0;
}

// 1 and the value if `key` is an entry of `rec`, else 0.
fn xd_get(s: *u8, rec: *xd_val, key: *u8, out: *xd_val) -> i32 {
    if (rec.kind != XD_REC) { return 0; }
    let end: u32 = rec.at + rec.len;
    let p: u32 = rec.at;
    while (p < end) {
        let n: u32 = xd_entry(s, p, end);
        if (n == XD_BAD) { return 0; }
        if (xd_spells(s, xd_k_at, xd_k_len, key)) {
            xd_describe(s, xd_v_at, xd_v_end, out);
            return 1;
        }
        p = n;
    }
    return 0;
}

// 1 and the index'th entry of a record - its key as an XD_SYM span in `key`,
// its value in `val` - else 0 past the end. For a reader that has to see
// every key, which is how an unknown one (a misspelt `evry = 60`) is caught
// instead of silently ignored.
fn xd_entry_at(s: *u8, rec: *xd_val, index: u32, key: *xd_val, val: *xd_val) -> i32 {
    if (rec.kind != XD_REC) { return 0; }
    let end: u32 = rec.at + rec.len;
    let p: u32 = rec.at;
    let i: u32 = 0;
    while (p < end) {
        let n: u32 = xd_entry(s, p, end);
        if (n == XD_BAD) { return 0; }
        if (i == index) {
            key.kind = XD_SYM; key.at = xd_k_at; key.len = xd_k_len; key.tag_at = 0; key.tag_len = 0;
            xd_describe(s, xd_v_at, xd_v_end, val);
            return 1;
        }
        i = i + 1;
        p = n;
    }
    return 0;
}

// 1 and the i'th item of a list, else 0 past the end.
fn xd_item(s: *u8, list: *xd_val, index: u32, out: *xd_val) -> i32 {
    if (list.kind != XD_LIST) { return 0; }
    let end: u32 = list.at + list.len;
    let p: u32 = list.at;
    let i: u32 = 0;
    while (true) {
        p = xd_skip(s, p, end);
        if (p >= end) { return 0; }
        let e: u32 = xd_value(s, p, end, 0);
        if (i == index) { xd_describe(s, p, e, out); return 1; }
        p = xd_skip(s, e, end);
        if (p < end && s[p] == XC_COMMA) { p = p + 1; }
        i = i + 1;
    }
    return 0;
}

// Items in a list, or entries in a record; 0 for anything else.
fn xd_count(s: *u8, v: *xd_val) -> u32 {
    let end: u32 = v.at + v.len;
    let p: u32 = v.at;
    let n: u32 = 0;
    if (v.kind == XD_REC) {
        while (p < end) {
            let q: u32 = xd_entry(s, p, end);
            if (q == XD_BAD) { return n; }
            n = n + 1;
            p = q;
        }
        return n;
    }
    if (v.kind != XD_LIST) { return 0; }
    while (true) {
        p = xd_skip(s, p, end);
        if (p >= end) { return n; }
        p = xd_skip(s, xd_value(s, p, end, 0), end);
        if (p < end && s[p] == XC_COMMA) { p = p + 1; }
        n = n + 1;
    }
    return n;
}

// ---- public: reading values ----

// The string, unescaped and NUL-terminated into buf. Its length, or
// XD_E_TYPE / XD_E_SPACE. The terminator needs room too, so a string of
// exactly `cap` bytes does not fit.
fn xd_str(s: *u8, v: *xd_val, buf: *u8, cap: u32) -> i32 {
    if (v.kind != XD_STR) { return XD_E_TYPE; }
    let p: u32 = v.at + 1;
    let end: u32 = v.at + v.len - 1;                   // the closing quote
    let n: u32 = 0;
    while (p < end) {
        let c: u8 = s[p];
        if (c == XC_BSLASH) {
            let e: u8 = s[p + 1];
            c = e;
            if (e == 110) { c = XC_LF; }
            if (e == 116) { c = XC_TAB; }
            if (e == 114) { c = XC_CR; }
            if (e == 48)  { c = 0; }
            p = p + 1;
        }
        if (n + 1 >= cap) { return XD_E_SPACE; }
        buf[n] = c;
        n = n + 1;
        p = p + 1;
    }
    if (cap == 0) { return XD_E_SPACE; }
    buf[n] = 0;
    return n as i32;
}

// The magnitude of an integer token, ignoring any sign. Sets *neg.
// XD_OK, or XD_E_RANGE if it does not fit in 32 bits.
fn xd_magnitude(s: *u8, v: *xd_val, mag: *u32, neg: *u32) -> i32 {
    let p: u32 = v.at;
    let end: u32 = v.at + v.len;
    let acc: u32 = 0;
    neg[0] = 0;
    if (s[p] == XC_MINUS) { neg[0] = 1; p = p + 1; }
    if (s[p] == 48 && p + 1 < end && (s[p + 1] == 120 || s[p + 1] == 88)) {
        p = p + 2;
        while (p < end) {
            let c: u8 = s[p];
            p = p + 1;
            if (c == XC_UNDER) { continue; }
            let d: u32 = 0;
            if (c >= 48 && c <= 57)  { d = (c - 48) as u32; }
            if (c >= 65 && c <= 70)  { d = (c - 55) as u32; }
            if (c >= 97 && c <= 102) { d = (c - 87) as u32; }
            if (acc > 268435455) { return XD_E_RANGE; }       // another hex digit would overflow
            acc = acc * 16 + d;
        }
    } else {
        while (p < end) {
            let c: u8 = s[p];
            p = p + 1;
            if (c == XC_UNDER) { continue; }
            let d: u32 = (c - 48) as u32;
            if (acc > 429496729) { return XD_E_RANGE; }
            if (acc == 429496729 && d > 5) { return XD_E_RANGE; }
            acc = acc * 10 + d;
        }
    }
    mag[0] = acc;
    return XD_OK;
}

// The integer as a u32. A negative value is out of range.
fn xd_u32(s: *u8, v: *xd_val, out: *u32) -> i32 {
    if (v.kind != XD_INT) { return XD_E_TYPE; }
    let mag: u32 = 0;
    let neg: u32 = 0;
    let rc: i32 = xd_magnitude(s, v, &mag, &neg);
    if (rc != XD_OK) { return rc; }
    if (neg != 0 && mag != 0) { return XD_E_RANGE; }
    out[0] = mag;
    return XD_OK;
}

// The integer as an i32, from -2147483648 to 2147483647.
fn xd_i32(s: *u8, v: *xd_val, out: *i32) -> i32 {
    if (v.kind != XD_INT) { return XD_E_TYPE; }
    let mag: u32 = 0;
    let neg: u32 = 0;
    let rc: i32 = xd_magnitude(s, v, &mag, &neg);
    if (rc != XD_OK) { return rc; }
    if (neg != 0) {
        if (mag > 2147483648) { return XD_E_RANGE; }
        out[0] = (0 - mag) as i32;
        return XD_OK;
    }
    if (mag > 2147483647) { return XD_E_RANGE; }
    out[0] = mag as i32;
    return XD_OK;
}

fn xd_bool(s: *u8, v: *xd_val, out: *u32) -> i32 {
    if (v.kind != XD_BOOL) { return XD_E_TYPE; }
    out[0] = 0;
    if (s[v.at] == 116) { out[0] = 1; }              // 't'
    return XD_OK;
}

// 1 if v is the symbol `name`.
fn xd_sym_is(s: *u8, v: *xd_val, name: *u8) -> i32 {
    if (v.kind != XD_SYM) { return 0; }
    if (xd_spells(s, v.at, v.len, name)) { return 1; }
    return 0;
}

// 1 if the record carries the tag `name`.
fn xd_tag_is(s: *u8, rec: *xd_val, name: *u8) -> i32 {
    if (rec.kind != XD_REC || rec.tag_len == 0) { return 0; }
    if (xd_spells(s, rec.tag_at, rec.tag_len, name)) { return 1; }
    return 0;
}
