// xc/asmdump.xfxn - print the assembly the X compiler generates for programs.
// Aurora Tejeda / CATX Systems
//
//   asmdump [-s] [--prelude FILE | --no-prelude] [-I DIR]... [--std DIR] [--object] PROGRAM...
//
// The same format as `cxk asm` in the DevKit (devkit/), so the code generator written in
// X can be compared with the C# one. Each PROGRAM is compiled on its own, with
// everything it imports. Per program:
//
//   == path
//   error file:line:col message        every diagnostic, in the order reported
//   ...assembly...                     if there were none: exactly what `cxk compile` writes
//
// -s prints a line per program instead: the error count and an FNV-1a hash of
// everything after the `==` line.

import "xc_sys.xfxn";
import "emit.xfxn";
import "dumputil.xfxn";

fn xc_main() -> i32 {
    let o: opts;
    if (!parse_opts(&o)) { return 1; }
    if (o.first == 0) { return 0; }
    let out: buf = buf_new();
    let i: u32 = o.first;
    while (i < xc_argc()) {
        let path: *u8 = xc_arg(i);
        let f: front;
        if (!analyze_with(&o, &f, path)) { err_str("asmdump: out of memory, or a file could not be read\n"); return 2; }
        let asm: buf = buf_new();
        let have: bool = false;
        if (f.checked && dg_count(&f.dg) == 0) {
            let e: emitter;
            emit_init(&e, &f.s, o.object);
            emit_program(&e, &f.decls, &asm);
            have = dg_count(&f.dg) == 0;
        }
        let d: buf = buf_new();
        dump_diags(&f, &d);
        if (have) { buf_append(&d, asm.data, asm.len); }
        if (o.sum) {
            buf_str(&out, path);
            buf_str(&out, ": ");
            buf_u32(&out, dg_count(&f.dg));
            buf_str(&out, " errors, ");
            buf_u32(&out, asm.len);
            buf_str(&out, " bytes, fnv1a ");
            buf_hex32(&out, fnv1a(d.data, d.len));
            buf_push(&out, '\n');
        } else {
            buf_str(&out, "== ");
            buf_str(&out, path);
            buf_push(&out, '\n');
            buf_append(&out, d.data, d.len);
        }
        buf_free(&asm);
        buf_free(&d);
        out_buf(&out);
        buf_clear(&out);
        i += 1;
    }
    return 0;
}
