// xc/tokdump.xfxn - print the tokens of X source files.
// Aurora Tejeda / CATX SYSTEMS LLC
//
//   tokdump a.xfxn b.xfxn ...
//   tokdump -s a.xfxn ...      one summary line per file instead
//
// The same format as `cxk tokens` in the DevKit (devkit/), so the X lexer and the C# one
// can be compared with a diff. Per file, a line `== path`, then one line per
// token:
//
//   Kind line:col payload
//
// where the payload is an identifier's text, an integer's value in decimal
// (and its suffix, if it has one), a string's decoded bytes in hex, or `-`.
//
// -s prints, per file, the token and error counts and an FNV-1a hash of the
// token lines - so a run on CXK can be checked against one on the host without
// carrying thousands of lines off the machine: equal hashes, equal tokens.

import "xc_sys.xfxn";
import "lex.xfxn";

global hexdig: *u8 = "0123456789abcdef";

fn buf_u128(b: *buf, v: u128) -> bool {
    let digits: [40]u8;
    let n: u32 = 0;
    let x: u128 = v;
    while (true) {
        digits[n] = '0' + (x % 10) as u8;
        n += 1;
        x /= 10;
        if (x == 0) { break; }
    }
    if (!buf_reserve(b, n)) { return false; }
    while (n > 0) { n -= 1; b.data[b.len] = digits[n]; b.len += 1; }
    return true;
}

fn dump(lx: *lexer, out: *buf) -> bool {
    let n: u32 = lex_count(lx);
    let i: u32 = 0;
    while (i < n) {
        let t: *token = lex_tok(lx, i);
        buf_str(out, tk_names[t.kind as u32]);
        buf_push(out, ' ');
        buf_u32(out, t.line);
        buf_push(out, ':');
        buf_u32(out, t.col);
        buf_push(out, ' ');
        switch (t.kind) {
            case tk.identifier { buf_append(out, &lx.src[t.at], t.len); }
            case tk.int_literal {
                buf_u128(out, t.value);
                if (t.suffix == SFX_CHAR) { buf_str(out, " char"); }
                else if (t.suffix != 0) { buf_push(out, ' '); buf_str(out, suffixes[t.suffix - 1]); }
            }
            case tk.string_literal {
                if (t.str_len == 0) { buf_push(out, '-'); }
                let j: u32 = 0;
                while (j < t.str_len) {
                    let c: u8 = lx.strs.data[t.str_at + j];
                    buf_push(out, hexdig[(c >> 4) as u32]);
                    buf_push(out, hexdig[(c & 15) as u32]);
                    j += 1;
                }
            }
            else { buf_push(out, '-'); }
        }
        if (!buf_push(out, '\n')) { return false; }
        i += 1;
    }
    return true;
}

fn fnv1a(p: *u8, n: u32) -> u32 {
    let h: u32 = 0x811C9DC5;
    let i: u32 = 0;
    while (i < n) { h ^= p[i] as u32; h *= 0x01000193; i += 1; }
    return h;
}

fn buf_hex32(b: *buf, v: u32) -> bool {
    let s: i32 = 28;
    while (s >= 0) { buf_push(b, hexdig[(v >> s as u32) & 15]); s -= 4; }
    return true;
}

fn xc_main() -> i32 {
    let out: buf = buf_new();
    let sum: bool = false;
    let i: u32 = 1;
    if (xc_argc() > 1 && xc_arg(1)[0] == '-' && xc_arg(1)[1] == 's' && xc_arg(1)[2] == 0) { sum = true; i = 2; }
    while (i < xc_argc()) {
        let path: *u8 = xc_arg(i);
        let src: buf = buf_new();
        if (!read_file(path, &src)) { err_str("tokdump: cannot read "); err_str(path); err_str("\n"); return 1; }
        let d: buf = buf_new();
        if (!sum) { buf_str(&d, "== "); buf_str(&d, path); buf_push(&d, '\n'); }   // the hash leaves the path out
        let lx: lexer;
        lex_init(&lx, src.data, src.len);
        if (!lex_all(&lx) || !dump(&lx, &d)) { err_str("tokdump: out of memory\n"); return 2; }
        if (sum) {
            buf_str(&out, path);
            buf_str(&out, ": ");
            buf_u32(&out, lex_count(&lx));
            buf_str(&out, " tokens, ");
            buf_u32(&out, lx.errors);
            buf_str(&out, " errors, fnv1a ");
            buf_hex32(&out, fnv1a(d.data, d.len));
            buf_push(&out, '\n');
        } else {
            buf_append(&out, d.data, d.len);
        }
        lex_free(&lx);
        buf_free(&src);
        buf_free(&d);
        out_buf(&out);
        buf_clear(&out);
        i += 1;
    }
    return 0;
}
