// xc/host/xc_sys.xfxn - the X compiler's platform, on a Linux host.
// Aurora Tejeda / CATX Systems
//
// The X compiler written in X runs in two places: on CXK, which is the point,
// and on the Linux host it is developed on, which is how it is tested - every
// piece is compared against the C# compiler on the same input, thousands of
// files at a time, without booting anything. This file is the host half. A
// build picks it with `-I os/xc/host/<target> -I os/xc/host` and
// `--no-prelude`; the CXK half sits in os/xc/cxk and uses the ordinary prelude
// and std/file.xfxn.
//
// What it provides is small on purpose - read a file, write to stdout and
// stderr, exit - plus the one thing std/heap.xfxn needs from below: vm_map,
// with the prelude's argument struct and constants, so the REAL allocator and
// std/buf.xfxn run here unchanged. Memory comes from brk, and like a CXK
// mapping it arrives zeroed.
//
// It runs as x86-64 (an x86-32 host went with that back end, roadmap step
// 6d3c). With no prelude, __syscall is Linux's own `syscall` entry, and
// xc_linux.xfxn, from the target's directory, holds its numbers. Addresses go
// to the kernel as usize, so a pointer to the stack (argv, a local) arrives
// whole, and so does every heap address: std/heap.xfxn hands them out as
// usize, and vm_map below puts the heap above 4 GB on purpose.

import "buf.xfxn";
import "xc_linux.xfxn";

const LINUX_EISDIR: i32 = -21;

// ---- what std/heap.xfxn expects of the prelude ----
const E_OK:    i32 = 0;
const E_NO_MEMORY: i32 = -8;
const MPROT_READ:  u32 = 0x01;
const MPROT_WRITE: u32 = 0x02;
const MOBJ_ANON: u32 = 0;
// `addr` is a usize here, where the prelude's is a u32 (the ABI keeps user
// addresses at 32 bits until the user half grows past 4 GB); std/heap.xfxn
// reads it `as usize`, which compiles against either.
struct vm_map_args { offset: u64, length: u64, granted: u64, object: u32, addr: usize, prot: u32, flags: u32 }

const MREMAP_MAYMOVE_FIXED: u32 = 3;
const HOST_QUOTA: u32 = 0x40000000;

global host_mapped: u32 = 0;
global host_high: usize = HOST_HEAP_HIGH;   // where the next high grant goes

// No unmap: the heap never unmaps. Pages come off the end of the data segment.
// A static binary's break starts just past its data, far under 4 GB.
//
// Each grant then moves up to HOST_HEAP_HIGH and beyond, one after
// the other, with mremap (mmap takes six arguments and __syscall passes five).
// So every address the heap hands out has bits above 32, and a pointer that
// anything cuts to a u32 points at nothing: the run faults instead of reading
// the wrong memory. __syscall's result is an i32, so the move is checked by
// its low 32 bits; the quota keeps those clear of the error range.
fn vm_map(a: *vm_map_args) -> i32 {
    let len: u32 = ((a.length as u32) + 4095) & 0xFFFFF000;
    if (len == 0 || len > HOST_QUOTA - host_mapped) { return E_NO_MEMORY; }
    let cur: usize = (__syscall(LINUX_BRK, 0, 0, 0, 0, 0) as u32) as usize;
    let want: usize = cur + (len as usize);
    if (want < cur || want > 0xFFFFFFFF) { return E_NO_MEMORY; }
    let got: usize = (__syscall(LINUX_BRK, want, 0, 0, 0, 0) as u32) as usize;
    if (got < want) { return E_NO_MEMORY; }
    let r: i32 = __syscall(LINUX_MREMAP, cur, len, len, MREMAP_MAYMOVE_FIXED, host_high);
    if ((r as u32) != (host_high as u32)) { return E_NO_MEMORY; }
    let at: usize = host_high;
    host_high = host_high + (len as usize);
    a.addr = at;
    a.granted = len;
    host_mapped += len;
    return E_OK;
}
fn mem_quota() -> u32 { return HOST_QUOTA; }
fn mem_used() -> u32 { return host_mapped; }

// ---- the compiler's platform interface ----
//
// Both platform files provide the same functions: the program starts in
// xc_main() and reads its arguments with xc_argc()/xc_arg(), whatever starts it.

global host_argc: u32;
global host_argv: **u8;

// The host start stub passes Linux's argc and argv.
fn main(argc: u32, argv: **u8) -> i32 {
    host_argc = argc;
    host_argv = argv;
    return xc_main();
}
fn xc_argc() -> u32 { return host_argc; }
fn xc_arg(i: u32) -> *u8 { return host_argv[i]; }

fn sys_exit(code: i32) -> void { __syscall(LINUX_EXIT, code as u32, 0, 0, 0, 0); }

// p + n, as the address the kernel is given
fn host_at(p: *u8, n: u32) -> usize { return (p as usize) + (n as usize); }

fn sys_write(fd: u32, p: *u8, n: u32) -> void {
    let done: u32 = 0;
    while (done < n) {
        let w: i32 = __syscall(LINUX_WRITE, fd, host_at(p, done), n - done, 0, 0);
        if (w <= 0) { return; }
        done += w as u32;
    }
}

fn out_bytes(p: *u8, n: u32) -> void { sys_write(1, p, n); }
fn out_buf(b: *buf) -> void { sys_write(1, b.data, b.len); }
fn err_str(s: *u8) -> void { let n: u32 = 0; while (s[n] != 0) { n += 1; } sys_write(2, s, n); }

// The whole of a file, appended to `out`. False if it cannot be opened or
// read, or memory runs out.
fn read_file(path: *u8, out: *buf) -> bool {
    let fd: i32 = __syscall(LINUX_OPEN, path, 0, 0, 0, 0);   // O_RDONLY
    if (fd < 0) { return false; }
    let ok: bool = true;
    while (true) {
        if (!buf_reserve(out, 65536)) { ok = false; break; }
        let r: i32 = __syscall(LINUX_READ, fd as u32, host_at(out.data, out.len), 65536, 0, 0);
        if (r < 0) { ok = false; break; }
        if (r == 0) { break; }
        out.len += r as u32;
    }
    __syscall(LINUX_CLOSE, fd as u32, 0, 0, 0, 0);
    return ok;
}

// Is there a FILE at this path? A directory is not one, as for C#'s File.Exists:
// it opens, but reading it fails with EISDIR.
fn xc_exists(path: *u8) -> bool {
    let fd: i32 = __syscall(LINUX_OPEN, path, 0, 0, 0, 0);
    if (fd < 0) { return false; }
    let c: [4]u8;
    let r: i32 = __syscall(LINUX_READ, fd as u32, &c[0], 1, 0, 0);
    __syscall(LINUX_CLOSE, fd as u32, 0, 0, 0, 0);
    return r != LINUX_EISDIR;
}

// The working directory, appended to `out`.
fn xc_cwd(out: *buf) -> bool {
    if (!buf_reserve(out, 4096)) { return false; }
    let n: i32 = __syscall(LINUX_GETCWD, host_at(out.data, out.len), 4096, 0, 0, 0);
    if (n <= 0) { return false; }
    out.len += (n - 1) as u32;   // Linux counts the NUL
    return true;
}

// A whole file written from p[0..n], replacing any it had. False on failure.
fn write_file(path: *u8, p: *u8, n: u32) -> bool {
    let fd: i32 = __syscall(LINUX_OPEN, path, 0x241, 420, 0, 0);   // O_WRONLY|O_CREAT|O_TRUNC, 0644
    if (fd < 0) { return false; }
    let done: u32 = 0;
    while (done < n) {
        let w: i32 = __syscall(LINUX_WRITE, fd as u32, host_at(p, done), n - done, 0, 0);
        if (w <= 0) { break; }
        done += w as u32;
    }
    __syscall(LINUX_CLOSE, fd as u32, 0, 0, 0, 0);
    return done == n;
}
