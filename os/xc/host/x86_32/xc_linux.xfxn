// xc/host/x86_32/xc_linux.xfxn - Linux's i386 system call numbers.
// Aurora Tejeda / CATX Systems
//
// xc_sys.xfxn's numbers for a 32-bit host build, which `--no-prelude`
// compiles to int $0x80. A build puts this directory ahead of os/xc/host
// (`-I os/xc/host/x86_32 -I os/xc/host`); x86_64/ holds the same names.

const LINUX_EXIT:  u32 = 1;
const LINUX_READ:  u32 = 3;
const LINUX_WRITE: u32 = 4;
const LINUX_OPEN:  u32 = 5;
const LINUX_CLOSE: u32 = 6;
const LINUX_UNLINK: u32 = 10;
const LINUX_BRK:   u32 = 45;
const LINUX_GETCWD: u32 = 183;
