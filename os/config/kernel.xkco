// kernel.xkco - the kernel's own limits, read once at boot.
//
// X Data (docs/x86_32/language/CX_X_DATA.md). Every key is optional: one left out keeps the
// built-in value, which is what each is set to here. The whole file is checked
// before any of it is used - a typo, an unknown key or a value out of range
// refuses the ENTIRE file, the boot log says which line, and the kernel runs on
// its built-in values. It is never half-applied.
//
// The build checks this file too (cxk check-xdata), so most mistakes stop the
// build before they reach a disk.

// Each kernel stack, in KiB: 8 to 32, a multiple of 4. Stacks are guarded, so
// one that is too small stops the machine with a panic naming the thread - it
// does not corrupt memory. Larger costs memory for every thread.
kernel_stack_kib = 8

// How many threads may be alive at once: 4 to 256. The executive, shell,
// supervisor and each running service or program is one.
max_threads = 8

// How many handles one process may have open at once: 16 to 4096. Open
// files, endpoints and every other object a program holds each take one.
max_handles = 1024

// The memory a process may map with SYS_VM_MAP unless its parent gives it
// less, in MiB: 1 to 64. A process can never be given more than its parent.
memory_quota_mib = 16

// Chaos, for testing only: at every race point the kernel's self-tests use,
// yield this many times in a thousand arrivals (0 to 1000; 0 is off), so
// other threads run in the middle of an operation. The boot log prints the
// seed it used; put that seed here as chaos_seed (any 32-bit number, 0 =
// take one from the kernel's generator) to replay the same decisions. Needs
// a kernel built with test hooks.
chaos_permille = 0
chaos_seed = 0
