// xtest.xfxn - the X tests, run from ring 3 (roadmap 1.5d2).
// Aurora Tejeda / CATX Systems
//
// The kernel's self-test (ktest_loader.c, ktest_xtests) runs it once with a
// pipe for its output and reports each test below as a self-test of its own
// (std/test.xfxn has the lines and the rules). A test returns 0, or the step
// it failed at.
//
// What a test can only show by how its process ends stays a program of its
// own, run by a self-test that reads the end: threads.xfxn (a worker's
// SYS_EXIT, a crash, the first thread ending first), futex.xfxn (a waiter's
// process ends).

import "test.xfxn";
import "thread.xfxn";
import "time.xfxn";
import "sync.xfxn";
import "heap.xfxn";
import "io.xfxn";
import "string.xfxn";
import "display.xfxn";
import "dserver.xfxn";

const MS: u64 = 1000000;

fn mapped() -> u64 {
    let u: vm_usage;
    vm_info(&u);
    return u.mapped as u64;
}

// -> the bytes written, or -E_*
fn info(h: i32, ti: *thread_info) -> i32 {
    let q: object_info_args;
    let size: thread_info;
    q.cap    = sizeof size;
    q.buf    = ti as u64;
    q.handle = h;
    q.topic  = OBJINFO_THREAD;
    return object_info(&q);
}

fn join(h: i32) -> i32 { return join_within(h, 30000); }

fn join_within(h: i32, ms: u32) -> i32 {
    let code: i32 = 0 - 1000;
    if (thread_join(h, time_deadline_ms(ms), &code) != 0) { return 0 - 1000; }
    return code;
}

// ==================== threads (roadmap 1.5a, 1.5c2) ====================

global results: [4]u64;

// arg's triangle number, kept where the test can check it
fn worker(arg: u64) -> i32 {
    let sum: u64 = 0;
    let i: u64 = 1;
    while (i <= arg) { sum = sum + i; i = i + 1; }
    results[(arg / 10) as i32] = sum;
    return (arg as i32) + 100;
}

// 1-4: refusals, each taking nothing
fn t_create_refused(arg: u64) -> i32 {
    let a: thread_create_args;
    a.entry = thread_main as u64; a.arg0 = worker as u64; a.arg1 = 3;
    a.stack_size = 0; a.flags = 1; a.reserved = 0; a.tls = 0;
    if (thread_create(&a) != E_INVALID_ARGS) { return 1; }
    a.flags = 0; a.reserved = 1;
    if (thread_create(&a) != E_INVALID_ARGS) { return 2; }
    a.reserved = 0; a.stack_size = 4096;
    if (thread_create(&a) != E_OUT_OF_RANGE) { return 3; }
    a.stack_size = 0; a.entry = 0;
    if (thread_create(&a) != E_INVALID_ARGS) { return 4; }
    return 0;
}

// 5-9: three workers at once, each joined with its code and its result, and
// every stack given back before its thread's end was signalled
fn t_workers_joined(arg: u64) -> i32 {
    let m0: u64 = mapped();
    let h: [3]i32;
    let i: u32 = 0;
    while (i < 3) {
        h[i] = thread_spawn(worker, (i + 1) as u64 * 10, 0);
        if (h[i] <= 0) { return 5; }
        i = i + 1;
    }
    i = 0;
    while (i < 3) {
        let code: i32 = 0;
        if (thread_join(h[i], time_deadline_ms(10000), &code) != 0) { return 6; }
        if (code != ((i + 1) * 10 + 100) as i32) { return 7; }
        i = i + 1;
    }
    if (results[1] != 55 || results[2] != 210 || results[3] != 465) { return 8; }
    if (mapped() != m0) { return 9; }
    return 0;
}

global nap_sp: u64;

fn napper(arg: u64) -> i32 {
    let here: u64 = 1;
    nap_sp = (&here) as u64;
    sleep_ms(300);
    return 5;
}

// 10-14: a stack is a mapping of its size while its thread lives (and its
// block, a page); a join whose deadline passes first leaves the handle to
// join again; a thread stack is not the program's to unmap
fn t_stacks_and_join_deadline(arg: u64) -> i32 {
    let m0: u64 = mapped();
    let n: i32 = thread_spawn(napper, 0, 0);
    if (n <= 0 || mapped() != m0 + (THREAD_USTACK_DEFAULT as u64) + (THREAD_BLOCK_BYTES as u64)) { return 10; }
    let code: i32 = 0;
    if (thread_join(n, time_deadline_ms(10), &code) != E_TIMED_OUT) { return 11; }
    // walk down from the napper's stack to the region's base, which refuses
    while (nap_sp == 0) { sleep_ms(1); }
    let pg: u64 = (nap_sp / 4096) * 4096;
    let k: u32 = 0;
    let r: i32 = E_NOT_FOUND;
    while (k < 18 && r == E_NOT_FOUND) { r = vm_unmap(pg - (k as u64) * 4096, 4096); k = k + 1; }
    if (r != E_ACCESS_DENIED) { return 12; }
    if (thread_join(n, time_deadline_ms(10000), &code) != 0 || code != 5) { return 13; }
    if (mapped() != m0) { return 14; }
    return 0;
}

const NONCANONICAL: u64 = 0x0000800000000000;   // the first past the user half
const KERNEL_HALF:  u64 = 0xFFFF800000001000;

global tls_seen: [4]u64;    // each worker's block, as it found it
global tls_go: u32;         // the workers start switching once all are up

// Each finds its own block in FS, made for it and named by its own word,
// holding its own id; and still finds it after every switch to a sibling
// with another. -> 0, or what went wrong.
fn tls_worker(arg: u64) -> i32 {
    let b: *tls_block = __tls_base() as *tls_block;
    if (b.self != tls_addr(b)) { return 1; }
    if (b.tid != thread_id() as u32 || tls_tid() != b.tid) { return 2; }
    if (tls_addr(b) == tls_addr(&tls_first)) { return 3; }
    tls_seen[arg as i32] = tls_addr(b) as u64;
    __atomic_add(&tls_go, 1);
    while (__atomic_load(&tls_go) < 3) { yield_(); }
    let i: u32 = 0;
    while (i < 50) {
        yield_();
        if (__tls_base() != tls_addr(b)) { return 4; }
        i = i + 1;
    }
    return 0;
}

// 16-22, 28: the test's own block is its own (not the first thread's);
// bases outside the user half refused; three workers each in their own
// block; every block given back
fn t_tls_blocks(arg: u64) -> i32 {
    let m0: u64 = mapped();
    let mine: usize = tls_addr(tls_self());
    if (mine != __tls_base() || mine == tls_addr(&tls_first)) { return 16; }
    // 17-19: refused at create and by the set call, the base unchanged
    let a: thread_create_args;
    a.entry = thread_main as u64; a.arg0 = tls_worker as u64; a.arg1 = 0;
    a.stack_size = 0; a.flags = 0; a.reserved = 0; a.tls = NONCANONICAL;
    if (thread_create(&a) != E_INVALID_ARGS) { return 17; }
    a.tls = KERNEL_HALF;
    if (thread_create(&a) != E_INVALID_ARGS) { return 17; }
    if (thread_set_tls(NONCANONICAL) != E_INVALID_ARGS) { return 18; }
    if (thread_set_tls(KERNEL_HALF) != E_INVALID_ARGS) { return 18; }
    if (__tls_base() != mine) { return 19; }

    // 20-22: three workers, each in its own block across 50 switches; this
    // thread finds its own after waiting on them
    let h: [3]i32;
    let i: u32 = 0;
    while (i < 3) {
        h[i] = thread_spawn(tls_worker, i as u64, 0);
        if (h[i] <= 0) { return 20; }
        i = i + 1;
    }
    i = 0;
    while (i < 3) {
        let code: i32 = -1;
        if (thread_join(h[i], time_deadline_ms(10000), &code) != 0) { return 21; }
        if (code != 0) { return 30 + code; }
        i = i + 1;
    }
    if (tls_seen[0] == tls_seen[1] || tls_seen[1] == tls_seen[2] || tls_seen[0] == tls_seen[2]) { return 22; }
    if (__tls_base() != mine || tls_tid() != thread_id() as u32) { return 22; }
    if (mapped() != m0) { return 28; }
    return 0;
}

// 23: names refused: empty, no NUL within THREAD_NAME_MAX, unreadable; 31
// bytes and a NUL taken
fn t_names(arg: u64) -> i32 {
    let nm: [33]u8;
    let k: u32 = 0;
    while (k < 33) { nm[k] = 120; k = k + 1; }
    nm[32] = 0;
    if (thread_set_name("") != E_INVALID_ARGS) { return 23; }
    if (thread_set_name(&nm[0]) != E_INVALID_ARGS) { return 23; }
    if (thread_set_name(KERNEL_HALF as *u8) != E_BAD_ADDRESS) { return 23; }
    nm[31] = 0;
    if (thread_set_name(&nm[0]) != 0) { return 23; }
    return 0;
}

global spin_named: u32;
global spin_stop: u32;
// 31 bytes: the longest name there is room for
fn long_name() -> *u8 { return "spinner-abcdefghijklmnopqrstuvw"; }

// Runs on the CPU for 30 ms of the clock, then names itself and waits to be
// looked at.
fn spinner(arg: u64) -> i32 {
    let end: u64 = time_deadline_ms(30);
    let now: u64 = 0;
    clock_monotonic(&now);
    while (now < end) { clock_monotonic(&now); }
    if (thread_set_name(long_name()) != 0) { return 1; }
    __atomic_store(&spin_named, 1);
    while (__atomic_load(&spin_stop) == 0) { sleep_ms(1); }
    return 0;
}

fn napper2(arg: u64) -> i32 {
    sleep_ms(100);
    return 0;
}

// 24-27: a thread that ran 30 ms is charged that much and named as it named
// itself, while it runs and after it ends; one that slept 100 ms is charged
// next to nothing, and is called what every new thread is
fn t_cpu_time_and_names(arg: u64) -> i32 {
    let ti: thread_info;
    let s: i32 = thread_spawn(spinner, 0, 0);
    if (s <= 0) { return 24; }
    while (__atomic_load(&spin_named) == 0) { sleep_ms(1); }
    if (info(s, &ti) < 0 || ti.ended != THR_RUNNING) { return 24; }
    if (ti.cpu_ns < 20 * MS || streq(&ti.name[0], long_name()) != 1) { return 25; }
    let ran: u64 = ti.cpu_ns;
    __atomic_store(&spin_stop, 1);
    let seen: u32 = 0;
    if (object_wait(s, SIGNAL_THREAD_ENDED, time_deadline_ms(10000), &seen) != 0) { return 26; }
    if (info(s, &ti) < 0 || ti.ended != THR_EXITED || ti.cpu_ns < ran) { return 26; }
    if (streq(&ti.name[0], long_name()) != 1 || ti.name[31] != 0) { return 26; }
    handle_close(s);

    let n: i32 = thread_spawn(napper2, 0, 0);
    if (n <= 0) { return 27; }
    if (object_wait(n, SIGNAL_THREAD_ENDED, time_deadline_ms(10000), &seen) != 0) { return 27; }
    if (info(n, &ti) < 0 || ti.cpu_ns >= 20 * MS || ti.cpu_ns == 0) { return 27; }
    if (streq(&ti.name[0], "thread") != 1) { return 27; }
    handle_close(n);
    return 0;
}

// ==================== futexes (roadmap 1.5b2) ====================

global word:  u32;   // a word of the image: keyed by the process and its address
global other: u32;   // another one, which no one waits on

// wait on the word at arg while it is 0 -> futex_wait's answer
fn waiter(arg: u64) -> i32 {
    return futex_wait(arg as *u32, 0, time_deadline_ms(20000));
}

// wake one waiter on w once one is there, checking no wake on `other`
// reaches it -> 1, or 0 if none came
fn wake_one(w: *u32) -> i32 {
    let until: u64 = time_deadline_ms(20000);
    while (time_now_ns() < until) {
        if (futex_wake(&other, FUTEX_WAKE_ALL) != 0) { return 0; }
        let n: i32 = futex_wake(w, 1);
        if (n != 0) { return n; }
        sleep_ms(1);
    }
    return 0;
}

// 1-8: refusals, the cases that do not wait, and a deadline that comes
// first, not before its time
fn f_refusals(arg: u64) -> i32 {
    let addr: u64 = (&word) as u64;
    if (futex_wait((addr + 2) as *u32, 0xFFFF_FFFF, DEADLINE_NEVER) != E_INVALID_ARGS) { return 1; }
    if (futex_wake((addr + 1) as *u32, 1) != E_INVALID_ARGS) { return 2; }
    if (futex_wait(0xFFFF_8000_0000_0000 as *u32, 0, DEADLINE_NEVER) != E_BAD_ADDRESS) { return 3; }
    if (futex_wake(0 as *u32, 1) != E_BAD_ADDRESS) { return 4; }
    word = 7;
    if (futex_wait(&word, 6, DEADLINE_NEVER) != E_SHOULD_WAIT) { return 5; }
    word = 0;
    if (futex_wake(&word, FUTEX_WAKE_ALL) != 0) { return 6; }
    let t0: u64 = time_now_ns();
    if (futex_wait(&word, 0, time_deadline_ms(30)) != E_TIMED_OUT) { return 7; }
    if (time_since_ns(t0) < 30 * NS_PER_MS) { return 7; }
    // one already passed only looks
    if (futex_wait(&word, 0, 0) != E_TIMED_OUT) { return 8; }
    return 0;
}

// 9-10: a waiter woken by a wake on its word, which says it woke one
fn f_wake_one(arg: u64) -> i32 {
    word = 0;
    let h: i32 = thread_spawn(waiter, (&word) as u64, 0);
    if (h <= 0) { return 9; }
    if (wake_one(&word) != 1) { return 9; }
    if (join(h) != 0) { return 10; }
    return 0;
}

// 11-13: three waiters; a wake of two wakes two, and the third is still
// there for the next
fn f_wake_two(arg: u64) -> i32 {
    word = 0;
    let w: [3]i32;
    let i: u32 = 0;
    while (i < 3) { w[i] = thread_spawn(waiter, (&word) as u64, 0); if (w[i] <= 0) { return 11; } i = i + 1; }
    let n: i32 = 0;
    let until: u64 = time_deadline_ms(20000);
    while (n < 2 && time_now_ns() < until) { n = n + futex_wake(&word, (2 - n) as u32); sleep_ms(1); }
    if (n != 2) { return 12; }
    if (wake_one(&word) != 1) { return 13; }
    i = 0;
    while (i < 3) { if (join(w[i]) != 0) { return 13; } i = i + 1; }
    return 0;
}

// 14-16: one memory object mapped at two addresses is one word: a wait
// through one is woken through the other
fn f_one_object_two_maps(arg: u64) -> i32 {
    let m: i32 = mem_create(4096, 0);
    if (m <= 0) { return 14; }
    let a: vm_map_args;
    a.offset = 0; a.length = 4096; a.object = m as u32;
    a.prot = MPROT_READ | MPROT_WRITE; a.flags = 0; a.reserved = 0; a.addr = 0;
    if (vm_map(&a) != 0) { return 14; }
    let one: u64 = a.addr;
    a.addr = 0;
    if (vm_map(&a) != 0 || a.addr == one) { return 14; }
    let two: u64 = a.addr;
    let p1: *u32 = (one + 64) as *u32;
    let p2: *u32 = (two + 64) as *u32;
    p1[0] = 5;
    if (p2[0] != 5) { return 15; }
    p1[0] = 0;
    let h: i32 = thread_spawn(waiter, one + 64, 0);
    if (h <= 0) { return 15; }
    if (wake_one(p2) != 1) { return 16; }
    if (join(h) != 0) { return 16; }
    vm_unmap(one, 0);
    vm_unmap(two, 0);
    handle_close(m);
    return 0;
}

// ==================== std/sync.xfxn (roadmap 1.5b2) ====================

const WORKERS: u32 = 4;
const ROUNDS:  u32 = 200;
const ITEMS:   u32 = 50;

global lock:  mutex;
global counter: u32;
global ids: [4]u32;

global cv:   cond;
global cvm:  mutex;
global slot_full: u32;
global slot_val:  u32;

global once_o: once;
global once_count: u32;

// 20-22: a mutex's word is its owner; only the owner unlocks it
fn s_mutex_owner(arg: u64) -> i32 {
    let me: u32 = thread_id() as u32;
    if (me == 0 || (me & FUTEX_WAITERS) != 0) { return 20; }
    if (mutex_unlock(&lock) != E_ACCESS_DENIED) { return 21; }
    if (mutex_trylock(&lock) != 0 || lock.w != me) { return 22; }
    if (mutex_trylock(&lock) != E_SHOULD_WAIT) { return 22; }
    if (mutex_unlock(&lock) != 0 || lock.w != 0) { return 22; }
    return 0;
}

// ROUNDS turns of the counter, read and written around a yield, so a lock
// that let two in would lose counts; then the heap, from every worker at once
fn bumper(arg: u64) -> i32 {
    let me: u32 = thread_id() as u32;
    ids[arg as u32] = me;
    let i: u32 = 0;
    while (i < ROUNDS) {
        mutex_lock(&lock);
        if ((__atomic_load(&lock.w) & ~FUTEX_WAITERS) != me) { return 1; }
        let v: u32 = counter;
        yield_();
        counter = v + 1;
        if (mutex_unlock(&lock) != 0) { return 2; }
        i = i + 1;
    }
    let blocks: [64]usize;
    let round: u32 = 0;
    while (round < 40) {
        let k: u32 = 0;
        while (k < 64) {
            let size: u32 = 8 + ((k + round + (arg as u32)) % 7) * 24;
            blocks[k] = alloc(size);
            if (blocks[k] == 0) { return 3; }
            memset(blocks[k] as *u8, (me & 0xFF) as u8, size);
            k = k + 1;
        }
        yield_();
        k = 0;
        while (k < 64) {
            let b: *u8 = blocks[k] as *u8;
            let size: u32 = 8 + ((k + round + (arg as u32)) % 7) * 24;
            let j: u32 = 0;
            while (j < size) { if (b[j] != (me & 0xFF) as u8) { return 4; } j = j + 1; }
            free(blocks[k]);
            k = k + 1;
        }
        round = round + 1;
    }
    return 0;
}

// 23-26: four threads through one mutex, and through the heap; each its own
// id, none the test's
fn s_mutex_contended(arg: u64) -> i32 {
    let me: u32 = thread_id() as u32;
    let h: [4]i32;
    let i: u32 = 0;
    while (i < WORKERS) { h[i] = thread_spawn(bumper, i as u64, 0); if (h[i] <= 0) { return 23; } i = i + 1; }
    i = 0;
    while (i < WORKERS) {
        let c: i32 = join_within(h[i], 300000);   // 10-114 s seen on 4 CPUs (1.9e4b)
        if (c != 0) { return 24 * 10 + c; }
        i = i + 1;
    }
    if (counter != WORKERS * ROUNDS) { return 25; }
    i = 0;
    while (i < WORKERS) {
        if (ids[i] == 0 || ids[i] == me) { return 26; }
        let j: u32 = i + 1;
        while (j < WORKERS) { if (ids[i] == ids[j]) { return 26; } j = j + 1; }
        i = i + 1;
    }
    return 0;
}

fn producer(arg: u64) -> i32 {
    let i: u32 = 1;
    while (i <= ITEMS) {
        mutex_lock(&cvm);
        while (slot_full == 1) { cond_wait(&cv, &cvm); }
        slot_val = i;
        slot_full = 1;
        cond_broadcast(&cv);
        mutex_unlock(&cvm);
        i = i + 1;
    }
    return 0;
}

// 27-28: a condition variable carries ITEMS through one slot
fn s_cond_carries(arg: u64) -> i32 {
    let p: i32 = thread_spawn(producer, 0, 0);
    if (p <= 0) { return 27; }
    let sum: u32 = 0;
    let got: u32 = 0;
    while (got < ITEMS) {
        mutex_lock(&cvm);
        while (slot_full == 0) { cond_wait(&cv, &cvm); }
        sum = sum + slot_val;
        slot_full = 0;
        cond_broadcast(&cv);
        mutex_unlock(&cvm);
        got = got + 1;
    }
    if (join(p) != 0 || sum != ITEMS * (ITEMS + 1) / 2) { return 28; }
    return 0;
}

// 29: a timed wait with no signal ends at its deadline, holding the lock
fn s_cond_deadline(arg: u64) -> i32 {
    mutex_lock(&cvm);
    let c2: cond;
    c2.seq = 0;
    if (cond_wait_until(&c2, &cvm, time_deadline_ms(20)) != E_TIMED_OUT) { return 29; }
    if (mutex_unlock(&cvm) != 0) { return 29; }
    return 0;
}

fn once_body() -> void {
    sleep_ms(30);
    __atomic_add(&once_count, 1);
}

fn once_user(arg: u64) -> i32 {
    once_run(&once_o, once_body);
    if (__atomic_load(&once_count) != 1) { return 1; }
    return 0;
}

// 30-31: once runs its function once, and every caller returns after it
fn s_once(arg: u64) -> i32 {
    let h: [3]i32;
    let i: u32 = 0;
    while (i < 3) { h[i] = thread_spawn(once_user, 0, 0); if (h[i] <= 0) { return 30; } i = i + 1; }
    once_run(&once_o, once_body);
    if (once_count != 1) { return 31; }
    i = 0;
    while (i < 3) { if (join(h[i]) != 0) { return 31; } i = i + 1; }
    if (once_count != 1) { return 31; }
    return 0;
}

fn allocer(arg: u64) -> i32 {
    let p: usize = alloc(64);
    if (p == 0) { return 1; }
    free(p);
    return 0;
}

fn printer(arg: u64) -> i32 {
    newline();
    return 0;
}

// Hold m, start f: it must still be running 50 ms on, asleep on m (its
// word marked FUTEX_WAITERS), and end once m is let go -> 0, or 1 / 2.
fn holds_off(m: *mutex, f: thread_fn) -> i32 {
    mutex_lock(m);
    let h: i32 = thread_spawn(f, 0, 0);
    if (h <= 0) { mutex_unlock(m); return 1; }
    let code: i32 = 0;
    let rc: i32 = thread_join(h, time_deadline_ms(50), &code);
    let waited: u32 = __atomic_load(&m.w) & FUTEX_WAITERS;
    mutex_unlock(m);
    if (rc != E_TIMED_OUT || waited == 0) { join(h); return 1; }
    if (join(h) != 0) { return 2; }
    return 0;
}

// 32-33: alloc takes the heap's lock. On one CPU a race inside alloc is a
// few instructions wide and the heap stress above seldom reaches it, so
// hold the lock here and see a thread wait on it.
fn s_heap_locked(arg: u64) -> i32 {
    let r: i32 = holds_off(&heap_mu, allocer);
    if (r != 0) { return 31 + r; }
    return 0;
}

// 34-35: and the output takes its own
fn s_output_locked(arg: u64) -> i32 {
    let r: i32 = holds_off(&io_mu, printer);
    if (r != 0) { return 33 + r; }
    return 0;
}

// ==================== limits, both sides (roadmap 1.6b) ====================
// Each bound the ABI names, at the bound and one past it. The refusals
// were tested before; what is new is the accepted side.

// 36-38: a pipe of PIPE_SIZE_MAX is made, and takes that much with no
// reader (a write blocks until every byte is in, so one that did not fit
// would never return); one byte more is refused
fn l_pipe_max(arg: u64) -> i32 {
    let ends: [2]i32;
    ends[0] = 0 - 1; ends[1] = 0 - 1;
    if (pipe_create(PIPE_SIZE_MAX + 1, &ends[0]) != E_OUT_OF_RANGE) { return 36; }
    if (pipe_create(PIPE_SIZE_MAX, &ends[0]) != 0) { return 37; }
    let p: usize = alloc(PIPE_SIZE_MAX);
    let r: i32 = 0 - 1;
    if (p != 0) { r = file_write(ends[1], p as *u8, PIPE_SIZE_MAX as u64); free(p); }
    handle_close(ends[0]);
    handle_close(ends[1]);
    if (r != PIPE_SIZE_MAX as i32) { return 38; }
    return 0;
}

// 39-40: a memory object of MMAP_MAX_BYTES is made (its commit charged and
// given back), one byte more is refused
fn l_mem_max(arg: u64) -> i32 {
    if (mem_create((MMAP_MAX_BYTES as u64) + 1, 0) != E_OUT_OF_RANGE) { return 39; }
    let m: i32 = mem_create(MMAP_MAX_BYTES as u64, 0);
    if (m <= 0) { return 40; }
    handle_close(m);
    return 0;
}

// 41-43: a thread's stack of THREAD_USTACK_MIN - 1 bytes is refused, of
// THREAD_USTACK_MAX made (a mapping of that size while it lives), of one
// byte more refused; nothing is left mapped
fn l_ustack(arg: u64) -> i32 {
    let m0: u64 = mapped();
    if (thread_spawn(napper2, 0, (THREAD_USTACK_MIN as u64) - 1) != E_OUT_OF_RANGE) { return 41; }
    if (thread_spawn(napper2, 0, (THREAD_USTACK_MAX as u64) + 1) != E_OUT_OF_RANGE) { return 41; }
    let h: i32 = thread_spawn(napper2, 0, THREAD_USTACK_MAX as u64);
    if (h <= 0) { return 42; }
    let big: u64 = mapped();
    if (join(h) != 0) { return 42; }
    if (big != m0 + (THREAD_USTACK_MAX as u64) + (THREAD_BLOCK_BYTES as u64)) { return 43; }
    if (mapped() != m0) { return 43; }
    return 0;
}

// 44-46: a process's handles to its limit: duplicates are made until one
// is refused with E_NO_RESOURCES; after a close one more is made, and
// refused again past it; every one is closed. The limit is the kernel's
// (kernel.xkco max_handles), so the count is not known here: at least the
// 1000 the default 1024 leaves a program this small.
global hl_h: [1100]i32;

fn l_handles(arg: u64) -> i32 {
    let m: i32 = mem_create(4096, 0);
    if (m <= 0) { return 44; }
    let n: u32 = 0;
    let r: i32 = 0;
    while (n < 1100) {
        r = handle_duplicate(m, HRIGHT_INSPECT);
        if (r <= 0) { break; }
        hl_h[n] = r;
        n = n + 1;
    }
    let ok: i32 = 0;
    if (r != E_NO_RESOURCES || n < 1000) { ok = 44; }
    if (ok == 0) {
        handle_close(hl_h[n - 1]);
        hl_h[n - 1] = handle_duplicate(m, HRIGHT_INSPECT);
        if (hl_h[n - 1] <= 0) { ok = 45; }
        else if (handle_duplicate(m, HRIGHT_INSPECT) != E_NO_RESOURCES) { ok = 46; }
    }
    let i: u32 = 0;
    while (i < n) { if (hl_h[i] > 0) { handle_close(hl_h[i]); } i = i + 1; }
    handle_close(m);
    return ok;
}

// ==================== randomness (roadmap 1.7b) ====================

// 47-51: random_read through the prelude. Refusals first; then either the
// generator is seeded and two reads differ, or it is not and the read is
// refused with nothing written. Verification boots are seeded; the kernel's
// own test holds an unseeded generator for the refusal.
fn r_read(arg: u64) -> i32 {
    let a: [256]u8;            // RANDOM_READ_MAX
    let b: [32]u8;
    if (random_read(&a[0], 0) != 0) { return 47; }
    if (random_read(&a[0], (RANDOM_READ_MAX as u64) + 1) != E_OUT_OF_RANGE) { return 48; }
    let i: u32 = 0;
    while (i < 32) { a[i] = 0xA5; b[i] = 0xA5; i = i + 1; }
    let r: i32 = random_read(&a[0], 32);
    if (r == E_SHOULD_WAIT) {
        i = 0;
        while (i < 32) { if (a[i] != 0xA5) { return 49; } i = i + 1; }
        return 0;
    }
    if (r != 32) { return 50; }
    if (random_read(&b[0], 32) != 32) { return 50; }
    let same: u32 = 0;
    i = 0;
    while (i < 32) { if (a[i] == b[i]) { same = same + 1; } i = i + 1; }
    if (same == 32) { return 51; }
    if (random_read(&a[0], RANDOM_READ_MAX as u64) != RANDOM_READ_MAX as i32) { return 51; }
    return 0;
}

// ==================== memory (roadmap 1.9c) ====================

// 52: the main thread's stack arrives zeroed. spawn.c maps its 64 pages
// below USER_ARGS_BASE from the page allocator, whose free pages hold 0xA5
// in every byte in a test-hook build (PMM_POISON); the lowest 16 are never
// reached by a program this shallow, so they still hold what they came with.
const MAIN_STACK_BOTTOM: u64 = 0xBFFBF000;   // spawn.c: USER_STACK_TOP - 64 pages

fn m_stack_zeroed(arg: u64) -> i32 {
    let p: *u64 = MAIN_STACK_BOTTOM as *u64;
    let i: u32 = 0;
    while (i < 16 * 512) {
        if (p[i] != 0) { return 52; }
        i = i + 1;
    }
    return 0;
}

// ---- the display server's renderer (std/display.xfxn, roadmap 2.3) ----

// 60-67: damage is clipped, merged and collapsed, and counts its area
fn dsx_find(d: *ds_damage, x: u32, y: u32, w: u32, h: u32) -> u32 {
    let i: u32 = 0;
    while (i < d.n) {
        if (d.r[i].x == x && d.r[i].y == y && d.r[i].w == w && d.r[i].h == h) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn d_damage(arg: u64) -> i32 {
    let d: ds_damage;
    ds_damage_init(&d, 100, 100);
    ds_damage_add(&d, 10, 10, 10, 10);
    ds_damage_add(&d, 12, 12, 2, 2);                      // covered: nothing
    if (d.n != 1 || dsx_find(&d, 10, 10, 10, 10) == 0) { return 60; }
    ds_damage_add(&d, 80, 80, 5, 5);                      // apart
    ds_damage_add(&d, 15, 15, 10, 10);                    // overlaps the first
    if (d.n != 2 || dsx_find(&d, 10, 10, 15, 15) == 0 || dsx_find(&d, 80, 80, 5, 5) == 0) { return 61; }
    ds_damage_add(&d, 95, 95, 20, 20);                    // clipped to the screen
    ds_damage_add(&d, 200, 0, 5, 5);                      // off it
    ds_damage_add(&d, 0, 0, 0, 5);                        // empty
    if (d.n != 3 || dsx_find(&d, 95, 95, 5, 5) == 0) { return 62; }
    if (ds_damage_area(&d) != 225 + 25 + 25) { return 63; }
    // one that meets two swallows both
    ds_damage_init(&d, 100, 100);
    ds_damage_add(&d, 0, 0, 10, 10);
    ds_damage_add(&d, 20, 0, 10, 10);
    ds_damage_add(&d, 5, 0, 20, 5);
    if (d.n != 1 || dsx_find(&d, 0, 0, 30, 10) == 0) { return 64; }
    // touching edges merge: nothing is wasted
    ds_damage_add(&d, 30, 0, 5, 10);
    if (d.n != 1 || dsx_find(&d, 0, 0, 35, 10) == 0) { return 65; }
    // past DS_DAMAGE_MAX, one bounding box
    ds_damage_init(&d, 100, 100);
    let i: u32 = 0;
    while (i < DS_DAMAGE_MAX) { ds_damage_add(&d, i * 12, 0, 10, 10); i = i + 1; }
    if (d.n != DS_DAMAGE_MAX) { return 66; }
    ds_damage_add(&d, 0, 50, 10, 10);
    if (d.n != 1 || dsx_find(&d, 0, 0, 94, 60) == 0) { return 67; }
    return 0;
}

// 70-72: source-over, premultiplied
fn d_blend(arg: u64) -> i32 {
    if (ds_over(0x80800000, 0xFF336699) != 0xFF99334C) { return 70; }
    if (ds_over(0, 0xFF336699) != 0xFF336699 || ds_over(0xFF123456, 0xFF336699) != 0xFF123456) { return 71; }
    if (ds_over(0x40404040, 0) != 0x40404040) { return 72; }
    return 0;
}

// The reference scene on a 64 x 48 virtual screen: an opaque desktop with a
// red bar, a half-transparent red square over it, and a white square that
// runs off the bottom-right corner.
global dsx_desk: ds_surface;
global dsx_over: ds_surface;
global dsx_tip: ds_surface;

fn dsx_scene(c: *ds_comp, sc: *ds_screen, format: u32) -> i32 {
    if (ds_screen_virtual(sc, 64, 48, format) != 0) { return 1; }
    if (ds_comp_init(c, 64, 48) != 0) { return 1; }
    if (ds_surface_new(&dsx_desk, 64, 48) != 0 || ds_surface_new(&dsx_over, 16, 16) != 0
        || ds_surface_new(&dsx_tip, 4, 4) != 0) { return 1; }
    ds_fill(&dsx_desk, 0, 0, 64, 48, 0xFF336699);
    ds_fill(&dsx_desk, 8, 8, 16, 8, 0xFFFF0000);
    ds_fill(&dsx_over, 0, 0, 16, 16, 0x80800000);
    ds_fill(&dsx_tip, 0, 0, 4, 4, 0xFFFFFFFF);
    ds_layer_add(c, &dsx_desk, 0, 0, 1);
    ds_layer_add(c, &dsx_over, 24, 16, 0);
    ds_layer_add(c, &dsx_tip, 62, 46, 1);
    return 0;
}

fn dsx_scene_free(c: *ds_comp, sc: *ds_screen) -> void {
    ds_surface_free(&dsx_desk);
    ds_surface_free(&dsx_over);
    ds_surface_free(&dsx_tip);
    ds_comp_free(c);
    ds_screen_close(sc);
}

// One format's frame: the pixels worked out by hand, then the whole frame's
// fingerprint against the reference (printed when it differs, so a deliberate
// change can be pinned again).
fn dsx_frame(format: u32, desk: u32, red: u32, ov: u32, white: u32, want: u32, base: i32) -> i32 {
    let c: ds_comp;
    let sc: ds_screen;
    if (dsx_scene(&c, &sc, format) != 0) { dsx_scene_free(&c, &sc); return base; }
    ds_compose(&c);
    let n: u64 = ds_present(&c, &sc);
    let rc: i32 = 0;
    if (n != 64 * 48 || c.damage.n != 0) { rc = base + 1; }
    else if (ds_screen_pixel(&sc, 0, 0) != desk || ds_screen_pixel(&sc, 10, 10) != red
             || ds_screen_pixel(&sc, 30, 20) != ov || ds_screen_pixel(&sc, 63, 47) != white
             || ds_screen_pixel(&sc, 61, 47) != desk) { rc = base + 2; }
    else if (ds_screen_hash(&sc) != want) {
        puts("display: frame fingerprint ");
        print_hex(ds_screen_hash(&sc));
        newline();
        rc = base + 3;
    }
    dsx_scene_free(&c, &sc);
    return rc;
}

// 80-83, 85-88
fn d_frames(arg: u64) -> i32 {
    let rc: i32 = dsx_frame(SCREEN_XRGB8888, 0x00336699, 0x00FF0000, 0x0099334C, 0x00FFFFFF, 0x99166225, 80);
    if (rc != 0) { return rc; }
    return dsx_frame(SCREEN_RGB565, 0x3333, 0xF800, 0x9989, 0xFFFF, 0xF343F115, 85);
}

// 90-94: after a frame, only the damage reaches the screen: everything else
// keeps the poison written over it
fn d_damage_only(arg: u64) -> i32 {
    let c: ds_comp;
    let sc: ds_screen;
    if (dsx_scene(&c, &sc, SCREEN_XRGB8888) != 0) { dsx_scene_free(&c, &sc); return 90; }
    ds_compose(&c);
    ds_present(&c, &sc);
    let p: *u32 = sc.px as *u32;
    let i: u32 = 0;
    while (i < sc.size / 4) { p[i] = 0xA5A5A5A5; i = i + 1; }
    ds_layer_move(&c, 1, 8, 24);                           // the square, left and down
    let rc: i32 = 0;
    if (c.damage.n != 1 || dsx_find(&c.damage, 8, 16, 32, 24) == 0) { rc = 91; }
    ds_compose(&c);
    if (rc == 0 && ds_present(&c, &sc) != 32 * 24) { rc = 92; }
    let poison: u32 = 0;
    let y: u32 = 0;
    while (y < 48) {
        let x: u32 = 0;
        while (x < 64) { if (ds_screen_pixel(&sc, x, y) == 0xA5A5A5A5) { poison = poison + 1; } x = x + 1; }
        y = y + 1;
    }
    if (rc == 0 && poison != 64 * 48 - 32 * 24) { rc = 93; }
    if (rc == 0 && (ds_screen_pixel(&sc, 10, 26) != 0x0099334C || ds_screen_pixel(&sc, 30, 20) != 0x00336699)) { rc = 94; }
    // a rectangle inside the half-transparent square is composed from the
    // opaque desktop under it, not from the square: once, not blended twice
    ds_damage_add(&c.damage, 10, 30, 2, 2);
    ds_compose(&c);
    ds_present(&c, &sc);
    if (rc == 0 && ds_screen_pixel(&sc, 10, 30) != 0x0099334C) { rc = 95; }
    dsx_scene_free(&c, &sc);
    return rc;
}

// 96: the real screen needs GRANT_FRAMEBUFFER, which the runner does not give
fn d_screen_denied(arg: u64) -> i32 {
    let sc: ds_screen;
    if (ds_screen_open(&sc) != E_ACCESS_DENIED || sc.mem != -1) { return 96; }
    return 0;
}

// ---- windows (2.4) ----

const WX_DESK: u32 = 0x00102030;
const WX_DESK_ARGB: u32 = 0xFF102030;

global wx: dsv;
global wx_live: u32;

// A fresh server on a 320x240 virtual screen, a plain desktop, an invisible
// pointer: 0 or an error.
fn wx_up() -> i32 {
    // a test that stopped early left its server: not this test's failure too
    if (wx_live != 0) { wx_down(); }
    let rc: i32 = dsv_init(&wx, 320, 240, 1, 1);
    if (rc != 0) { return rc; }
    wx_live = 1;
    ds_fill(&wx.desktop, 0, 0, 320, 240, WX_DESK_ARGB);
    return 0;
}

// Drop everything wx_up made, clients with it.
fn wx_down() -> void {
    wx_live = 0;
    dsv_shutdown(&wx);
    handle_close(wx.queue);
    handle_close(wx.ep);
    ds_comp_free(&wx.comp);
    ds_surface_free(&wx.desktop);
    ds_surface_free(&wx.cursor);
}

fn wx_draw() -> void { ds_compose(&wx.comp); ds_present(&wx.comp, &wx.screen); wm_frames_done(&wx.w); }
fn wx_at(x: u32, y: u32) -> u32 { return ds_screen_pixel(&wx.screen, x, y) & 0xFFFFFF; }

// A window for client c, its first commit already made in one colour. The
// buffers are the test's own, so the lease is 0: the lease's rule is the
// server's and is tested through it, below. Its index, or WM_NONE.
fn wx_window(c: u32, w: u32, h: u32, flags: u32, argb: u32) -> u32 {
    let a: ds_surface;
    let b: ds_surface;
    if (ds_surface_new(&a, w, h) != 0 || ds_surface_new(&b, w, h) != 0) { return WM_NONE; }
    ds_fill(&a, 0, 0, w, h, argb);
    ds_fill(&b, 0, 0, w, h, argb);
    let id: i32 = wm_window_new(&wx.w, c, w, h, flags, "t", &a, &b);
    if (id < 0) { return WM_NONE; }
    if (wm_commit(&wx.w, id as u32, 0, 0, 0 as *ds_rect, 0) != WM_NONE) { return WM_NONE; }
    return id as u32;
}

// The next event for client c, or kind 0 if none.
fn wx_next(c: u32, ev: *wm_event) -> void {
    ev.kind = 0;
    wm_take(&wx.w, c, ev);
}

// Throw away what is queued for client c.
fn wx_clear(c: u32) -> void {
    let ev: wm_event;
    while (wm_take(&wx.w, c, &ev) == 1) { }
}

fn wx_click(x: i32, y: i32) -> void {
    wm_pointer(&wx.w, x, y, 1);
    wm_pointer(&wx.w, x, y, 0);
}

// Two windows: A at (24,24), B at (52,52) over it, both 100x60.
// A's content (26,44)-(125,103); B's (54,72)-(153,131); (80,90) is in both.
fn wx_two(a: *u32, b: *u32, ca: *u32, cb: *u32) -> i32 {
    ca[0] = wm_client_new(&wx.w);
    cb[0] = wm_client_new(&wx.w);
    a[0] = wx_window(ca[0], 100, 60, 0, 0xFFAA0000);
    b[0] = wx_window(cb[0], 100, 60, 0, 0xFF00BB00);
    if (a[0] == WM_NONE || b[0] == WM_NONE) { return 1; }
    wx_draw();
    wx_clear(ca[0]);
    wx_clear(cb[0]);
    return 0;
}

// 100: the stack: what is on top shows, a press raises and focuses
fn w_stack(arg: u64) -> i32 {
    let wr: i32 = wx_up();
    if (wr != 0) { return 1000 + (0 - wr); }
    let a: u32; let b: u32; let ca: u32; let cb: u32;
    if (wx_two(&a, &b, &ca, &cb) != 0) { return 101; }
    if (wx_at(30, 50) != 0xAA0000) { return 102; }
    if (wx_at(140, 120) != 0x00BB00) { return 103; }
    if (wx_at(80, 90) != 0x00BB00) { return 104; }
    if (wx_at(300, 230) != WX_DESK) { return 105; }
    if (wx.w.focus != b) { return 106; }
    // the frame is the server's: B's bar focused, A's idle
    if (wx_at(60, 54) != (WM_COL_FOCUS & 0xFFFFFF)) { return 107; }
    if (wx_at(30, 26) != (WM_COL_IDLE & 0xFFFFFF)) { return 108; }
    wx_click(30, 50);
    wx_draw();
    if (wx.w.focus != a || wx.w.z[1] != a) { return 109; }
    if (wx_at(80, 90) != 0xAA0000) { return 110; }
    if (wx_at(30, 26) != (WM_COL_FOCUS & 0xFFFFFF)) { return 111; }
    wx_down();
    return 0;
}

// 120: a key goes to the focused window and no other; the server's keys to none
fn w_keys(arg: u64) -> i32 {
    if (wx_up() != 0) { return 120; }
    let a: u32; let b: u32; let ca: u32; let cb: u32;
    if (wx_two(&a, &b, &ca, &cb) != 0) { return 121; }
    let ev: wm_event;
    wm_key(&wx.w, 97);
    wx_next(cb, &ev);
    if (ev.kind != WM_EV_KEY || ev.a != 97 || ev.win != b) { return 122; }
    wx_next(ca, &ev);
    if (ev.kind != 0) { return 123; }
    // the focus moves with Ctrl+N, which nobody is told as a key
    wm_key(&wx.w, WM_KEY_NEXT);
    if (wx.w.focus != a) { return 124; }
    wx_next(cb, &ev);
    if (ev.kind != WM_EV_FOCUS || ev.a != 0) { return 125; }
    wx_next(cb, &ev);
    if (ev.kind != 0) { return 126; }
    wx_next(ca, &ev);
    if (ev.kind != WM_EV_FOCUS || ev.a != 1) { return 127; }
    wx_next(ca, &ev);
    if (ev.kind != 0) { return 128; }
    wm_key(&wx.w, 98);
    wx_next(ca, &ev);
    if (ev.kind != WM_EV_KEY || ev.a != 98) { return 129; }
    wx_next(cb, &ev);
    if (ev.kind != 0) { return 130; }
    // Ctrl+Q ends the session, and reaches no client
    wm_key(&wx.w, WM_KEY_QUIT);
    if (wx.w.quit != 1) { return 131; }
    wx_next(ca, &ev);
    if (ev.kind != 0) { return 132; }
    wx_down();
    return 0;
}

// 140: the pointer: in the window under it, in its coordinates; held to
// the window a press landed in
fn w_pointer(arg: u64) -> i32 {
    if (wx_up() != 0) { return 140; }
    let a: u32; let b: u32; let ca: u32; let cb: u32;
    if (wx_two(&a, &b, &ca, &cb) != 0) { return 141; }
    let ev: wm_event;
    // over B's content
    wm_pointer(&wx.w, 60, 80, 0);
    wx_next(cb, &ev);
    if (ev.kind != WM_EV_POINTER || ev.a != 6 || ev.b != 8 || ev.c != 0) { return 142; }
    wx_next(ca, &ev);
    if (ev.kind != 0) { return 143; }
    // over nothing, and over a title: no window is told
    wm_pointer(&wx.w, 300, 230, 0);
    wm_pointer(&wx.w, 60, 54, 0);
    wx_next(cb, &ev);
    if (ev.kind != 0) { return 144; }
    // a press in B's content, dragged off it: still B's, in B's coordinates
    wm_pointer(&wx.w, 60, 80, 1);
    wx_next(cb, &ev);
    if (ev.kind != WM_EV_POINTER || ev.c != 1) { return 145; }
    wm_pointer(&wx.w, 30, 50, 1);
    wx_next(cb, &ev);
    if (ev.kind != WM_EV_POINTER || ev.a != (30 - 54) || ev.b != (50 - 72)) { return 146; }
    wx_next(ca, &ev);
    if (ev.kind != 0) { return 147; }
    wm_pointer(&wx.w, 30, 50, 0);
    wx_next(cb, &ev);
    if (ev.kind != WM_EV_POINTER || ev.c != 0) { return 148; }
    // released, the next movement belongs to what is under it
    wm_pointer(&wx.w, 31, 50, 0);
    wx_next(ca, &ev);
    if (ev.kind != WM_EV_POINTER || ev.a != 5) { return 149; }
    wx_next(cb, &ev);
    if (ev.kind != 0) { return 150; }
    wx_down();
    return 0;
}

// 160: the frame's title bar drags, and what was under it comes back
fn w_drag(arg: u64) -> i32 {
    if (wx_up() != 0) { return 160; }
    let a: u32; let b: u32; let ca: u32; let cb: u32;
    if (wx_two(&a, &b, &ca, &cb) != 0) { return 161; }
    wm_pointer(&wx.w, 60, 54, 1);       // B's title bar, 8 in and 2 down
    wx_clear(cb);
    wm_pointer(&wx.w, 208, 164, 1);
    wx_draw();
    if (wx.w.win[b].x != 200 || wx.w.win[b].y != 162) { return 162; }
    if (wx_at(80, 90) != 0xAA0000) { return 163; }       // A shows through
    if (wx_at(140, 120) != WX_DESK) { return 164; }       // the desktop too
    if (wx_at(210, 190) != 0x00BB00) { return 165; }
    wm_pointer(&wx.w, 208, 164, 0);
    wm_pointer(&wx.w, 260, 200, 0);     // released: no longer dragged
    if (wx.w.win[b].x != 200) { return 166; }
    // dragged past the corner, it stops on the screen
    wm_pointer(&wx.w, 208, 164, 1);
    wm_pointer(&wx.w, 2, 1, 1);
    wm_pointer(&wx.w, 2, 1, 0);
    if (wx.w.win[b].x != 0 || wx.w.win[b].y != 0) { return 167; }
    wx_down();
    return 0;
}

// 180: only what a commit says changed is composed, and a rectangle
// cannot reach outside its window
fn w_commit(arg: u64) -> i32 {
    if (wx_up() != 0) { return 180; }
    let c: u32 = wm_client_new(&wx.w);
    let i: u32 = wx_window(c, 40, 30, 0, 0xFF808080);
    if (i == WM_NONE) { return 181; }
    wx_draw();
    let win: *wm_win = &wx.w.win[i];
    if (win.cur != 0) { return 182; }
    ds_fill(&win.buf[1], 0, 0, 40, 30, 0xFF0000FF);
    let r: [2]ds_rect;
    ds_rect_set(&r[0], 2, 3, 4, 5);
    ds_rect_set(&r[1], 39, 29, 0xFFFFFFF0, 0xFFFFFFF0);
    // the buffer shown can be committed no second time, and 2 is no buffer
    if (wm_commit(&wx.w, i, 0, 0, &r[0], 1) != WM_COMMIT_REFUSED) { return 183; }
    if (wm_commit(&wx.w, i, 2, 0, &r[0], 1) != WM_COMMIT_REFUSED) { return 184; }
    if (wm_commit(&wx.w, i, 1, 0, &r[0], 2) != 0) { return 185; }
    if (win.cur != 1 || win.want_frame != 1) { return 186; }
    let ox: u32 = win.x + WM_EDGE;
    let oy: u32 = win.y + WM_TITLE_H;
    // the huge rectangle stops at the window: what is damaged is inside it
    let dk: u32 = 0;
    let sawd: u32 = 0;
    while (dk < wx.comp.damage.n) {
        let dr: *ds_rect = &wx.comp.damage.r[dk];
        if (dr.x + dr.w > ox + 40 || dr.y + dr.h > oy + 30) { sawd = 1; }
        dk = dk + 1;
    }
    if (sawd != 0) { return 192; }
    wx_draw();
    if (wx_at(ox + 2, oy + 3) != 0x0000FF) { return 187; }
    if (wx_at(ox + 39, oy + 29) != 0x0000FF) { return 188; }
    if (wx_at(ox + 10, oy + 10) != 0x808080) { return 189; }   // not damaged, so not redrawn
    if (wx_at(ox + 40, oy + 29) != (WM_COL_FOCUS & 0xFFFFFF)) { return 190; }   // its edge, intact
    // told once, when it reached the screen
    let ev: wm_event;
    let frames: u32 = 0;
    wx_next(c, &ev);
    while (ev.kind != 0) { if (ev.kind == WM_EV_FRAME) { frames = frames + 1; } wx_next(c, &ev); }
    if (frames != 2) { return 191; }                         // the first commit's and this
    wx_down();
    return 0;
}

// 200: transparency: a translucent window over the desktop; its hole in the frame
fn w_alpha(arg: u64) -> i32 {
    if (wx_up() != 0) { return 200; }
    let c: u32 = wm_client_new(&wx.w);
    if (wx_window(c, 40, 30, WM_F_ALPHA, 0x80404040) == WM_NONE) { return 201; }
    wx_draw();
    let win: *wm_win = &wx.w.win[0];
    // 0x40 + 0x10 * 0x7F / 255 = 0x47, and the same for the other channels
    let want: u32 = (ds_over(0x80404040, WX_DESK_ARGB)) & 0xFFFFFF;
    if (want == WX_DESK || want == 0x404040) { return 202; }
    if (wx_at(win.x + WM_EDGE + 5, win.y + WM_TITLE_H + 5) != want) { return 203; }
    wx_down();
    return 0;
}

// 220: a client that stops reading goes grey; its close box then ends it.
// One that reads is only asked.
fn w_hung(arg: u64) -> i32 {
    if (wx_up() != 0) { return 220; }
    let a: u32; let b: u32; let ca: u32; let cb: u32;
    if (wx_two(&a, &b, &ca, &cb) != 0) { return 221; }
    wm_tick(&wx.w, 1000);
    wm_key(&wx.w, 97);                  // B has something to read now
    wm_tick(&wx.w, 1000 + WM_HANG_MS - 1);
    if (wx.w.client[cb].hung != 0) { return 222; }
    // a press on the close box of one that answers asks it
    wm_pointer(&wx.w, 144, 58, 1);      // B's close box, B on top
    wm_pointer(&wx.w, 144, 58, 0);
    let ev: wm_event;
    if (wx.w.client[cb].kill != 0) { return 223; }
    wx_next(cb, &ev);
    while (ev.kind != 0 && ev.kind != WM_EV_CLOSE) { wx_next(cb, &ev); }
    if (ev.kind != WM_EV_CLOSE) { return 224; }
    wm_tick(&wx.w, 1000);
    wm_key(&wx.w, 97);
    wm_tick(&wx.w, 1000 + WM_HANG_MS);
    wx_draw();
    if (wx.w.client[cb].hung != 1) { return 225; }
    if (wx_at(60, 54) != (WM_COL_HUNG & 0xFFFFFF)) { return 226; }
    // a client with nothing to read has not stopped answering
    if (wx.w.client[ca].hung != 0) { return 227; }
    // it can still be moved
    wm_pointer(&wx.w, 60, 54, 1);
    wm_pointer(&wx.w, 70, 60, 1);
    wm_pointer(&wx.w, 70, 60, 0);
    if (wx.w.win[b].x != 62) { return 228; }
    // and its close box ends it
    wm_pointer(&wx.w, 154, 64, 1);      // moved 10 right, 8 down... the box follows
    wm_pointer(&wx.w, 154, 64, 0);
    if (wx.w.client[cb].kill != 1) { return 229; }
    // waiting for an event again is answering
    wx.w.client[cb].kill = 0;
    wm_wait(&wx.w, cb, 0);
    if (wx.w.client[cb].hung != 0) { return 230; }
    wx_down();
    return 0;
}

// 240: a client that goes takes its windows with it, and the focus moves on
fn w_gone(arg: u64) -> i32 {
    if (wx_up() != 0) { return 240; }
    let a: u32; let b: u32; let ca: u32; let cb: u32;
    if (wx_two(&a, &b, &ca, &cb) != 0) { return 241; }
    wm_client_gone(&wx.w, cb);
    wx_draw();
    if (wx.w.zn != 1 || wx.w.focus != a) { return 242; }
    if (wx_at(140, 120) != WX_DESK) { return 243; }
    if (wx_at(80, 90) != 0xAA0000) { return 244; }
    if (wx.w.client[cb].used != 0) { return 245; }
    let ev: wm_event;
    wx_next(ca, &ev);
    if (ev.kind != WM_EV_FRAME && ev.kind != WM_EV_FOCUS) { return 246; }
    wm_client_gone(&wx.w, ca);
    wx_draw();
    if (wx.w.focus != WM_NONE || wx_at(80, 90) != WX_DESK) { return 247; }
    wm_key(&wx.w, 97);                  // nobody to tell: nothing goes wrong
    wx_down();
    return 0;
}

// 260: the limits: the windows a client may have, and the slot one frees
fn w_limits(arg: u64) -> i32 {
    if (wx_up() != 0) { return 260; }
    let c: u32 = wm_client_new(&wx.w);
    let i: u32 = 0;
    while (i < WM_PER_CLIENT) {
        if (wx_window(c, 8, 8, 0, 0xFFFFFFFF) == WM_NONE) { return 261; }
        i = i + 1;
    }
    if (wx_window(c, 8, 8, 0, 0xFFFFFFFF) != WM_NONE) { return 262; }
    // another client is not held to the first one's count
    let d: u32 = wm_client_new(&wx.w);
    if (wx_window(d, 8, 8, 0, 0xFFFFFFFF) == WM_NONE) { return 263; }
    wx_down();
    return 0;
}

// 280: a title, from a font: its pixels where the font says
fn w_text(arg: u64) -> i32 {
    let s: ds_surface;
    if (ds_surface_new(&s, 32, 16) != 0) { return 280; }
    // 2 glyphs of 8x2: glyph 1 is a bar on the left and a dot on the right
    let bits: [4]u8;
    bits[0] = 0; bits[1] = 0; bits[2] = 0xF0; bits[3] = 0x01;
    let f: ds_font;
    f.bits = &bits[0]; f.width = 8; f.height = 2; f.count = 2;
    let text: [3]u8;
    text[0] = 1; text[1] = 1; text[2] = 0;
    ds_text(&s, &f, 4, 3, 32, &text[0], 0xFFFFFFFF);
    if (ds_pixel(&s, 4, 3) != 0xFFFFFFFF || ds_pixel(&s, 7, 3) != 0xFFFFFFFF) { return 281; }
    if (ds_pixel(&s, 8, 3) != 0 || ds_pixel(&s, 11, 4) != 0xFFFFFFFF) { return 282; }
    if (ds_pixel(&s, 12, 3) != 0xFFFFFFFF) { return 283; }       // the second glyph
    // room for one glyph: the second is not drawn
    ds_fill(&s, 0, 0, 32, 16, 0);
    ds_text(&s, &f, 4, 3, 8, &text[0], 0xFFFFFFFF);
    if (ds_pixel(&s, 4, 3) != 0xFFFFFFFF || ds_pixel(&s, 12, 3) != 0) { return 284; }
    ds_surface_free(&s);
    return 0;
}

// ---- real clients, through the real protocol ----

fn wx_blob(out: *u8, rgb: *u8, mode: *u8) -> u32 {
    let n: u32 = strcopy(out, "wdemo", 16) + 1;
    n = n + strcopy(&out[n], rgb, 16) + 1;
    if (mode != (0 as *u8)) { n = n + strcopy(&out[n], mode, 16) + 1; }
    return n;
}

fn wx_start(rgb: *u8, mode: *u8) -> i32 {
    let blob: [64]u8;
    let n: u32 = wx_blob(&blob[0], rgb, mode);
    return dsv_launch(&wx, "/Shared/Programs/wdemo.xuex", &blob[0], n);
}

const WX_WAIT_MS: u64 = 25000;

// Turn the loop until `n` windows are showing, or a long time has passed.
fn wx_shown(n: u32) -> u32 {
    let t0: u64 = time_now_ms();
    while (time_now_ms() - t0 < WX_WAIT_MS) {
        dsv_step(&wx);
        let k: u32 = 0;
        let up: u32 = 0;
        while (k < wx.w.zn) { if (wx.w.win[wx.w.z[k]].cur != WM_NONE) { up = up + 1; } k = k + 1; }
        if (up == n) { return 1; }
    }
    return 0;
}

// Turn the loop until the screen has this at (x, y).
fn wx_until(x: u32, y: u32, rgb: u32) -> u32 {
    let t0: u64 = time_now_ms();
    while (time_now_ms() - t0 < WX_WAIT_MS) {
        dsv_step(&wx);
        if (wx_at(x, y) == rgb) { return 1; }
    }
    return 0;
}

// Turn the loop until n clients are left.
fn wx_gone(n: u32) -> u32 {
    let t0: u64 = time_now_ms();
    while (dsv_clients(&wx) != n && time_now_ms() - t0 < WX_WAIT_MS) { dsv_step(&wx); }
    if (dsv_clients(&wx) == n) { return 1; }
    return 0;
}

// 300: two real programs, the whole way through: each key is drawn only by
// the focused one, a close box asks one to go, and one that stops reading goes
// grey and is ended. One test, because each program started is a signature
// checked, which is a minute under emulation.
global wx_real_ph: i32;

fn wx_real_body() -> i32 {
    if (wx_up() != 0) { return 300; }
    let c0: i32 = wx_start("aa0000", 0 as *u8);
    let c1: i32 = wx_start("00bb00", 0 as *u8);
    if (c0 < 0 || c1 < 0) { return 301; }
    if (wx_shown(2) == 0) { return 302; }
    // windows are 160x100: (30,50) is only the lower one's, (200,165) the upper's
    let top: u32 = wx.w.z[1];
    let low: u32 = wx.w.z[0];
    if (wx.w.focus != top || wx.w.win[top].x != 52 || wx.w.win[low].x != 24) { return 303; }
    let up_x: u32 = 200;
    let up_y: u32 = 165;
    let low_was: u32 = wx_at(30, 50);
    if (low_was != 0xAA0000 && low_was != 0x00BB00) { return 304; }

    // a key: drawn by the focused one alone
    wm_key(&wx.w, 0x61);
    if (wx_until(up_x, up_y, 0x616161) == 0) { return 305; }
    if (wx_at(30, 50) != low_was) { return 306; }
    // the other one, then a key: drawn by it, the first unchanged
    wm_key(&wx.w, WM_KEY_NEXT);
    if (wx.w.focus != low) { return 307; }
    wm_key(&wx.w, 0x62);
    if (wx_until(30, 50, 0x626262) == 0) { return 308; }
    if (wx_at(up_x, up_y) != 0x616161) { return 309; }
    // a third commit from it: the buffer the first gave back can be drawn on again
    wm_key(&wx.w, 0x63);
    if (wx_until(30, 50, 0x636363) == 0) { return 310; }

    // the close box asks; the program closes its window and exits
    let lc: u32 = wx.w.win[low].client;
    let x: u32 = wx.w.win[low].x + wm_frame_w(&wx.w.win[low]) - WM_EDGE - 4;
    let y: u32 = wx.w.win[low].y + 5;
    wx_real_ph = handle_duplicate(wx.proc[lc], HRIGHT_WAIT | HRIGHT_INSPECT | HRIGHT_KILL);
    let ph: i32 = wx_real_ph;
    if (ph <= 0) { return 311; }
    wx_click(x as i32, y as i32);
    if (wx_gone(1) == 0) { return 312; }
    if (object_wait(ph, SIGNAL_PROCESS_ENDED, time_deadline_ms(30000), 0 as *u32) != 0) { return 313; }
    let pi: process_info;
    let oi: object_info_args;
    memzero((&oi) as *u8, sizeof oi);
    oi.handle = ph; oi.topic = OBJINFO_PROCESS; oi.buf = (&pi) as u64; oi.cap = sizeof pi;
    if (object_info(&oi) < 0 || pi.ended != PROC_EXITED || pi.code != 0) { return 314; }
    handle_close(ph);
    wx_real_ph = 0;
    if (wx_until(30, 50, WX_DESK) == 0) { return 315; }

    // the other stops reading: with something to read it goes grey
    let left: u32 = wx.w.z[0];
    let hc: u32 = wx.w.win[left].client;
    wm_key(&wx.w, 72);
    wm_key(&wx.w, 0x64);
    let t0: u64 = time_now_ms();
    while (wx.w.client[hc].hung == 0 && time_now_ms() - t0 < WX_WAIT_MS) { dsv_step(&wx); }
    if (wx.w.client[hc].hung != 1) { return 316; }
    if (wx_until(wx.w.win[left].x + 10, wx.w.win[left].y + 3, WM_COL_HUNG & 0xFFFFFF) == 0) { return 317; }
    // its close box ends it, asking nothing
    x = wx.w.win[left].x + wm_frame_w(&wx.w.win[left]) - WM_EDGE - 4;
    y = wx.w.win[left].y + 5;
    wx_real_ph = handle_duplicate(wx.proc[hc], HRIGHT_WAIT | HRIGHT_INSPECT | HRIGHT_KILL);
    ph = wx_real_ph;
    if (ph <= 0) { return 318; }
    wx_click(x as i32, y as i32);
    if (wx_gone(0) == 0) { return 319; }
    if (object_wait(ph, SIGNAL_PROCESS_ENDED, time_deadline_ms(30000), 0 as *u32) != 0) { return 320; }
    memzero((&oi) as *u8, sizeof oi);
    oi.handle = ph; oi.topic = OBJINFO_PROCESS; oi.buf = (&pi) as u64; oi.cap = sizeof pi;
    if (object_info(&oi) < 0 || pi.ended == PROC_EXITED) { return 321; }
    handle_close(ph);
    wx_real_ph = 0;
    if (wx_until(200, 165, WX_DESK) == 0) { return 322; }
    wx_down();
    return 0;
}

// Whichever way it stopped, its programs do not outlive it: the runner checks
// that nothing is left, and one test's stray client is not the next one's.
fn w_real(arg: u64) -> i32 {
    wx_real_ph = 0;
    let rc: i32 = wx_real_body();
    if (wx_live != 0) { wx_down(); }
    if (wx_real_ph > 0) {
        process_kill(wx_real_ph);
        object_wait(wx_real_ph, SIGNAL_PROCESS_ENDED, time_deadline_ms(30000), 0 as *u32);
        handle_close(wx_real_ph);
        wx_real_ph = 0;
    }
    return rc;
}

// The hostile client's thread: it runs the protocol by hand. 0 = all refused.
global wx_hostile_ep: i32;
global wx_hostile_rc: i32;
global wx_hostile_done: i32;
global wx_hostile_win: win;

fn wx_call_raw(ep: i32, bytes: *u8, len: u64, h: *ipc_handle, count: u32, rep: *ds_rep) -> i32 {
    let a: ipc_call_args;
    memzero((&a) as *u8, sizeof a);
    a.ep_handle = ep;
    a.req = bytes as u64;
    a.req_len = len;
    a.reply = rep as u64;
    a.reply_cap = sizeof *rep;
    a.handles = h as u64;
    a.handle_count = count;
    let n: i32 = ipc_call(&a);
    if (n < 0) { return n; }
    return rep.status;
}

global wx_big: [65536]u8;

fn wx_hostile_body() -> i32 {
    let w: *win = &wx_hostile_win;
    if (win_open(w, wx_hostile_ep, 40, 30, 0, "h") != 0) { return 1; }
    let rep: ds_rep;
    // a message too big for the protocol, whole 64 KiB, that starts like a
    // real request for its own window: refused, not stuck, and not obeyed
    let big: *ds_req = (&wx_big[0]) as *ds_req;
    big.op = DS_OP_WINDOW_CLOSE;
    big.win = w.id;
    if (wx_call_raw(wx_hostile_ep, &wx_big[0], 65536, 0 as *ipc_handle, 0, &rep) != E_INVALID_ARGS) { return 2; }
    // a window that is not its own, or none
    let req: ds_req;
    memzero((&req) as *u8, sizeof req);
    req.op = DS_OP_WINDOW_CLOSE; req.win = 15;
    if (wx_call_raw(wx_hostile_ep, (&req) as *u8, sizeof req, 0 as *ipc_handle, 0, &rep) != E_INVALID_ARGS) { return 3; }
    // a buffer too small for the size it claims
    // (two objects each time: the kernel refuses one handle named twice in a
    // call, which would refuse these before the server saw them)
    let hs: [2]ipc_handle;
    hs[0].handle = mem_create(4096, 0); hs[0].op = IPC_HANDLE_COPY; hs[0].rights = HRIGHT_MAP | HRIGHT_INSPECT; hs[0].reserved = 0;
    hs[1] = hs[0];
    hs[1].handle = mem_create(4096, 0);
    memzero((&req) as *u8, sizeof req);
    req.op = DS_OP_WINDOW_NEW; req.w = 400; req.h = 400;
    if (wx_call_raw(wx_hostile_ep, (&req) as *u8, sizeof req, &hs[0], 2, &rep) != E_INVALID_ARGS) { return 4; }
    // too large a window; an unknown flag
    // (on buffers that would have room for it)
    hs[0].handle = mem_create(((WM_DIM_MAX + 1) as u64) * 4, 0);
    hs[1].handle = mem_create(((WM_DIM_MAX + 1) as u64) * 4, 0);
    req.w = WM_DIM_MAX + 1; req.h = 1;
    if (wx_call_raw(wx_hostile_ep, (&req) as *u8, sizeof req, &hs[0], 2, &rep) != E_INVALID_ARGS) { return 5; }
    req.w = 1; req.flags = 2;
    if (wx_call_raw(wx_hostile_ep, (&req) as *u8, sizeof req, &hs[0], 2, &rep) != E_INVALID_ARGS) { return 6; }
    // a lease on some other object, offered as the window's buffer
    let other: i32 = mem_create(40 * 30 * 4, 0);
    let lease: i32 = mem_lend(other);
    if (lease <= 0) { return 7; }
    let h: ipc_handle;
    h.handle = lease; h.op = IPC_HANDLE_MOVE; h.rights = IPC_RIGHTS_SAME; h.reserved = 0;
    memzero((&req) as *u8, sizeof req);
    req.op = DS_OP_COMMIT; req.win = w.id; req.buffer = 0;
    if (wx_call_raw(wx_hostile_ep, (&req) as *u8, sizeof req, &h, 1, &rep) != E_INVALID_ARGS) { return 8; }
    // and a commit with no lease at all
    if (wx_call_raw(wx_hostile_ep, (&req) as *u8, sizeof req, 0 as *ipc_handle, 0, &rep) != E_INVALID_ARGS) { return 9; }
    // it refused those, and that refused lease came back as lifted
    let a: vm_map_args;
    memzero((&a) as *u8, sizeof a);
    a.object = other as u32; a.length = 4096; a.prot = MPROT_READ | MPROT_WRITE;
    if (vm_map(&a) != E_OK) { return 10; }
    vm_unmap(a.addr, 0);

    // a real commit: then the buffer on the screen cannot be mapped writable
    ds_fill(&w.s, 0, 0, 40, 30, 0xFF123456);
    if (win_commit(w) != 0) { return 11; }
    memzero((&a) as *u8, sizeof a);
    a.object = w.mem[0] as u32; a.length = 4096; a.prot = MPROT_READ | MPROT_WRITE;
    if (vm_map(&a) != E_BUSY) { return 12; }
    // the second commit gives the first back
    ds_fill(&w.s, 0, 0, 40, 30, 0xFF654321);
    if (win_commit(w) != 0) { return 13; }
    if (w.back != 0) { return 14; }
    win_close(w);
    return 0;
}

fn wx_hostile(arg: u64) -> i32 {
    wx_hostile_rc = wx_hostile_body();
    wx_hostile_done = 1;
    return 0;
}

// 360: a client that breaks the protocol is refused and the server carries on
global wx_hostile_t: i32;

fn wx_hostile_run() -> i32 {
    if (wx_up() != 0) { return 360; }
    let c: u32 = wm_client_new(&wx.w);
    wx_hostile_ep = ep_mint(wx.ep, (c + 1) as u64, HRIGHT_SEND);
    if (wx_hostile_ep <= 0) { return 361; }
    wx_hostile_done = 0;
    wx_hostile_t = thread_spawn(wx_hostile, 0, 0);
    let t: i32 = wx_hostile_t;
    if (t <= 0) { return 362; }
    let t0: u64 = time_now_ms();
    while (wx_hostile_done == 0 && time_now_ms() - t0 < WX_WAIT_MS) { dsv_step(&wx); }
    if (wx_hostile_done == 0) { return 363; }
    let tc: i32 = 0;
    if (thread_join(t, time_deadline_ms(10000), &tc) != 0) { return 364; }
    wx_hostile_t = 0;
    if (wx_hostile_rc != 0) { return 370 + wx_hostile_rc; }
    return 0;
}

// Its server goes either way, which frees a client thread still in a call.
fn w_hostile(arg: u64) -> i32 {
    wx_hostile_t = 0;
    wx_hostile_ep = 0;
    let rc: i32 = wx_hostile_run();
    if (wx_hostile_ep > 0) { handle_close(wx_hostile_ep); }
    if (wx_live != 0) { wx_down(); }
    if (wx_hostile_t > 0) {
        let tc: i32 = 0;
        thread_join(wx_hostile_t, time_deadline_ms(10000), &tc);
    }
    return rc;
}

// The names are what the boot reports, after "x: ".
fn all() -> void {
    test_run("threads: create refusals",               t_create_refused,           30000);
    test_run("threads: workers joined with codes",     t_workers_joined,           30000);
    test_run("threads: stacks, a join's deadline",     t_stacks_and_join_deadline, 30000);
    test_run("threads: a block each in FS",            t_tls_blocks,               30000);
    test_run("threads: names refused and set",         t_names,                    30000);
    test_run("threads: cpu time and names",            t_cpu_time_and_names,       30000);
    test_run("futex: refusals, waits that end at once", f_refusals,                30000);
    test_run("futex: a wake wakes its waiter",         f_wake_one,                 30000);
    test_run("futex: a wake of two wakes two",         f_wake_two,                 30000);
    test_run("futex: one object mapped twice",         f_one_object_two_maps,      30000);
    test_run("sync: a mutex's word is its owner",      s_mutex_owner,              30000);
    test_run("sync: four threads, a mutex, the heap",  s_mutex_contended,          300000);
    test_run("sync: a cond carries items",             s_cond_carries,             30000);
    test_run("sync: a timed cond wait ends",           s_cond_deadline,            30000);
    test_run("sync: once runs once",                   s_once,                     30000);
    test_run("sync: alloc takes the heap lock",        s_heap_locked,              30000);
    test_run("sync: output takes its lock",            s_output_locked,            30000);
    test_run("limits: a pipe of PIPE_SIZE_MAX",        l_pipe_max,                 30000);
    test_run("limits: a memory object of the most",    l_mem_max,                  30000);
    test_run("limits: thread stacks, both ends",       l_ustack,                   30000);
    test_run("limits: a process's handles",            l_handles,                  60000);
    test_run("random: random_read",                    r_read,                     30000);
    test_run("memory: a new process's stack is zeroed", m_stack_zeroed,            30000);
    test_run("display: damage clipped, merged, bounded", d_damage,                  30000);
    test_run("display: source-over, premultiplied",    d_blend,                    30000);
    test_run("display: reference frames, both formats", d_frames,                  60000);
    test_run("display: only the damage is presented",  d_damage_only,              60000);
    test_run("display: the screen needs its grant",    d_screen_denied,            30000);
    test_run("windows: the stack, a press raises",     w_stack,                    30000);
    test_run("windows: keys to the focused one only",  w_keys,                     30000);
    test_run("windows: the pointer, held by a press",  w_pointer,                  30000);
    test_run("windows: a title bar drags",             w_drag,                     30000);
    test_run("windows: a commit's damage, bounded",    w_commit,                   30000);
    test_run("windows: transparency",                  w_alpha,                    30000);
    test_run("windows: not answering, grey and ended", w_hung,                     30000);
    test_run("windows: a client gone takes its own",   w_gone,                     30000);
    test_run("windows: how many a client may have",    w_limits,                   30000);
    test_run("windows: a title's pixels",              w_text,                     30000);
    test_run("windows: real clients, the whole way",   w_real,                     400000);
    test_run("windows: a hostile client is refused",   w_hostile,                  120000);
}

fn _start() -> void { test_main(all); }
