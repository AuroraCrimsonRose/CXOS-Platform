// apps/wdemo.xfxn - a window, drawn by a client (roadmap 2.4).
// Aurora Tejeda / CATX Systems
// Threads: one.
//
//   run +screen +spawn +endpoint +disk displayd wdemo wdemo
//
// Started by the display server, which is how it gets its connection. It
// fills its window with one colour and, for each key, with a colour that key
// names, so a test can see from the screen which window got which key.
//
//   wdemo [rrggbb [alpha]]
//
//   rrggbb   the colour to start with (hex)
//   alpha    the window is translucent: alpha 0x80, premultiplied
//
// The key H stops it reading events for good, which is what a client that
// has hung looks like to the server. C asks to read the screen and reads it
// once; O asks for an overlay and opens one. Either goes green if it was
// allowed and red if it was refused.
//
// The key L shows a retained layer, a small square, and sends it to the other
// side of the window on a spring; F fades it in or out, S scales it. Pressed
// again mid-flight it turns round with the speed it has. The server does the
// animating: this program is asleep in win_wait.

import "window.xfxn";

global wd_win: win;
global wd_layer: win_layer;
global wd_have_layer: u32;
global wd_right: u32;
global wd_faded: u32;
global wd_big: u32;

const WD_SQUARE: u32 = 24;

fn wd_hex(s: *u8) -> u32 {
    let v: u32 = 0;
    let i: u32 = 0;
    while (s[i] != 0) {
        let d: u32 = s[i] as u32;
        if (d >= 48 && d <= 57) { d = d - 48; }
        else if (d >= 97 && d <= 102) { d = d - 87; }
        else { return v; }
        v = (v << 4) | d;
        i = i + 1;
    }
    return v;
}

fn wd_arg(n: u32) -> *u8 {
    let ai: args_info;
    if (args_read(&ai) != 0 || n >= ai.count) { return 0 as *u8; }
    let page: *u32 = ai.base as *u32;
    return (ai.base + (page[1 + n] as u64)) as *u8;
}

fn wd_is(s: *u8, word: *u8) -> u32 {
    if (s == (0 as *u8)) { return 0; }
    if (strlen(s) != strlen(word)) { return 0; }
    if (strneq(s, word, strlen(word)) != 0) { return 1; }
    return 0;
}

// the colour a key names: its code in each channel
fn wd_key_colour(code: u32) -> u32 {
    let k: u32 = code & 0xFF;
    return (k << 16) | (k << 8) | k;
}

fn wd_paint(rgb: u32, alpha: u32) -> i32 {
    let c: u32 = 0xFF000000 | rgb;
    if (alpha == 1) {
        // premultiplied at 0x80
        let r: u32 = (((rgb >> 16) & 0xFF) * 0x80) / 255;
        let g: u32 = (((rgb >> 8) & 0xFF) * 0x80) / 255;
        let b: u32 = ((rgb & 0xFF) * 0x80) / 255;
        c = 0x80000000 | (r << 16) | (g << 8) | b;
    }
    ds_fill(&wd_win.s, 0, 0, wd_win.width, wd_win.height, c);
    return win_commit(&wd_win);
}

// Show the square, and send it across. 0 or an error.
fn wd_layer_go(p: *ds_lprops) -> i32 {
    if (wd_have_layer == 0) {
        let rc: i32 = win_layer_open(&wd_layer, WD_SQUARE, WD_SQUARE);
        if (rc != 0) { return rc; }
        ds_fill(&wd_layer.s, 0, 0, WD_SQUARE, WD_SQUARE, 0xFFF0C020);
        rc = win_layer_add(&wd_win, &wd_layer, SC_NONE, 0);
        if (rc != 0) { return rc; }
        wd_have_layer = 1;
    }
    p.k = SP_K;
    p.c = 22;       // under-damped, so that it is seen to be a spring
    return win_layer_set(&wd_win, wd_layer.id, p);
}

// A key for the layer: 0, or an error.
fn wd_layer_key(code: i32) -> i32 {
    let p: ds_lprops;
    memzero((&p) as *u8, sizeof p);
    if (code == 76) {
        wd_right = 1 - wd_right;
        p.mask = WM_LP_POS;
        p.x = (wd_right * (wd_win.width - WD_SQUARE)) as i32;
        p.y = 10;
    }
    if (code == 70) {
        wd_faded = 1 - wd_faded;
        p.mask = WM_LP_ALPHA;
        p.alpha = 255 - wd_faded * 200;
    }
    if (code == 83) {
        wd_big = 1 - wd_big;
        p.mask = WM_LP_SCALE | WM_LP_ANCHOR;
        p.ax = (WD_SQUARE / 2) as i32;
        p.ay = (WD_SQUARE / 2) as i32;
        p.scale = 1000 + wd_big * 800;
    }
    return wd_layer_go(&p);
}

global wd_overlay: win;

// Key C: ask, and read the screen once (640x480 is not assumed: 16 MiB is
// enough for 2048x2048). 0x00C000 allowed, 0xC00000 refused.
fn wd_capture_key() -> u32 {
    if (win_consent(&wd_win, WM_CAP_CAPTURE) != 0) { return 0xC00000; }
    let mem: i32 = mem_create(16 * 1024 * 1024, 0);
    if (mem <= 0) { return 0xC00000; }
    let rc: i32 = win_capture(&wd_win, mem);
    handle_close(mem);
    if (rc != 0) { return 0xC00000; }
    return 0x00C000;
}

// Key O: ask, and open a small window above all the others.
fn wd_overlay_key() -> u32 {
    if (win_consent(&wd_win, WM_CAP_OVERLAY) != 0) { return 0xC00000; }
    if (win_open(&wd_overlay, wd_win.ep, 80, 40, WM_F_OVERLAY, "overlay") != 0) { return 0xC00000; }
    ds_fill(&wd_overlay.s, 0, 0, 80, 40, 0xFFE0A000);
    if (win_commit(&wd_overlay) != 0) { return 0xC00000; }
    return 0x00C000;
}

fn _start() -> void {
    let ep: i32 = win_connection();
    if (ep <= 0) { exit(2); }
    let rgb: u32 = 0x3070B0;
    let a1: *u8 = wd_arg(1);
    if (a1 != (0 as *u8)) { rgb = wd_hex(a1); }
    let mode: *u8 = wd_arg(2);
    let alpha: u32 = wd_is(mode, "alpha");
    let flags: u32 = 0;
    if (alpha == 1) { flags = WM_F_ALPHA; }
    let rc: i32 = win_open(&wd_win, ep, 160, 100, flags, "wdemo");
    if (rc != 0) { exit(3); }
    rc = wd_paint(rgb, alpha);
    if (rc != 0) { exit(4); }
    let ev: wm_event;
    while (win_wait(&wd_win, &ev) == 0) {
        if (ev.kind == WM_EV_CLOSE) { win_close(&wd_win); exit(0); }
        if (ev.kind == WM_EV_KEY && ev.a == 72) {
            while (1 == 1) { sleep_ms(1000); }
        }
        if (ev.kind == WM_EV_KEY && (ev.a == 76 || ev.a == 70 || ev.a == 83)) {
            rc = wd_layer_key(ev.a);
            if (rc != 0) { exit(6); }
        } else if (ev.kind == WM_EV_KEY && (ev.a == 67 || ev.a == 79)) {
            if (ev.a == 67) { rgb = wd_capture_key(); } else { rgb = wd_overlay_key(); }
            rc = wd_paint(rgb, alpha);
            if (rc != 0) { exit(7); }
        } else if (ev.kind == WM_EV_KEY) {
            rgb = wd_key_colour(ev.a as u32);
            rc = wd_paint(rgb, alpha);
            if (rc != 0) { exit(5); }
        }
    }
    exit(0);
}
