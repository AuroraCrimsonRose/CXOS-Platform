// Aurora Tejeda / CATX Systems
//
// Imported by xtest.xfxn, which runs each. A ui is driven here as a window
// would drive it, by tk_key and tk_pointer, and read back from its tree and
// its canvas. The gallery's own test, through the display server, is in
// xtest.xfxn (it needs the server's helpers there). Codes 4000-5099 and 5300-6199.

import "toolkit.xfxn";

global tt_ui: tk_ui;
global tt_fontbuf: [2072]u8;    // 24 + 128 glyphs x 16 rows
global tt_font: ds_font;

// A font whose every glyph is a solid 8x16 block, so where text went is
// plain to see; made through ds_font_parse, which must also refuse bad
// ones. 0, or the step that failed.
fn tt_make_font() -> i32 {
    let p: *u8 = &tt_fontbuf[0];
    memzero(p, 2072);
    p[0] = 88; p[1] = 70; p[2] = 78; p[3] = 84;     // XFNT
    p[6] = 1; p[7] = 1; p[8] = 8; p[9] = 16; p[10] = 128; p[11] = 0;
    let k: u32 = 24;
    while (k < 2072) { p[k] = 0xFF; k = k + 1; }
    // the glyphs reach past what was read: refused
    if (ds_font_parse(&tt_font, p, 2071) != E_INVALID_ARGS) { return 1; }
    p[8] = 9;
    if (ds_font_parse(&tt_font, p, 2072) != E_INVALID_ARGS) { return 2; }
    p[8] = 8;
    p[0] = 89;
    if (ds_font_parse(&tt_font, p, 2072) != E_INVALID_ARGS) { return 3; }
    p[0] = 88;
    if (ds_font_parse(&tt_font, p, 2072) != 0 || tt_font.width != 8 || tt_font.count != 128) { return 4; }
    return 0;
}

// A ui at scale q with a canvas fitted to its tree, laid out, not drawn.
fn tt_place(q: u32) -> i32 {
    tk_set_scale(&tt_ui, q);
    let w: u32 = 0;
    let h: u32 = 0;
    tk_fit(&tt_ui, &w, &h);
    if (tk_size(&tt_ui, w, h) != 0) { return 1; }
    tk_layout(&tt_ui);
    return 0;
}

// A ui at scale q with a canvas fitted to its tree, drawn.
fn tt_show(q: u32) -> i32 {
    tk_set_scale(&tt_ui, q);
    let w: u32 = 0;
    let h: u32 = 0;
    tk_fit(&tt_ui, &w, &h);
    if (tk_size(&tt_ui, w, h) != 0) { return 1; }
    let d: ds_damage;
    tk_paint(&tt_ui, &d);
    return 0;
}

fn tt_paint_count() -> u32 {
    let d: ds_damage;
    return tk_paint(&tt_ui, &d);
}

// Every box's device edges are its logical edges, each rounded on its own.
fn tt_edges_ok(ui: *tk_ui) -> u32 {
    let k: u32 = 0;
    while (k < ui.used) {
        let n: *tk_node = &ui.node[k];
        if ((n.flags & TK_F_HIDDEN) == 0) {
            if (n.dx != tk_dev(ui, n.x) || n.dx + n.dw != tk_dev(ui, n.x + n.w)) { return 0; }
            if (n.dy != tk_dev(ui, n.y) || n.dy + n.dh != tk_dev(ui, n.y + n.h)) { return 0; }
        }
        k = k + 1;
    }
    return 1;
}

// 4000: layout at 100, 125, 150 and 200 %: boxes meet edge to edge in
// pixels, nest in their parents, and a grower takes exactly what is left.
fn tt_layout(arg: u64) -> i32 {
    let rc: i32 = tt_make_font();
    if (rc != 0) { return 4000 + rc; }
    let scales: [4]u32;
    scales[0] = 4; scales[1] = 5; scales[2] = 6; scales[3] = 8;
    let s: u32 = 0;
    while (s < 4) {
        tk_init(&tt_ui, scales[s], &tt_font);
        let root: u32 = tk_root(&tt_ui);
        tk_set_spacing(&tt_ui, root, 1, 1);
        tk_set_min(&tt_ui, root, 301, 0);
        let row: u32 = tk_add(&tt_ui, root, TK_ROW, 0 as *u8);
        tk_set_spacing(&tt_ui, row, 1, 0);
        tk_set_flags(&tt_ui, row, TK_F_FILL, 0);
        let a: u32 = tk_add(&tt_ui, row, TK_BUTTON, "A");
        let b: u32 = tk_add(&tt_ui, row, TK_CHECK, "BB");
        let c: u32 = tk_add(&tt_ui, row, TK_BUTTON, "CCC");
        tk_set_flags(&tt_ui, c, TK_F_GROW, 0);
        let g: u32 = tk_add(&tt_ui, root, TK_GRID, 0 as *u8);
        tk_set_cols(&tt_ui, g, 3);
        tk_set_spacing(&tt_ui, g, 1, 1);
        let k: u32 = 0;
        while (k < 7) { tk_add(&tt_ui, g, TK_SWITCH, "s"); k = k + 1; }
        if (a == 0 || b == 0 || c == 0 || g == 0) { return 4010; }
        if (tt_place(scales[s]) != 0) { return 4011; }
        if (tt_edges_ok(&tt_ui) == 0) { return 4012; }
        if (tk_boxes_nest(&tt_ui) == 0) { return 4013; }
        let ia: u32 = tk_index(&tt_ui, a);
        let ib: u32 = tk_index(&tt_ui, b);
        let ic: u32 = tk_index(&tt_ui, c);
        let ir: u32 = tk_index(&tt_ui, row);
        // the gap between neighbours is the spacing step, in logical units
        if (tt_ui.node[ib].x != tt_ui.node[ia].x + tt_ui.node[ia].w + tk_sp(1)) { return 4014; }
        // the grower ends where its row does
        if (tt_ui.node[ic].x + tt_ui.node[ic].w != tt_ui.node[ir].x + tt_ui.node[ir].w) { return 4015; }
        if (tt_ui.node[ic].w <= tt_ui.node[ic].pw) { return 4016; }
        // the root covers the canvas it was fitted to: the canvas in logical
        // units is rounded up, so it may reach one pixel past (clipped), never short
        let rw: u32 = tt_ui.node[tt_ui.root].dw;
        if (rw < tt_ui.canvas.width || rw > tt_ui.canvas.width + 1) { return 4017; }
        tk_free(&tt_ui);
        s = s + 1;
    }
    return 0;
}

// 4100: damage is the box of what changed, coalesced, and nothing else.
fn tt_damage(arg: u64) -> i32 {
    tk_init(&tt_ui, 4, 0 as *ds_font);
    let root: u32 = tk_root(&tt_ui);
    tk_set_spacing(&tt_ui, root, 2, 2);
    let k: u32 = tk_add(&tt_ui, root, TK_CHECK, "Check");
    let b: u32 = tk_add(&tt_ui, root, TK_BUTTON, "Button");
    if (k == 0 || b == 0 || tt_show(4) != 0) { return 4100; }
    if (tt_paint_count() != 0) { return 4101; }             // nothing changed
    let kb: ds_rect;
    tk_box_of(&tt_ui, k, &kb);
    tk_set_flags(&tt_ui, k, TK_F_CHECKED, 0);
    tk_set_flags(&tt_ui, k, 0, TK_F_CHECKED);
    tk_set_flags(&tt_ui, k, TK_F_CHECKED, 0);
    let d: ds_damage;
    if (tk_paint(&tt_ui, &d) != 1) { return 4102; }
    if (d.r[0].x != kb.x || d.r[0].y != kb.y || d.r[0].w != kb.w || d.r[0].h != kb.h) { return 4103; }
    // the same state again: no damage
    tk_set_flags(&tt_ui, k, TK_F_CHECKED, 0);
    if (tt_paint_count() != 0) { return 4104; }
    // the pointer over the button: its box alone
    let bb: ds_rect;
    tk_box_of(&tt_ui, b, &bb);
    tk_pointer(&tt_ui, (bb.x + 5) as i32, (bb.y + 5) as i32, 0);
    if (tk_paint(&tt_ui, &d) != 1 || d.r[0].y != bb.y || d.r[0].h != bb.h) { return 4105; }
    if ((tk_flags(&tt_ui, b) & TK_F_HOVER) == 0) { return 4106; }
    // the theme: all of it
    tk_set_dark(&tt_ui, 1);
    if (tk_paint(&tt_ui, &d) != 1 || d.r[0].w != tt_ui.canvas.width || d.r[0].h != tt_ui.canvas.height) { return 4107; }
    if (ds_pixel(&tt_ui.canvas, 0, 0) != tt_ui.theme.surface) { return 4108; }
    tk_free(&tt_ui);
    return 0;
}

// 4200: Tab goes through what can take the focus, in tree order, skipping
// what is disabled or hidden (itself or a parent), and wraps.
fn tt_focus(arg: u64) -> i32 {
    tk_init(&tt_ui, 4, 0 as *ds_font);
    let root: u32 = tk_root(&tt_ui);
    tk_add(&tt_ui, root, TK_LABEL, "label");
    let a: u32 = tk_add(&tt_ui, root, TK_BUTTON, "A");
    let b: u32 = tk_add(&tt_ui, root, TK_BUTTON, "B");
    tk_set_flags(&tt_ui, b, TK_F_DISABLED, 0);
    let hid: u32 = tk_add(&tt_ui, root, TK_COLUMN, 0 as *u8);
    tk_add(&tt_ui, hid, TK_BUTTON, "C");
    tk_set_flags(&tt_ui, hid, TK_F_HIDDEN, 0);
    let d: u32 = tk_add(&tt_ui, root, TK_CHECK, "D");
    let e: u32 = tk_add(&tt_ui, root, TK_SLIDER, "E");
    tk_add(&tt_ui, root, TK_PROGRESS, "F");
    if (e == 0 || tt_show(4) != 0) { return 4200; }
    if (tk_focused(&tt_ui) != 0) { return 4201; }
    tk_key(&tt_ui, KC_TAB, 0, 0);
    if (tk_focused(&tt_ui) != a) { return 4202; }
    tk_key(&tt_ui, KC_TAB, 0, 0);
    if (tk_focused(&tt_ui) != d) { return 4203; }          // not B, not C
    tk_key(&tt_ui, KC_TAB, 0, 0);
    if (tk_focused(&tt_ui) != e) { return 4204; }
    tk_key(&tt_ui, KC_TAB, 0, 0);
    if (tk_focused(&tt_ui) != a) { return 4205; }          // wrapped
    if ((tk_flags(&tt_ui, a) & TK_F_FOCUS) == 0) { return 4206; }
    // a focused widget that is turned off loses the focus
    tk_set_flags(&tt_ui, a, TK_F_DISABLED, 0);
    if (tk_focused(&tt_ui) != 0 || (tk_flags(&tt_ui, a) & TK_F_FOCUS) != 0) { return 4207; }
    // an app cannot set the focus flag itself
    tk_set_flags(&tt_ui, d, TK_F_FOCUS, 0);
    if ((tk_flags(&tt_ui, d) & TK_F_FOCUS) != 0) { return 4208; }
    // nothing that can take it: Tab leaves it nowhere
    tk_init(&tt_ui, 4, 0 as *ds_font);
    tk_add(&tt_ui, tk_root(&tt_ui), TK_LABEL, "only");
    tk_key(&tt_ui, KC_TAB, 0, 0);
    if (tk_focused(&tt_ui) != 0) { return 4209; }
    tk_free(&tt_ui);
    return 0;
}

fn tt_centre(id: u32, x: *i32, y: *i32) -> void {
    let r: ds_rect;
    tk_box_of(&tt_ui, id, &r);
    *x = (r.x + r.w / 2) as i32;
    *y = (r.y + r.h / 2) as i32;
}

fn tt_click(id: u32) -> void {
    let x: i32 = 0;
    let y: i32 = 0;
    tt_centre(id, &x, &y);
    tk_pointer(&tt_ui, x, y, 1);
    tk_pointer(&tt_ui, x, y, 0);
}

// The next event of the app, or kind TK_EV_NONE.
fn tt_event(ev: *tk_event) -> void {
    if (tk_next(&tt_ui, ev) == 0) { ev.kind = TK_EV_NONE; ev.id = 0; }
}

// 4300: the pointer and the keys press widgets as they should.
fn tt_pointer(arg: u64) -> i32 {
    tk_init(&tt_ui, 4, 0 as *ds_font);
    let root: u32 = tk_root(&tt_ui);
    tk_set_spacing(&tt_ui, root, 2, 2);
    let b: u32 = tk_add(&tt_ui, root, TK_BUTTON, "Press");
    let off: u32 = tk_add(&tt_ui, root, TK_BUTTON, "Off");
    tk_set_flags(&tt_ui, off, TK_F_DISABLED, 0);
    let k: u32 = tk_add(&tt_ui, root, TK_CHECK, "Check");
    let row: u32 = tk_add(&tt_ui, root, TK_ROW, 0 as *u8);
    let r1: u32 = tk_add(&tt_ui, row, TK_RADIO, "1");
    let r2: u32 = tk_add(&tt_ui, row, TK_RADIO, "2");
    let r3: u32 = tk_add(&tt_ui, row, TK_RADIO, "3");
    let other: u32 = tk_add(&tt_ui, row, TK_RADIO, "x");
    tk_set_group(&tt_ui, r1, 1); tk_set_group(&tt_ui, r2, 1); tk_set_group(&tt_ui, r3, 1);
    tk_set_group(&tt_ui, other, 2);
    tk_set_flags(&tt_ui, r1, TK_F_CHECKED, 0);
    tk_set_flags(&tt_ui, other, TK_F_CHECKED, 0);
    let s: u32 = tk_add(&tt_ui, root, TK_SLIDER, "Slide");
    tk_set_range(&tt_ui, s, 0, 100, 10);
    tk_set_value(&tt_ui, s, 50);
    if (s == 0 || tt_show(4) != 0) { return 4300; }
    let ev: tk_event;

    // a press and a release over it: pressed once
    tt_click(b);
    tt_event(&ev);
    if (ev.kind != TK_EV_ACTIVATE || ev.id != b) { return 4301; }
    tt_event(&ev);
    if (ev.kind != TK_EV_NONE) { return 4302; }
    if ((tk_flags(&tt_ui, b) & TK_F_PRESSED) != 0 || tk_focused(&tt_ui) != b) { return 4303; }
    // pressed, then let go somewhere else: not pressed, and not drawn pressed
    let x: i32 = 0;
    let y: i32 = 0;
    tt_centre(b, &x, &y);
    tk_pointer(&tt_ui, x, y, 1);
    if ((tk_flags(&tt_ui, b) & TK_F_PRESSED) == 0) { return 4304; }
    tk_pointer(&tt_ui, 0, (tt_ui.canvas.height - 1) as i32, 1);
    if ((tk_flags(&tt_ui, b) & TK_F_PRESSED) != 0) { return 4305; }
    tk_pointer(&tt_ui, 0, (tt_ui.canvas.height - 1) as i32, 0);
    tt_event(&ev);
    if (ev.kind != TK_EV_NONE) { return 4306; }
    // a disabled one does nothing
    tt_click(off);
    tt_event(&ev);
    if (ev.kind != TK_EV_NONE) { return 4307; }
    // Space and Enter on the focused button
    tk_key(&tt_ui, KC_SPACE, 32, 0);
    tk_key(&tt_ui, KC_ENTER, 0, 0);
    tt_event(&ev);
    if (ev.kind != TK_EV_ACTIVATE || ev.id != b) { return 4308; }
    tt_event(&ev);
    if (ev.kind != TK_EV_ACTIVATE) { return 4309; }

    // a check box turns over; a mixed one becomes checked
    tt_click(k);
    tt_event(&ev);
    if (ev.kind != TK_EV_CHANGE || ev.id != k || ev.value != 1) { return 4310; }
    tt_click(k);
    tt_event(&ev);
    if (ev.value != 0 || (tk_flags(&tt_ui, k) & TK_F_CHECKED) != 0) { return 4311; }
    tk_set_flags(&tt_ui, k, TK_F_MIXED, 0);
    tt_click(k);
    tt_event(&ev);
    if ((tk_flags(&tt_ui, k) & (TK_F_CHECKED | TK_F_MIXED)) != TK_F_CHECKED) { return 4312; }

    // radios: one of a group, the other group untouched
    tt_click(r2);
    tt_event(&ev);
    if (ev.kind != TK_EV_CHANGE || ev.id != r2) { return 4313; }
    if ((tk_flags(&tt_ui, r1) & TK_F_CHECKED) != 0 || (tk_flags(&tt_ui, r2) & TK_F_CHECKED) == 0) { return 4314; }
    if ((tk_flags(&tt_ui, other) & TK_F_CHECKED) == 0) { return 4315; }
    // the arrows move the choice within the group, wrapping, never to x
    tk_key(&tt_ui, KC_RIGHT, 0, 0);
    if ((tk_flags(&tt_ui, r3) & TK_F_CHECKED) == 0 || (tk_flags(&tt_ui, r2) & TK_F_CHECKED) != 0) { return 4316; }
    tk_key(&tt_ui, KC_RIGHT, 0, 0);
    if ((tk_flags(&tt_ui, r1) & TK_F_CHECKED) == 0 || tk_focused(&tt_ui) != r1) { return 4317; }
    if ((tk_flags(&tt_ui, other) & TK_F_CHECKED) == 0) { return 4318; }
    while (tk_next(&tt_ui, &ev) == 1) { }

    // a slider: the pointer sets it, the keys step it, both ends hold
    let sb: ds_rect;
    tk_box_of(&tt_ui, s, &sb);
    tt_centre(s, &x, &y);
    tk_pointer(&tt_ui, sb.x as i32, y, 1);
    tk_pointer(&tt_ui, sb.x as i32, y, 0);
    if (tk_value(&tt_ui, s) != 0) { return 4319; }
    tk_pointer(&tt_ui, (sb.x + sb.w - 1) as i32, y, 1);
    tk_pointer(&tt_ui, (sb.x + sb.w - 1) as i32, y, 0);
    if (tk_value(&tt_ui, s) != 100) { return 4320; }
    while (tk_next(&tt_ui, &ev) == 1) { }
    tk_key(&tt_ui, KC_RIGHT, 0, 0);
    if (tk_value(&tt_ui, s) != 100) { return 4321; }
    tt_event(&ev);
    if (ev.kind != TK_EV_NONE) { return 4322; }             // no change, no event
    tk_key(&tt_ui, KC_LEFT, 0, 0);
    tt_event(&ev);
    if (tk_value(&tt_ui, s) != 90 || ev.kind != TK_EV_CHANGE || ev.value != 90) { return 4323; }
    tk_key(&tt_ui, KC_HOME, 0, 0);
    tk_key(&tt_ui, KC_LEFT, 0, 0);
    if (tk_value(&tt_ui, s) != 0) { return 4324; }
    // a key nothing takes goes to the app
    while (tk_next(&tt_ui, &ev) == 1) { }
    if (tk_key(&tt_ui, KC_Q, 113, 0) != 0) { return 4325; }
    tt_event(&ev);
    if (ev.kind != TK_EV_KEY || ev.code != KC_Q || ev.ch != 113 || ev.mods != 0) { return 4326; }
    // a release goes to nobody, and is no event
    if (tk_key(&tt_ui, KC_Q, 113, KEYEV_RELEASE) != 0) { return 4327; }
    tt_event(&ev);
    if (ev.kind != TK_EV_NONE) { return 4328; }
    tk_free(&tt_ui);
    return 0;
}

// 4400: ids from before a reset are refused; text is the ui's own copy;
// only containers take children.
fn tt_ids(arg: u64) -> i32 {
    tk_init(&tt_ui, 4, 0 as *ds_font);
    let mine: [8]u8;
    strcopy(&mine[0], "Name", 8);
    let b: u32 = tk_add(&tt_ui, tk_root(&tt_ui), TK_BUTTON, &mine[0]);
    if (b == 0) { return 4400; }
    mine[0] = 88;
    let nm: *u8 = tk_name(&tt_ui, b);
    if (nm == (0 as *u8) || nm[0] != 78) { return 4401; }          // still "Name"
    if (tk_add(&tt_ui, b, TK_LABEL, "x") != 0) { return 4402; }    // a button is no container
    if (tk_add(&tt_ui, tk_root(&tt_ui), 99, "x") != 0) { return 4403; }
    if (tk_role(&tt_ui, b) != TK_ROLE_BUTTON) { return 4404; }
    tk_reset(&tt_ui);
    let again: u32 = tk_add(&tt_ui, tk_root(&tt_ui), TK_CHECK, "New");
    // the same slot, another generation
    if (again == 0 || (again & 0xFFFF) != (b & 0xFFFF) || again == b) { return 4405; }
    if (tk_set_flags(&tt_ui, b, TK_F_CHECKED, 0) != E_INVALID_ARGS) { return 4406; }
    if ((tk_flags(&tt_ui, again) & TK_F_CHECKED) != 0) { return 4407; }
    if (tk_index(&tt_ui, 0) != TK_NONE || tk_index(&tt_ui, 0x10000 | 200) != TK_NONE) { return 4408; }
    // the pool runs out cleanly
    let n: u32 = 0;
    while (tk_add(&tt_ui, tk_root(&tt_ui), TK_LABEL, 0 as *u8) != 0) { n = n + 1; }
    if (tt_ui.used != TK_NODES_MAX) { return 4409; }
    return 0;
}

// The reference: every one of a pixel's sixteen samples looked at, no
// shortcut (tk_cov takes some; this is what they must agree with).
fn tt_cov(px: i32, py: i32, x: i32, y: i32, w: i32, h: i32, r: i32, t: i32) -> u32 {
    let n: u32 = 0;
    let j: i32 = 0;
    while (j < 4) {
        let i: i32 = 0;
        while (i < 4) {
            let sx: i32 = px * 8 + 2 * i + 1;
            let sy: i32 = py * 8 + 2 * j + 1;
            if (tk_in_rr(sx, sy, x, y, w, h, r) == 1) {
                if (t <= 0 || tk_in_rr(sx, sy, x + t, y + t, w - 2 * t, h - 2 * t, tk_imax(r - t, 0)) == 0) {
                    n = n + 1;
                }
            }
            i = i + 1;
        }
        j = j + 1;
    }
    return n;
}

// One shape drawn with tk_shape over a plain canvas, every pixel held to
// what sampling all of it gives: 1 if they agree.
fn tt_shape_ok(x: i32, y: i32, w: i32, h: i32, r: i32, t: i32, clip: *ds_rect) -> u32 {
    let bg: u32 = 0xFF102030;
    let fg: u32 = 0xFFE0C040;
    ds_fill(&tt_ui.canvas, 0, 0, tt_ui.canvas.width, tt_ui.canvas.height, bg);
    tk_shape(&tt_ui, clip, x, y, w, h, r, t, fg);
    let rr: i32 = tk_imin(r, tk_imin(w, h) / 2);
    let py: u32 = 0;
    while (py < tt_ui.canvas.height) {
        let px: u32 = 0;
        while (px < tt_ui.canvas.width) {
            let want: u32 = bg;
            let inclip: u32 = 0;
            if (px >= clip.x && py >= clip.y && px < clip.x + clip.w && py < clip.y + clip.h) { inclip = 1; }
            if (inclip == 1 && w > 0 && h > 0) {
                let cov: u32 = tt_cov(px as i32, py as i32, x, y, w, h, rr, t);
                if (cov >= 16) { want = fg; }
                else if (cov > 0) { want = ds_over(ds_fade(fg, (cov * 255) / 16), bg); }
            }
            if (ds_pixel(&tt_ui.canvas, px, py) != want) { return 0; }
            px = px + 1;
        }
        py = py + 1;
    }
    return 1;
}

// 4700: shapes are drawn as sampling every pixel would draw them, though
// only their corners are sampled: filled, rings, circles, ones too small
// for their radius or ring, and cut by a clip.
fn tt_shapes(arg: u64) -> i32 {
    tk_init(&tt_ui, 4, 0 as *ds_font);
    if (tk_size(&tt_ui, 48, 40) != 0) { return 4700; }
    let all: ds_rect;
    ds_rect_set(&all, 0, 0, 48, 40);
    let cut: ds_rect;
    ds_rect_set(&cut, 7, 5, 19, 13);
    if (tt_shape_ok(2, 3, 30, 20, 4, 0, &all) == 0) { return 4701; }       // filled
    if (tt_shape_ok(2, 3, 30, 20, 4, 2, &all) == 0) { return 4702; }       // a ring
    if (tt_shape_ok(5, 5, 16, 16, 8, 0, &all) == 0) { return 4703; }       // a circle
    if (tt_shape_ok(5, 5, 16, 16, 8, 3, &all) == 0) { return 4704; }       // a round ring
    if (tt_shape_ok(1, 1, 40, 6, 9, 0, &all) == 0) { return 4705; }        // radius past half
    if (tt_shape_ok(1, 1, 5, 30, 1, 3, &all) == 0) { return 4706; }        // ring wider than half
    if (tt_shape_ok(3, 2, 34, 30, 0, 2, &all) == 0) { return 4707; }       // square corners
    if (tt_shape_ok(2, 3, 30, 20, 5, 2, &cut) == 0) { return 4708; }       // clipped
    if (tt_shape_ok(40, 30, 20, 20, 4, 0, &all) == 0) { return 4709; }     // past the canvas
    if (tt_shape_ok(2, 3, 30, 20, 1, 6, &all) == 0) { return 4710; }       // ring thicker than its radius
    tk_free(&tt_ui);
    return 0;
}

// 4500: what is drawn: text kept to its widget's box, the states' colours,
// dark.
fn tt_paint(arg: u64) -> i32 {
    let rc: i32 = tt_make_font();
    if (rc != 0) { return 4500 + rc; }
    tk_init(&tt_ui, 4, &tt_font);
    let root: u32 = tk_root(&tt_ui);
    tk_set_spacing(&tt_ui, root, 0, 4);         // 16 logical units round
    let b: u32 = tk_add(&tt_ui, root, TK_BUTTON, "Far too long a label for it");
    let k: u32 = tk_add(&tt_ui, root, TK_CHECK, "On");
    tk_set_flags(&tt_ui, k, TK_F_CHECKED, 0);
    // a label clips nothing itself: its box, from the tree, is all that cuts it
    let lab: u32 = tk_add(&tt_ui, root, TK_LABEL, "A label longer than its box");
    if (k == 0 || lab == 0) { return 4510; }
    // a canvas narrower than the button asks: it is cut to what there is
    if (tk_size(&tt_ui, 100, 200) != 0) { return 4511; }
    let d: ds_damage;
    tk_paint(&tt_ui, &d);
    let bb: ds_rect;
    tk_box_of(&tt_ui, b, &bb);
    if (bb.x != 16 || bb.x + bb.w != 84) { return 4512; }
    let cy: u32 = bb.y + bb.h / 2;
    // its text reaches the box's inside edge and goes no further
    if (ds_pixel(&tt_ui.canvas, bb.x + bb.w - 6, cy) != tt_ui.theme.text) { return 4513; }
    if (ds_pixel(&tt_ui.canvas, bb.x + bb.w + 2, cy) != tt_ui.theme.surface) { return 4514; }
    if (ds_pixel(&tt_ui.canvas, 98, cy) != tt_ui.theme.surface) { return 4515; }
    // a checked box is the accent, inside its corner
    let kb: ds_rect;
    tk_box_of(&tt_ui, k, &kb);
    let s: u32 = tk_dev(&tt_ui, TK_BOX);
    let bx: u32 = kb.x + tk_dev(&tt_ui, TK_RING);
    let by: u32 = kb.y + (kb.h - s) / 2;
    if (ds_pixel(&tt_ui.canvas, bx + 2, by + 2) != tt_ui.theme.accent) { return 4516; }
    // the ring only once it has the focus
    if (ds_pixel(&tt_ui.canvas, kb.x + kb.w / 2, kb.y) != tt_ui.theme.surface) { return 4517; }
    tk_focus(&tt_ui, k);
    tk_paint(&tt_ui, &d);
    if (ds_pixel(&tt_ui.canvas, kb.x + kb.w / 2, kb.y) != tt_ui.theme.ring) { return 4518; }
    // unchecked: the accent is gone
    tk_key(&tt_ui, KC_SPACE, 32, 0);
    tk_paint(&tt_ui, &d);
    if (ds_pixel(&tt_ui.canvas, bx + 2, by + 2) == tt_ui.theme.accent) { return 4519; }
    tk_set_dark(&tt_ui, 1);
    tk_paint(&tt_ui, &d);
    if (ds_pixel(&tt_ui.canvas, 2, 2) != 0xFF1E2126) { return 4520; }
    let lb: ds_rect;
    tk_box_of(&tt_ui, lab, &lb);
    if (lb.w == 0 || ds_pixel(&tt_ui.canvas, lb.x + 2, lb.y + 2) != tt_ui.theme.text) { return 4521; }
    if (ds_pixel(&tt_ui.canvas, lb.x + lb.w + 2, lb.y + 2) != tt_ui.theme.surface) { return 4522; }
    tk_free(&tt_ui);
    return 0;
}

// ---- 2.8a2: commands, the text field, the clipboard, dead keys ----

// The key that types ASCII c on a US keyboard, and whether Shift is held.
fn tt_ascii(c: u32, code: *u32, mods: *u32) -> void {
    *mods = 0;
    *code = 0;
    if (c >= 97 && c <= 122) { *code = KC_A + (c - 97); }
    else if (c >= 65 && c <= 90) { *code = KC_A + (c - 65); *mods = KEYMOD_SHIFT; }
    else if (c >= 49 && c <= 57) { *code = KC_1 + (c - 49); }
    else if (c == 48) { *code = KC_0; }
    else if (c == 32) { *code = KC_SPACE; }
    else if (c == 39) { *code = KC_QUOTE; }
    else if (c == 34) { *code = KC_QUOTE; *mods = KEYMOD_SHIFT; }
    else if (c == 96) { *code = KC_GRAVE; }
    else if (c == 126) { *code = KC_GRAVE; *mods = KEYMOD_SHIFT; }
    else if (c == 94) { *code = KC_1 + 5; *mods = KEYMOD_SHIFT; }
    else if (c == 46) { *code = KC_PERIOD; }
}

// Type an ASCII string, a press for each character.
fn tt_type(s: *u8) -> void {
    let k: u32 = 0;
    while (s[k] != 0) {
        let code: u32 = 0;
        let mods: u32 = 0;
        tt_ascii(s[k] as u32, &code, &mods);
        tk_key(&tt_ui, code, s[k] as u32, mods);
        k = k + 1;
    }
}

// A press of code with mods held and no character.
fn tt_press(code: u32, mods: u32) -> u32 { return tk_key(&tt_ui, code, 0, mods); }

// A press with Ctrl of a letter key: its character is the letter's.
fn tt_ctrl(letter: u32, more: u32) -> u32 {
    return tk_key(&tt_ui, KC_A + (letter - 97), letter, KEYMOD_CTRL | more);
}

// 1 if field id holds exactly s.
fn tt_text_is(id: u32, s: *u8) -> u32 {
    let t: *u8 = tk_field_text(&tt_ui, id);
    if (t == (0 as *u8)) { return 0; }
    if (streq(t, s) != 0) { return 1; }
    return 0;
}

// 1 if field id holds exactly the n bytes at b.
fn tt_bytes_are(id: u32, b: *u8, n: u32) -> u32 {
    let t: *u8 = tk_field_text(&tt_ui, id);
    if (t == (0 as *u8) || strlen(t) != n) { return 0; }
    if (memeq(t, b, n) != 0) { return 1; }
    return 0;
}

fn tt_drain() -> void {
    let ev: tk_event;
    while (tk_next(&tt_ui, &ev) == 1) { }
}

// 4800: commands: the standard ones are there; a clash is refused and the
// binding stays; the system's keys and keys that type are refused; a key
// runs exactly its command; a widget runs one; the dialog manager's keys.
fn tt_commands(arg: u64) -> i32 {
    tk_init(&tt_ui, 4, 0 as *ds_font);
    let root: u32 = tk_root(&tt_ui);
    let ok: u32 = tk_add(&tt_ui, root, TK_BUTTON, "OK");
    let no: u32 = tk_add(&tt_ui, root, TK_BUTTON, "Cancel");
    let save_btn: u32 = tk_add(&tt_ui, root, TK_BUTTON, "Save");
    tk_set_flags(&tt_ui, ok, TK_F_DEFAULT, 0);
    tk_set_flags(&tt_ui, no, TK_F_CANCEL, 0);
    if (save_btn == 0 || tt_show(4) != 0) { return 4800; }
    if (tk_command_find(&tt_ui, "copy") != TK_CMD_COPY || tk_command_find(&tt_ui, "redo") != TK_CMD_REDO) { return 4801; }
    let save: i32 = tk_command(&tt_ui, "save", KC_S, KEYMOD_CTRL);
    if (save != 7) { return 4802; }
    let s: u32 = save as u32;
    // clashes: the key, or the name; and the standard ones' keys too
    if (tk_command(&tt_ui, "save-as", KC_S, KEYMOD_CTRL) != E_ALREADY_EXISTS) { return 4803; }
    if (tk_command(&tt_ui, "save", KC_S, KEYMOD_CTRL | KEYMOD_SHIFT) != E_ALREADY_EXISTS) { return 4804; }
    if (tk_command(&tt_ui, "copy-2", KC_C, KEYMOD_CTRL) != E_ALREADY_EXISTS) { return 4805; }
    // the system's keys, whatever else is held
    if (tk_command(&tt_ui, "a", KC_S, KEYMOD_SUPER) != E_ACCESS_DENIED) { return 4806; }
    if (tk_command(&tt_ui, "a", KC_S, KEYMOD_SUPER | KEYMOD_CTRL) != E_ACCESS_DENIED) { return 4807; }
    if (tk_command(&tt_ui, "a", KC_LSUPER, 0) != E_ACCESS_DENIED) { return 4808; }
    if (tk_command(&tt_ui, "a", KC_TAB, KEYMOD_ALT) != E_ACCESS_DENIED) { return 4809; }
    if (tk_command(&tt_ui, "a", KC_TAB, KEYMOD_ALT | KEYMOD_SHIFT) != E_ACCESS_DENIED) { return 4810; }
    if (tk_command(&tt_ui, "a", KC_F4, KEYMOD_ALT) != E_ACCESS_DENIED) { return 4811; }
    if (tk_command(&tt_ui, "a", KC_F2, KEYMOD_CTRL | KEYMOD_ALT) != E_ACCESS_DENIED) { return 4812; }
    if (tk_command(&tt_ui, "a", KC_DELETE, KEYMOD_CTRL | KEYMOD_ALT) != E_ACCESS_DENIED) { return 4813; }
    if (tk_command(&tt_ui, "a", KC_DELETE, KEYMOD_CTRL | KEYMOD_ALT | KEYMOD_SHIFT) != E_ACCESS_DENIED) { return 4814; }
    if (tk_command(&tt_ui, "a", KC_KP_PERIOD, KEYMOD_CTRL | KEYMOD_ALT) != E_ACCESS_DENIED) { return 4815; }
    if (tk_command(&tt_ui, "a", KC_ENTER, KEYMOD_SUPER | KEYMOD_CTRL) != E_ACCESS_DENIED) { return 4816; }
    // keys that type, a modifier alone, a key with a press's flags
    if (tk_command(&tt_ui, "a", KC_S, 0) != E_INVALID_ARGS) { return 4817; }
    if (tk_command(&tt_ui, "a", KC_S, KEYMOD_SHIFT) != E_INVALID_ARGS) { return 4818; }
    if (tk_command(&tt_ui, "a", KC_LCTRL, KEYMOD_CTRL) != E_INVALID_ARGS) { return 4819; }
    if (tk_command(&tt_ui, "a", KC_S, KEYMOD_CTRL | KEYEV_REPEAT) != E_INVALID_ARGS) { return 4820; }
    // but an F-key alone, Alt with a letter, and none at all are fine
    let refresh: i32 = tk_command(&tt_ui, "refresh", KC_F5, 0);
    if (refresh != 8) { return 4821; }
    if (tk_command(&tt_ui, "alt-f", KC_F, KEYMOD_ALT) != 9) { return 4822; }
    if (tk_command(&tt_ui, "unbound", 0, 0) != 10) { return 4823; }
    // a refused rebinding keeps the key it had
    if (tk_bind(&tt_ui, s, KC_F5, 0) != E_ALREADY_EXISTS) { return 4824; }
    if (tk_bind(&tt_ui, s, KC_F4, KEYMOD_ALT) != E_ACCESS_DENIED) { return 4825; }
    tt_drain();
    let ev: tk_event;
    if (tt_ctrl(115, 0) != 1) { return 4826; }
    tt_event(&ev);
    if (ev.kind != TK_EV_COMMAND || ev.value != save || ev.id != 0) { return 4827; }
    // exactly its mods: Ctrl+Shift+S is not it; a release runs nothing
    if (tt_ctrl(115, KEYMOD_SHIFT) != 0) { return 4828; }
    tt_event(&ev);
    if (ev.kind != TK_EV_KEY || ev.mods != (KEYMOD_CTRL | KEYMOD_SHIFT)) { return 4829; }
    tk_key(&tt_ui, KC_S, 115, KEYMOD_CTRL | KEYEV_RELEASE);
    tt_event(&ev);
    if (ev.kind != TK_EV_NONE) { return 4830; }
    // what is held as a lock is not held: Caps Lock on still runs it
    tk_key(&tt_ui, KC_S, 83, KEYMOD_CTRL | KEYMOD_CAPS | KEYMOD_NUM);
    tt_event(&ev);
    if (ev.kind != TK_EV_COMMAND || ev.value != save) { return 4831; }
    // moved to F12; Ctrl+S is then nobody's, and unbound it runs from no key
    if (tk_bind(&tt_ui, s, KC_F12, 0) != 0) { return 4832; }
    tt_ctrl(115, 0);
    tt_event(&ev);
    if (ev.kind != TK_EV_KEY) { return 4833; }
    tt_press(KC_F12, 0);
    tt_event(&ev);
    if (ev.kind != TK_EV_COMMAND || ev.value != save) { return 4834; }
    if (tk_bind(&tt_ui, s, 0, 0) != 0) { return 4835; }
    tt_press(KC_F12, 0);
    tt_event(&ev);
    if (ev.kind != TK_EV_KEY) { return 4836; }
    // the key it gave up is free for another
    if (tk_command(&tt_ui, "save-2", KC_S, KEYMOD_CTRL) != 11) { return 4837; }
    // a widget runs its command, and says which it was
    if (tk_set_command(&tt_ui, save_btn, s) != 0) { return 4838; }
    if (tk_set_command(&tt_ui, save_btn, 99) != E_INVALID_ARGS) { return 4839; }
    tt_click(save_btn);
    tt_event(&ev);
    if (ev.kind != TK_EV_COMMAND || ev.value != save || ev.id != save_btn) { return 4840; }
    // no text field has the focus: copy is the app's to do
    tt_ctrl(99, 0);
    tt_event(&ev);
    if (ev.kind != TK_EV_COMMAND || ev.value != (TK_CMD_COPY as i32)) { return 4841; }
    // Esc presses the cancel button, Enter the default one, Shift+Tab goes back
    tt_drain();
    tt_press(KC_ESC, 0);
    tt_event(&ev);
    if (ev.kind != TK_EV_ACTIVATE || ev.id != no) { return 4842; }
    tk_focus(&tt_ui, no);
    tt_press(KC_TAB, KEYMOD_SHIFT);
    if (tk_focused(&tt_ui) != ok) { return 4843; }
    tt_press(KC_TAB, KEYMOD_SHIFT);
    if (tk_focused(&tt_ui) != save_btn) { return 4844; }        // wrapped
    tt_press(KC_KP_ENTER, 0);
    tt_event(&ev);
    if (ev.kind != TK_EV_COMMAND || ev.id != save_btn) { return 4845; }  // the focused one first
    // the table fills, and says so
    let name: [8]u8;
    let k: u32 = 0;
    let rc: i32 = 0;
    while (k < TK_CMDS_MAX + 2) {
        name[0] = 120; name[1] = (48 + k / 10) as u8; name[2] = (48 + k % 10) as u8; name[3] = 0;
        rc = tk_command(&tt_ui, &name[0], 0, 0);
        if (rc < 0) { break; }
        k = k + 1;
    }
    if (rc != E_NO_RESOURCES || tt_ui.cmd_n != TK_CMDS_MAX) { return 4846; }
    tk_free(&tt_ui);
    return 0;
}

// 4900: the text field: typing, the caret and selection by keys and by the
// pointer, characters of more than a byte as one, the limit, undo, and the
// clipboard asked for only by copy, cut and paste.
fn tt_field(arg: u64) -> i32 {
    let rc: i32 = tt_make_font();
    if (rc != 0) { return 4900 + rc; }
    tk_init(&tt_ui, 4, &tt_font);
    let root: u32 = tk_root(&tt_ui);
    let f: u32 = tk_add(&tt_ui, root, TK_TEXTFIELD, "Name");
    let b: u32 = tk_add(&tt_ui, root, TK_BUTTON, "B");
    if (b == 0 || tt_show(4) != 0) { return 4905; }
    if (tk_role(&tt_ui, f) != TK_ROLE_TEXTFIELD || tt_text_is(f, "") == 0) { return 4906; }
    tk_key(&tt_ui, KC_TAB, 0, 0);
    if (tk_focused(&tt_ui) != f) { return 4907; }
    tt_type("hello");
    let ev: tk_event;
    tt_event(&ev);
    if (ev.kind != TK_EV_CHANGE || ev.id != f || ev.value != 1) { return 4908; }
    tt_drain();
    if (tt_text_is(f, "hello") == 0) { return 4909; }
    // Ctrl with a letter types nothing; it is the app's
    tt_ctrl(113, 0);
    tt_event(&ev);
    if (ev.kind != TK_EV_KEY || tt_text_is(f, "hello") == 0) { return 4910; }
    // two left, one more with Shift: the third letter, either way round
    let a: u32 = 0;
    let z: u32 = 0;
    tt_press(KC_LEFT, 0); tt_press(KC_LEFT, 0); tt_press(KC_LEFT, KEYMOD_SHIFT);
    tk_field_selection(&tt_ui, f, &a, &z);
    if (a != 2 || z != 3) { return 4911; }
    tt_type("X");
    if (tt_text_is(f, "heXlo") == 0) { return 4912; }
    tk_field_selection(&tt_ui, f, &a, &z);
    if (a != 3 || z != 3) { return 4913; }
    // Right with a selection goes to its end and drops it
    tt_press(KC_LEFT, KEYMOD_SHIFT); tt_press(KC_LEFT, KEYMOD_SHIFT);
    tt_press(KC_RIGHT, 0);
    tk_field_selection(&tt_ui, f, &a, &z);
    if (a != 3 || z != 3) { return 4914; }
    // Home, Shift+End: all of it; Backspace takes the selection
    tt_press(KC_HOME, 0); tt_press(KC_END, KEYMOD_SHIFT);
    tk_field_selection(&tt_ui, f, &a, &z);
    if (a != 0 || z != 5) { return 4915; }
    tt_press(KC_BACKSPACE, 0);
    if (tt_text_is(f, "") == 0) { return 4916; }
    // Delete takes what is after the caret, Backspace what is before
    tt_type("abc");
    tt_press(KC_HOME, 0); tt_press(KC_DELETE, 0);
    if (tt_text_is(f, "bc") == 0) { return 4917; }
    tt_press(KC_END, 0); tt_press(KC_BACKSPACE, 0);
    if (tt_text_is(f, "b") == 0) { return 4918; }
    // a character of two bytes is one step and one deletion
    let e2: [4]u8;
    e2[0] = 0xC3; e2[1] = 0xA9; e2[2] = 120; e2[3] = 0;     // e acute, x
    if (tk_set_field_text(&tt_ui, f, &e2[0]) != 0) { return 4919; }
    tt_press(KC_HOME, 0); tt_press(KC_RIGHT, 0);
    tk_field_selection(&tt_ui, f, &a, &z);
    if (a != 2) { return 4920; }
    tt_press(KC_BACKSPACE, 0);
    if (tt_text_is(f, "x") == 0) { return 4921; }
    // text that is not UTF-8 is refused
    e2[0] = 0xC3; e2[1] = 0;
    if (tk_set_field_text(&tt_ui, f, &e2[0]) != E_INVALID_ARGS) { return 4922; }
    e2[0] = 0xED; e2[1] = 0xA0; e2[2] = 0x80; e2[3] = 0;   // a surrogate
    if (tk_set_field_text(&tt_ui, f, &e2[0]) != E_INVALID_ARGS || tt_text_is(f, "x") == 0) { return 4923; }
    // undo: a run of typing is one change, and redo puts it back
    tt_press(KC_END, 0);
    tt_type("yz");
    tt_ctrl(122, 0);
    if (tt_text_is(f, "x") == 0) { return 4924; }
    tt_ctrl(122, KEYMOD_SHIFT);
    if (tt_text_is(f, "xyz") == 0) { return 4925; }
    // nothing asked of the clipboard yet: not even by Ctrl+A
    tt_ctrl(97, 0);
    if (tk_clip_take(&tt_ui) != TK_CLIP_NONE) { return 4926; }
    tk_field_selection(&tt_ui, f, &a, &z);
    if (a != 0 || z != 3) { return 4927; }
    // copy asks to set it, with the selection
    tt_ctrl(99, 0);
    if (tk_clip_take(&tt_ui) != TK_CLIP_SET || tt_ui.clip_n != 3 || memeq(&tt_ui.clip[0], "xyz", 3) == 0) { return 4928; }
    if (tk_clip_take(&tt_ui) != TK_CLIP_NONE) { return 4929; }          // asked once
    // cut too, and takes it out (the y alone)
    tt_press(KC_END, 0); tt_press(KC_LEFT, 0); tt_press(KC_LEFT, KEYMOD_SHIFT);
    tt_ctrl(120, 0);
    if (tk_clip_take(&tt_ui) != TK_CLIP_SET || tt_ui.clip_n != 1 || tt_ui.clip[0] != 121) { return 4930; }
    if (tt_text_is(f, "xz") == 0) { return 4931; }
    // with no selection, copy asks nothing
    tt_ctrl(99, 0);
    if (tk_clip_take(&tt_ui) != TK_CLIP_NONE) { return 4932; }
    // paste only asks; what comes back goes in, tidied
    tt_ctrl(118, 0);
    if (tk_clip_take(&tt_ui) != TK_CLIP_GET || tt_text_is(f, "xz") == 0) { return 4933; }
    let p: [8]u8;
    p[0] = 65; p[1] = 9; p[2] = 66; p[3] = 1; p[4] = 0xFF; p[5] = 0xC3; p[6] = 0xA9; p[7] = 10;
    if (tk_paste_text(&tt_ui, &p[0], 8) != 6) { return 4934; }
    let want: [9]u8;
    want[0] = 120; want[1] = 65; want[2] = 32; want[3] = 66; want[4] = 0xC3; want[5] = 0xA9;
    want[6] = 32; want[7] = 122; want[8] = 0;
    if (tt_bytes_are(f, &want[0], 8) == 0) { return 4935; }
    // the limit: whole characters only
    let full: [256]u8;
    memset(&full[0], 97, 254);
    full[254] = 0;
    if (tk_set_field_text(&tt_ui, f, &full[0]) != 0) { return 4936; }
    p[0] = 0xC3; p[1] = 0xA9;
    if (tk_paste_text(&tt_ui, &p[0], 2) != 0) { return 4937; }        // one byte of room
    tt_type("b");
    tt_type("c");
    tk_field_selection(&tt_ui, f, &a, &z);
    if (a != 255 || strlen(tk_field_text(&tt_ui, f)) != 255) { return 4938; }
    // the pointer: a click puts the caret between characters, a drag selects
    tk_set_field_text(&tt_ui, f, "abcdef");
    let fb: ds_rect;
    tk_box_of(&tt_ui, f, &fb);
    let tx: i32 = (fb.x + tk_dev(&tt_ui, TK_RING) + tk_dev(&tt_ui, TK_FIELD_PADX)) as i32;
    let ty: i32 = (fb.y + fb.h / 2) as i32;
    tk_pointer(&tt_ui, tx + 2 * 8 + 3, ty, 1);
    tk_field_selection(&tt_ui, f, &a, &z);
    if (a != 2 || z != 2) { return 4939; }
    tk_pointer(&tt_ui, tx + 4 * 8 + 1, ty, 1);
    tk_pointer(&tt_ui, tx + 4 * 8 + 1, ty, 0);
    tk_field_selection(&tt_ui, f, &a, &z);
    if (a != 2 || z != 4) { return 4940; }
    // drawn: the selection in the accent, the rest in the text colour, the
    // caret after the last character
    let d: ds_damage;
    tk_paint(&tt_ui, &d);
    let gy: u32 = (fb.y + fb.h / 2) as u32;
    if (ds_pixel(&tt_ui.canvas, (tx + 2 * 8 + 4) as u32, gy) != tt_ui.theme.on_accent) { return 4941; }
    if (ds_pixel(&tt_ui.canvas, (tx + 1 * 8 + 4) as u32, gy) != tt_ui.theme.text) { return 4942; }
    tt_press(KC_END, 0);
    tk_paint(&tt_ui, &d);
    if (ds_pixel(&tt_ui.canvas, (tx + 6 * 8) as u32, gy) != tt_ui.theme.text) { return 4943; }
    if (ds_pixel(&tt_ui.canvas, (tx + 6 * 8 + 3) as u32, gy) != tt_ui.theme.raised) { return 4944; }
    // so many fields and no more
    let k: u32 = 1;
    while (k < TK_FIELDS_MAX) { tk_add(&tt_ui, root, TK_TEXTFIELD, "more"); k = k + 1; }
    if (tk_add(&tt_ui, root, TK_TEXTFIELD, "one too many") != 0) { return 4945; }
    tk_free(&tt_ui);
    return 0;
}

// The field's text against bytes: 1 if it is them.
fn tt_dead_is(f: *u8, n: u32, id: u32) -> u32 { return tt_bytes_are(id, f, n); }

// 5000: the dead-key method: each accent on each letter it goes on, capitals
// too; Space or the same accent alone; Esc and Backspace drop it; a key that
// is not a character gives the accent and goes on; Shift on its own changes
// nothing; another accent waits in its place; a move of the focus drops it.
fn tt_dead(arg: u64) -> i32 {
    tk_init(&tt_ui, 4, 0 as *ds_font);
    let root: u32 = tk_root(&tt_ui);
    let f: u32 = tk_add(&tt_ui, root, TK_TEXTFIELD, "Name");
    let g: u32 = tk_add(&tt_ui, root, TK_TEXTFIELD, "Other");
    if (g == 0 || tt_show(4) != 0) { return 5000; }
    tk_focus(&tt_ui, f);
    // with no method an accent is itself at once
    tt_type("'");
    if (tt_text_is(f, "'") == 0) { return 5001; }
    if (tk_set_im(&tt_ui, TK_IM_DEAD) != 0 || tk_set_im(&tt_ui, 7) != E_INVALID_ARGS) { return 5002; }
    let w: [16]u8;
    // the accent waits, and is shown at the caret
    tk_set_field_text(&tt_ui, f, "");
    tt_type("'");
    if (tt_text_is(f, "") == 0 || tt_ui.field[0].dead != 39 || tk_field_caret_col(&tt_ui.field[0]) != 1) { return 5003; }
    tt_type("e");
    w[0] = 0xC3; w[1] = 0xA9;
    if (tt_dead_is(&w[0], 2, f) == 0) { return 5004; }
    // all five, and capitals
    tk_set_field_text(&tt_ui, f, "");
    tt_type("`a^o~n\"u'E\"y'c");
    w[0] = 0xC3; w[1] = 0xA0;       // a grave
    w[2] = 0xC3; w[3] = 0xB4;       // o circumflex
    w[4] = 0xC3; w[5] = 0xB1;       // n tilde
    w[6] = 0xC3; w[7] = 0xBC;       // u diaeresis
    w[8] = 0xC3; w[9] = 0x89;       // E acute
    w[10] = 0xC3; w[11] = 0xBF;     // y diaeresis
    w[12] = 0xC3; w[13] = 0xA7;     // c cedilla
    if (tt_dead_is(&w[0], 14, f) == 0) { return 5005; }
    // Space, or the accent again: the accent; on what it does not go on:
    // the accent, then that
    tk_set_field_text(&tt_ui, f, "");
    tt_type("' ''~e\"Y");
    if (tt_text_is(f, "''~e\"Y") == 0) { return 5006; }
    // Esc and Backspace drop it, and do nothing else
    tt_type("'");
    tt_press(KC_ESC, 0);
    tt_type("'");
    tt_press(KC_BACKSPACE, 0);
    if (tt_text_is(f, "''~e\"Y") == 0 || tt_ui.field[0].dead != 0) { return 5007; }
    // an arrow: the accent, and the caret moves on from after it
    tk_set_field_text(&tt_ui, f, "ab");
    tt_type("'");
    tt_press(KC_LEFT, 0);
    let a: u32 = 0;
    let z: u32 = 0;
    tk_field_selection(&tt_ui, f, &a, &z);
    if (tt_text_is(f, "ab'") == 0 || z != 2) { return 5008; }
    // Shift pressed on its own between them changes nothing
    tk_set_field_text(&tt_ui, f, "");
    tt_type("'");
    tk_key(&tt_ui, KC_LSHIFT, 0, KEYMOD_SHIFT);
    tk_key(&tt_ui, KC_E, 69, KEYMOD_SHIFT);
    w[0] = 0xC3; w[1] = 0x89;
    if (tt_dead_is(&w[0], 2, f) == 0) { return 5009; }
    // another accent: the first, and the second waits
    tk_set_field_text(&tt_ui, f, "");
    tt_type("'`a");
    w[0] = 39; w[1] = 0xC3; w[2] = 0xA0;
    if (tt_dead_is(&w[0], 3, f) == 0) { return 5010; }
    // with Ctrl: the accent, then the command
    tk_set_field_text(&tt_ui, f, "");
    tt_type("^");
    tt_ctrl(97, 0);
    let s: u32 = 0;
    tk_field_selection(&tt_ui, f, &s, &z);
    if (tt_text_is(f, "^") == 0 || s != 0 || z != 1) { return 5011; }
    // the focus moves (not by a key, which would give the accent first):
    // dropped, in neither field
    tk_set_field_text(&tt_ui, f, "");
    tt_type("'");
    tk_focus(&tt_ui, g);
    if (tk_focused(&tt_ui) != g || tt_text_is(f, "") == 0 || tt_ui.field[0].dead != 0) { return 5012; }
    tt_type("u");
    if (tt_text_is(g, "u") == 0) { return 5013; }
    tk_free(&tt_ui);
    return 0;
}

// ---- 2.8a3: scroll views, rows, tabs, menus, tooltips, dialogs, text grids ----

fn tt_repaint() -> void {
    let d: ds_damage;
    tk_paint(&tt_ui, &d);
}

// Is a's box inside b's? 1 if so.
fn tt_inside(a: u32, b: u32) -> u32 {
    let ra: ds_rect;
    let rb: ds_rect;
    tk_box_of(&tt_ui, a, &ra);
    tk_box_of(&tt_ui, b, &rb);
    let ax: i32 = ra.x as i32; let ay: i32 = ra.y as i32;
    let bx: i32 = rb.x as i32; let by: i32 = rb.y as i32;
    if (ax < bx || ay < by || ax + (ra.w as i32) > bx + (rb.w as i32) || ay + (ra.h as i32) > by + (rb.h as i32)) { return 0; }
    return 1;
}

// The canvas at (x, y).
fn tt_pix(x: i32, y: i32) -> u32 {
    let row: *u32 = ds_row(&tt_ui.canvas, y as u32);
    return row[x as u32];
}

// The pointer over a widget, no button held.
fn tt_hover(id: u32) -> void {
    let x: i32 = 0;
    let y: i32 = 0;
    tt_centre(id, &x, &y);
    tk_pointer(&tt_ui, x, y, 0);
}

// 5300: a scroll view scrolls within its content, no further; the focus
// going to a widget out of sight brings it into the view.
fn tt_scroll(arg: u64) -> i32 {
    let rc: i32 = tt_make_font();
    if (rc != 0) { return 5300; }
    tk_init(&tt_ui, 4, &tt_font);
    let root: u32 = tk_root(&tt_ui);
    let s: u32 = tk_add(&tt_ui, root, TK_SCROLL, 0 as *u8);
    tk_set_min(&tt_ui, s, 120, 60);
    let col: u32 = tk_add(&tt_ui, s, TK_COLUMN, 0 as *u8);
    let first: u32 = tk_add(&tt_ui, col, TK_BUTTON, "First");
    let k: u32 = 0;
    while (k < 6) { tk_add(&tt_ui, col, TK_BUTTON, "Middle"); k = k + 1; }
    let last: u32 = tk_add(&tt_ui, col, TK_BUTTON, "Last");
    if (last == 0 || tt_show(4) != 0) { return 5301; }
    let x: i32 = 7;
    let y: i32 = 7;
    if (tk_scroll_pos(&tt_ui, s, &x, &y) != 0 || x != 0 || y != 0) { return 5302; }
    if (tk_role(&tt_ui, s) != TK_ROLE_SCROLL || tk_scroll_by(&tt_ui, col, 0, 1) != E_INVALID_ARGS) { return 5303; }
    tk_scroll_by(&tt_ui, s, 0, 20);
    tk_scroll_pos(&tt_ui, s, &x, &y);
    if (y != 20 || x != 0) { return 5304; }
    // no further than the content goes
    tk_scroll_by(&tt_ui, s, 500, 10000);
    tk_scroll_pos(&tt_ui, s, &x, &y);
    if (x != 0 || y <= 20 || y >= 10000) { return 5305; }
    tt_repaint();
    if (tt_inside(last, s) == 0) { return 5306; }
    tk_scroll_by(&tt_ui, s, 0, -10000);
    tk_scroll_pos(&tt_ui, s, &x, &y);
    if (y != 0) { return 5307; }
    tt_repaint();
    if (tt_inside(first, s) == 0 || tt_inside(last, s) == 1) { return 5308; }
    // the focus brings what it goes to into the view, and back
    tk_focus(&tt_ui, last);
    tt_repaint();
    tk_scroll_pos(&tt_ui, s, &x, &y);
    if (y <= 0 || tt_inside(last, s) == 0) { return 5309; }
    tk_focus(&tt_ui, first);
    tt_repaint();
    tk_scroll_pos(&tt_ui, s, &x, &y);
    if (y != 0) { return 5310; }
    tk_free(&tt_ui);
    return 0;
}

// 5400: a list's keys choose, past a disabled row, stopping at the ends;
// Enter activates the choice; tk_select chooses without telling; a press
// chooses. A table's header is never chosen (5600).
fn tt_list(arg: u64) -> i32 {
    let rc: i32 = tt_make_font();
    if (rc != 0) { return 5400; }
    tk_init(&tt_ui, 4, &tt_font);
    let root: u32 = tk_root(&tt_ui);
    let l: u32 = tk_add(&tt_ui, root, TK_LIST, "Names");
    let a: u32 = tk_add(&tt_ui, l, TK_ITEM, "A");
    let b: u32 = tk_add(&tt_ui, l, TK_ITEM, "B");
    let c: u32 = tk_add(&tt_ui, l, TK_ITEM, "C");
    let d: u32 = tk_add(&tt_ui, l, TK_ITEM, "D");
    tk_set_flags(&tt_ui, b, TK_F_DISABLED, 0);
    if (d == 0 || tt_show(4) != 0) { return 5401; }
    if (tk_role(&tt_ui, l) != TK_ROLE_LIST || tk_role(&tt_ui, a) != TK_ROLE_LISTITEM || tk_selected(&tt_ui, l) != 0) { return 5402; }
    tk_key(&tt_ui, KC_TAB, 0, 0);
    if (tk_focused(&tt_ui) != l) { return 5403; }
    let ev: tk_event;
    tt_press(KC_DOWN, 0);
    tt_event(&ev);
    if (ev.kind != TK_EV_CHANGE || ev.id != l || ev.value != 0 || ev.code != a || tk_selected(&tt_ui, l) != a) { return 5404; }
    tt_press(KC_DOWN, 0);
    tt_event(&ev);
    if (tk_selected(&tt_ui, l) != c || ev.value != 2) { return 5405; }
    tt_press(KC_END, 0);
    tt_press(KC_DOWN, 0);
    if (tk_selected(&tt_ui, l) != d) { return 5406; }
    tt_press(KC_HOME, 0);
    tt_press(KC_UP, 0);
    if (tk_selected(&tt_ui, l) != a) { return 5407; }
    tt_drain();
    tt_press(KC_ENTER, 0);
    tt_event(&ev);
    if (ev.kind != TK_EV_ACTIVATE || ev.id != l || ev.value != 0 || ev.code != a) { return 5408; }
    // tk_select: no event; a disabled row or another's refused
    if (tk_select(&tt_ui, l, c) != 0 || tk_selected(&tt_ui, l) != c) { return 5409; }
    tt_event(&ev);
    if (ev.kind != TK_EV_NONE) { return 5410; }
    if (tk_select(&tt_ui, l, b) != E_INVALID_ARGS || tk_select(&tt_ui, l, root) != E_INVALID_ARGS || tk_selected(&tt_ui, l) != c) { return 5411; }
    tt_repaint();
    tt_click(d);
    if (tk_selected(&tt_ui, l) != d) { return 5412; }
    tt_click(b);
    if (tk_selected(&tt_ui, l) != d) { return 5413; }
    tk_free(&tt_ui);

    // a table: its first item is the header, which is not a row to choose
    tk_init(&tt_ui, 4, &tt_font);
    root = tk_root(&tt_ui);
    let t: u32 = tk_add(&tt_ui, root, TK_TABLE, "Files");
    let h: u32 = tk_add(&tt_ui, t, TK_ITEM, 0 as *u8);
    tk_add(&tt_ui, h, TK_ITEM, "Name"); tk_add(&tt_ui, h, TK_ITEM, "Size");
    let r1: u32 = tk_add(&tt_ui, t, TK_ITEM, 0 as *u8);
    tk_add(&tt_ui, r1, TK_ITEM, "one"); tk_add(&tt_ui, r1, TK_ITEM, "1");
    let r2: u32 = tk_add(&tt_ui, t, TK_ITEM, 0 as *u8);
    tk_add(&tt_ui, r2, TK_ITEM, "two");
    if (tk_add(&tt_ui, r2, TK_ITEM, "2") == 0 || tt_show(4) != 0) { return 5600; }
    if (tk_role(&tt_ui, t) != TK_ROLE_TABLE || tk_role(&tt_ui, h) != TK_ROLE_HEADER || tk_role(&tt_ui, r1) != TK_ROLE_ROW) { return 5601; }
    tk_key(&tt_ui, KC_TAB, 0, 0);
    tt_press(KC_HOME, 0);
    if (tk_selected(&tt_ui, t) != r1) { return 5602; }
    tt_press(KC_UP, 0);
    if (tk_selected(&tt_ui, t) != r1) { return 5603; }
    tt_press(KC_DOWN, 0);
    if (tk_selected(&tt_ui, t) != r2) { return 5604; }
    if (tk_select(&tt_ui, t, h) != E_INVALID_ARGS) { return 5605; }
    tt_click(h);
    if (tk_selected(&tt_ui, t) != r2) { return 5606; }
    tk_free(&tt_ui);
    return 0;
}

// 5500: a tree's keys, as Serenity's TreeView: Right opens a closed item or
// goes into an open one; Left closes an open one or goes to its parent; a
// closed item's children are not rows; opening and closing are heard.
fn tt_tree(arg: u64) -> i32 {
    let rc: i32 = tt_make_font();
    if (rc != 0) { return 5500; }
    tk_init(&tt_ui, 4, &tt_font);
    let root: u32 = tk_root(&tt_ui);
    let t: u32 = tk_add(&tt_ui, root, TK_TREE, "Files");
    let p: u32 = tk_add(&tt_ui, t, TK_ITEM, "P");
    tk_set_flags(&tt_ui, p, TK_F_OPEN, 0);
    let p1: u32 = tk_add(&tt_ui, p, TK_ITEM, "p1");
    tk_add(&tt_ui, p, TK_ITEM, "p2");
    let q: u32 = tk_add(&tt_ui, t, TK_ITEM, "Q");
    let q1: u32 = tk_add(&tt_ui, q, TK_ITEM, "q1");
    let r: u32 = tk_add(&tt_ui, t, TK_ITEM, "R");
    if (r == 0 || tt_show(4) != 0) { return 5501; }
    if (tk_role(&tt_ui, t) != TK_ROLE_TREE || tk_role(&tt_ui, q1) != TK_ROLE_TREEITEM) { return 5502; }
    // q1 is under a closed item: not a row
    if (tk_select(&tt_ui, t, q1) != E_INVALID_ARGS) { return 5503; }
    tk_key(&tt_ui, KC_TAB, 0, 0);
    tt_press(KC_DOWN, 0);
    if (tk_selected(&tt_ui, t) != p) { return 5504; }
    tt_press(KC_RIGHT, 0);
    if (tk_selected(&tt_ui, t) != p1) { return 5505; }
    tt_press(KC_LEFT, 0);
    if (tk_selected(&tt_ui, t) != p) { return 5506; }
    tt_drain();
    let ev: tk_event;
    tt_press(KC_LEFT, 0);
    tt_event(&ev);
    if (ev.kind != TK_EV_EXPAND || ev.id != t || ev.value != 0 || ev.code != p || (tk_flags(&tt_ui, p) & TK_F_OPEN) != 0) { return 5507; }
    tt_press(KC_DOWN, 0);
    if (tk_selected(&tt_ui, t) != q) { return 5508; }
    tt_drain();
    tt_press(KC_RIGHT, 0);
    tt_event(&ev);
    if (ev.kind != TK_EV_EXPAND || ev.value != 1 || ev.code != q || tk_selected(&tt_ui, t) != q) { return 5509; }
    tt_press(KC_RIGHT, 0);
    if (tk_selected(&tt_ui, t) != q1) { return 5510; }
    tt_press(KC_END, 0);
    if (tk_selected(&tt_ui, t) != r) { return 5511; }
    // Enter on a leaf activates; on an item with children, opens or closes it
    tt_drain();
    tt_press(KC_ENTER, 0);
    tt_event(&ev);
    if (ev.kind == TK_EV_ACTIVATE) { return 5512; }
    tk_select(&tt_ui, t, q);
    tt_press(KC_ENTER, 0);
    if ((tk_flags(&tt_ui, q) & TK_F_OPEN) != 0) { return 5513; }
    tk_free(&tt_ui);
    return 0;
}

// 5700: tabs: Left, Right, Home and End on the focused tabs, stopping at the
// ends; Ctrl+Tab and Ctrl+Shift+Tab wrap; a hidden page's widgets cannot
// have the focus, and the focus in a page turned away goes to the tabs.
fn tt_tabs(arg: u64) -> i32 {
    let rc: i32 = tt_make_font();
    if (rc != 0) { return 5700; }
    tk_init(&tt_ui, 4, &tt_font);
    let root: u32 = tk_root(&tt_ui);
    let t: u32 = tk_add(&tt_ui, root, TK_TABS, 0 as *u8);
    let p1: u32 = tk_add(&tt_ui, t, TK_COLUMN, "One");
    let b1: u32 = tk_add(&tt_ui, p1, TK_BUTTON, "In one");
    let p2: u32 = tk_add(&tt_ui, t, TK_COLUMN, "Two");
    let b2: u32 = tk_add(&tt_ui, p2, TK_BUTTON, "In two");
    let p3: u32 = tk_add(&tt_ui, t, TK_COLUMN, "Three");
    if (p3 == 0 || tt_show(4) != 0) { return 5701; }
    if (tk_role(&tt_ui, t) != TK_ROLE_TABLIST || tk_role(&tt_ui, p1) != TK_ROLE_TABPANEL || tk_selected(&tt_ui, t) != p1) { return 5702; }
    tk_key(&tt_ui, KC_TAB, 0, 0);
    if (tk_focused(&tt_ui) != t) { return 5703; }
    tk_key(&tt_ui, KC_TAB, 0, 0);
    if (tk_focused(&tt_ui) != b1) { return 5704; }
    tk_key(&tt_ui, KC_TAB, 0, KEYMOD_SHIFT);
    let ev: tk_event;
    tt_drain();
    tt_press(KC_RIGHT, 0);
    tt_event(&ev);
    if (ev.kind != TK_EV_CHANGE || ev.id != t || ev.value != 1 || tk_selected(&tt_ui, t) != p2) { return 5705; }
    // b1's page is hidden: Tab goes past it to b2
    tk_key(&tt_ui, KC_TAB, 0, 0);
    if (tk_focused(&tt_ui) != b2) { return 5706; }
    tk_key(&tt_ui, KC_TAB, 0, KEYMOD_SHIFT);
    tt_press(KC_END, 0);
    tt_press(KC_RIGHT, 0);
    if (tk_selected(&tt_ui, t) != p3) { return 5707; }
    tt_press(KC_HOME, 0);
    tt_press(KC_LEFT, 0);
    if (tk_selected(&tt_ui, t) != p1) { return 5708; }
    // Ctrl+Tab wraps either way, from a widget in a page too
    tk_focus(&tt_ui, b1);
    tt_press(KC_TAB, KEYMOD_CTRL | KEYMOD_SHIFT);
    if (tk_selected(&tt_ui, t) != p3 || tk_focused(&tt_ui) != t) { return 5709; }
    tt_press(KC_TAB, KEYMOD_CTRL);
    if (tk_selected(&tt_ui, t) != p1) { return 5710; }
    if (tk_focus(&tt_ui, b2) == 0) { return 5711; }
    if (tk_select(&tt_ui, t, b1) != E_INVALID_ARGS || tk_select(&tt_ui, t, p2) != 0 || tk_selected(&tt_ui, t) != p2) { return 5712; }
    tk_free(&tt_ui);
    return 0;
}

// 5800: menus: F10 opens the bar's first menu with its first item lit; Up
// and Down step past separators and disabled items, wrapping; Right goes
// to the next menu; Enter chooses and closes; Esc closes. A context menu
// by Shift+F10, by a right press, by tk_popup; a bar's menu is not one.
fn tt_menus(arg: u64) -> i32 {
    let rc: i32 = tt_make_font();
    if (rc != 0) { return 5800; }
    tk_init(&tt_ui, 4, &tt_font);
    let root: u32 = tk_root(&tt_ui);
    let bar: u32 = tk_add(&tt_ui, root, TK_MENUBAR, 0 as *u8);
    let file: u32 = tk_add(&tt_ui, bar, TK_MENU, "File");
    let fnew: u32 = tk_add(&tt_ui, file, TK_MENUITEM, "New");
    tk_add(&tt_ui, file, TK_MENUITEM, 0 as *u8);
    let off: u32 = tk_add(&tt_ui, file, TK_MENUITEM, "Off");
    tk_set_flags(&tt_ui, off, TK_F_DISABLED, 0);
    let fopen: u32 = tk_add(&tt_ui, file, TK_MENUITEM, "Open");
    let edit: u32 = tk_add(&tt_ui, bar, TK_MENU, "Edit");
    tk_add(&tt_ui, edit, TK_MENUITEM, "Undo");
    let b: u32 = tk_add(&tt_ui, root, TK_BUTTON, "Here");
    let ctx: u32 = tk_add(&tt_ui, root, TK_MENU, 0 as *u8);
    let c1: u32 = tk_add(&tt_ui, ctx, TK_MENUITEM, "First");
    if (c1 == 0 || tt_show(4) != 0) { return 5801; }
    if (tk_role(&tt_ui, bar) != TK_ROLE_MENUBAR || tk_role(&tt_ui, fopen) != TK_ROLE_MENUITEM || tk_open_top(&tt_ui) != 0) { return 5802; }
    tt_press(TK_KC_F10, 0);
    if (tk_open_top(&tt_ui) != file || tk_menu_lit(&tt_ui, file) != fnew) { return 5803; }
    tt_press(KC_DOWN, 0);
    if (tk_menu_lit(&tt_ui, file) != fopen) { return 5804; }
    tt_press(KC_DOWN, 0);
    if (tk_menu_lit(&tt_ui, file) != fnew) { return 5805; }
    tt_press(KC_UP, 0);
    if (tk_menu_lit(&tt_ui, file) != fopen) { return 5806; }
    tt_drain();
    let ev: tk_event;
    tt_press(KC_ENTER, 0);
    tt_event(&ev);
    if (tk_open_top(&tt_ui) != 0 || ev.kind != TK_EV_ACTIVATE || ev.id != fopen) { return 5807; }
    tt_press(TK_KC_F10, 0);
    tt_press(KC_RIGHT, 0);
    if (tk_open_top(&tt_ui) != edit) { return 5808; }
    tt_press(KC_RIGHT, 0);
    if (tk_open_top(&tt_ui) != file) { return 5809; }
    tt_press(KC_ESC, 0);
    if (tk_open_top(&tt_ui) != 0) { return 5810; }
    // context menus
    if (tk_set_context(&tt_ui, b, file) != E_INVALID_ARGS || tk_popup(&tt_ui, file, 1, 1) != E_INVALID_ARGS) { return 5811; }
    if (tk_set_context(&tt_ui, b, ctx) != 0) { return 5812; }
    tk_focus(&tt_ui, b);
    tt_press(TK_KC_F10, KEYMOD_SHIFT);
    if (tk_open_top(&tt_ui) != ctx || tk_menu_lit(&tt_ui, ctx) != c1) { return 5813; }
    tt_press(KC_ESC, 0);
    if (tk_open_top(&tt_ui) != 0 || tk_focused(&tt_ui) != b) { return 5814; }
    let x: i32 = 0;
    let y: i32 = 0;
    tt_centre(b, &x, &y);
    tk_pointer(&tt_ui, x, y, 2);
    tk_pointer(&tt_ui, x, y, 0);
    if (tk_open_top(&tt_ui) != ctx) { return 5815; }
    tk_menus_close(&tt_ui);
    if (tk_open_top(&tt_ui) != 0) { return 5816; }
    if (tk_popup(&tt_ui, ctx, 2, 2) != 0 || tk_open_top(&tt_ui) != ctx) { return 5817; }
    // a press outside closes it and goes no further
    tt_drain();
    tt_centre(b, &x, &y);
    tk_pointer(&tt_ui, x + 300, y + 300, 1);
    tk_pointer(&tt_ui, x + 300, y + 300, 0);
    if (tk_open_top(&tt_ui) != 0) { return 5818; }
    tk_free(&tt_ui);
    return 0;
}

// 5900: a tooltip shows after 700 ms still over its widget, and not
// before; moving to another while one is up switches at once; moving off,
// or a press, hides it; tk_due says how long is left.
fn tt_tips(arg: u64) -> i32 {
    let rc: i32 = tt_make_font();
    if (rc != 0) { return 5900; }
    tk_init(&tt_ui, 4, &tt_font);
    let root: u32 = tk_root(&tt_ui);
    tk_set_spacing(&tt_ui, root, 4, 4);
    let a: u32 = tk_add(&tt_ui, root, TK_BUTTON, "A");
    let b: u32 = tk_add(&tt_ui, root, TK_BUTTON, "B");
    let l: u32 = tk_add(&tt_ui, root, TK_LABEL, "none");
    if (tk_set_tip(&tt_ui, a, "Tip A") != 0 || tk_set_tip(&tt_ui, b, "Tip B") != 0 || tk_set_tip(&tt_ui, 9999, "x") != E_INVALID_ARGS) { return 5901; }
    if (l == 0 || tt_show(4) != 0) { return 5902; }
    tk_tick(&tt_ui, 1000);
    if (tk_due(&tt_ui) != TK_NONE) { return 5903; }
    tt_hover(a);
    if (tk_due(&tt_ui) != 700 || tk_tip_shown(&tt_ui) != 0) { return 5904; }
    tk_tick(&tt_ui, 1699);
    if (tk_tip_shown(&tt_ui) != 0 || tk_due(&tt_ui) != 1) { return 5905; }
    tk_tick(&tt_ui, 1700);
    if (tk_tip_shown(&tt_ui) != a || tk_due(&tt_ui) != TK_NONE) { return 5906; }
    tt_hover(b);
    // and drawn under b, not still under a
    let rb: ds_rect;
    tk_box_of(&tt_ui, b, &rb);
    if (tk_tip_shown(&tt_ui) != b || tt_ui.tip_y < (rb.y as i32) + (rb.h as i32)) { return 5907; }
    tt_hover(l);
    if (tk_tip_shown(&tt_ui) != 0 || tk_due(&tt_ui) != TK_NONE) { return 5908; }
    // moving on before the time is up starts it again
    tk_tick(&tt_ui, 5000);
    tt_hover(a);
    tk_tick(&tt_ui, 5400);
    tt_hover(b);
    tk_tick(&tt_ui, 5800);
    if (tk_tip_shown(&tt_ui) != 0 || tk_due(&tt_ui) != 300) { return 5909; }
    tk_tick(&tt_ui, 6100);
    if (tk_tip_shown(&tt_ui) != b) { return 5910; }
    // it is drawn: the canvas changes where it is
    tt_repaint();
    let x: i32 = 0;
    let y: i32 = 0;
    tt_centre(b, &x, &y);
    tk_pointer(&tt_ui, x, y, 1);
    if (tk_tip_shown(&tt_ui) != 0) { return 5911; }
    tk_pointer(&tt_ui, x, y, 0);
    tk_free(&tt_ui);
    return 0;
}

// 6000: a dialog: refused with no buttons or unknown ones; open, it holds
// the focus and the keys; Esc answers Cancel, Enter OK; the focus goes back.
fn tt_dialog(arg: u64) -> i32 {
    let rc: i32 = tt_make_font();
    if (rc != 0) { return 6000; }
    tk_init(&tt_ui, 4, &tt_font);
    let root: u32 = tk_root(&tt_ui);
    let under: u32 = tk_add(&tt_ui, root, TK_BUTTON, "Under");
    tk_add(&tt_ui, root, TK_BUTTON, "Also under");
    if (tk_dialog(&tt_ui, "T", "x", 0) != 0 || tk_dialog(&tt_ui, "T", "x", 128) != 0) { return 6001; }
    let d: u32 = tk_dialog(&tt_ui, "Save?", "The text.", TK_DLG_OK | TK_DLG_CANCEL | TK_DLG_DISCARD);
    let body: u32 = tk_dialog_body(&tt_ui, d);
    if (d == 0 || body == 0 || tk_dialog_body(&tt_ui, under) != 0) { return 6002; }
    let k: u32 = tk_add(&tt_ui, body, TK_CHECK, "Do not ask");
    if (k == 0 || tt_show(4) != 0) { return 6003; }
    if (tk_role(&tt_ui, d) != TK_ROLE_DIALOG || tk_open_top(&tt_ui) != 0) { return 6004; }
    tk_focus(&tt_ui, under);
    if (tk_dialog_open(&tt_ui, d) != 0 || tk_open_top(&tt_ui) != d || tk_focused(&tt_ui) != k) { return 6005; }
    // the focus stays in it
    let n: u32 = 0;
    while (n < 6) {
        tk_key(&tt_ui, KC_TAB, 0, 0);
        if (tk_focused(&tt_ui) == under || tk_focused(&tt_ui) == 0) { return 6006; }
        n = n + 1;
    }
    tt_drain();
    tt_repaint();
    // a press on what is under it does nothing there
    tt_click(under);
    let ev: tk_event;
    tt_event(&ev);
    if (ev.kind == TK_EV_ACTIVATE && ev.id == under) { return 6007; }
    if (tk_open_top(&tt_ui) != d) { return 6008; }
    tt_drain();
    tk_focus(&tt_ui, k);
    tt_press(KC_ESC, 0);
    tt_event(&ev);
    if (ev.kind != TK_EV_DIALOG || ev.id != d || ev.value != (TK_DLG_CANCEL as i32)) { return 6009; }
    if (tk_open_top(&tt_ui) != 0 || tk_focused(&tt_ui) != under) { return 6010; }
    tk_dialog_open(&tt_ui, d);
    tt_drain();
    tt_press(KC_ENTER, 0);
    tt_event(&ev);
    if (ev.kind != TK_EV_DIALOG || ev.value != (TK_DLG_OK as i32) || tk_open_top(&tt_ui) != 0) { return 6011; }
    // closed without an answer: nothing heard
    tk_dialog_open(&tt_ui, d);
    tt_drain();
    if (tk_dialog_close(&tt_ui, d) != 0 || tk_open_top(&tt_ui) != 0 || tk_dialog_close(&tt_ui, under) != E_INVALID_ARGS) { return 6012; }
    tt_event(&ev);
    if (ev.kind != TK_EV_NONE) { return 6013; }
    // a dialog with only Discard: Enter presses it (the last), Esc nothing
    let d2: u32 = tk_dialog(&tt_ui, "Gone", 0 as *u8, TK_DLG_DISCARD);
    tk_dialog_open(&tt_ui, d2);
    tt_drain();
    tt_press(KC_ESC, 0);
    if (tk_open_top(&tt_ui) != d2) { return 6014; }
    tt_drain();
    tt_press(KC_ENTER, 0);
    tt_event(&ev);
    if (ev.kind != TK_EV_DIALOG || ev.id != d2 || ev.value != (TK_DLG_DISCARD as i32)) { return 6015; }
    tk_free(&tt_ui);
    return 0;
}

// 6100: a text grid: its size bounded, its cells written and read back,
// scrolled, its cursor placed; the cells' pool runs out cleanly; what is in
// a cell, and the cursor, are drawn.
fn tt_textgrid(arg: u64) -> i32 {
    let rc: i32 = tt_make_font();
    if (rc != 0) { return 6100; }
    tk_init(&tt_ui, 4, &tt_font);
    let root: u32 = tk_root(&tt_ui);
    let g: u32 = tk_add(&tt_ui, root, TK_TEXTGRID, 0 as *u8);
    let g2: u32 = tk_add(&tt_ui, root, TK_TEXTGRID, 0 as *u8);
    if (tk_grid_size(&tt_ui, g, 0, 5) != E_INVALID_ARGS || tk_grid_size(&tt_ui, g, 256, 1) != E_INVALID_ARGS || tk_grid_size(&tt_ui, root, 2, 2) != E_INVALID_ARGS) { return 6101; }
    if (tk_grid_put(&tt_ui, g, 0, 0, 65, 0, 0) != E_INVALID_ARGS) { return 6102; }
    if (tk_grid_size(&tt_ui, g, 10, 3) != 0) { return 6103; }
    if (tk_grid_size(&tt_ui, g2, 64, 64) != E_NO_RESOURCES || tk_grid_size(&tt_ui, g2, 2, 2) != 0) { return 6104; }
    if (tk_grid_write(&tt_ui, g, 0, 0, "hello", 2, 0) != 5) { return 6105; }
    if (tk_grid_cell(&tt_ui, g, 1, 0) != tk_grid_pack(101, 2, 0) || tk_grid_cell(&tt_ui, g, 5, 0) != 0) { return 6106; }
    if (tk_grid_write(&tt_ui, g, 8, 1, "abc", 0, 0) != 2 || tk_grid_cell(&tt_ui, g, 9, 1) != tk_grid_pack(98, 0, 0)) { return 6107; }
    if (tk_grid_put(&tt_ui, g, 10, 0, 65, 0, 0) != E_INVALID_ARGS || tk_grid_put(&tt_ui, g, 0, 3, 65, 0, 0) != E_INVALID_ARGS) { return 6108; }
    if (tk_grid_put(&tt_ui, g, 0, 0, 65, 17, 0) != E_INVALID_ARGS || tk_grid_put(&tt_ui, g, 0, 0, 0x110000, 0, 0) != E_INVALID_ARGS) { return 6109; }
    if (tk_grid_put(&tt_ui, g, 2, 2, 0xE9, 16, 5) != 0 || tk_grid_cell(&tt_ui, g, 2, 2) != tk_grid_pack(0xE9, 16, 5)) { return 6110; }
    // up a row: row 1 to row 0, a blank row at the bottom
    if (tk_grid_scroll(&tt_ui, g, 1) != 0 || tk_grid_cell(&tt_ui, g, 8, 0) != tk_grid_pack(97, 0, 0) || tk_grid_cell(&tt_ui, g, 0, 0) != 0) { return 6111; }
    if (tk_grid_cell(&tt_ui, g, 2, 1) != tk_grid_pack(0xE9, 16, 5) || tk_grid_cell(&tt_ui, g, 2, 2) != 0) { return 6112; }
    if (tk_grid_cursor(&tt_ui, g, 10, 0, 1) != E_INVALID_ARGS || tk_grid_cursor(&tt_ui, g, 4, 2, 1) != 0 || (tk_flags(&tt_ui, g) & TK_F_CURSOR) == 0) { return 6113; }
    if (tk_role(&tt_ui, g) != TK_ROLE_TEXTGRID) { return 6114; }
    if (tt_show(4) != 0) { return 6115; }
    let gi: u32 = tk_index(&tt_ui, g);
    let x: i32 = 0;
    let y: i32 = 0;
    // a written cell, a blank one, the cursor's: the font's glyphs are solid
    tk_grid_xy(&tt_ui, gi, 8, 0, &x, &y);
    let ink: u32 = tt_pix(x + 4, y + 4);
    tk_grid_xy(&tt_ui, gi, 6, 2, &x, &y);
    let blank: u32 = tt_pix(x + 4, y + 4);
    tk_grid_xy(&tt_ui, gi, 4, 2, &x, &y);
    let cur: u32 = tt_pix(x + 4, y + 4);
    if (ink == blank || cur == blank) { return 6116; }
    tk_grid_cursor(&tt_ui, g, 4, 2, 0);
    tt_repaint();
    if (tt_pix(x + 4, y + 4) != blank) { return 6117; }
    if (tk_grid_clear(&tt_ui, g) != 0 || tk_grid_cell(&tt_ui, g, 8, 0) != 0) { return 6118; }
    tk_free(&tt_ui);
    return 0;
}
