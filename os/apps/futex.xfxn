// futex.xfxn - a futex waiter's process ends (roadmap 1.5b2).
// Aurora Tejeda / CATX Systems
//
// What only a process's end can show. The calls and std/sync.xfxn are
// tested by xtest.xfxn (1.5d2). The kernel's self-test (ktest_loader.c,
// ktest_futex) runs it once and reads how it ended: a worker waits on a word
// with no deadline and the first thread calls SYS_EXIT. The process ends
// PROC_EXITED 43, and the kernel finds no waiter left behind.

import "thread.xfxn";
import "time.xfxn";

global word: u32;   // a word of the image: keyed by the process and its address

// wait with no deadline: only the process's end ends it
fn forever(arg: u64) -> i32 {
    return futex_wait(arg as *u32, 0, DEADLINE_NEVER);
}

fn _start() -> void {
    let h: i32 = thread_spawn(forever, (&word) as u64, 0);
    if (h <= 0) { exit(1); }
    sleep_ms(200);   // time to be waiting
    exit(43);
}
