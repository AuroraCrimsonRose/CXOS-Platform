// futex.xfxn - futexes and std/sync.xfxn, from ring 3 (roadmap 1.5b2).
// Aurora Tejeda / CATX Systems
//
// The kernel's self-test (ktest_loader.c, ktest_futex) runs it twice and
// reads how each process ended:
//
//   futex           the calls' refusals, a wake that wakes exactly whom it
//                   says, one memory object mapped twice being one word,
//                   a timed wait; then a contended mutex, the heap from
//                   four threads, a condition variable and once. Any
//                   failure is exit(step); all passed is exit(0).
//   futex exit      a worker waits on a word with no deadline and the first
//                   thread calls SYS_EXIT: the process ends PROC_EXITED 43,
//                   and the kernel finds no waiter left behind.

import "thread.xfxn";
import "time.xfxn";
import "sync.xfxn";
import "heap.xfxn";
import "io.xfxn";

const WORKERS: u32 = 4;
const ROUNDS:  u32 = 200;
const ITEMS:   u32 = 50;

global word:  u32;   // a word of the image: keyed by the process and its address
global other: u32;   // another one, which no one waits on
global lock:  mutex;
global counter: u32;
global ids: [4]u32;

global cv:   cond;
global cvm:  mutex;
global slot_full: u32;
global slot_val:  u32;

global once_o: once;
global once_count: u32;

// wait on the word at arg while it is 0 -> futex_wait's answer
fn waiter(arg: u64) -> i32 {
    return futex_wait(arg as *u32, 0, time_deadline_ms(20000));
}

// the same with no deadline: only the process's end ends it
fn forever(arg: u64) -> i32 {
    return futex_wait(arg as *u32, 0, DEADLINE_NEVER);
}

// wake one waiter on w once one is there, checking no wake on `other`
// reaches it -> 1, or 0 if none came
fn wake_one(w: *u32) -> i32 {
    let until: u64 = time_deadline_ms(20000);
    while (time_now_ns() < until) {
        if (futex_wake(&other, FUTEX_WAKE_ALL) != 0) { return 0; }
        let n: i32 = futex_wake(w, 1);
        if (n != 0) { return n; }
        sleep_ms(1);
    }
    return 0;
}

fn join(h: i32) -> i32 {
    let code: i32 = 0 - 1000;
    if (thread_join(h, time_deadline_ms(30000), &code) != 0) { return 0 - 1000; }
    return code;
}

fn calls() -> void {
    // 1-6: refusals, and the cases that do not wait
    let addr: u64 = (&word) as u64;
    if (futex_wait((addr + 2) as *u32, 0xFFFF_FFFF, DEADLINE_NEVER) != E_INVALID_ARGS) { exit(1); }
    if (futex_wake((addr + 1) as *u32, 1) != E_INVALID_ARGS) { exit(2); }
    if (futex_wait(0xFFFF_8000_0000_0000 as *u32, 0, DEADLINE_NEVER) != E_BAD_ADDRESS) { exit(3); }
    if (futex_wake(0 as *u32, 1) != E_BAD_ADDRESS) { exit(4); }
    word = 7;
    if (futex_wait(&word, 6, DEADLINE_NEVER) != E_SHOULD_WAIT) { exit(5); }
    word = 0;
    if (futex_wake(&word, FUTEX_WAKE_ALL) != 0) { exit(6); }

    // 7: a deadline that comes first, not before its time
    let t0: u64 = time_now_ns();
    if (futex_wait(&word, 0, time_deadline_ms(30)) != E_TIMED_OUT) { exit(7); }
    if (time_since_ns(t0) < 30 * NS_PER_MS) { exit(7); }
    // 8: one already passed only looks
    if (futex_wait(&word, 0, 0) != E_TIMED_OUT) { exit(8); }

    // 9-10: a waiter woken by a wake on its word, which says it woke one
    let h: i32 = thread_spawn(waiter, addr, 0);
    if (h <= 0) { exit(9); }
    if (wake_one(&word) != 1) { exit(9); }
    if (join(h) != 0) { exit(10); }

    // 11-13: three waiters; a wake of two wakes two, and the third is still
    // there for the next
    let w: [3]i32;
    let i: u32 = 0;
    while (i < 3) { w[i] = thread_spawn(waiter, addr, 0); if (w[i] <= 0) { exit(11); } i = i + 1; }
    let n: i32 = 0;
    let until: u64 = time_deadline_ms(20000);
    while (n < 2 && time_now_ns() < until) { n = n + futex_wake(&word, (2 - n) as u32); sleep_ms(1); }
    if (n != 2) { exit(12); }
    if (wake_one(&word) != 1) { exit(13); }
    i = 0;
    while (i < 3) { if (join(w[i]) != 0) { exit(13); } i = i + 1; }

    // 14-16: one memory object mapped at two addresses is one word: a wait
    // through one is woken through the other
    let m: i32 = mem_create(4096, 0);
    if (m <= 0) { exit(14); }
    let a: vm_map_args;
    a.offset = 0; a.length = 4096; a.object = m as u32;
    a.prot = MPROT_READ | MPROT_WRITE; a.flags = 0; a.reserved = 0; a.addr = 0;
    if (vm_map(&a) != 0) { exit(14); }
    let one: u64 = a.addr;
    a.addr = 0;
    if (vm_map(&a) != 0 || a.addr == one) { exit(14); }
    let two: u64 = a.addr;
    let p1: *u32 = (one + 64) as *u32;
    let p2: *u32 = (two + 64) as *u32;
    p1[0] = 5;
    if (p2[0] != 5) { exit(15); }
    p1[0] = 0;
    h = thread_spawn(waiter, one + 64, 0);
    if (h <= 0) { exit(15); }
    if (wake_one(p2) != 1) { exit(16); }
    if (join(h) != 0) { exit(16); }
    vm_unmap(one, 0);
    vm_unmap(two, 0);
    handle_close(m);
}

// ROUNDS turns of the counter, read and written around a yield, so a lock
// that let two in would lose counts; then the heap, from every worker at once
fn bumper(arg: u64) -> i32 {
    let me: u32 = thread_id() as u32;
    ids[arg as u32] = me;
    let i: u32 = 0;
    while (i < ROUNDS) {
        mutex_lock(&lock);
        if ((__atomic_load(&lock.w) & ~FUTEX_WAITERS) != me) { return 1; }
        let v: u32 = counter;
        yield_();
        counter = v + 1;
        if (mutex_unlock(&lock) != 0) { return 2; }
        i = i + 1;
    }
    let blocks: [64]usize;
    let round: u32 = 0;
    while (round < 40) {
        let k: u32 = 0;
        while (k < 64) {
            let size: u32 = 8 + ((k + round + (arg as u32)) % 7) * 24;
            blocks[k] = alloc(size);
            if (blocks[k] == 0) { return 3; }
            memset(blocks[k] as *u8, (me & 0xFF) as u8, size);
            k = k + 1;
        }
        yield_();
        k = 0;
        while (k < 64) {
            let b: *u8 = blocks[k] as *u8;
            let size: u32 = 8 + ((k + round + (arg as u32)) % 7) * 24;
            let j: u32 = 0;
            while (j < size) { if (b[j] != (me & 0xFF) as u8) { return 4; } j = j + 1; }
            free(blocks[k]);
            k = k + 1;
        }
        round = round + 1;
    }
    return 0;
}

fn producer(arg: u64) -> i32 {
    let i: u32 = 1;
    while (i <= ITEMS) {
        mutex_lock(&cvm);
        while (slot_full == 1) { cond_wait(&cv, &cvm); }
        slot_val = i;
        slot_full = 1;
        cond_broadcast(&cv);
        mutex_unlock(&cvm);
        i = i + 1;
    }
    return 0;
}

fn once_body() -> void {
    sleep_ms(30);
    __atomic_add(&once_count, 1);
}

fn once_user(arg: u64) -> i32 {
    once_run(&once_o, once_body);
    if (__atomic_load(&once_count) != 1) { return 1; }
    return 0;
}

fn sync_lib() -> void {
    // 20-22: a mutex's word is its owner; only the owner unlocks it
    let me: u32 = thread_id() as u32;
    if (me == 0 || (me & FUTEX_WAITERS) != 0) { exit(20); }
    if (mutex_unlock(&lock) != E_ACCESS_DENIED) { exit(21); }
    if (mutex_trylock(&lock) != 0 || lock.w != me) { exit(22); }
    if (mutex_trylock(&lock) != E_SHOULD_WAIT) { exit(22); }
    if (mutex_unlock(&lock) != 0 || lock.w != 0) { exit(22); }

    // 23-26: four threads through one mutex, and through the heap
    let h: [4]i32;
    let i: u32 = 0;
    while (i < WORKERS) { h[i] = thread_spawn(bumper, i as u64, 0); if (h[i] <= 0) { exit(23); } i = i + 1; }
    i = 0;
    while (i < WORKERS) {
        let c: i32 = join(h[i]);
        if (c != 0) { exit(24 * 10 + c); }
        i = i + 1;
    }
    if (counter != WORKERS * ROUNDS) { exit(25); }
    // each its own id, none the first thread's
    i = 0;
    while (i < WORKERS) {
        if (ids[i] == 0 || ids[i] == me) { exit(26); }
        let j: u32 = i + 1;
        while (j < WORKERS) { if (ids[i] == ids[j]) { exit(26); } j = j + 1; }
        i = i + 1;
    }

    // 27-28: a condition variable carries ITEMS through one slot
    let p: i32 = thread_spawn(producer, 0, 0);
    if (p <= 0) { exit(27); }
    let sum: u32 = 0;
    let got: u32 = 0;
    while (got < ITEMS) {
        mutex_lock(&cvm);
        while (slot_full == 0) { cond_wait(&cv, &cvm); }
        sum = sum + slot_val;
        slot_full = 0;
        cond_broadcast(&cv);
        mutex_unlock(&cvm);
        got = got + 1;
    }
    if (join(p) != 0 || sum != ITEMS * (ITEMS + 1) / 2) { exit(28); }
    // 29: a timed wait with no signal ends at its deadline, holding the lock
    mutex_lock(&cvm);
    let c2: cond;
    c2.seq = 0;
    if (cond_wait_until(&c2, &cvm, time_deadline_ms(20)) != E_TIMED_OUT) { exit(29); }
    if (mutex_unlock(&cvm) != 0) { exit(29); }

    // 30-31: once runs its function once, and every caller returns after it
    i = 0;
    while (i < 3) { h[i] = thread_spawn(once_user, 0, 0); if (h[i] <= 0) { exit(30); } i = i + 1; }
    once_run(&once_o, once_body);
    if (once_count != 1) { exit(31); }
    i = 0;
    while (i < 3) { if (join(h[i]) != 0) { exit(31); } i = i + 1; }
    if (once_count != 1) { exit(31); }

    // 32-35: alloc and the output take the library's locks. On one CPU a
    // race inside alloc is a few instructions wide and the heap stress above
    // seldom reaches it, so hold each lock here and see a thread wait on it.
    let r: i32 = holds_off(&heap_mu, allocer);
    if (r != 0) { exit(31 + r); }
    r = holds_off(&io_mu, printer);
    if (r != 0) { exit(33 + r); }
}

fn allocer(arg: u64) -> i32 {
    let p: usize = alloc(64);
    if (p == 0) { return 1; }
    free(p);
    return 0;
}

fn printer(arg: u64) -> i32 {
    newline();
    return 0;
}

// Hold m, start f: it must still be running 50 ms on, asleep on m (its
// word marked FUTEX_WAITERS), and end once m is let go -> 0, or 1 / 2.
fn holds_off(m: *mutex, f: thread_fn) -> i32 {
    mutex_lock(m);
    let h: i32 = thread_spawn(f, 0, 0);
    if (h <= 0) { mutex_unlock(m); return 1; }
    let code: i32 = 0;
    let rc: i32 = thread_join(h, time_deadline_ms(50), &code);
    let waited: u32 = __atomic_load(&m.w) & FUTEX_WAITERS;
    mutex_unlock(m);
    if (rc != E_TIMED_OUT || waited == 0) { join(h); return 1; }
    if (join(h) != 0) { return 2; }
    return 0;
}

fn args_first() -> *u8 {
    let ai: args_info;
    if (args_read(&ai) != 0 || ai.count == 0) { return 0 as *u8; }
    let page: *u32 = ai.base as *u32;
    return (ai.base + (page[1] as u64)) as *u8;
}

fn is(s: *u8, w: *u8) -> i32 {
    if (s == (0 as *u8)) { return 0; }
    let i: u32 = 0;
    while (w[i] != 0) { if (s[i] != w[i]) { return 0; } i = i + 1; }
    if (s[i] != 0) { return 0; }
    return 1;
}

fn _start() -> void {
    if (is(args_first(), "exit") == 1) {
        let h: i32 = thread_spawn(forever, (&word) as u64, 0);
        if (h <= 0) { exit(1); }
        sleep_ms(200);   // time to be waiting
        exit(43);
    }
    calls();
    sync_lib();
    exit(0);
}
