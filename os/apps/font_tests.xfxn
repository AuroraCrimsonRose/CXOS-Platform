// SPDX-License-Identifier: MIT
// SPDX-FileCopyrightText: 2026 Aurora Tejeda (trading as CATX Systems)
// apps/font_tests.xfxn - x tests: the toolkit's text in outline fonts (2.8a′4).
// Aurora Tejeda / CATX Systems
// Threads: one, the x test's.
//
// 8000-8099 the font handle: sizes, metrics, rescale, proportional width
// 8100-8199 text drawn pixel for pixel as rs_draw draws it: plain, clipped,
//           bold, mirrored
// 8200-8299 layout and the text field: widths, scroll, hit-test, caret
// 8300-8399 a face shared as a memory object, the UI setting, a face by
//           family and weight
//
// What is drawn is held to rs_draw (std/raster.xfxn, itself held to the C#
// oracle by RasterDiff), never to the glyph cache tk_text draws from, and
// where each glyph goes is worked out here from rs_draw's advances.

import "toolkit_tests.xfxn";
import "fontfile.xfxn";
import "settings.xfxn";

global fh_reg: of_face;
global fh_bold: of_face;
global fh_t: tk_font;
global fh_s: tk_font;
global fh_h: tk_font;
global fh_ui: tk_ui;

const FH_W: u32 = 200;
const FH_H: u32 = 48;
const FH_BG: u32 = 0xFF102030;
const FH_FG: u32 = 0xFFF0E0D0;
global fh_want: [9600]u32;          // FH_W x FH_H

// Both faces and the three fonts, at scale 4: 0, or the step that failed.
fn fh_faces() -> i32 {
    if (of_load(&fh_reg, "cxsans") != 0) { return 1; }
    if (of_load(&fh_bold, "cxsans-b") != 0) { of_free(&fh_reg); return 2; }
    if (tk_font_init(&fh_t, &fh_reg, TK_TEXT_SIZE, 4) != 0) { return 3; }
    if (tk_font_init(&fh_s, &fh_bold, TK_TEXT_SIZE, 4) != 0) { return 4; }
    if (tk_font_init(&fh_h, &fh_bold, TK_HEAD_SIZE, 4) != 0) { return 5; }
    return 0;
}

fn fh_unfaces() -> void {
    tk_set_fonts(&fh_ui, 0 as *tk_font, 0 as *tk_font, 0 as *tk_font);
    tk_set_fonts(&tt_ui, 0 as *tk_font, 0 as *tk_font, 0 as *tk_font);
    tk_font_free(&fh_t);
    tk_font_free(&fh_s);
    tk_font_free(&fh_h);
    of_free(&fh_reg);
    of_free(&fh_bold);
}

// A 26.6 pen as a whole pixel, rounded at the half (the test's own).
fn fh_pen(p: i64) -> i32 { return ((p + 32) / 64) as i32; }

// 26.6 up to a whole pixel.
fn fh_ceil(p: i64) -> i32 { return ((p + 63) / 64) as i32; }

// The ASCII string s in font t, in 26.6, from rs_draw's advances.
fn fh_width(t: *tk_font, s: *u8) -> i64 {
    let w: i64 = 0;
    let k: u32 = 0;
    while (s[k] != 0) {
        let b: rs_bitmap;
        if (rs_draw(t.face, of_lookup(t.face, s[k] as u32), t.ppem, &b) != 0) { return 0 - 1; }
        w = w + b.advance;
        rs_release(&b);
        k = k + 1;
    }
    return w;
}

// ---- 8000: the font handle ----

fn fh_handle(arg: u64) -> i32 {
    let rc: i32 = fh_faces();
    if (rc != 0) { return 8000 + rc; }
    // sizes are logical: a ui at scale q (quarters) gets size*q/4, rounded
    if (fh_t.ppem != 13 || fh_h.ppem != 18) { fh_unfaces(); return 8010; }
    if (fh_t.asc <= 0 || fh_t.line <= fh_t.asc || fh_t.ult < 1 || fh_t.ul < 1) { fh_unfaces(); return 8011; }
    if (fh_h.line <= fh_t.line) { fh_unfaces(); return 8012; }
    let fa: *of_face = &fh_reg;
    if (fh_t.asc != fh_ceil(rs_scale(fa.ascender, 13))) { fh_unfaces(); return 8019; }
    if (fh_t.line != fh_t.asc + fh_ceil(rs_scale(0 - fa.descender, 13))) { fh_unfaces(); return 8026; }
    let line4: i32 = fh_t.line;
    tk_font_scale(&fh_t, 6);
    if (fh_t.ppem != 20) { fh_unfaces(); return 8013; }
    tk_font_scale(&fh_t, 8);
    if (fh_t.ppem != 26 || fh_t.line < 2 * line4 - 2 || fh_t.line > 2 * line4 + 2) { fh_unfaces(); return 8014; }
    tk_font_scale(&fh_t, 4);
    if (fh_t.ppem != 13 || fh_t.line != line4) { fh_unfaces(); return 8015; }
    // what is not one is refused
    let bad: tk_font;
    if (tk_font_init(&bad, &fh_reg, 0, 4) != E_INVALID_ARGS) { fh_unfaces(); return 8016; }
    if (tk_font_init(&bad, &fh_reg, 257, 4) != E_INVALID_ARGS) { fh_unfaces(); return 8017; }
    if (tk_font_init(&bad, 0 as *of_face, 13, 4) != E_INVALID_ARGS) { fh_unfaces(); return 8018; }
    // widths are the sum of the advances, proportional
    let wi: i64 = tk_font_width(&fh_t, "iiii", 4);
    let wm: i64 = tk_font_width(&fh_t, "MMMM", 4);
    if (wi <= 0 || wi * 2 >= wm) { fh_unfaces(); return 8020; }
    if (wi != fh_width(&fh_t, "iiii") || wm != fh_width(&fh_t, "MMMM")) { fh_unfaces(); return 8021; }
    let wa: i64 = tk_font_width(&fh_t, "Wave", 4);
    if (wa != fh_width(&fh_t, "Wave")) { fh_unfaces(); return 8022; }
    // a character of two bytes is one advance; one that takes no room, none
    let z: [8]u8;
    z[0] = 0xC3; z[1] = 0xA9;                       // e acute
    z[2] = 0xE2; z[3] = 0x80; z[4] = 0x8B;          // U+200B
    z[5] = 0xC2; z[6] = 0xAD; z[7] = 0;             // soft hyphen
    let we: i64 = tk_font_width(&fh_t, &z[0], 2);
    if (we <= 0 || we != tk_font_adv(&fh_t, 0xE9)) { fh_unfaces(); return 8023; }
    if (tk_font_width(&fh_t, &z[0], 7) != we) { fh_unfaces(); return 8024; }
    let bm: *rs_bitmap = 0 as *rs_bitmap;
    if (tk_font_glyph(&fh_t, 0x200B, &bm) != E_NOT_FOUND) { fh_unfaces(); return 8025; }
    // in a ui: lines and widths in each style, and a rescale of every font
    let f: i32 = tt_make_font();
    if (f != 0) { fh_unfaces(); return 8030 + f; }
    tk_init(&fh_ui, 4, &tt_font);
    let cell_h: u32 = tk_line_h(&fh_ui, TK_ST_TEXT);
    tk_set_fonts(&fh_ui, &fh_t, &fh_s, &fh_h);
    if (tk_line_h(&fh_ui, TK_ST_TEXT) != (fh_t.line as u32)) { fh_unfaces(); return 8040; }
    if (tk_line_h(&fh_ui, TK_ST_STRONG) != (fh_s.line as u32)) { fh_unfaces(); return 8041; }
    if (tk_line_h(&fh_ui, TK_ST_HEAD) != (fh_h.line as u32)) { fh_unfaces(); return 8042; }
    if (tk_line_h(&fh_ui, TK_ST_CELL) != cell_h) { fh_unfaces(); return 8043; }    // a grid's cells stay cells
    if (tk_str_dw(&fh_ui, "iiii", 4, TK_ST_TEXT) != (fh_pen(wi) as u32)) { fh_unfaces(); return 8044; }
    if (tk_str_dw(&fh_ui, "MMMM", 4, TK_ST_STRONG) != (fh_pen(fh_width(&fh_s, "MMMM")) as u32)) { fh_unfaces(); return 8045; }
    if (tk_str_dw(&fh_ui, "MMMM", 4, TK_ST_CELL) != 4 * tk_char_w(&fh_ui)) { fh_unfaces(); return 8046; }
    tk_set_scale(&fh_ui, 8);
    if (fh_t.ppem != 26 || fh_s.ppem != 26 || fh_h.ppem != 36) { fh_unfaces(); return 8047; }
    if (tk_str_dw(&fh_ui, "iiii", 4, TK_ST_TEXT) != (fh_pen(fh_width(&fh_t, "iiii")) as u32)) { fh_unfaces(); return 8048; }
    tk_set_scale(&fh_ui, 4);
    if (fh_t.ppem != 13 || fh_h.ppem != 18) { fh_unfaces(); return 8049; }
    // no fonts: the bitmap's cells again
    tk_set_fonts(&fh_ui, 0 as *tk_font, &fh_s, &fh_h);
    if (tk_line_h(&fh_ui, TK_ST_HEAD) != cell_h || tk_str_dw(&fh_ui, "iiii", 4, TK_ST_STRONG) != 4 * tk_char_w(&fh_ui)) { fh_unfaces(); return 8050; }
    fh_unfaces();
    return 0;
}

// ---- 8100: text drawn as rs_draw draws it ----

// The canvas, and fh_want, all FH_BG.
fn fh_clear() -> void {
    let y: u32 = 0;
    while (y < FH_H) {
        let row: *u32 = ds_row(&fh_ui.canvas, y);
        let x: u32 = 0;
        while (x < FH_W) { row[x] = FH_BG; fh_want[y * FH_W + x] = FH_BG; x = x + 1; }
        y = y + 1;
    }
}

// ASCII s in font t into fh_want, its line's top at y, its pen from x,
// what falls outside columns [x0, x1) left out: 0, or 1 if a glyph would
// not draw.
fn fh_expect(t: *tk_font, s: *u8, x: i32, y: i32, x0: i32, x1: i32) -> i32 {
    let pen: i64 = 0;
    let k: u32 = 0;
    while (s[k] != 0) {
        let b: rs_bitmap;
        if (rs_draw(t.face, of_lookup(t.face, s[k] as u32), t.ppem, &b) != 0) { return 1; }
        let gx: i32 = x + fh_pen(pen) + b.left;
        let gy: i32 = y + t.asc + b.top;
        let r: u32 = 0;
        while (r < b.height) {
            let c: u32 = 0;
            while (c < b.width) {
                let px: i32 = gx + (c as i32);
                let py: i32 = gy + (r as i32);
                let a: u32 = b.cov[r * b.width + c] as u32;
                if (a != 0 && px >= x0 && px < x1 && px >= 0 && px < (FH_W as i32) && py >= 0 && py < (FH_H as i32)) {
                    let at: u32 = (py as u32) * FH_W + (px as u32);
                    if (a == 255) { fh_want[at] = FH_FG; }
                    else { fh_want[at] = ds_over(ds_fade(FH_FG, a), fh_want[at]); }
                }
                c = c + 1;
            }
            r = r + 1;
        }
        pen = pen + b.advance;
        rs_release(&b);
        k = k + 1;
    }
    return 0;
}

// The canvas against fh_want: 0, or 1 at the first pixel that differs.
// Some pixel must have been drawn, or the test proves nothing.
fn fh_same() -> i32 {
    let inked: u32 = 0;
    let y: u32 = 0;
    while (y < FH_H) {
        let row: *u32 = ds_row(&fh_ui.canvas, y);
        let x: u32 = 0;
        while (x < FH_W) {
            if (row[x] != fh_want[y * FH_W + x]) { return 1; }
            if (row[x] != FH_BG) { inked = 1; }
            x = x + 1;
        }
        y = y + 1;
    }
    if (inked == 0) { return 2; }
    return 0;
}

fn fh_draw(arg: u64) -> i32 {
    let rc: i32 = fh_faces();
    if (rc != 0) { return 8100 + rc; }
    rc = tt_make_font();
    if (rc != 0) { fh_unfaces(); return 8110 + rc; }
    tk_init(&fh_ui, 4, &tt_font);
    tk_set_fonts(&fh_ui, &fh_t, &fh_s, &fh_h);
    if (tk_size(&fh_ui, FH_W, FH_H) != 0) { fh_unfaces(); return 8120; }
    let all: ds_rect;
    ds_rect_set(&all, 0, 0, FH_W, FH_H);
    // body text: each glyph at its rounded pen, on the baseline
    fh_clear();
    tk_text(&fh_ui, &all, 7, 5, "Wave fold", FH_FG, TK_ST_TEXT);
    if (fh_expect(&fh_t, "Wave fold", 7, 5, 0, FH_W as i32) != 0) { fh_unfaces(); return 8121; }
    rc = fh_same();
    if (rc != 0) { fh_unfaces(); return 8122 + rc; }
    // strong text is the bold face's; a heading, the bold face at its size
    fh_clear();
    tk_text(&fh_ui, &all, 3, 2, "Bold", FH_FG, TK_ST_STRONG);
    if (fh_expect(&fh_s, "Bold", 3, 2, 0, FH_W as i32) != 0) { fh_unfaces(); return 8125; }
    rc = fh_same();
    if (rc != 0) { fh_unfaces(); return 8126 + rc; }
    fh_clear();
    tk_text(&fh_ui, &all, 3, 2, "Head", FH_FG, TK_ST_HEAD);
    if (fh_expect(&fh_h, "Head", 3, 2, 0, FH_W as i32) != 0) { fh_unfaces(); return 8129; }
    rc = fh_same();
    if (rc != 0) { fh_unfaces(); return 8130 + rc; }
    // clipped: what is past the clip's edge stays as it was, mid-glyph too
    let pen2: i32 = fh_pen(fh_width(&fh_t, "H"));
    let cut: i32 = 10 + pen2 + pen2 / 2;
    let cl: ds_rect;
    ds_rect_set(&cl, 0, 0, cut as u32, FH_H);
    fh_clear();
    tk_text(&fh_ui, &cl, 10, 4, "HHHH", FH_FG, TK_ST_TEXT);
    if (fh_expect(&fh_t, "HHHH", 10, 4, 0, cut) != 0) { fh_unfaces(); return 8133; }
    rc = fh_same();
    if (rc != 0) { fh_unfaces(); return 8134 + rc; }
    // the ui moved by tx: the same text, tx to the right
    fh_ui.tx = 9;
    fh_clear();
    tk_text(&fh_ui, &all, 4, 4, "Move", FH_FG, TK_ST_TEXT);
    fh_ui.tx = 0;
    if (fh_expect(&fh_t, "Move", 13, 4, 9, FH_W as i32) != 0) { fh_unfaces(); return 8137; }
    rc = fh_same();
    if (rc != 0) { fh_unfaces(); return 8138 + rc; }
    // mirrored: the text's box is mirrored, its glyphs are not (§10): it
    // ends x from the canvas's right edge, set left to right
    tk_set_mirror(&fh_ui, 1);
    fh_clear();
    tk_text(&fh_ui, &all, 12, 6, "Mirror", FH_FG, TK_ST_TEXT);
    tk_set_mirror(&fh_ui, 0);
    let mx: i32 = (FH_W as i32) - 12 - fh_pen(fh_width(&fh_t, "Mirror"));
    if (fh_expect(&fh_t, "Mirror", mx, 6, 0, FH_W as i32) != 0) { fh_unfaces(); return 8141; }
    rc = fh_same();
    if (rc != 0) { fh_unfaces(); return 8142 + rc; }
    // at scale 8 the same text is the 26-pixel face's
    tk_set_scale(&fh_ui, 8);
    fh_clear();
    tk_text(&fh_ui, &all, 2, 1, "Big", FH_FG, TK_ST_TEXT);
    if (fh_expect(&fh_t, "Big", 2, 1, 0, FH_W as i32) != 0) { fh_unfaces(); return 8145; }
    rc = fh_same();
    if (rc != 0) { fh_unfaces(); return 8146 + rc; }
    tk_free(&fh_ui);
    fh_unfaces();
    return 0;
}

// ---- 8200: layout and the text field ----

fn fh_field(arg: u64) -> i32 {
    let rc: i32 = fh_faces();
    if (rc != 0) { return 8200 + rc; }
    rc = tt_make_font();
    if (rc != 0) { fh_unfaces(); return 8210 + rc; }
    // labels as wide as their text, a heading as tall as its font's line
    tk_init(&tt_ui, 4, &tt_font);
    tk_set_fonts(&tt_ui, &fh_t, &fh_s, &fh_h);
    let root: u32 = tk_root(&tt_ui);
    let li: u32 = tk_add(&tt_ui, root, TK_LABEL, "iiii");
    let lm: u32 = tk_add(&tt_ui, root, TK_LABEL, "MMMM");
    let hd: u32 = tk_add(&tt_ui, root, TK_HEADING, "MMMM");
    let f: u32 = tk_add(&tt_ui, root, TK_TEXTFIELD, "Name");
    if (f == 0 || tt_show(4) != 0) { fh_unfaces(); return 8220; }
    let ri: ds_rect; let rm: ds_rect; let rh: ds_rect;
    tk_box_of(&tt_ui, li, &ri);
    tk_box_of(&tt_ui, lm, &rm);
    tk_box_of(&tt_ui, hd, &rh);
    if (ri.w * 2 >= rm.w) { fh_unfaces(); return 8221; }
    if (rm.w != (fh_pen(fh_width(&fh_t, "MMMM")) as u32)) { fh_unfaces(); return 8222; }
    if (rm.h != (fh_t.line as u32) || rh.h != (fh_h.line as u32)) { fh_unfaces(); return 8223; }
    if (rh.w != (fh_pen(fh_width(&fh_h, "MMMM")) as u32)) { fh_unfaces(); return 8224; }
    // the field: a pointer at a character's edge is before it
    tk_key(&tt_ui, KC_TAB, 0, 0);
    if (tk_focused(&tt_ui) != f) { fh_unfaces(); return 8225; }
    tt_type("iMiM");
    tt_drain();
    tt_repaint();
    let i: u32 = tk_index(&tt_ui, f);
    let n: *tk_node = &tt_ui.node[i];
    let tx: i32 = 0; let ty: i32 = 0; let lim: i32 = 0;
    tk_field_geom(&tt_ui, n, &tx, &ty, &lim);
    let k: u32 = 0;
    let pre: [8]u8;
    let s: *u8 = "iMiM";
    while (k <= 4) {
        memzero(&pre[0], 8);
        memcpy(&pre[0], s, k);
        let e: i32 = fh_pen(fh_width(&fh_t, &pre[0]));
        if (tk_field_at(&tt_ui, i, tx + e) != k) { fh_unfaces(); return (8230 + k) as i32; }
        k = k + 1;
    }
    // past the middle of an M is after it, short of it before
    let e1: i32 = fh_pen(fh_width(&fh_t, "i"));
    let e2: i32 = fh_pen(fh_width(&fh_t, "iM"));
    let mid: i32 = e2 - (e2 - e1) / 2;
    if (tk_field_at(&tt_ui, i, tx + mid) != 2 || tk_field_at(&tt_ui, i, tx + mid - 2) != 1) { fh_unfaces(); return 8236; }
    if (tk_field_at(&tt_ui, i, tx + 150) != 4) { fh_unfaces(); return 8237; }
    // the caret, at the end of the text
    let cx: i32 = tx + fh_pen(fh_width(&fh_t, "iMiM"));
    if (tt_pix(cx, ty + fh_t.line / 2) != tt_ui.theme.text) { fh_unfaces(); return 8238; }
    // a long text scrolls just far enough for the caret to show
    let m: [41]u8;
    memset(&m[0], 77, 40);
    m[40] = 0;
    if (tk_set_field_text(&tt_ui, f, &m[0]) != 0) { fh_unfaces(); return 8240; }
    tt_press(KC_END, 0);
    tt_repaint();
    let fl: *tk_field = &tt_ui.field[n.field];
    if (fl.caret != 40) { fh_unfaces(); return 8241; }
    let am: i64 = fh_width(&fh_t, "M");
    let want: u32 = 0;
    while (want < 40 && fh_pen(40 * am) - fh_pen((want as i64) * am) > lim) { want = want + 1; }
    if (want == 0) { fh_unfaces(); return 8242; }       // too short to scroll: the test proves nothing
    if (fl.scroll != want) { fh_unfaces(); return 8243; }
    let cx2: i32 = tx + fh_pen(40 * am) - fh_pen((want as i64) * am);
    if (tt_pix(cx2, ty + fh_t.line / 2) != tt_ui.theme.text) { fh_unfaces(); return 8244; }
    // the first character shown is at the field's first column
    if (tk_field_at(&tt_ui, i, tx) != want) { fh_unfaces(); return 8245; }
    tt_press(KC_HOME, 0);
    tt_repaint();
    if (fl.scroll != 0) { fh_unfaces(); return 8246; }
    fh_unfaces();
    return 0;
}

// ---- 8300: a shared face, the UI setting, a face by name ----

fn fh_share(arg: u64) -> i32 {
    let f: of_face;
    if (of_load(&f, "cxsans") != 0) { return 8300; }
    // a face handed over as its memory object maps, read-only, as loaded
    let g: of_face;
    if (of_map(&g, f.mem) != 0) { of_free(&f); return 8301; }
    if (g.glyphs != f.glyphs || g.mem >= 0 || g.addr == f.addr) { of_free(&g); of_free(&f); return 8302; }
    let a: rs_bitmap;
    let b: rs_bitmap;
    if (rs_draw(&f, of_lookup(&f, 97), 20, &a) != 0) { of_free(&g); of_free(&f); return 8303; }
    if (rs_draw(&g, of_lookup(&g, 97), 20, &b) != 0) { rs_release(&a); of_free(&g); of_free(&f); return 8304; }
    let same: u32 = 0;
    if (a.width == b.width && a.height == b.height && a.left == b.left && a.top == b.top && a.width > 0) {
        if (memeq(a.cov, b.cov, a.width * a.height) != 0) { same = 1; }
    }
    rs_release(&a);
    rs_release(&b);
    of_free(&g);
    if (same == 0) { of_free(&f); return 8305; }
    // the loader's face outlives the mapping's
    if (rs_draw(&f, of_lookup(&f, 97), 20, &a) != 0) { of_free(&f); return 8306; }
    rs_release(&a);
    // a copy is checked as the file is: a broken one is refused
    let size: i64 = file_size("/System/Fonts/cxsans.xfnt");
    if (size <= 0) { of_free(&f); return 8307; }
    let addr: u64 = 0;
    let mh: i32 = ds_mem(size as u64, &addr);
    if (mh <= 0) { of_free(&f); return 8308; }
    let p: *u8 = addr as *u8;
    memcpy(p, f.addr as *u8, size as u32);
    of_free(&f);
    let h: of_face;
    if (of_map(&h, mh) != 0) { vm_unmap(addr, 0); handle_close(mh); return 8310; }
    of_free(&h);
    p[0] = p[0] ^ 0xFF;
    if (of_map(&h, mh) != E_CORRUPT || h.why == 0 || h.addr != 0) { vm_unmap(addr, 0); handle_close(mh); return 8311; }
    p[0] = p[0] ^ 0xFF;
    p[29] = p[29] ^ 0x40;                               // a glyph count it cannot hold
    if (of_map(&h, mh) != E_CORRUPT) { vm_unmap(addr, 0); handle_close(mh); return 8312; }
    p[29] = p[29] ^ 0x40;
    if (of_map(&h, mh) != 0) { vm_unmap(addr, 0); handle_close(mh); return 8313; }
    of_free(&h);
    vm_unmap(addr, 0);
    handle_close(mh);
    if (of_map(&h, 0x7FFF) >= 0) { return 8314; }       // not a handle
    // the setting: a percentage, 100 to 400 in steps of 25
    if (settings_ui_quarters("100") != 4 || settings_ui_quarters("125") != 5) { return 8320; }
    if (settings_ui_quarters("250") != 10 || settings_ui_quarters("400") != 16) { return 8321; }
    if (settings_ui_quarters("75") != 0 || settings_ui_quarters("110") != 0 || settings_ui_quarters("425") != 0) { return 8322; }
    if (settings_ui_quarters("") != 0 || settings_ui_quarters("1x0") != 0 || settings_ui_quarters("0100") != 0) { return 8323; }
    // a face by family, weight and style
    let nm: [16]u8;
    if (of_face_name(&nm[0], "cxsans", 1, 1) != 1 || streq(&nm[0], "cxsans-bi") == 0) { return 8330; }
    if (of_face_name(&nm[0], "cxsans", 0, 1) != 1 || streq(&nm[0], "cxsans-i") == 0) { return 8331; }
    if (of_face_name(&nm[0], "cxsans", 0, 0) != 1 || streq(&nm[0], "cxsans") == 0) { return 8332; }
    if (of_face_name(&nm[0], "", 0, 0) != 0) { return 8333; }
    // weight 700 is bold's file, byte for byte
    let fb: of_face;
    let ob: of_face;
    if (of_open(&fb, "cxsans", 700, 0) != 0) { return 8334; }
    if (of_load(&ob, "cxsans-b") != 0) { of_free(&fb); return 8335; }
    let bsz: i64 = file_size("/System/Fonts/cxsans-b.xfnt");
    let ok: u32 = 0;
    if (bsz > 0 && bsz != size && memeq(fb.addr as *u8, ob.addr as *u8, bsz as u32) != 0) { ok = 1; }
    of_free(&fb); of_free(&ob);
    if (ok == 0) { return 8337; }
    if (of_open(&fb, "nosuch", 400, 0) != E_NOT_FOUND) { return 8338; }
    if (of_open(&fb, "cxsans", 400, 1) != 0) { return 8339; }
    of_free(&fb);
    return 0;
}
