// apps/displayd.xfxn - the display server (roadmap 2.4).
// Aurora Tejeda / CATX Systems
// Threads: one.
//
//   run +screen +spawn +endpoint +disk displayd [client ...]    (default: two wdemo windows)
//
// +disk is for the title bars' font; without it the frames have no text.
//
// Takes the screen (SYS_SCREEN_OPEN) and the keyboard and pointer
// (SYS_INPUT_OPEN) from the kernel and starts its clients, which is how they
// are connected to it. The windows, frames and input routing are
// std/wm.xfxn, the loop and protocol std/dserver.xfxn. A bare client name is
// looked for in /Shared/Programs.
//
// `displayd --empty` starts nobody and waits for Ctrl+Q.
//
// Ctrl+Q ends the session, as does the last client going. When it ends, the
// screen's and the keyboard's last references go: the kernel repaints its
// console and the shell has its keys back.

import "dserver.xfxn";
import "io.xfxn";
import "fmt.xfxn";

const DD_CURSOR_W: u32 = 11;
const DD_CURSOR_H: u32 = 16;

global dd: dsv;
global dd_path: [128]u8;

// A vertical gradient with a faint grid every 32 pixels: opaque.
fn dd_paint_desktop(s: *ds_surface) -> void {
    let y: u32 = 0;
    while (y < s.height) {
        let t: u32 = (y * 255) / s.height;
        let r: u32 = 0x20 + (t * 0x20) / 255;
        let g: u32 = 0x30 + (t * 0x30) / 255;
        let b: u32 = 0x48 + (t * 0x38) / 255;
        let c: u32 = 0xFF000000 | (r << 16) | (g << 8) | b;
        ds_fill(s, 0, y, s.width, 1, c);
        if (y % 32 == 0) { ds_fill(s, 0, y, s.width, 1, 0xFF2A3A54); }
        y = y + 1;
    }
    let x: u32 = 0;
    while (x < s.width) { ds_fill(s, x, 0, 1, s.height, 0xFF2A3A54); x = x + 32; }
}

// An arrow: a black outline, white inside, transparent around it.
fn dd_paint_cursor(s: *ds_surface) -> void {
    let y: u32 = 0;
    while (y < DD_CURSOR_H) {
        let x: u32 = 0;
        let last: u32 = ds_min(y, DD_CURSOR_W - 1);
        while (x <= last) {
            let c: u32 = 0xFFFFFFFF;
            if (x == 0 || x == last || y == DD_CURSOR_H - 1) { c = 0xFF000000; }
            ds_put(s, x, y, c);
            x = x + 1;
        }
        y = y + 1;
    }
}

fn dd_fail(what: *u8, rc: i32) -> void {
    puts("displayd: ");
    puts(what);
    puts(": error -");
    print_u32((0 - rc) as u32);
    newline();
    exit(1);
}

// One client: a name alone is looked for in /Shared/Programs.
fn dd_launch(name: *u8) -> void {
    let i: u32 = 0;
    let slash: u32 = 0;
    while (name[i] != 0) { if (name[i] == 47) { slash = 1; } i = i + 1; }
    if (slash == 1) {
        strcopy(&dd_path[0], name, 128);
    } else {
        let n: u32 = strcopy(&dd_path[0], "/Shared/Programs/", 128);
        n = n + strcopy(&dd_path[n], name, 128 - n);
        strcopy(&dd_path[n], ".xuex", 128 - n);
    }
    let rc: i32 = dsv_launch(&dd, &dd_path[0], name, strlen(name) + 1);
    if (rc < 0) { dd_fail("a client would not start", rc); }
}

fn _start() -> void {
    let rc: i32 = dsv_init(&dd, 0, 0, DD_CURSOR_W, DD_CURSOR_H);
    if (rc != 0) { dd_fail("no screen or no keyboard (run it as `run +screen +spawn +endpoint +disk displayd`)", rc); }
    dd_paint_desktop(&dd.desktop);
    dd_paint_cursor(&dd.cursor);

    let ai: args_info;
    let argc: u32 = 0;
    if (args_read(&ai) == 0) { argc = ai.count; }
    let empty: u32 = 0;
    if (argc > 1 && strlen((ai.base + ((ai.base as *u32)[2] as u64)) as *u8) == 7
        && strneq((ai.base + ((ai.base as *u32)[2] as u64)) as *u8, "--empty", 7) != 0) {
        empty = 1;
    } else if (argc > 1) {
        let page: *u32 = ai.base as *u32;
        let i: u32 = 1;
        while (i < argc) {
            dd_launch((ai.base + (page[1 + i] as u64)) as *u8);
            i = i + 1;
        }
    } else {
        dd_launch("wdemo");
        dd_launch("wdemo");
    }

    while (dd.w.quit == 0 && (empty == 1 || dsv_clients(&dd) > 0)) { dsv_step(&dd); }

    let frames: u32 = dd.frames;
    let pixels: u64 = dd.pixels;
    dsv_shutdown(&dd);
    puts("displayd: ");
    print_u32(frames);
    puts(" frames, ");
    print_u64(pixels);
    puts(" pixels written\n");
    exit(0);
}
