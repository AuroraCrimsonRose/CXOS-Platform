// apps/gallery.xfxn - the widget gallery, the toolkit's witness (roadmap 2.8a1).
// Aurora Tejeda / CATX Systems
// Threads: one.
//
//   run +screen +spawn +endpoint +disk displayd gallery
//
// Every widget in every state (gallery_pages.xfxn). Started by the display
// server, which gives it the connection, the font and its strings
// (2.8a4: /System/Locale/gallery-<tag>.xstr, displayd --locale), and the
// UI face and scale (2.8a′4: /Shared/Config/ui.xuco, the shell's `ui`).
// Keys: Tab, Space, Enter and the arrows go to the widgets; Ctrl+Tab turns
// the page; F10 opens the menus; Ctrl+D turns dark on and off, Ctrl+Shift+H high
// contrast, Ctrl+Shift+I the inspector's outlines; Ctrl+1, 2, 3 show it at
// 100, 150 and 200 %.

import "toolkit_window.xfxn";
import "gallery_pages.xfxn";

global ga_ui: tk_ui;
global ga_win: tk_win;

fn _start() -> void {
    let ep: i32 = win_connection();
    if (ep <= 0) { exit(2); }
    let font: *ds_font = 0 as *ds_font;
    if (tk_win_font(&ga_win) == 1) { font = &ga_win.font; }
    tk_init(&ga_ui, tk_win_scale(), font);    // at the scale the user chose (2.8a′4)
    tk_win_fonts(&ga_win, &ga_ui);             // its text in the UI face, CX Sans
    tk_win_locale(&ga_win, &ga_ui);     // its strings, as the server's locale has them (2.8a4)
    if (gp_build(&ga_ui) != 0) { exit(3); }
    if (tk_win_open(&ga_win, &ga_ui, ep, "Widget gallery", 0) != 0) { exit(4); }
    let ev: tk_event;
    while (1 == 1) {
        tk_win_next(&ga_win, &ev);
        if (ev.kind == TK_EV_CLOSE) { tk_win_close(&ga_win); exit(0); }
        if (ev.kind == TK_EV_GONE) { exit(5); }
        if (gp_event(&ga_ui, &ev) == 1) {
            if (tk_win_reopen(&ga_win, ep, "Widget gallery", 0) != 0) { exit(6); }
        }
    }
}
