// shell.xfxn - the CXK console shell.
// Aurora Tejeda / CATX Systems
//
// A privileged OS-level executable (GRANT_OS_BASELINE): reads input, writes the
// console, draws, and reboots directly.
//
// Commands are a DISPATCH TABLE of function pointers rather than an if/else
// chain - adding one is a single register() call. Each command also demonstrates
// one of the standard libraries.

import "io.xfxn";
import "string.xfxn";
import "mem.xfxn";
import "fmt.xfxn";
import "fixed.xfxn";
import "gfx.xfxn";
import "settings.xfxn";
import "cxos.xfxn";
import "net.xfxn";
import "file.xfxn";
import "edit.xfxn";
import "heap.xfxn";
import "buf.xfxn";
type cmd_fn = fn(*u8) -> void;      // a command receives its argument text

const MAX_CMDS: u32 = 32;

global cmd_names: [32]*u8;
global cmd_fns:   [32]cmd_fn;
global cmd_desc:  [32]*u8;
global cmd_n:     u32;

// Search path for `run <name>`, and the buffer the candidate is built in.
// Filled in by main, because X has no initialized-array syntax.
//
// Two extensions, tried in this order after the bare name: a system program
// before a user one, for the same reason /System is searched before /Shared -
// something dropped in a writable place must not shadow what the system ships.
// There is no .xcex any more; an executable is named for whose it is.
const RUN_DIRS: u32 = 2;
const RUN_EXTS: u32 = 2;
global run_dirs: [2]*u8;
global run_exts: [2]*u8;
global run_buf:  [160]u8;

// The packed argument blob handed to the kernel: the argument strings back to
// back, each NUL-terminated. 512 bytes is far more than the 128-byte command
// line can produce and well inside the one page the kernel gives a child.
const RUN_ARGC:  u32 = 512;
global run_argbuf: [512]u8;

fn register(name: *u8, f: cmd_fn, desc: *u8) -> void {
    if (cmd_n >= MAX_CMDS) { return; }
    cmd_names[cmd_n] = name;
    cmd_fns[cmd_n]   = f;
    cmd_desc[cmd_n]  = desc;
    cmd_n = cmd_n + 1;
}

// ---- commands ----

fn cmd_help(arg: *u8) -> void {
    let i: u32 = 0;
    while (i < cmd_n) {
        puts("  ");
        puts(cmd_names[i]);
        // pad to a column so the descriptions line up
        let pad: u32 = strlen(cmd_names[i]);
        while (pad < 10) { putc(32); pad = pad + 1; }
        puts(cmd_desc[i]);
        newline();
        i = i + 1;
    }
}

fn cmd_echo(arg: *u8) -> void { puts(arg); newline(); }

fn cmd_pid(arg: *u8) -> void {
    puts("pid ");
    print_u32(getpid() as u32);
    puts("  uid ");
    print_u32(getuid() as u32);
    newline();
}

// string.xfxn
fn cmd_str(arg: *u8) -> void {
    puts("length   "); print_u32(strlen(arg)); newline();
    let at: i32 = strchr(arg, 101);          // 'e'
    puts("first e  ");
    if (at < 0) { puts("not found"); } else { print_u32(at as u32); }
    newline();
    puts("is echo? ");
    print_u32(starts_with(arg, "echo") as u32);
    newline();
}

// mem.xfxn
fn cmd_mem(arg: *u8) -> void {
    let a: [16]u8;
    let b: [16]u8;
    memzero(&a[0], sizeof a);
    memzero(&b[0], sizeof b);

    strcopy(&a[0], "hello", sizeof a);
    memcpy(&b[0], &a[0], 6);
    puts("memcpy   "); puts(&b[0]); newline();

    puts("memcmp   ");
    print_u32(memeq(&a[0], &b[0], 6) as u32);
    puts(" (1 = equal)"); newline();

    memmove(&a[2], &a[0], 5);                // deliberately overlapping
    puts("memmove  "); puts(&a[0]);
    puts("  (overlap-safe)"); newline();
}

// heap.xfxn - what this process may hold, what it holds, and a round trip
// through the allocator to show the numbers move.
fn cmd_heap(arg: *u8) -> void {
    puts("quota      "); print_u32(heap_quota() / 1024); puts(" KiB"); newline();
    puts("mapped     "); print_u32(heap_used() / 1024);  puts(" KiB"); newline();

    let before: u32 = heap_used();
    let a: u32 = alloc(1000);
    if (a == 0) { puts("alloc      FAILED\n"); return; }

    // Prove the memory is really there and really writable, at both ends -
    // a mapping that is short by a byte fails here rather than at some later
    // point in an unrelated program.
    memset(a as *u8, 0x5A, 1000);
    let p: *u8 = a as *u8;
    if (p[0] != 0x5A) { puts("alloc      BAD FIRST BYTE\n"); return; }
    if (p[999] != 0x5A) { puts("alloc      BAD LAST BYTE\n"); return; }

    puts("alloc      1000 bytes at "); print_hex(a); newline();
    puts("reserved   "); print_u32(alloc_size(a)); puts(" bytes (rounded)"); newline();
    puts("mapped now "); print_u32(heap_used() / 1024); puts(" KiB (was ");
    print_u32(before / 1024); puts(" KiB)"); newline();

    // Grow past the block in place, so realloc has to move it and copy.
    let b: u32 = realloc(a, 40000);
    if (b == 0) { puts("realloc    FAILED\n"); return; }
    let q: *u8 = b as *u8;
    if (q[0] != 0x5A) { puts("realloc    LOST THE CONTENTS\n"); return; }
    if (q[999] != 0x5A) { puts("realloc    LOST THE CONTENTS\n"); return; }
    puts("realloc    40000 bytes, contents intact"); newline();

    free(b);

    // Everything freed, so the next request must be servable from the arena
    // that was just released rather than needing a new one from the kernel.
    let after: u32 = heap_used();
    let c: u32 = alloc(1000);
    if (c == 0) { puts("reuse      FAILED\n"); return; }
    free(c);
    if (heap_used() != after) { puts("reuse      GREW INSTEAD OF REUSING\n"); return; }
    puts("reuse      freed space served the next request"); newline();

    // A growable buffer on top of it: "1 2 3 ... 2000" is about 9 KB, built a
    // byte at a time from a 16-byte start, so it reallocates repeatedly.
    let s: buf = buf_new();
    let n: u32 = 1;
    while (n <= 2000) {
        if (!buf_u32(&s, n) || !buf_push(&s, ' ')) { puts("buf        GROWTH REFUSED\n"); buf_free(&s); return; }
        n += 1;
    }
    let t: *u8 = buf_cstr(&s);
    if (s.len != 8893 || t[0] != '1' || t[s.len - 2] != '0' || t[s.len] != 0) {
        puts("buf        WRONG CONTENTS\n"); buf_free(&s); return;
    }
    puts("buf        "); print_u32(s.len); puts(" bytes built by growing, contents checked"); newline();
    buf_free(&s);
}

// fixed.xfxn
fn cmd_math(arg: *u8) -> void {
    puts("2/3        "); print_fx(fx_ratio(2, 3), 4); newline();
    puts("15% of 200 "); print_fx(fx_pct(fx(200), fx(15)), 2); newline();
    puts("lerp 0..10 "); print_fx(fx_lerp(fx(0), fx(10), fx_ratio(1, 4)), 2);
    puts(" (quarter)"); newline();
}

// gfx.xfxn
fn cmd_gui(arg: *u8) -> void {
    // hand over to the graphical shell; returns when the user closes it
    cxos_run();
    puts("returned from gui\n");
}

fn cmd_ver(arg: *u8) -> void {
    puts("CXK v5 - shell in X native, ");
    print_u32(cmd_n);
    puts(" commands\n");
}

fn cmd_reboot(arg: *u8) -> void { puts("rebooting...\n"); reboot(); }

// parse "a.b.c.d" into a packed address; returns 0 if it doesn't look like one
fn parse_ip(s: *u8) -> ipv4 {
    let parts: [4]u32;
    let p: u32 = 0;
    let acc: u32 = 0;
    let digits: u32 = 0;
    let i: u32 = 0;

    while (1 == 1) {
        let c: u8 = s[i];
        if (c >= 48 && c <= 57) {
            acc = acc * 10 + ((c - 48) as u32);
            digits = digits + 1;
        }
        if (c == 46 || c == 0) {          // '.' or end
            if (digits == 0) { return 0; }
            if (p > 3) { return 0; }
            parts[p] = acc;
            p = p + 1;
            acc = 0;
            digits = 0;
            if (c == 0) { break; }
        }
        i = i + 1;
    }
    if (p != 4) { return 0; }
    return ip4(parts[0], parts[1], parts[2], parts[3]);
}

fn cmd_ifconfig(arg: *u8) -> void {
    if (net_up() != 1) {
        puts("net: interface down (no e1000 found)\n");
        return;
    }
    let mac: [8]u8;
    net_mac(&mac[0]);
    puts("  mac      "); print_mac(&mac[0]); newline();

    let cfg: [4]u32;
    net_config(&cfg[0]);
    puts("  ip       "); print_ip(cfg[0]); newline();
    puts("  mask     "); print_ip(cfg[1]); newline();
    puts("  gateway  "); print_ip(cfg[2]); newline();
    puts("  dns      "); print_ip(cfg[3]); newline();
}

fn cmd_setip(arg: *u8) -> void {
    let addr: ipv4 = parse_ip(arg);
    if (addr == 0) { puts("usage: setip a.b.c.d\n"); return; }
    net_set_ip(addr);
    puts("ip set to "); print_ip(addr); newline();
}

fn cmd_ping(arg: *u8) -> void {
    let dst: ipv4 = parse_ip(arg);
    if (dst == 0) { puts("usage: ping a.b.c.d\n"); return; }
    if (net_up() != 1) { puts("net: interface down\n"); return; }

    let ok: u32 = 0;
    let seq: u32 = 0;
    while (seq < 4) {
        let rtt: [1]u32;
        rtt[0] = 0;
        let r: i32 = net_ping(dst, seq, &rtt[0]);
        puts("  seq "); print_u32(seq);
        if (r == 1) {
            // rtt is in MICROSECONDS (measured with the TSC, not the 1000 Hz
            // PIT - that is why this used to read 0 for every reply)
            puts("  reply from "); print_ip(dst);
            puts("  "); print_u32(rtt[0]); puts(" us");
            ok = ok + 1;
        }
        if (r == 0) { puts("  timeout"); }
        if (r < 0)  {
            if (r == 0 - 2) { puts("  unreachable (broadcast/network address)"); }
            else { puts("  error "); print_u32((0 - r) as u32); }
        }
        newline();
        seq = seq + 1;
    }
    puts("  "); print_u32(ok); puts(" of 4 replied\n");
}

fn cmd_shutdown(arg: *u8) -> void {
    puts("shutting down...\n");
    shutdown();
    puts("shutdown unavailable (no ACPI S5) - use reboot\n");
}


// ---- file.xfxn: the filesystem ----
// These are the first commands that touch the disk. Everything before them
// worked inside the process; these go out through SYS_FILE_OP to CXFS, which
// needs GRANT_DISK - part of GRANT_OS_BASELINE, so the shell has it.

// report a failed call and return 1, or return 0 when rc is fine
fn file_err(what: *u8, rc: i32) -> i32 {
    if (rc >= 0) { return 0; }
    puts(what);
    puts(": ");
    puts(file_strerror(rc));
    newline();
    return 1;
}

// ---- font: list and select the console font ----
//
// Listing is plain directory reading - the kernel has no syscall for it and
// does not need one, because the shell can already read a directory. Selecting
// goes through SYS_FB_OP, which takes a NAME and composes the path itself.
//
// The ".xfnt" is trimmed when listing so that what is printed is what you type.
// The kernel refuses a name containing '.', deliberately, so "term_8.xfnt"
// would be rejected - showing it and then refusing it would be a trap.
// ---- the console's own settings document ----
//
// /Shared/Config/console.<slot>.xuco, written through settings.xfxn so a power
// cut mid-save costs the last change at worst, never the file. Two slots, a
// sequence number and a commit marker; see settings.xfxn for why that shape.
//
// /Shared/Config rather than /System/Config, and .xuco rather than .xoco,
// because this is written from ring 3: a user process can never be UID_SYSTEM,
// so /System is readable to it and not writable. The OS's own .xoco documents
// stay where they are and stay SYSTEM-written - kernel.xkco is one.

fn console_save_font(name: *u8) -> i32 {
    let body: [160]u8;
    let n: u32 = 0;
    body[0] = 0;
    n = settings_cat(&body[0], sizeof body, n, "font = \"");
    n = settings_cat(&body[0], sizeof body, n, name);
    n = settings_cat(&body[0], sizeof body, n, "\"");
    return settings_store("/Shared/Config", "console", "xuco", &body[0]);
}

// Apply the saved font, if there is one. Silent about absence - no settings
// yet is the normal state on a fresh install, not a problem to report - and
// silent about a font that will not load, because the compiled-in one is
// already drawing this line and saying so would be the only visible effect.
fn console_restore_font() -> void {
    if (gfx_width() < 320) { return; }            // VGA text: nothing to apply
    let text: [2048]u8;
    let seq: u32 = 0;
    let n: i32 = settings_load("/Shared/Config", "console", "xuco",
                               &text[0], sizeof text, &seq);
    if (n <= 0) { return; }
    let name: [64]u8;
    if (settings_get_str(&text[0], n as u32, "font", &name[0], sizeof name) != 1) { return; }
    gfx_set_font(&name[0]);
}

fn put_font_name(name: *u8) -> void {
    let tmp: [64]u8;
    strcopy(&tmp[0], name, sizeof tmp);
    let n: u32 = strlen(&tmp[0]);
    if (n > 5) {
        if (streq(&tmp[n - 5], ".xfnt") == 1) { n = n - 5; }
    }
    write(&tmp[0], n);
}

// List one font directory, tagging each entry with where it came from. Returns
// how many were printed. A missing directory is not an error worth reporting:
// /Shared/Fonts is empty on a fresh install and may not have been created yet
// on a disk from before it existed.
fn list_fonts_in(dir: *u8, tag: *u8) -> u32 {
    let st: file_stat;
    let i: u32 = 0;
    let n: u32 = 0;
    while (1 == 1) {
        let rc: i32 = dir_entry(dir, i, &st);
        if (rc < 0) { return n; }
        if (rc == 0) { break; }
        if (st.kind != FTYPE_DIR) {
            puts("  ");
            put_font_name(&st.name[0]);
            puts("  [");
            puts(tag);
            puts("]");
            newline();
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

fn cmd_font(arg: *u8) -> void {
    // VGA text cells come from character ROM at a size this kernel does not
    // choose, so there is nothing to select there. Say which, rather than
    // failing obscurely.
    if (gfx_width() < 320) {
        puts("font needs the framebuffer - VGA text glyphs are the hardware's\n");
        return;
    }

    if (arg[0] == 0) {
        // Listed in the order the kernel searches them, so a name appearing
        // twice is visibly the system one that wins.
        let n: u32 = 0;
        n = n + list_fonts_in("/System/Fonts", "system");
        n = n + list_fonts_in("/Shared/Fonts", "shared");
        if (n == 0) { puts("  (no fonts installed)\n"); return; }
        puts("  ");
        print_u32(n);
        puts(" font(s) - 'font <name>' to use one\n");
        return;
    }

    let rc: i32 = gfx_set_font(arg);
    if (rc == 0) {
        // Remember it, but never at the cost of the change itself: the font is
        // already applied, so a failed save is worth saying and not worth
        // undoing.
        if (console_save_font(arg) != 0) {
            puts("font: applied, but could not be saved for next boot\n");
        }
        // The console was cleared by the change, so this line is the first
        // thing drawn in the new font - which is the confirmation.
        puts("font: ");
        puts(arg);
        newline();
        return;
    }
    if (rc == E_NOENT) { puts("font: no such font - 'font' lists them\n"); return; }
    if (rc == E_INVAL) { puts("font: bad name, or not a usable .xfnt\n"); return; }
    puts("font: refused\n");
}

fn cmd_pwd(arg: *u8) -> void {
    let buf: [256]u8;
    if (file_err("pwd", getcwd(&buf[0], sizeof buf)) == 1) { return; }
    puts(&buf[0]);
    newline();
}

fn cmd_cd(arg: *u8) -> void {
    if (arg[0] == 0) { arg = "/"; }       // bare `cd` goes home, which is root
    file_err(arg, chdir(arg));
}

fn cmd_ls(arg: *u8) -> void {
    if (arg[0] == 0) { arg = "."; }       // default to the working directory
    let st: file_stat;
    let i: u32 = 0;
    let files: u32 = 0;
    let bytes: u32 = 0;

    while (1 == 1) {
        let rc: i32 = dir_entry(arg, i, &st);
        if (rc < 0) { file_err(arg, rc); return; }
        if (rc == 0) { break; }           // index ran past the end

        if (st.kind == FTYPE_DIR) { puts("  <dir>  "); }
        else {
            puts("  ");
            let n: u32 = print_pad(st.size, 6);
            puts("  ");
            bytes = bytes + st.size;
        }
        puts(&st.name[0]);
        newline();
        files = files + 1;
        i = i + 1;
    }

    puts("  ");
    print_u32(files);
    puts(" entries, ");
    print_u32(bytes);
    puts(" bytes\n");
}

// print v right-aligned in a field of `w`
fn print_pad(v: u32, w: u32) -> u32 {
    let tmp: [16]u8;
    let n: u32 = u32_to_dec(&tmp[0], sizeof tmp, v);
    let pad: u32 = 0;
    while (pad + n < w) { putc(32); pad = pad + 1; }
    puts(&tmp[0]);
    return n;
}

fn cmd_cat(arg: *u8) -> void {
    if (arg[0] == 0) { puts("usage: cat <path>\n"); return; }

    let h: i32 = file_open_read(arg);
    if (file_err(arg, h) == 1) { return; }

    // Stream it a chunk at a time rather than sizing a buffer to the file:
    // the shell has a 4KB stack and the file can be any size.
    let buf: [256]u8;
    while (1 == 1) {
        let n: i32 = file_read(h, &buf[0], sizeof buf);
        if (n <= 0) { break; }
        write(&buf[0], n as u32);
    }
    file_close(h);
    newline();
}

fn cmd_write(arg: *u8) -> void {
    // "write <path> <text...>"
    let text: *u8 = split_arg(arg);
    if (arg[0] == 0) { puts("usage: write <path> <text>\n"); return; }

    let h: i32 = file_create(arg);
    if (file_err(arg, h) == 1) { return; }
    let n: i32 = file_puts(h, text);
    file_close(h);
    if (file_err(arg, n) == 1) { return; }

    print_u32(n as u32);
    puts(" bytes -> ");
    puts(arg);
    newline();
}

// append instead of replacing, so the offset layer gets exercised for what it
// was built for: adding to a file without rewriting it
fn cmd_append(arg: *u8) -> void {
    let text: *u8 = split_arg(arg);
    if (arg[0] == 0) { puts("usage: append <path> <text>\n"); return; }

    let h: i32 = file_append(arg);
    if (file_err(arg, h) == 1) { return; }
    let at: i32 = file_tell(h);
    let n: i32 = file_puts(h, text);
    file_close(h);
    if (file_err(arg, n) == 1) { return; }

    print_u32(n as u32);
    puts(" bytes at offset ");
    print_u32(at as u32);
    newline();
}

fn cmd_mkdir(arg: *u8) -> void {
    if (arg[0] == 0) { puts("usage: mkdir <path>\n"); return; }
    file_err(arg, mkdir(arg));
}

fn cmd_rm(arg: *u8) -> void {
    if (arg[0] == 0) { puts("usage: rm <path>\n"); return; }
    file_err(arg, unlink(arg));
}

fn cmd_mv(arg: *u8) -> void {
    let newname: *u8 = split_arg(arg);
    if (arg[0] == 0 || newname[0] == 0) { puts("usage: mv <path> <newname>\n"); return; }
    file_err(arg, rename(arg, newname));
}

// Run a program that lives on the disk. The shell holds GRANT_OS_BASELINE, so it
// can hand a child any subset of that - here GRANT_CONSOLE, which is the least
// that lets a program say anything. broker_endpoint is -1: the shell owns a
// SEND handle to its own executive, not a RECV endpoint of its own, so it has
// no broker to give. The child gets authority directly instead.
// Split a command tail into arguments and pack them the way the kernel wants
// them: the strings one after another, each NUL-terminated, argv[0] first.
// Runs of spaces separate arguments and leading spaces are skipped, so
// `run  hi   a  b` gives the same three arguments as `run hi a b`.
//
// There is deliberately no quoting. A shell that half-implements it - honouring
// a quote in one place and not the next - is worse than one that plainly has
// none, and nothing on the disk needs an argument with a space in it yet.
//
// Returns the total byte count, or 0 for an empty line or one too long to pack.
fn run_pack_args(s: *u8) -> u32 {
    let n: u32 = 0;
    let i: u32 = 0;
    while (s[i] != 0) {
        while (s[i] == 32) { i = i + 1; }
        if (s[i] == 0) { break; }
        while (s[i] != 0 && s[i] != 32) {
            if (n + 2 >= RUN_ARGC) { return 0; }
            run_argbuf[n] = s[i];
            n = n + 1;
            i = i + 1;
        }
        run_argbuf[n] = 0;
        n = n + 1;
    }
    return n;
}

// Build "<dir>/<name>", or "<dir>/<name>" plus one of run_exts when ext is
// non-zero, into
// run_buf, and hand back a pointer to it. One shared buffer: cmd_run uses the
// result before building the next candidate.
fn run_candidate(dir: *u8, name: *u8, ext: u32) -> *u8 {
    let n: u32 = strcopy(&run_buf[0], dir, 160);
    if (n + 1 < 160) { run_buf[n] = 47; n = n + 1; }         // '/'
    n = n + strcopy(&run_buf[n], name, 160 - n);
    if (ext > 0) { n = n + strcopy(&run_buf[n], run_exts[ext - 1], 160 - n); }
    return &run_buf[0];
}

// Run a program that lives on the disk. The shell holds GRANT_OS_BASELINE, so it
// can hand a child any subset of that - here GRANT_CONSOLE, which is the least
// that lets a program say anything. broker_endpoint is -1: the shell owns a
// SEND handle to its own executive, not a RECV endpoint of its own, so it has
// no broker to give. The child gets authority directly instead.
//
// A bare name is looked up on a search path rather than in the working
// directory, so `run hi` works from anywhere. /System/Programs is searched
// before /Shared/Programs: /Shared is writable by any user, and a program
// dropped there must not be able to shadow one the system ships. The suffix
// is optional and both are tried, so `run hi`, `run hi.xsex` and `run hi.xuex`
// all find the same file.
//
// Anything with a '/' in it is taken as a path and used verbatim - that is the
// escape hatch for running something the search path does not cover, and it
// keeps `run ./x` meaning the x in the working directory rather than whichever
// x the search path happens to find first.
// `+disk` and the like, before the program's name: authority to hand it on
// top of the console. Granted only on request, never by default - the
// capability model's whole point - and the kernel still refuses anything the
// shell does not hold itself, since a spawn can only attenuate.
fn run_grant(word: *u8, n: u32) -> u32 {
    if (n == 4 && strneq(word, "disk", 4) != 0) { return GRANT_DISK; }
    if (n == 3 && strneq(word, "net", 3) != 0) { return GRANT_NET; }
    return 0;
}

fn cmd_run(arg: *u8) -> void {
    let caps: u32 = GRANT_CONSOLE;
    while (arg[0] == '+') {
        let n: u32 = 0;
        while (arg[1 + n] != 0 && arg[1 + n] != ' ') { n += 1; }
        let g: u32 = run_grant(&arg[1], n);
        if (g == 0) { puts("run: unknown grant (one of +disk, +net)\n"); return; }
        caps |= g;
        arg = &arg[1 + n];
        while (arg[0] == ' ') { arg = &arg[1]; }
    }
    if (arg[0] == 0) { puts("usage: run [+disk] [+net] <path> [args...]\n"); return; }

    // The whole tail is packed at once, so the program's own name becomes
    // argv[0] exactly as the user typed it and the rest follow it. The packed
    // first string is then the name to look up - no second pass to find it.
    let blob: u32 = run_pack_args(arg);
    if (blob == 0) { puts("run: command line too long\n"); return; }
    let name: *u8 = &run_argbuf[0];

    let a: spawn_args;
    memzero((&a) as *u8, sizeof a);
    a.name            = name;
    a.broker_endpoint = 0 - 1;
    a.caps            = caps;
    a.args            = &run_argbuf[0];
    a.args_len        = blob;

    let pid: i32 = E_NOENT;
    if (strchr(name, 47) >= 0) {                             // '/' - a path
        pid = exec_path(name, &a);
    } else {
        let d: u32 = 0;
        while (d < RUN_DIRS) {
            let ext: u32 = 0;
            while (ext <= RUN_EXTS) {
                let p: *u8 = run_candidate(run_dirs[d], name, ext);
                a.name = p;
                pid = exec_path(p, &a);
                // Only E_NOENT means "not here, keep looking". A file that
                // exists but will not run - unsigned, a directory, not a CXEX
                // - is the answer, and reporting it beats walking past it and
                // saying the program does not exist.
                if (pid != E_NOENT) { ext = RUN_EXTS + 1; d = RUN_DIRS; }
                else { ext = ext + 1; }
            }
            d = d + 1;
        }
        a.name = name;
    }

    if (pid < 0) {
        puts(name);
        puts(": ");
        // E_PERM here means the signature check refused it, not a file
        // permission problem - worth saying plainly, since an unsigned build
        // is by far the most likely cause.
        if (pid == E_PERM) { puts("not signed by a key this kernel trusts\n"); }
        else { puts(file_strerror(pid)); newline(); }
        return;
    }
    puts("started pid ");
    print_u32(pid as u32);
    newline();
}

fn cmd_edit(arg: *u8) -> void {
    if (arg[0] == 0) { puts("usage: edit <path>\n"); return; }
    // The editor draws itself with gfx_text, so it needs the framebuffer. In
    // VGA text mode gfx_width() is 0 and it declines - say so rather than
    // reporting "invalid argument" about the file, which is not the problem.
    if (gfx_width() < 320) { puts("edit needs the framebuffer - build with CXK_ENABLE_FB=1\n"); return; }
    let rc: i32 = edit_run(arg);
    if (rc < 0) { file_err(arg, rc); return; }
    puts("left the editor\n");
}

fn cmd_stat(arg: *u8) -> void {
    if (arg[0] == 0) { puts("usage: stat <path>\n"); return; }
    let st: file_stat;
    if (file_err(arg, stat(arg, &st)) == 1) { return; }

    puts("name  "); puts(&st.name[0]); newline();
    puts("kind  ");
    if (st.kind == FTYPE_DIR) { puts("directory"); } else { puts("file"); }
    newline();
    puts("size  "); print_u32(st.size); puts(" bytes\n");
    puts("owner "); print_u32(st.owner_uid); newline();
    puts("perms "); print_hex(st.permissions); newline();
    puts("id    "); print_u32(st.id); newline();
}

// ---- line handling ----

// split at the first space: terminates the command word in place and returns
// a pointer to the argument text (empty string if there is none)
fn split_arg(line: *u8) -> *u8 {
    let i: u32 = 0;
    while (line[i] != 0) {
        if (line[i] == 32) {
            line[i] = 0;
            return &line[i + 1];
        }
        i = i + 1;
    }
    return &line[i];                // points at the NUL: an empty argument
}

fn _start() -> void {
    let line: [128]u8;

    run_dirs[0] = "/System/Programs";
    run_dirs[1] = "/Shared/Programs";
    run_exts[0] = ".xsex";
    run_exts[1] = ".xuex";

    register("help",   cmd_help,   "list commands");
    register("echo",   cmd_echo,   "print the rest of the line");
    register("pid",    cmd_pid,    "process and user id");
    register("str",    cmd_str,    "string library demo");
    register("mem",    cmd_mem,    "memory library demo");
    register("heap",   cmd_heap,   "allocation: quota, use, and a round trip");
    register("math",   cmd_math,   "fixed-point demo");
    register("gui",    cmd_gui,    "enter the CXOS graphical shell");
    register("ver",    cmd_ver,    "version");
    register("ls",     cmd_ls,     "list a directory");
    register("cat",    cmd_cat,    "print a file");
    register("write",  cmd_write,  "write text to a file (replaces)");
    register("append", cmd_append, "add text to the end of a file");
    register("stat",   cmd_stat,   "show an entry's metadata");
    register("edit",   cmd_edit,   "full-screen text editor");
    register("run",    cmd_run,    "run a signed program (searches /System and /Shared); +disk +net grant more");
    register("mkdir",  cmd_mkdir,  "create a directory");
    register("rm",     cmd_rm,     "delete a file or empty directory");
    register("mv",     cmd_mv,     "rename an entry");
    register("cd",     cmd_cd,     "change the working directory");
    register("pwd",    cmd_pwd,    "print the working directory");
    register("font",   cmd_font,   "list console fonts, or 'font <name>' to use one");
    register("ifconfig", cmd_ifconfig, "network interface status");
    register("setip",  cmd_setip,  "set the local IP address");
    register("ping",   cmd_ping,   "ICMP echo a host");
    register("reboot", cmd_reboot, "restart the machine");
    register("shutdown", cmd_shutdown, "ACPI soft off");

    console_restore_font();
    puts("CXK shell - type 'help'\n");

    while (1 == 1) {
        puts("cxk> ");
        read_line(&line[0], sizeof line);

        let arg: *u8 = split_arg(&line[0]);
        if (line[0] == 0) { continue; }          // blank line

        // dispatch through the table
        let i: u32 = 0;
        let found: i32 = 0;
        while (i < cmd_n) {
            if (streq(&line[0], cmd_names[i]) == 1) {
                cmd_fns[i](arg);                 // call through a function pointer
                found = 1;
                break;
            }
            i = i + 1;
        }

        if (found == 0) {
            puts("unknown command: ");
            puts(&line[0]);
            puts("  (try 'help')\n");
        }
    }
}
