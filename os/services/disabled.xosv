// disabled.xosv - a service that is present but not started.
//
// `start` is absent, so the supervisor reads this, finds no instruction to run
// it, and moves on. That is the point: a service can sit on disk turned off
// without being deleted, and turning it on is adding one line rather than
// remembering what the file used to contain.
//
// Absent is the ONLY way to say "off". `start = off`, or a misspelt
// `start = boto`, is refused with the line it is on rather than quietly
// read as "not yet".
//
// It also proves the walk finds more than one descriptor.

exec   = "/Shared/Programs/hi.xuex"
args   = ["this should never print"]
grants = [console]
