<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- The kernel interface, the one definition the ABI is generated from
       (docs/kernel/CX_SYSCALLS_IPC.md section 9). Embedded so a released cxk
       generates the header and the X prelude from the interface it was built
       with, with no repository beside it. See Abi/AbiModel.cs. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\abi\kernel.xfil" LogicalName="kernel.xfil" Link="Abi\kernel.xfil" />
  </ItemGroup>

</Project>
