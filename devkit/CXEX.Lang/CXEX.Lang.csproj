<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- The canonical ABI (DevKit engineering review section 7). Embedded so a
       released cxk generates the X prelude from the header it was built
       against, with no repository beside it. See Abi/AbiModel.cs. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\abi\cxk_abi.h" LogicalName="cxk_abi.h" Link="Abi\cxk_abi.h" />
  </ItemGroup>

</Project>
