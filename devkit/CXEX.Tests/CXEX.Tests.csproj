<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The DevKit's own test stack: `dotnet test`, no Python interpreter
         (HARDENING_PLAN D1). -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../CXEX.Build/CXEX.Build.csproj" />
    <ProjectReference Include="../CXEX.Core/CXEX.Core.csproj" />
    <ProjectReference Include="../CXEX.Crypto/CXEX.Crypto.csproj" />
    <ProjectReference Include="../CXEX.FileType/CXEX.FileType.csproj" />
    <ProjectReference Include="../CXEX.Lang/CXEX.Lang.csproj" />
  </ItemGroup>

</Project>
