module pointer 4
string @str.0 = "hi\0a\00"
global @msg size 4 align 4 = { addr @str.0 }
global @table size 8 align 4 = { addr @twice, addr @twice }
global @big size 8 align 4 = { bytes 2 0 0 0 1 0 0 0 }

extern fn @ext(ptr p) -> i32

fn @twice(i32 v %0) -> i32 {
  slot $0 4 align 4 ; v
b0:
  store i32 %0, $0
  %1 = load i32, $0
  %2 = shl i32 %1, 1
  ret i32 %2
}

fn @make(i32 a %0) -> agg 8 {
  slot $0 4 align 4 ; a
  slot $1 8 align 4
  slot $2 8 align 4
b0:
  store i32 %0, $0
  %1 = load i32, $0
  store i32 %1, $2
  %2 = load i32, $0
  %3 = add i32 %2, 1
  %4 = ptradd $2, 4
  store i32 %3, %4
  copy $1, $2, 8
  ret agg 8 $1
}

fn @area(ptr s %0) -> i32 {
  slot $0 4 align 4 ; s
  slot $1 4 align 4 ; b
b0:
  store ptr %0, $0
  %1 = load ptr, $0
  %2 = load i32, %1
  switch i32 %2, b3 [1: b1, 0: b2]
b1:
  %3 = ptradd %1, 4
  store ptr %3, $1
  %4 = load ptr, $1
  %5 = ptradd %4, 4
  %6 = load i32, %5
  %7 = load ptr, $1
  %8 = load i32, %7
  %9 = mul i32 %8, %6
  ret i32 %9
b2:
  ret i32 0
b3:
  ret i32 0
}

fn @mix(i8 a %0, i64 b %1, bool c %2, bool d %3) -> i64 {
  slot $0 1 align 4 ; a
  slot $1 8 align 4 ; b
  slot $2 1 align 4 ; c
  slot $3 1 align 4 ; d
  slot $4 1 align 4
b0:
  store i8 %0, $0
  store i64 %1, $1
  store bool %2, $2
  store bool %3, $3
  %4 = load bool, $2
  store bool %4, $4
  brif %4, b1, b2
b1:
  %5 = load bool, $3
  store bool %5, $4
  br b2
b2:
  %6 = load bool, $4
  brif %6, b3, b4
b3:
  %7 = load i8, $0
  %8 = zext i8 %7 to i64
  %9 = load i64, $1
  %10 = sdiv i64 %9, %8
  ret i64 %10
b4:
  %11 = load i64, $1
  %12 = load i8, $0
  %13 = zext i8 %12 to i64
  %14 = sub i64 %13, %11
  ret i64 %14
}

fn @sys(ptr p %0) -> i32 {
  slot $0 4 align 4 ; p
b0:
  store ptr %0, $0
  %1 = load ptr, $0
  %2 = call @ext(ptr %1) -> i32
  %3 = load ptr, $0
  %4 = ptrtoint ptr %3 to i32
  %5 = syscall i32 (i32 3, i32 %4, i32 4)
  %6 = add i32 %5, %2
  ret i32 %6
}

fn @use(ptr f %0) -> i32 {
  slot $0 4 align 4 ; f
  slot $1 8 align 4 ; q
  slot $2 8 align 4
b0:
  store ptr %0, $0
  call @make(i32 2) -> agg 8 $2
  copy $1, $2, 8
  %1 = load ptr, $0
  %2 = call %1(i32 3) -> i32
  %3 = ptradd $1, 4
  %4 = load i32, %3
  %5 = add i32 %4, %2
  ret i32 %5
}
