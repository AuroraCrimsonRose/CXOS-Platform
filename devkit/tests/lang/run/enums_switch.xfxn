enum color { red, green, blue }
enum op: u8 { add = 1, sub, mul = 10, neg }
enum sgn: i8 { minus = -1, zero, plus }

enum node {
    num { value: i64 },
    bin { kind: op, left: *node, right: *node },
    eof,
}

global pool: [16]node;
global used: u32 = 0;
fn put(n: node) -> *node { let p: *node = &pool[used]; *p = n; used += 1; return p; }

fn eval(n: *node) -> i64 {
    switch (*n) {
        case node.num(x) { return x.value; }
        case node.bin(b) {
            let l: i64 = eval(b.left);
            let r: i64 = eval(b.right);
            switch (b.kind) {
                case op.add { return l + r; }
                case op.sub { return l - r; }
                case op.mul { return l * r; }
                case op.neg { return 0 - l; }
            }
        }
        case node.eof { return 0; }
    }
    return 0;
}

fn name_of(c: color) -> u8 {
    switch (c) { case color.red { return 'r'; } case color.green { return 'g'; } case color.blue { return 'b'; } }
    return '?';
}

fn classify(c: u8) -> u32 {
    switch (c) {
        case 'a', 'e', 'i', 'o', 'u' { return 1; }
        case ' ', '\t', '\n' { return 2; }
        else { if (c >= '0' && c <= '9') { return 3; } return 0; }
    }
    return 99;
}

global hits: u32 = 0;
fn bump() -> u32 { hits += 1; return 7; }

fn main() -> i32 {
    // plain enums: values, backing sizes, conversion only through `as`
    if (color.blue as u32 != 2) { return 1; }
    if (op.sub as u32 != 2 || op.mul as u32 != 10 || op.neg as u32 != 11) { return 2; }
    if (sizeof op.add != 1 || sizeof color.red != 4) { return 3; }
    if (sgn.minus as i32 != 0 - 1 || sgn.plus as i32 != 1) { return 4; }
    let c: color = color.green;
    if (c != color.green || c == color.red) { return 5; }
    if (name_of(color.blue) != 'b' || name_of(c) != 'g') { return 6; }
    let raw: u32 = 2;
    if (name_of(raw as color) != 'b') { return 7; }

    // integer switch with character labels and else
    if (classify('e') != 1 || classify('\t') != 2 || classify('7') != 3 || classify('z') != 0) { return 10; }
    // subject evaluated once
    switch (bump()) { case 1 { } case 7 { } else { } }
    if (hits != 1) { return 11; }

    // a sum type: (2 + 3) * -(4) = -20
    let two: *node = put(node.num { value: 2 });
    let three: *node = put(node.num { value: 3 });
    let four: *node = put(node.num { value: 4 });
    let sum: *node = put(node.bin { kind: op.add, left: two, right: three });
    let neg4: *node = put(node.bin { kind: op.neg, left: four, right: four });
    let prod: *node = put(node.bin { kind: op.mul, left: sum, right: neg4 });
    if (eval(prod) != 0 - 20) { return 20; }
    if (eval(put(node.eof)) != 0) { return 21; }
    if (eval(put(node.num { value: 0x7FFFFFFFFFFF })) != 0x7FFFFFFFFFFF) { return 22; }

    // sum values by value: copied, passed, switched on directly
    let a: node = node.num { value: 5 };
    let b: node = a;
    let t: u32 = 0;
    switch (b) { case node.num(v) { if (v.value == 5) { t = 1; } } case node.bin { t = 2; } case node.eof { t = 3; } }
    if (t != 1) { return 23; }
    a = node.eof;
    switch (a) { case node.eof { t = 4; } else { t = 5; } }
    if (t != 4) { return 24; }

    // a binding is a pointer into the subject: writes through it are seen
    let m: node = node.num { value: 1 };
    switch (m) { case node.num(v) { v.value = 41; } else { } }
    switch (m) { case node.num(v) { if (v.value != 41) { return 25; } } else { return 26; } }

    // defer inside a case runs when the case's block is left
    let d: u32 = 0;
    switch (color.red) { case color.red { defer d = 9; d = 1; } else { } }
    if (d != 9) { return 27; }
    return 0;
}
