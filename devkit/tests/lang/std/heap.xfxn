// A stand-in for std/heap.xfxn, so buf.xfxn can be tested on the host: the real
// allocator asks the kernel for memory, and there is no kernel here. Bump
// allocation from a fixed arena, sizes kept in a header, and a switch that
// makes the next allocations fail - which is what lets the test check that a
// refused append leaves a buffer exactly as it was.
global test_arena: [262144]u8;
global test_top: u32 = 0;
global test_refuse: u32 = 0;      // > 0: refuse that many more allocations
global test_allocs: u32 = 0;

fn alloc(n: u32) -> u32 {
    if (test_refuse > 0) { test_refuse -= 1; return 0; }
    let size: u32 = (n + 7) & 0xFFFFFFF8;
    if (test_top + 8 + size > 262144) { return 0; }
    let base: u32 = (&test_arena[0]) as u32 + test_top;
    let h: *u32 = base as *u32;
    h[0] = size;
    test_top += 8 + size;
    test_allocs += 1;
    return base + 8;
}
fn alloc_size(p: u32) -> u32 { let h: *u32 = (p - 8) as *u32; return h[0]; }
fn free(p: u32) -> void { }
fn realloc(p: u32, n: u32) -> u32 {
    if (p == 0) { return alloc(n); }
    let have: u32 = alloc_size(p);
    if (have >= n) { return p; }
    let q: u32 = alloc(n);
    if (q == 0) { return 0; }
    let s: *u8 = p as *u8;
    let d: *u8 = q as *u8;
    let i: u32 = 0;
    while (i < have) { d[i] = s[i]; i += 1; }
    return q;
}
