// A stand-in for std/heap.xfxn, so buf.xfxn can be tested on the host: the real
// allocator asks the kernel for memory, and there is no kernel here. Bump
// allocation from an arena the test hands over (test_arena_at), sizes kept in a
// header, and a switch that makes the next allocations fail - which is what
// lets the test check that a refused append leaves a buffer exactly as it was.
//
// The test gives it an arena on its own stack: on x86-64 Linux the stack is
// above 4 GB, so every address buf.xfxn handles there is one that a u32 would
// cut short.
global test_base: usize = 0;
global test_size: u32 = 0;
global test_top: u32 = 0;
global test_refuse: u32 = 0;      // > 0: refuse that many more allocations
global test_allocs: u32 = 0;

fn test_arena_at(base: *u8, size: u32) -> void {
    test_base = base as usize;
    test_size = size;
    test_top = 0;
}

fn alloc(n: u32) -> usize {
    if (test_refuse > 0) { test_refuse -= 1; return 0; }
    let size: u32 = (n + 7) & 0xFFFFFFF8;
    if (test_top + 8 + size > test_size) { return 0; }
    let base: usize = test_base + (test_top as usize);
    let h: *u32 = base as *u32;
    h[0] = size;
    test_top += 8 + size;
    test_allocs += 1;
    return base + 8;
}
fn alloc_size(p: usize) -> u32 { let h: *u32 = (p - 8) as *u32; return h[0]; }
fn free(p: usize) -> void { }
fn realloc(p: usize, n: u32) -> usize {
    if (p == 0) { return alloc(n); }
    let have: u32 = alloc_size(p);
    if (have >= n) { return p; }
    let q: usize = alloc(n);
    if (q == 0) { return 0; }
    let s: *u8 = p as *u8;
    let d: *u8 = q as *u8;
    let i: u32 = 0;
    while (i < have) { d[i] = s[i]; i += 1; }
    return q;
}
